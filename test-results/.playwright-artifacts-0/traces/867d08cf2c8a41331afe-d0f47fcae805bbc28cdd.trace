b,u+f1e3,u+f1ea,u+f1f7,u+f1f9,u+f20a,u+f247-f248,u+f24a,u+f24d,u+f255-f25b,u+f25d,u+f271-f274,u+f278,u+f27b,u+f28c,u+f28e,u+f29c,u+f2b5,u+f2b7,u+f2ba,u+f2bc,u+f2be,u+f2c0-f2c1,u+f2c3,u+f2d0,u+f2d2,u+f2d4,u+f2dc}@font-face{font-family:\"FontAwesome\";font-display:block;src:url(/@fs/workspaces/Game-Design/node_modules/@fortawesome/fontawesome-free/webfonts/fa-v4compatibility.woff2) format(\"woff2\");unicode-range:u+f041,u+f047,u+f065-f066,u+f07d-f07e,u+f080,u+f08b,u+f08e,u+f090,u+f09a,u+f0ac,u+f0ae,u+f0b2,u+f0d0,u+f0d6,u+f0e4,u+f0ec,u+f10a-f10b,u+f123,u+f13e,u+f148-f149,u+f14c,u+f156,u+f15e,u+f160-f161,u+f163,u+f175-f178,u+f195,u+f1f8,u+f219,u+f27a}"],["STYLE",{},"/*\n * WILD CARDS — GLOBAL MOTION BLUR\n * A lightweight, preference-controlled movement accent. The base filter is\n * captured at animation start so character drop-shadows and other styling\n * remain intact. Blur is intentionally subtle to protect image readability.\n */\n:root.wc-motion-blur-enabled .wc-motion-blur-active {\n  filter: var(--wc-motion-base-filter, none) blur(1.15px) !important;\n  backface-visibility: hidden;\n}\n\n/* Avoid adding blur to static UI or accessibility-reduced motion. */\n@media (prefers-reduced-motion: reduce) {\n  :root.wc-motion-blur-enabled .wc-motion-blur-active {\n    filter: var(--wc-motion-base-filter, none) !important;\n  }\n}\n"],["STYLE",{},"/*\n * Wild Cards global graphics presets.\n * Low keeps the complete interface and combat feedback while trimming expensive\n * decorative layers. Normal is the original presentation. High enhances the\n * effects the browser and source artwork can actually provide.\n */\n:root[data-wc-quality=\"low\"] *,\n:root[data-wc-quality=\"low\"] *::before,\n:root[data-wc-quality=\"low\"] *::after {\n  box-shadow: none !important;\n  text-shadow: none !important;\n  backdrop-filter: none !important;\n  -webkit-backdrop-filter: none !important;\n}\n\n:root[data-wc-quality=\"low\"] #battleLayout > #battleArena {\n  background: #0b1711 !important;\n}\n\n/* Low mode suppresses optional blur even if its preference remains enabled. */\n:root[data-wc-quality=\"low\"].wc-motion-blur-enabled .wc-motion-blur-active {\n  filter: var(--wc-motion-base-filter, none) !important;\n}\n\n:root[data-wc-quality=\"low\"] #battleLayout .solo-fighter-art::before {\n  display: none !important;\n}\n\n:root[data-wc-quality=\"low\"] .team-battle .fighter-portrait-wrapper {\n  box-shadow: none !important;\n}\n\n:root[data-wc-quality=\"low\"] .team-battle .fighter-portrait-wrapper:not(.fighter-stunned) {\n  background: #091321 !important;\n}\n\n:root[data-wc-quality=\"low\"] #battleLayout .solo-fighter-art:not(:has(.impact-attack)):not(:has(.impact-damage)) .solo-portrait-wrapper > img,\n:root[data-wc-quality=\"low\"] .team-battle .fighter-art-button:not(:has(.impact-attack)):not(:has(.impact-damage)) .fighter-portrait {\n  animation: none !important;\n}\n\n/* High means maximum detail/effects available from the browser and assets,\n   not artificial upscaling of low-resolution character artwork to true 8K. */\n:root[data-wc-quality=\"high\"] #battleLayout > #battleArena {\n  box-shadow: inset 0 0 34px #0007, 0 0 22px #13d5ff35, 0 0 54px #13d5ff18;\n}\n\n:root[data-wc-quality=\"high\"] #battleLayout .solo-fighter-hud,\n:root[data-wc-quality=\"high\"] .team-battle .fighter-card,\n:root[data-wc-quality=\"high\"] .team-battle .fighter-hud,\n:root[data-wc-quality=\"high\"] #battleLayout .attack-card {\n  box-shadow: 0 9px 24px #0008, 0 0 16px #13d5ff22, inset 0 1px 0 #ffffff20;\n}\n\n:root[data-wc-quality=\"high\"] #battleLayout .solo-fighter-art img,\n:root[data-wc-quality=\"high\"] .team-battle .fighter-portrait {\n  image-rendering: auto;\n  filter: saturate(1.12) contrast(1.06) drop-shadow(0 0 10px #13d5ff35);\n}\n\n:root[data-wc-quality=\"high\"] .team-battle .opponent-team .fighter-portrait {\n  filter: saturate(1.12) contrast(1.06) drop-shadow(0 0 10px #ff315945);\n}\n\n:root[data-wc-quality=\"high\"] .team-battle .fighter-portrait-wrapper.fighter-stunned > .fighter-portrait {\n  filter: drop-shadow(0 0 5px #13d5ff) drop-shadow(0 0 14px rgba(19, 213, 255, .9));\n}\n"],["STYLE",{},"@import url(\"https://fonts.googleapis.com/css2?family=Oxanium:wght@500;600;700;800&display=swap\");\n\n.game-intro {\n  --intro-lime: #c8f36a;\n  --intro-gold: #f2d477;\n  position: fixed;\n  inset: 0;\n  z-index: 9999;\n  display: grid;\n  place-items: center;\n  overflow: hidden;\n  padding: 28px;\n  isolation: isolate;\n  color: #f5f0df;\n  background:\n    radial-gradient(ellipse at 50% 48%, rgba(70, 83, 49, 0.32), transparent 55%),\n    linear-gradient(145deg, #101a1c, #080e14 58%, #171a16);\n  font-family: \"Oxanium\", sans-serif;\n}\n\n.game-intro-grid,\n.game-intro-scanlines {\n  position: absolute;\n  inset: 0;\n  z-index: -1;\n  pointer-events: none;\n}\n\n.game-intro-grid {\n  opacity: 0.2;\n  background-image:\n    linear-gradient(rgba(200, 243, 106, 0.11) 1px, transparent 1px),\n    linear-gradient(90deg, rgba(200, 243, 106, 0.11) 1px, transparent 1px);\n  background-size: 46px 46px;\n  mask-image: radial-gradient(ellipse, black, transparent 78%);\n  animation: intro-grid-drift 16s linear infinite;\n}\n\n.game-intro-scanlines {\n  opacity: 0.12;\n  background: repeating-linear-gradient(\n    to bottom,\n    transparent 0,\n    transparent 3px,\n    rgba(0, 0, 0, 0.6) 4px\n  );\n}\n\n.game-intro-card {\n  position: relative;\n  width: min(100%, 900px);\n  min-height: 340px;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 34px;\n  padding: clamp(30px, 7vw, 76px);\n  border-top: 1px solid rgba(242, 212, 119, 0.65);\n  border-bottom: 1px solid rgba(200, 243, 106, 0.45);\n  background: linear-gradient(110deg, rgba(11, 20, 22, 0.3), rgba(28, 35, 25, 0.5), rgba(11, 20, 22, 0.3));\n  text-align: center;\n  animation: intro-card-enter 650ms cubic-bezier(.16, 1, .3, 1) both;\n}\n\n.game-intro-card::before,\n.game-intro-card::after {\n  content: \"\";\n  position: absolute;\n  width: 38px;\n  height: 38px;\n  border-color: var(--intro-lime);\n  border-style: solid;\n  opacity: 0.85;\n}\n\n.game-intro-card::before {\n  top: 0;\n  left: 0;\n  border-width: 2px 0 0 2px;\n}\n\n.game-intro-card::after {\n  right: 0;\n  bottom: 0;\n  border-width: 0 2px 2px 0;\n}\n\n.game-intro-index,\n.game-intro-progress,\n.game-intro-skip,\n.game-intro-countdown,\n.game-intro-impact {\n  color: #aab69a;\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: 3px;\n}\n\n.game-intro-copy {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 8px;\n  width: 100%;\n  font-size: clamp(19px, 4vw, 38px);\n  font-weight: 800;\n  line-height: 1.2;\n  letter-spacing: clamp(1px, 0.3vw, 4px);\n  text-wrap: balance;\n}\n\n.game-intro-copy span {\n  display: block;\n  animation: intro-line-enter 500ms cubic-bezier(.16, 1, .3, 1) both;\n}\n\n.game-intro-credit .game-intro-copy span:first-child,\n.game-intro-beta .game-intro-copy span:last-child {\n  color: var(--intro-gold);\n}\n\n.game-intro-community .game-intro-copy span:nth-child(2) {\n  color: var(--intro-lime);\n}\n\n.game-intro-progress {\n  position: absolute;\n  right: 24px;\n  bottom: 18px;\n  font-variant-numeric: tabular-nums;\n}\n\n.game-intro-skip {\n  position: absolute;\n  right: 24px;\n  bottom: 22px;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 10px 12px;\n  border: 1px solid rgba(200, 243, 106, 0.25);\n  background: rgba(5, 10, 12, 0.55);\n  color: #b9c2ad;\n  cursor: pointer;\n  transition: color 160ms ease, border-color 160ms ease;\n}\n\n.game-intro-skip:hover {\n  color: var(--intro-lime);\n  border-color: var(--intro-lime);\n}\n\n.game-intro-skip span {\n  color: var(--intro-lime);\n}\n\n.game-intro-finale {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 22px;\n  text-align: center;\n  animation: finale-enter 500ms ease-out both;\n}\n\n.game-intro-finale h1 {\n  display: flex;\n  flex-direction: column;\n  margin: 0;\n  font-size: clamp(64px, 14vw, 150px);\n  font-weight: 800;\n  font-style: italic;\n  line-height: 0.82;\n  letter-spacing: -0.055em;\n  text-shadow: 7px 7px 0 rgba(0, 0, 0, 0.5);\n}\n\n.game-intro-finale h1 span {\n  animation: finale-word 500ms cubic-bezier(.16, 1, .3, 1) both;\n}\n\n.game-intro-finale h1 span:nth-child(2) {\n  color: var(--intro-gold);\n}\n\n.game-intro-finale h1 span:nth-child(3) {\n  color: var(--intro-lime);\n}\n\n.game-intro-card-word {\n  text-shadow: 0 0 26px rgba(200, 243, 106, 0.28), 7px 7px 0 rgba(0, 0, 0, 0.5);\n}\n\n.game-intro-impact {\n  animation: intro-fade-in 500ms ease-out 180ms both;\n}\n\n@keyframes intro-card-enter {\n  from { opacity: 0; transform: scale(1.035) translateY(16px); filter: blur(5px); }\n  to { opacity: 1; transform: scale(1) translateY(0); filter: blur(0); }\n}\n\n@keyframes intro-line-enter {\n  from { opacity: 0; transform: translateY(18px) skewY(2deg); filter: blur(4px); }\n  to { opacity: 1; transform: translateY(0) skewY(0); filter: blur(0); }\n}\n\n@keyframes finale-enter {\n  from { opacity: 0; transform: scale(.92); filter: blur(8px); }\n  to { opacity: 1; transform: scale(1); filter: blur(0); }\n}\n\n@keyframes finale-word {\n  0% { opacity: 0; transform: translateY(28px) scale(.88); }\n  65% { opacity: 1; transform: translateY(-5px) scale(1.035); }\n  100% { opacity: 1; transform: translateY(0) scale(1); }\n}\n\n@keyframes intro-fade-in {\n  from { opacity: 0; letter-spacing: 8px; }\n  to { opacity: 1; letter-spacing: 3px; }\n}\n\n@keyframes intro-grid-drift {\n  to { background-position: 46px 46px, 46px 46px; }\n}\n\n@media (max-width: 560px) {\n  .game-intro { padding: 16px; }\n  .game-intro-card { min-height: 300px; gap: 25px; padding: 32px 18px; }\n  .game-intro-index { font-size: 9px; letter-spacing: 1.5px; }\n  .game-intro-copy { gap: 12px; font-size: clamp(18px, 5.2vw, 28px); }\n  .game-intro-skip { right: 12px; bottom: 12px; font-size: 9px; }\n  .game-intro-progress { right: 16px; bottom: 58px; }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .game-intro-grid,\n  .game-intro-card,\n  .game-intro-copy span,\n  .game-intro-finale,\n  .game-intro-finale h1 span,\n  .game-intro-impact { animation: none !important; }\n}\n"],["STYLE",{},"\n@import url(\"https://fonts.googleapis.com/css2?family=Oxanium:wght@400;500;600;700;800&family=Rajdhani:wght@400;500;600;700&display=swap\");\n\n/* ==========================================\n   WILD CARDS — ACHIEVEMENTS\n   Shared green and gold arcade identity\n========================================== */\n\n.achievements-screen {\n  --wc-lime: #a5f51b;\n  --wc-gold: #f6d84a;\n  --wc-dark: #10141c;\n  --wc-panel: rgba(12, 18, 27, 0.94);\n  --wc-muted: #aab3c0;\n\n  position: relative;\n  isolation: isolate;\n  min-height: 100vh;\n  padding: 25px 5%;\n  overflow: hidden;\n  color: #fff;\n  background: var(--wc-dark);\n  font-family: \"Rajdhani\", sans-serif;\n}\n\n.achievements-screen *,\n.achievements-screen *::before,\n.achievements-screen *::after {\n  box-sizing: border-box;\n}\n\n/* BACKGROUND */\n\n.achievements-background {\n  position: fixed;\n  inset: 0;\n  z-index: -1;\n  pointer-events: none;\n  background:\n    radial-gradient(\n      ellipse at 50% 15%,\n      rgba(165, 245, 27, 0.10),\n      transparent 42%\n    ),\n    radial-gradient(\n      ellipse at 90% 80%,\n      rgba(246, 216, 74, 0.045),\n      transparent 40%\n    ),\n    linear-gradient(145deg, #18221c, #10141c 55%, #090e15);\n}\n\n.achievements-background::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  opacity: 0.16;\n  background-image:\n    linear-gradient(rgba(165, 245, 27, 0.07) 1px, transparent 1px),\n    linear-gradient(90deg, rgba(165, 245, 27, 0.07) 1px, transparent 1px);\n  background-size: 48px 48px;\n  mask-image: linear-gradient(\n    to bottom,\n    transparent,\n    black 25%,\n    black 80%,\n    transparent\n  );\n}\n\n/* HEADER */\n\n.achievements-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  width: 100%;\n  max-width: 1300px;\n  margin: 0 auto;\n}\n\n.achievements-logo {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  color: #fff9e9;\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 16px;\n  font-weight: 800;\n  letter-spacing: 2px;\n}\n\n.achievements-logo .logo-mark {\n  display: grid;\n  place-items: center;\n  width: 44px;\n  height: 44px;\n  color: #172015;\n  background: var(--wc-lime);\n  font-size: 17px;\n  font-weight: 900;\n  transform: skew(-8deg);\n  box-shadow: 4px 4px 0 #536b25;\n}\n\n.achievements-back {\n  padding: 11px 19px;\n  border: 1px solid rgba(246, 216, 74, 0.35);\n  border-left: 4px solid var(--wc-lime);\n  background: rgba(12, 18, 27, 0.85);\n  color: #e8e2cd;\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: 1.5px;\n  cursor: pointer;\n  transition: 180ms ease;\n}\n\n.achievements-back:hover {\n  border-color: var(--wc-lime);\n  color: var(--wc-lime);\n  background: rgba(165, 245, 27, 0.08);\n  transform: translateX(-3px);\n}\n\n/* MAIN CONTENT */\n\n.achievements-content {\n  width: 100%;\n  max-width: 1250px;\n  margin: 65px auto 45px;\n}\n\n.achievements-eyebrow {\n  margin: 0 0 10px;\n  color: var(--wc-lime);\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 11px;\n  font-weight: 800;\n  letter-spacing: 5px;\n  text-align: center;\n}\n\n.achievements-title {\n  margin: 0;\n  color: #fff9e9;\n  font-family: \"Oxanium\", sans-serif;\n  font-size: clamp(34px, 6vw, 58px);\n  font-weight: 800;\n  letter-spacing: 2px;\n  text-align: center;\n  text-shadow:\n    3px 3px 0 rgba(0, 0, 0, 0.45),\n    0 0 22px rgba(165, 245, 27, 0.12);\n}\n\n.achievements-subtitle {\n  margin: 12px 0 38px;\n  color: #c4c6b9;\n  font-size: 16px;\n  font-weight: 600;\n  letter-spacing: 0.5px;\n  text-align: center;\n}\n\n/* PROGRESS PANEL */\n\n.achievement-progress {\n  max-width: 680px;\n  margin: 0 auto 42px;\n  padding: 20px 23px;\n  border: 1px solid rgba(246, 216, 74, 0.23);\n  border-left: 4px solid var(--wc-lime);\n  background:\n    linear-gradient(\n      110deg,\n      rgba(36, 48, 34, 0.92),\n      rgba(12, 18, 27, 0.96)\n    );\n  box-shadow: 0 8px 25px rgba(0, 0, 0, 0.22);\n}\n\n.achievement-progress-info {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 12px;\n  margin-bottom: 13px;\n  color: #d6d5c8;\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: 2px;\n}\n\n.achievement-progress-info strong {\n  color: var(--wc-gold);\n  font-size: 15px;\n  font-variant-numeric: tabular-nums;\n}\n\n.achievement-progress-track {\n  height: 9px;\n  overflow: hidden;\n  background: #252d2b;\n  border: 1px solid rgba(165, 245, 27, 0.12);\n}\n\n.achievement-progress-fill {\n  height: 100%;\n  background: linear-gradient(\n    90deg,\n    #719d22,\n    var(--wc-lime)\n  );\n  box-shadow: 0 0 13px rgba(165, 245, 27, 0.4);\n  transition: width 0.45s ease;\n}\n\n/* ACHIEVEMENT GRID */\n\n.achievement-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));\n  gap: 20px;\n}\n\n/* ACHIEVEMENT CARDS */\n\n.achievement-card {\n  position: relative;\n  display: flex;\n  align-items: center;\n  gap: 19px;\n  min-height: 225px;\n  padding: 19px;\n  overflow: hidden;\n  border: 1px solid rgba(246, 216, 74, 0.19);\n  border-bottom: 3px solid rgba(165, 245, 27, 0.35);\n  background:\n    linear-gradient(\n      140deg,\n      rgba(35, 44, 39, 0.97),\n      rgba(12, 18, 27, 0.98)\n    );\n  transition:\n    transform 180ms ease,\n    border-color 180ms ease,\n    box-shadow 180ms ease;\n}\n\n.achievement-card.unlocked {\n  border-color: rgba(165, 245, 27, 0.55);\n  border-bottom-color: var(--wc-lime);\n  box-shadow: inset 0 0 22px rgba(165, 245, 27, 0.035);\n}\n\n.achievement-card.unlocked:hover {\n  transform: translateY(-4px);\n  border-color: var(--wc-gold);\n  box-shadow:\n    0 10px 25px rgba(0, 0, 0, 0.3),\n    0 0 17px rgba(165, 245, 27, 0.1);\n}\n\n.achievement-card.locked {\n  border-color: rgba(150, 157, 145, 0.15);\n  border-bottom-color: rgba(150, 157, 145, 0.25);\n  background: rgba(15, 20, 26, 0.92);\n}\n\n/* ARTWORK */\n\n.achievement-artwork {\n  position: relative;\n  flex-shrink: 0;\n  width: 125px;\n  height: 190px;\n  overflow: hidden;\n  border: 1px solid rgba(246, 216, 74, 0.28);\n  background: #11191a;\n}\n\n.achievement-card.unlocked .achievement-artwork {\n  border-color: rgba(165, 245, 27, 0.55);\n  box-shadow: 0 0 12px rgba(165, 245, 27, 0.08);\n}\n\n.achievement-artwork img {\n  display: block;\n  width: 100%;\n  height: 100%;\n  object-fit: contain;\n}\n\n.achievement-lock {\n  position: absolute;\n  inset: 0;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 9px;\n  color: #d5d5ca;\n  background: rgba(5, 10, 12, 0.78);\n  backdrop-filter: grayscale(1);\n  font-size: 25px;\n}\n\n.achievement-lock small {\n  color: var(--wc-gold);\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 10px;\n  font-weight: 800;\n  letter-spacing: 2px;\n}\n\n/* DETAILS */\n\n.achievement-details {\n  flex: 1;\n  min-width: 0;\n}\n\n.achievement-category {\n  color: var(--wc-lime);\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 10px;\n  font-weight: 800;\n  letter-spacing: 2px;\n}\n\n.achievement-card.locked .achievement-category {\n  color: #8c9586;\n}\n\n.achievement-details h2 {\n  margin: 9px 0;\n  color: #fff6df;\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 18px;\n  font-weight: 800;\n  line-height: 1.25;\n}\n\n.achievement-details p {\n  margin: 0 0 15px;\n  color: #c1c6bb;\n  font-size: 14px;\n  font-weight: 600;\n  line-height: 1.45;\n}\n\n.achievement-requirement {\n  display: flex;\n  flex-direction: column;\n  gap: 5px;\n  margin-bottom: 13px;\n}\n\n.achievement-requirement strong {\n  color: #a9a58c;\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 9px;\n  font-weight: 700;\n  letter-spacing: 1.5px;\n}\n\n.achievement-requirement span {\n  color: #e0dece;\n  font-size: 12px;\n  font-weight: 600;\n  line-height: 1.4;\n}\n\n/* STATUS */\n\n.achievement-status {\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 10px;\n  font-weight: 800;\n  letter-spacing: 1px;\n}\n\n.achievement-status.earned {\n  color: var(--wc-gold);\n}\n\n.achievement-status.not-earned {\n  color: #828b80;\n}\n\n/* FOOTER */\n\n.achievements-footer {\n  padding: 25px 0 5px;\n  color: #858a7b;\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 9px;\n  font-weight: 600;\n  letter-spacing: 2px;\n  text-align: center;\n}\n\n/* RESPONSIVE */\n\n@media (max-width: 700px) {\n  .achievements-screen {\n    padding: 20px 15px;\n  }\n\n  .achievements-content {\n    margin-top: 45px;\n  }\n\n  .achievement-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .achievement-card {\n    gap: 14px;\n    padding: 14px;\n  }\n\n  .achievement-artwork {\n    width: 100px;\n    height: 152px;\n  }\n\n  .achievement-details h2 {\n    font-size: 16px;\n  }\n\n  .achievement-details p {\n    font-size: 13px;\n  }\n}\n\n@media (max-width: 380px) {\n  .achievement-card {\n    align-items: flex-start;\n    gap: 11px;\n    padding: 11px;\n  }\n\n  .achievement-artwork {\n    width: 85px;\n    height: 130px;\n  }\n\n  .achievement-details h2 {\n    font-size: 14px;\n  }\n\n  .achievement-category,\n  .achievement-status {\n    font-size: 8px;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .achievement-card,\n  .achievement-progress-fill,\n  .achievements-back {\n    transition: none;\n  }\n}\n"],["STYLE",{},".wild-stage-select {\n  width:min(1320px,calc(100% - 32px));\n  margin:24px auto 30px;\n  padding:clamp(16px,2.2vw,28px);\n  color:#f4f2dc;\n  border:1px solid #536d4c;\n  border-radius:16px;\n  background:radial-gradient(ellipse at 50% 0%,#29452d 0%,#101d17 55%,#09120e 100%);\n  box-shadow:0 18px 48px #0008,inset 0 1px #ffffff12;\n}\n.stage-select-heading {text-align:center;margin:0 0 22px}\n.stage-select-heading p,.stage-showdown-card>p {margin:0 0 7px;color:#f7d64d;font:900 10px Oxanium,sans-serif;letter-spacing:4px}\n.stage-select-heading h2 {margin:0;font:1000 clamp(25px,4vw,42px) Oxanium,sans-serif;letter-spacing:1px;text-shadow:3px 3px #6c2c20}\n.stage-select-heading>span {display:block;margin-top:7px;color:#b9c8b7;font-size:13px}\n.stage-select-grid {display:grid;grid-template-columns:repeat(auto-fit,minmax(185px,1fr));gap:13px}\n.stage-select-card {min-width:0;padding:0;text-align:left;overflow:hidden;border:1px solid #455b4d;border-radius:10px;background:#101b19;color:#f3f4e8;cursor:pointer;transition:transform .18s,border-color .18s,box-shadow .18s}\n.stage-select-card:hover:not(:disabled) {transform:translateY(-3px);border-color:#ffe15c;box-shadow:0 8px 22px #0008,0 0 13px #ffe15c35}\n.stage-select-card.is-selected {border:2px solid #ffe15c;box-shadow:0 0 0 2px #ffe15c25,0 0 18px #ffe15c44}\n.stage-select-card:disabled {cursor:default;opacity:.8}\n.stage-card-art {position:relative;display:block;height:116px;overflow:hidden;background:#070d0b}\n.stage-card-art img {width:100%;height:100%;display:block;object-fit:cover;transition:transform .45s}\n.stage-select-card:hover .stage-card-art img {transform:scale(1.04)}\n.stage-card-art:after {content:\"\";position:absolute;inset:35% 0 0;background:linear-gradient(transparent,#07100ee8)}\n.stage-card-index {position:absolute;z-index:1;top:8px;left:9px;padding:4px 6px;background:#07100dbb;color:#ffe15c;font:800 10px Oxanium}\n.stage-card-check {position:absolute;z-index:2;right:8px;bottom:8px;padding:4px 7px;border-radius:4px;background:#ffe15c;color:#10140e;font:900 9px Oxanium}\n.stage-card-copy {display:grid;gap:4px;padding:10px 11px 12px}\n.stage-card-copy strong {font:900 12px Oxanium;letter-spacing:.6px}\n.stage-card-copy small {color:#9eafa4;font-size:9px;letter-spacing:1px}\n.stage-select-footer,.local-stage-actions {display:flex;justify-content:center;align-items:center;gap:12px;margin-top:20px}\n.stage-random-button,.stage-ready-button,.stage-fight-button {min-height:42px;padding:0 17px;border-radius:7px;font:900 11px Oxanium;letter-spacing:1px;cursor:pointer}\n.stage-random-button {border:1px solid #6d8c75;background:#17281f;color:#d9eddb}\n.stage-ready-button {border:1px solid #42c6e9;background:#102c38;color:#7be6ff}\n.stage-fight-button {min-width:220px;border:1px solid #fff08a;background:linear-gradient(110deg,#fff17c,#e8b92d);color:#19170c;box-shadow:0 4px 0 #956d16}\n.stage-random-button:disabled,.stage-ready-button:disabled {opacity:.55;cursor:default}\n.local-stage-players {display:grid;grid-template-columns:1fr 1fr;gap:18px}\n.local-stage-player {min-width:0;padding:14px;border:1px solid #52634d;border-radius:12px;background:#0b1512aa}\n.local-stage-player-2 {border-color:#315d79}\n.local-stage-player>header {display:flex;justify-content:space-between;align-items:center;gap:10px;margin-bottom:12px;font:900 11px Oxanium;letter-spacing:1px}\n.local-stage-player-1>header strong {color:#ffcf6a}\n.local-stage-player-2>header strong {color:#64dcff}\n.local-stage-player>header span {color:#9aab9f;font-size:9px}\n.local-stage-grid {grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}\n.local-stage-grid .stage-card-art {height:76px}\n.local-stage-grid .stage-card-copy {padding:7px}\n.local-stage-grid .stage-card-copy strong {font-size:10px}\n.local-stage-grid .stage-card-copy small {font-size:8px}\n.local-stage-actions {margin-top:12px}\n.local-stage-actions button {flex:1}\n.stage-versus-hint {margin:18px 0 0;text-align:center;color:#b9c8b7;font-size:11px}\n.stage-showdown-backdrop {position:fixed;z-index:10000;inset:0;display:grid;place-items:center;padding:20px;background:#030806df;backdrop-filter:blur(8px);animation:stage-showdown-in .25s ease-out}\n.stage-showdown-card {width:min(520px,100%);padding:25px;text-align:center;border:1px solid #ffe15c;border-radius:16px;background:linear-gradient(145deg,#1b3024,#080e0b);box-shadow:0 0 50px #f5d34a35}\n.stage-showdown-card h2 {margin:0 0 17px;font:1000 clamp(20px,4vw,32px) Oxanium}\n.stage-showdown-art {position:relative;height:220px;overflow:hidden;border:2px solid #ffe15c;border-radius:10px;box-shadow:0 0 24px #ffe15c55}\n.stage-showdown-art img {width:100%;height:100%;object-fit:cover;animation:stage-showdown-pulse .32s ease-in-out infinite alternate}\n.stage-showdown-art span {position:absolute;inset:0;display:grid;place-items:center;color:#fff2a4;font-size:65px;text-shadow:0 0 22px #ffe15c}\n.stage-showdown-card>strong,.stage-showdown-card>small {display:block;margin-top:13px;font-family:Oxanium}\n.stage-showdown-card>strong {color:#ffe15c;font-size:17px}\n.stage-showdown-card>small {color:#9eb3a4;font-size:9px;letter-spacing:2px}\n@keyframes stage-showdown-in {from{opacity:0}to{opacity:1}}\n@keyframes stage-showdown-pulse {from{transform:scale(1.02);filter:saturate(1)}to{transform:scale(1.1);filter:saturate(1.5) brightness(1.15)}}\n@media(max-width:800px){.local-stage-players{grid-template-columns:1fr}.stage-select-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}\n@media(max-width:480px){.stage-select-footer{flex-direction:column}.stage-select-footer button{width:100%}.stage-card-art{height:90px}.local-stage-grid .stage-card-art{height:68px}}\n\n/* Shared map-select screen: both local players use this one grid. */\n.wild-stage-select.is-shared-local-select { max-width: 1420px; }\n.shared-stage-player-status {\n  display:grid;\n  grid-template-columns:1fr 1fr;\n  gap:12px;\n  margin:0 0 16px;\n}\n.shared-stage-player {\n  min-width:0;\n  display:flex;\n  justify-content:space-between;\n  align-items:center;\n  gap:10px;\n  padding:10px 14px;\n  border:1px solid #53634e;\n  border-radius:8px;\n  background:#101c16;\n  color:#dce7d9;\n  text-align:left;\n  font:800 10px Oxanium,sans-serif;\n  letter-spacing:1px;\n}\n.shared-stage-player span { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; color:#a9b9ac; font-size:9px; }\n.shared-stage-player.p1.is-active { border-color:#ffd35b; box-shadow:0 0 13px #ffd35b35; }\n.shared-stage-player.p2.is-active { border-color:#48d9ff; box-shadow:0 0 13px #48d9ff35; }\n.shared-stage-player.p1 strong { color:#ffd35b; }\n.shared-stage-player.p2 strong { color:#48d9ff; }\n.shared-stage-player.is-ready { opacity:.62; }\n.shared-stage-grid { grid-template-columns:repeat(4,minmax(0,1fr)); }\n.shared-stage-grid .stage-card-art { height:clamp(105px,13vw,170px); }\n.stage-select-card.is-p1-selected { border-color:#ffd35b; box-shadow:0 0 0 2px #ffd35b55,0 0 17px #ffd35b3d; }\n.stage-select-card.is-p2-selected { border-color:#48d9ff; box-shadow:0 0 0 2px #48d9ff55,0 0 17px #48d9ff3d; }\n.stage-player-marker {\n  position:absolute;\n  z-index:3;\n  top:8px;\n  padding:4px 7px;\n  border-radius:4px;\n  color:#111;\n  font:1000 9px Oxanium,sans-serif;\n}\n.p1-marker { right:8px; background:#ffd35b; }\n.p2-marker { right:38px; background:#48d9ff; }\n.stage-mystery-art {\n  width:100%;\n  height:100%;\n  display:flex;\n  flex-direction:column;\n  align-items:center;\n  justify-content:center;\n  gap:3px;\n  background:\n    radial-gradient(circle at 50% 35%,#596b3c 0,#263629 34%,#111a18 72%),\n    repeating-linear-gradient(135deg,#ffffff08 0 8px,transparent 8px 16px);\n}\n.stage-mystery-art strong {\n  color:#ffe66d;\n  font:1000 clamp(48px,7vw,82px)/.9 Oxanium,sans-serif;\n  text-shadow:0 0 18px #ffe15c99,3px 4px #000;\n}\n.stage-mystery-art small { color:#e7e5c7; font:900 8px Oxanium,sans-serif; letter-spacing:2px; }\n.stage-select-footer .p1-ready-button { border-color:#ffd35b; color:#ffe08a; }\n.stage-select-footer .p2-ready-button { border-color:#48d9ff; color:#8beaff; }\n.stage-versus-hint { letter-spacing:.3px; }\n.stage-battle-transition {\n  position:fixed;\n  z-index:11000;\n  inset:0;\n  display:grid;\n  place-items:center;\n  overflow:hidden;\n  background:#020805;\n  animation:stage-transition-fade-in .65s ease-out both;\n}\n.stage-transition-art {\n  position:absolute;\n  inset:-3%;\n  background-position:center;\n  background-size:cover;\n  filter:brightness(.32) saturate(1.15);\n  transform:scale(1.04);\n  animation:stage-transition-zoom 1.1s ease-out both;\n}\n.stage-transition-content {\n  position:relative;\n  z-index:1;\n  width:min(760px,90vw);\n  padding:30px 20px;\n  text-align:center;\n  color:#f5f1d5;\n  animation:stage-transition-title .8s .12s ease-out both;\n}\n.stage-transition-content>span {\n  color:#ffe15c;\n  font:1000 12px Oxanium,sans-serif;\n  letter-spacing:7px;\n  text-shadow:0 0 16px #ffe15c66;\n}\n.stage-transition-content h2 {\n  margin:15px 0 8px;\n  font:1000 clamp(25px,5vw,56px)/1.05 Oxanium,sans-serif;\n  letter-spacing:2px;\n  text-shadow:0 4px 0 #382a12,0 0 24px #ffe15c55;\n}\n.stage-transition-content p { margin:0; color:#c9d8c7; font:800 12px Oxanium,sans-serif; letter-spacing:3px; }\n.stage-transition-content i {\n  display:block;\n  width:min(260px,65vw);\n  height:3px;\n  margin:24px auto 0;\n  background:linear-gradient(90deg,transparent,#ffe15c,transparent);\n  box-shadow:0 0 15px #ffe15c;\n  animation:stage-transition-line .8s ease-in-out infinite alternate;\n}\n@keyframes stage-transition-fade-in { from{opacity:0} to{opacity:1} }\n@keyframes stage-transition-zoom { from{transform:scale(1.14);filter:brightness(.12) blur(4px)} to{transform:scale(1);filter:brightness(.32) blur(0)} }\n@keyframes stage-transition-title { from{opacity:0;transform:translateY(18px);filter:blur(5px)} to{opacity:1;transform:translateY(0);filter:blur(0)} }\n@keyframes stage-transition-line { from{opacity:.45;transform:scaleX(.7)} to{opacity:1;transform:scaleX(1)} }\n@media(max-width:850px) {\n  .shared-stage-grid { grid-template-columns:repeat(2,minmax(0,1fr)); }\n  .shared-stage-grid .stage-card-art { height:clamp(90px,18vw,145px); }\n}\n@media(max-width:520px) {\n  .shared-stage-player-status { grid-template-columns:1fr; gap:7px; }\n  .shared-stage-player { padding:8px 10px; }\n  .stage-select-footer { flex-wrap:wrap; }\n  .stage-select-footer .stage-ready-button { flex:1 1 42%; }\n  .shared-stage-grid .stage-card-art { height:92px; }\n}\n\n/* Final blackout: keep the selected stage visible while it fades away. */\n.stage-battle-transition.is-exiting {\n  animation: stage-transition-fade-out .72s ease-in forwards;\n  pointer-events: none;\n}\n.stage-battle-transition.is-exiting .stage-transition-content {\n  animation: stage-transition-content-out .55s ease-in forwards;\n}\n.stage-battle-transition.is-exiting .stage-transition-art {\n  animation: stage-transition-art-out .72s ease-in forwards;\n}\n@keyframes stage-transition-fade-out {\n  from { opacity:1; }\n  to { opacity:0; }\n}\n@keyframes stage-transition-content-out {\n  from { opacity:1; transform:scale(1); filter:blur(0); }\n  to { opacity:0; transform:scale(1.04); filter:blur(8px); }\n}\n@keyframes stage-transition-art-out {\n  from { opacity:1; filter:brightness(.32) blur(0); transform:scale(1); }\n  to { opacity:0; filter:brightness(0) blur(5px); transform:scale(1.08); }\n}\n\n"],["STYLE",{},"@import url(\"https://fonts.googleapis.com/css2?family=Oxanium:wght@400;500;600;700;800&family=Rajdhani:wght@400;500;600;700&display=swap\");\n\n.character-select-screen *,\n.character-select-screen *::before,\n.character-select-screen *::after {\n  box-sizing: border-box;\n}\n\n.character-select-screen button {\n  font-family: inherit;\n}\n\n.select-header,\n.select-footer {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  max-width: 1250px;\n  margin: 0 auto;\n}\n\n.select-back-button {\n  padding: 12px 16px;\n  border: 1px solid #3b4a64;\n  background: #101a2d;\n  color: #e5edff;\n  font-size: 11px;\n  font-weight: 900;\n  letter-spacing: 1px;\n  cursor: pointer;\n}\n\n.select-back-button:hover {\n  border-color: var(--select-cyan);\n  color: var(--select-cyan);\n}\n\n.select-back-button:disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n}\n\n.select-match-info {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: flex-end;\n  gap: 10px;\n}\n\n.select-match-info span {\n  padding: 9px 12px;\n  border: 1px solid #31415c;\n  color: var(--select-cyan);\n  font-size: 10px;\n  font-weight: 900;\n  letter-spacing: 1px;\n}\n\n.select-eyebrow {\n  margin: 0 0 10px;\n  color: var(--select-cyan);\n  font-size: 11px;\n  font-weight: 900;\n  letter-spacing: 4px;\n}\n\n.select-heading h1 {\n  margin: 0;\n  font-size: clamp(30px, 5vw, 48px);\n  font-weight: 1000;\n  font-style: italic;\n  text-shadow: 3px 3px 0 #6d172c;\n}\n\n.select-heading > p:last-child {\n  color: #aebbd2;\n  font-size: 13px;\n}\n\n/* PLAYER AND CPU PANELS */\n\n.versus-selection {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) 65px minmax(0, 1fr);\n  align-items: stretch;\n  gap: 18px;\n  max-width: 1150px;\n  margin: 0 auto 34px;\n}\n\n.roster-side {\n  min-width: 0;\n  padding: 18px;\n  border: 1px solid #34415a;\n  background: linear-gradient(145deg, #151e30, #0c1220);\n}\n\n.roster-side-heading {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  margin-bottom: 22px;\n}\n\n.player-label,\n.cpu-label {\n  display: grid;\n  place-items: center;\n  min-width: 48px;\n  height: 42px;\n  font-size: 13px;\n  font-weight: 1000;\n  font-style: italic;\n}\n\n.player-label {\n  color: #07111e;\n  background: var(--select-cyan);\n  box-shadow: 0 0 16px #13d5ff35;\n}\n\n.cpu-label {\n  color: white;\n  background: var(--select-red);\n  box-shadow: 0 0 16px #ff315935;\n}\n\n.roster-side-heading h2 {\n  margin: 0 0 5px;\n  font-size: 15px;\n  font-style: italic;\n  font-weight: 1000;\n}\n\n.roster-side-heading p {\n  margin: 0;\n  color: #8e9db6;\n  font-size: 9px;\n  font-weight: 900;\n  letter-spacing: 1px;\n}\n\n.roster-fighter-info.lee {\n  --fighter-accent: var(--select-cyan);\n}\n\n.roster-fighter-description {\n  margin: 0 0 7px;\n  color: var(--fighter-accent);\n  font-size: 10px;\n  font-weight: 900;\n  letter-spacing: 2px;\n}\n\n.roster-fighter-info h2 {\n  margin: 0 0 18px;\n  overflow-wrap: anywhere;\n  font-size: clamp(23px, 3vw, 36px);\n  font-weight: 1000;\n  font-style: italic;\n}\n\n.roster-stat-list > div {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  padding: 10px;\n  border: 1px solid #2b3850;\n  background: #101a2a;\n}\n\n.roster-stat-list span {\n  color: #96a5bf;\n  font-size: 9px;\n  font-weight: 900;\n  letter-spacing: 1px;\n}\n\n.roster-stat-list strong {\n  color: var(--fighter-accent);\n  font-size: 21px;\n  font-weight: 1000;\n}\n\n.roster-moves {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 7px;\n  margin-top: 17px;\n}\n\n.roster-moves p {\n  flex-basis: 100%;\n  margin: 0 0 3px;\n  color: #aebbd2;\n  font-size: 9px;\n  font-weight: 900;\n  letter-spacing: 2px;\n}\n\n.roster-moves span {\n  padding: 7px 8px;\n  border: 1px solid #36425a;\n  background: #111b2c;\n  color: #e7edfa;\n  font-size: 10px;\n}\n\n/* UNKNOWN CPU */\n\n.cpu-placeholder {\n  display: flex;\n  min-height: 225px;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 10px;\n  text-align: center;\n  background: radial-gradient(ellipse, #ff31590c, transparent 70%);\n}\n\n.cpu-placeholder > span {\n  color: #ff3159;\n  font-size: 100px;\n  font-weight: 1000;\n  line-height: 1;\n  text-shadow: 0 0 25px #ff315930;\n}\n\n.cpu-placeholder strong {\n  color: #ff718b;\n  font-size: 10px;\n  letter-spacing: 2px;\n}\n\n.cpu-placeholder p {\n  color: #8391a9;\n  font-size: 11px;\n}\n\n/* CHARACTER ROSTER GRID */\n\n.roster-section {\n  max-width: 950px;\n  margin: 0 auto;\n}\n\n.roster-title-row {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  margin-bottom: 14px;\n}\n\n.roster-title-row h2 {\n  margin: 0;\n  font-size: 13px;\n  font-weight: 1000;\n  font-style: italic;\n  letter-spacing: 2px;\n}\n\n.roster-title-row > span {\n  color: #8292ac;\n  font-size: 9px;\n  font-weight: 900;\n  letter-spacing: 1px;\n}\n\n.roster-tile.mina {\n  --tile-accent: var(--select-red);\n}\n\n.roster-tile.lee {\n  --tile-accent: var(--select-cyan);\n}\n\n.roster-tile.cpu-selected {\n  border-color: var(--select-red);\n  box-shadow: inset 0 0 22px #ff315915, 0 0 14px #ff315930;\n}\n\n.roster-tile.p1-selected.cpu-selected {\n  border-color: #fff;\n  box-shadow: inset 0 0 20px #ffffff15, 0 0 14px #ffffff25;\n}\n\n.roster-tile.roster-locked {\n  cursor: default;\n}\n\n.roster-cursor {\n  position: absolute;\n  top: 0;\n  left: 0;\n  z-index: 1;\n  padding: 6px 9px;\n  font-size: 10px;\n  font-weight: 1000;\n  letter-spacing: 1px;\n  animation: cursor-pop 0.2s ease-out;\n}\n\n.p1-cursor {\n  background: var(--select-cyan);\n  color: #06111d;\n}\n\n.cpu-cursor {\n  right: 0;\n  left: auto;\n  background: var(--select-red);\n  color: #fff;\n}\n\n.roster-tile strong {\n  overflow-wrap: anywhere;\n  font-size: 12px;\n  font-weight: 1000;\n  text-align: center;\n}\n\n/* ROSTER CONTROLS */\n\n.roster-controls {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  margin-top: 14px;\n}\n\n.roster-controls p {\n  color: #8f9db4;\n  font-size: 9px;\n  font-weight: 900;\n  letter-spacing: 1px;\n  text-align: center;\n}\n\n.roster-nav-button {\n  padding: 11px 13px;\n  border: 1px solid #3b4a64;\n  background: #101a2d;\n  color: #e5edff;\n  font-size: 9px;\n  font-weight: 1000;\n  letter-spacing: 1px;\n  cursor: pointer;\n}\n\n.roster-nav-button:hover:not(:disabled) {\n  border-color: var(--select-cyan);\n  color: var(--select-cyan);\n}\n\n.roster-nav-button:disabled {\n  opacity: 0.4;\n  cursor: not-allowed;\n}\n\n/* CONFIRMATION FOOTER */\n\n.select-footer {\n  max-width: 1150px;\n  margin-top: 28px;\n  padding-top: 20px;\n  border-top: 1px solid #28364c;\n}\n\n.select-footer p {\n  margin: 0;\n  color: #9eacc4;\n  font-size: 10px;\n  font-weight: 900;\n  letter-spacing: 1px;\n}\n\n.select-footer strong {\n  color: white;\n}\n\n.confirm-fighter-button {\n  padding: 16px 22px;\n  border: 1px solid #ff6c87;\n  background: var(--select-red);\n  color: white;\n  box-shadow: 4px 4px 0 #79172c;\n  font-size: 11px;\n  font-weight: 1000;\n  letter-spacing: 1px;\n  cursor: pointer;\n  transition: 0.2s ease;\n}\n\n.confirm-fighter-button span {\n  margin-left: 12px;\n}\n\n.confirm-fighter-button:disabled {\n  opacity: 0.65;\n  cursor: wait;\n}\n\n.character-select-screen button:focus-visible {\n  outline: 3px solid white;\n  outline-offset: 3px;\n}\n\n@keyframes roster-enter {\n  from {\n    opacity: 0.6;\n    transform: translateY(4px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n@keyframes cursor-pop {\n  from {\n    opacity: 0;\n    transform: scale(0.85);\n  }\n  to {\n    opacity: 1;\n    transform: scale(1);\n  }\n}\n\n@keyframes cpu-lock {\n  0%, 100% {\n    transform: scale(1);\n  }\n  50% {\n    transform: scale(1.025);\n  }\n}\n\n/* RESPONSIVE */\n\n@media (max-width: 800px) {\n  .versus-selection {\n    grid-template-columns: minmax(0, 1fr) 35px minmax(0, 1fr);\n    gap: 8px;\n  }\n\n  .roster-side {\n    padding: 12px;\n  }\n\n  .roster-side-heading {\n    align-items: flex-start;\n    gap: 8px;\n  }\n\n  .player-label,\n  .cpu-label {\n    min-width: 36px;\n    height: 34px;\n  }\n\n  .roster-side-heading h2 {\n    font-size: 12px;\n  }\n\n  .roster-side-heading p {\n    font-size: 8px;\n  }\n\n  .character-roster-grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .roster-tile {\n    min-height: 160px;\n  }\n}\n\n@media (max-width: 520px) {\n  .select-header {\n    align-items: flex-start;\n  }\n\n  .select-match-info {\n    gap: 5px;\n  }\n\n  .select-match-info span {\n    padding: 8px;\n    font-size: 8px;\n  }\n\n  .versus-selection {\n    grid-template-columns: minmax(0, 1fr);\n  }\n\n  .versus-divider {\n    padding: 2px;\n    font-size: 23px;\n  }\n\n  .roster-side {\n    padding: 15px;\n  }\n\n  .roster-fighter-info h2 {\n    font-size: 29px;\n  }\n\n  .roster-controls {\n    flex-wrap: wrap;\n  }\n\n  .roster-controls p {\n    order: -1;\n    flex-basis: 100%;\n  }\n\n  .roster-nav-button {\n    flex: 1;\n  }\n\n  .select-footer {\n    align-items: stretch;\n    flex-direction: column;\n  }\n\n  .confirm-fighter-button {\n    width: 100%;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .roster-fighter-info,\n  .roster-cursor,\n  .roster-tile.cpu-selected:not(.p1-selected) {\n    animation: none;\n  }\n\n  .roster-tile,\n  .confirm-fighter-button {\n    transition: none;\n  }\n}\n\n/* CHARACTER SELECT: STAT BARS */\n\n.roster-stat-list {\n  display: flex;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 14px;\n  flex-direction: column;\n  width: 100%;\n  margin: 18px 0;\n}\n\n.roster-stat {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  width: 100%;\n  min-width: 0;\n}\n\n.roster-stat-heading {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 10px;\n  font-size: 0.8rem;\n  font-weight: 800;\n  letter-spacing: 1px;\n}\n\n.roster-stat-heading strong {\n  white-space: nowrap;\n  font-size: 0.85rem;\n  font-variant-numeric: tabular-nums;\n}\n\n.roster-stat-track {\n  width: 100%;\n  height: 14px;\n  overflow: hidden;\n  border: 1px solid #34445e;\n  border-radius: 4px;\n  background: #111a2a;\n  box-shadow: inset 0 1px 4px #0009;\n}\n\n/* Individual stat colors */\n\n.roster-stat-track.health .roster-stat-fill {\n  background: #ff3159;\n  color: #ff3159;\n}\n\n.roster-stat-track.mana .roster-stat-fill {\n  background: #13d5ff;\n  color: #13d5ff;\n}\n\n.roster-stat-track.defense .roster-stat-fill {\n  background: #ffb52e;\n  color: #ffb52e;\n}\n\n.roster-stat-track.agility .roster-stat-fill {\n  background: #36e6a0;\n  color: #36e6a0;\n}\n\n/* Compact horizontal fighter cards */\n\n.roster-fighter-layout {\n  display: grid;\n  grid-template-columns: 125px minmax(0, 1fr);\n  align-items: center;\n  gap: 18px;\n  width: 100%;\n}\n\n.roster-fighter-portrait {\n  width: 100%;\n  height: 190px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  overflow: hidden;\n  border-radius: 8px;\n  background: #111a2a;\n}\n\n.roster-fighter-portrait img {\n  width: 100%;\n  height: 100%;\n  object-fit: contain;\n  object-position: center bottom;\n}\n\n.roster-fighter-details {\n  min-width: 0;\n  width: 100%;\n}\n\n.roster-fighter-details h2 {\n  margin: 4px 0 12px;\n}\n\n.roster-fighter-details .roster-stat-list {\n  margin: 12px 0;\n  gap: 10px;\n}\n\n.roster-fighter-details .roster-stat-track {\n  height: 12px;\n}\n\n@media (max-width: 600px) {\n  .roster-fighter-layout {\n    grid-template-columns: 85px minmax(0, 1fr);\n    gap: 12px;\n  }\n\n  .roster-fighter-portrait {\n    height: 150px;\n  }\n\n  .roster-fighter-details .roster-stat-heading {\n    font-size: 0.7rem;\n  }\n}\n\n/* Fighter roster portrait images */\n\n/* Full-image character roster tiles */\n\n.character-roster-grid {\n  display: grid;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  gap: 12px;\n  align-items: start;\n}\n\n.roster-portrait {\n  display: block;\n  place-items: center;\n  width: 100%;\n  height: 86px;\n  border: 1px solid color-mix(in srgb, var(--tile-accent) 65%, transparent);\n  background: #080d1c;\n  color: var(--tile-accent);\n  font-size: 60px;\n  font-weight: 1000;\n  font-style: italic;\n  line-height: 1;\n  text-shadow: 0 0 18px color-mix(in srgb, var(--tile-accent) 35%, transparent);\n  align-items: center;\n  justify-content: center;\n  overflow: hidden;\n  position: relative;\n  aspect-ratio: 2 / 3;\n}\n\n.roster-portrait img {\n  width: 100%;\n  height: 100%;\n  object-fit: contain;\n  object-position: center;\n  display: block;\n  transition: transform 0.25s ease;\n}\n\n.roster-tile:hover .roster-portrait img {\n  transform: scale(1.035);\n}\n\n.roster-tile-info {\n  display: flex;\n  flex-direction: column;\n  gap: 5px;\n  width: 100%;\n  padding: 12px;\n  background: #101a2d;\n}\n\n.roster-tile-info > strong {\n  font-size: 14px;\n  font-weight: 900;\n  line-height: 1.3;\n}\n\n.roster-tile-description {\n  color: #98a7bf;\n  font-size: 10px;\n  font-weight: 900;\n  text-align: center;\n  line-height: 1.4;\n  letter-spacing: 0.7px;\n}\n\n/* Locked character artwork */\n\n.fighter-unavailable .roster-portrait img {\n  filter: grayscale(0.85) brightness(0.55);\n}\n\n.fighter-lock-overlay {\n  position: absolute;\n  inset: 0;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  color: #fff;\n  background: rgba(5, 9, 20, 0.3);\n  pointer-events: none;\n}\n\n.fighter-lock-icon {\n  display: grid;\n  place-items: center;\n  width: 46px;\n  height: 46px;\n  border: 1px solid rgba(255, 49, 89, 0.8);\n  border-radius: 50%;\n  background: rgba(8, 13, 28, 0.9);\n  font-size: 22px;\n}\n\n.fighter-lock-overlay strong {\n  color: #ff3159;\n  font-size: 13px;\n  font-weight: 1000;\n  letter-spacing: 2px;\n}\n\n.fighter-lock-overlay small {\n  font-size: 9px;\n  font-weight: 800;\n  letter-spacing: 1px;\n}\n\n.fighter-unavailable:hover {\n  border-color: #ff3159;\n}\n\n.roster-tile:disabled {\n  cursor: default;\n}\n\n@media (max-width: 480px) {\n  .roster-tile-info {\n    padding: 8px;\n  }\n\n  .roster-tile-info > strong {\n    font-size: 12px;\n  }\n\n  .roster-tile-description {\n    font-size: 9px;\n  }\n}\n\n/* =========================================\n   CHARACTER SELECT - ARCADE ANIMATIONS\n========================================= */\n\n/* Bring the screen in smoothly */\n\n.character-select-screen {\n  --select-red: #ff3159;\n  --select-cyan: #13d5ff;\n\n  min-height: 100vh;\n  padding: 24px clamp(16px, 4vw, 55px);\n  color: #f5f7ff;\n  background:\n    radial-gradient(ellipse at 50% 40%, #1a2945 0%, transparent 65%),\n    #080d1c;\n  font-family: Arial, Helvetica, sans-serif;\n  animation: select-screen-enter 0.45s ease-out both;\n}\n\n.select-header {\n  animation: select-header-enter 0.5s ease-out both;\n}\n\n.select-heading {\n  margin: 32px auto 26px;\n  text-align: center;\n  animation: select-heading-impact 0.65s cubic-bezier(0.16, 1, 0.3, 1) 0.08s both;\n}\n\n/* Player and CPU panels enter from opposite sides */\n\n.player-side {\n  border-top: 3px solid var(--select-cyan);\n  animation: player-panel-enter 0.55s cubic-bezier(0.16, 1, 0.3, 1) 0.12s both;\n}\n\n.cpu-side {\n  border-top: 3px solid var(--select-red);\n  animation: cpu-panel-enter 0.55s cubic-bezier(0.16, 1, 0.3, 1) 0.2s both;\n}\n\n.versus-divider {\n  display: grid;\n  place-items: center;\n  align-self: center;\n  color: #fff;\n  font-size: 29px;\n  font-weight: 1000;\n  font-style: italic;\n  text-shadow: 0 0 18px #ff315955;\n  transform: skew(-8deg);\n  animation: versus-impact 0.5s cubic-bezier(0.16, 1, 0.3, 1) 0.25s both;\n}\n\n/* Fighter roster cards enter one after another */\n\n.character-roster-grid .roster-tile {\n  animation: fighter-card-enter 0.4s cubic-bezier(0.16, 1, 0.3, 1) backwards;\n}\n\n.character-roster-grid .roster-tile:nth-child(1)  { animation-delay: 0.05s; }\n\n.character-roster-grid .roster-tile:nth-child(2)  { animation-delay: 0.09s; }\n\n.character-roster-grid .roster-tile:nth-child(3)  { animation-delay: 0.13s; }\n\n.character-roster-grid .roster-tile:nth-child(4)  { animation-delay: 0.17s; }\n\n.character-roster-grid .roster-tile:nth-child(5)  { animation-delay: 0.21s; }\n\n.character-roster-grid .roster-tile:nth-child(6)  { animation-delay: 0.25s; }\n\n.character-roster-grid .roster-tile:nth-child(7)  { animation-delay: 0.29s; }\n\n.character-roster-grid .roster-tile:nth-child(8)  { animation-delay: 0.33s; }\n\n.character-roster-grid .roster-tile:nth-child(9)  { animation-delay: 0.37s; }\n\n.character-roster-grid .roster-tile:nth-child(10) { animation-delay: 0.41s; }\n\n.character-roster-grid .roster-tile:nth-child(11) { animation-delay: 0.45s; }\n\n.character-roster-grid .roster-tile:nth-child(12) { animation-delay: 0.49s; }\n\n/* Make the current player selection feel active */\n\n.roster-tile.p1-selected .roster-tile-info {\n  background: linear-gradient(\n    135deg,\n    rgba(19, 213, 255, 0.16),\n    #101a2d 75%\n  );\n}\n\n/* CPU selection stays red */\n\n.roster-tile.cpu-selected:not(.p1-selected) {\n  animation: cpu-lock 0.35s ease-in-out;\n  border-color: var(--select-red);\n  box-shadow:\n    inset 0 0 22px rgba(255, 49, 89, 0.12),\n    0 0 14px rgba(255, 49, 89, 0.25);\n}\n\n/* A stronger card hover without the old hover glitches */\n\n.roster-tile:hover:not(:disabled) {\n  transform: translateY(-4px) scale(1.015);\n  border-color: var(--tile-accent);\n  filter: brightness(1.08);\n  z-index: 2;\n}\n\n.roster-tile:active:not(:disabled) {\n  transform: translateY(0) scale(0.98);\n}\n\n/* Animate the artwork slightly when hovering over a card */\n\n.roster-tile:hover:not(:disabled) .roster-portrait img {\n  transform: scale(1.055);\n}\n\n/* Navigation buttons get a satisfying press effect */\n\n.select-back-button,\n.roster-nav-button,\n.confirm-fighter-button {\n  transition:\n    transform 0.16s ease,\n    border-color 0.2s ease,\n    box-shadow 0.2s ease,\n    filter 0.2s ease;\n}\n\n.select-back-button:hover:not(:disabled),\n.roster-nav-button:hover:not(:disabled) {\n  transform: translateY(-2px);\n  box-shadow: 0 0 14px rgba(19, 213, 255, 0.16);\n}\n\n.select-back-button:active:not(:disabled),\n.roster-nav-button:active:not(:disabled),\n.confirm-fighter-button:active:not(:disabled) {\n  transform: scale(0.97);\n}\n\n/* Give the main confirmation button a gentle idle glow */\n\n.confirm-fighter-button:not(:disabled) {\n  animation: confirm-button-ready 2s ease-in-out infinite;\n}\n\n.confirm-fighter-button:hover:not(:disabled) {\n  transform: translateY(-2px);\n  box-shadow:\n    0 0 26px rgba(255, 49, 89, 0.45),\n    4px 4px 0 #79172c;\n  filter: brightness(1.12);\n}\n\n/* Keyframes */\n\n@keyframes select-screen-enter {\n  from {\n    opacity: 0;\n  }\n  to {\n    opacity: 1;\n  }\n}\n\n@keyframes select-header-enter {\n  from {\n    opacity: 0;\n    transform: translateY(-12px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n@keyframes select-heading-impact {\n  0% {\n    opacity: 0;\n    transform: translateY(16px) scale(0.97);\n  }\n  75% {\n    opacity: 1;\n    transform: translateY(-2px) scale(1.01);\n  }\n  100% {\n    opacity: 1;\n    transform: translateY(0) scale(1);\n  }\n}\n\n@keyframes player-panel-enter {\n  from {\n    opacity: 0;\n    transform: translateX(-22px);\n  }\n  to {\n    opacity: 1;\n    transform: translateX(0);\n  }\n}\n\n@keyframes cpu-panel-enter {\n  from {\n    opacity: 0;\n    transform: translateX(22px);\n  }\n  to {\n    opacity: 1;\n    transform: translateX(0);\n  }\n}\n\n@keyframes versus-impact {\n  0% {\n    opacity: 0;\n    transform: skew(-8deg) scale(0.5);\n  }\n  75% {\n    opacity: 1;\n    transform: skew(-8deg) scale(1.2);\n  }\n  100% {\n    opacity: 1;\n    transform: skew(-8deg) scale(1);\n  }\n}\n\n@keyframes fighter-card-enter {\n  from {\n    opacity: 0;\n    transform: translateY(15px) scale(0.96);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0) scale(1);\n  }\n}\n\n@keyframes confirm-button-ready {\n  0%, 100% {\n    box-shadow: 4px 4px 0 #79172c;\n  }\n  50% {\n    box-shadow:\n      0 0 17px rgba(255, 49, 89, 0.24),\n      4px 4px 0 #79172c;\n  }\n}\n\n/* Explicitly retain the entrance animations with reduced-motion enabled */\n\n@media (prefers-reduced-motion: reduce) {\n  .character-select-screen {\n    animation: select-screen-enter 0.45s ease-out both !important;\n  }\n\n  .select-header {\n    animation: select-header-enter 0.5s ease-out both !important;\n  }\n\n  .select-heading {\n    animation: select-heading-impact 0.65s ease-out 0.08s both !important;\n  }\n\n  .player-side {\n    animation: player-panel-enter 0.55s ease-out 0.12s both !important;\n  }\n\n  .cpu-side {\n    animation: cpu-panel-enter 0.55s ease-out 0.2s both !important;\n  }\n\n  .versus-divider {\n    animation: versus-impact 0.5s ease-out 0.25s both !important;\n  }\n\n  .character-roster-grid .roster-tile {\n    animation: fighter-card-enter 0.4s ease-out backwards !important;\n  }\n\n  .character-roster-grid .roster-tile:nth-child(1)  { animation-delay: 0.05s !important; }\n  .character-roster-grid .roster-tile:nth-child(2)  { animation-delay: 0.09s !important; }\n  .character-roster-grid .roster-tile:nth-child(3)  { animation-delay: 0.13s !important; }\n  .character-roster-grid .roster-tile:nth-child(4)  { animation-delay: 0.17s !important; }\n  .character-roster-grid .roster-tile:nth-child(5)  { animation-delay: 0.21s !important; }\n  .character-roster-grid .roster-tile:nth-child(6)  { animation-delay: 0.25s !important; }\n  .character-roster-grid .roster-tile:nth-child(7)  { animation-delay: 0.29s !important; }\n  .character-roster-grid .roster-tile:nth-child(8)  { animation-delay: 0.33s !important; }\n  .character-roster-grid .roster-tile:nth-child(9)  { animation-delay: 0.37s !important; }\n  .character-roster-grid .roster-tile:nth-child(10) { animation-delay: 0.41s !important; }\n  .character-roster-grid .roster-tile:nth-child(11) { animation-delay: 0.45s !important; }\n  .character-roster-grid .roster-tile:nth-child(12) { animation-delay: 0.49s !important; }\n\n  .confirm-fighter-button:not(:disabled) {\n    animation: confirm-button-ready 2s ease-in-out infinite !important;\n  }\n}\n\n/* ================================\n   CHARACTER SELECT ANIMATIONS\n================================ */\n\n/* Smooth movement and glow changes */\n\n.roster-tile {\n  --tile-accent: #53617a;\n  position: relative;\n  display: flex;\n  min-width: 0;\n  min-height: 175px;\n  flex-direction: column;\n  align-items: center;\n  justify-content: flex-end;\n  gap: 8px;\n  padding: 0;\n  overflow: hidden;\n  border: 2px solid #2b3850;\n  background:\n    radial-gradient(ellipse at 50% 35%, #26344b, transparent 70%),\n    #101726;\n  color: #fff;\n  cursor: pointer;\n  transition:\n    border-color 0.25s ease,\n    box-shadow 0.25s ease,\n    filter 0.25s ease;\n  height: 100%;\n  text-align: left;\n}\n\n/* Impact animation when the selected fighter changes */\n\n.roster-tile.p1-selected {\n  border-color: #13d5ff;\n  box-shadow:\n    0 0 10px rgba(19, 213, 255, 0.65),\n    0 0 25px rgba(19, 213, 255, 0.35);\n  animation: fighterSelectPop 0.38s cubic-bezier(.16, 1, .3, 1) both;\n  z-index: 2;\n}\n\n/* Make the character portrait feel alive */\n\n.roster-tile.p1-selected .roster-portrait {\n  animation: fighterPortraitFlash 0.45s ease-out both;\n}\n\n/* Selected fighter pops into focus */\n\n@keyframes fighterSelectPop {\n  0% {\n    transform: scale(0.94);\n    filter: brightness(0.75);\n  }\n\n  65% {\n    transform: scale(1.06);\n    filter: brightness(1.3);\n  }\n\n  100% {\n    transform: scale(1);\n    filter: brightness(1);\n  }\n}\n\n/* Quick neon flash on the portrait */\n\n@keyframes fighterPortraitFlash {\n  0% {\n    filter: brightness(0.65) saturate(0.8);\n  }\n\n  55% {\n    filter: brightness(1.45) saturate(1.3);\n  }\n\n  100% {\n    filter: brightness(1) saturate(1);\n  }\n}\n\n/* Animate the player selection cursor */\n\n.roster-cursor.p1-cursor {\n  animation: cursor-pop 0.3s cubic-bezier(.16, 1, .3, 1) both;\n}\n\n/* Keep these animations active even when reduced motion is enabled */\n\n@media (prefers-reduced-motion: reduce) {\n  .roster-tile.p1-selected {\n    animation: fighterSelectPop 0.38s cubic-bezier(.16, 1, .3, 1) both !important;\n  }\n\n  .roster-tile.p1-selected .roster-portrait {\n    animation: fighterPortraitFlash 0.45s ease-out both !important;\n  }\n\n  .roster-cursor.p1-cursor {\n    animation: cursor-pop 0.3s cubic-bezier(.16, 1, .3, 1) both !important;\n  }\n}\n\n/* =========================================\n   FIGHTER STATS - SELECTION ANIMATIONS\n========================================= */\n\n/* Player stats: cyan impact */\n\n.player-side .roster-fighter-info {\n  transform-origin: left center;\n}\n\n.player-side .roster-fighter-info .roster-fighter-portrait {\n  overflow: hidden;\n}\n\n.player-side .roster-fighter-portrait img {\n  transition: filter 0.25s ease;\n}\n\n.player-side .roster-fighter-info .roster-stat-fill {\n  transform-origin: left center;\n}\n\n/* CPU stats: red impact */\n\n.cpu-side .roster-fighter-info {\n  transform-origin: right center;\n}\n\n.cpu-side .roster-fighter-info .roster-fighter-portrait {\n  overflow: hidden;\n}\n\n.cpu-side .roster-fighter-portrait img {\n  transition: filter 0.25s ease;\n}\n\n/* Play when React mounts the new fighter info */\n\n.roster-fighter-info {\n  --fighter-accent: var(--select-red);\n  min-width: 0;\n  animation: fighter-info-impact 0.42s cubic-bezier(0.16, 1, 0.3, 1) both;\n}\n\n.roster-fighter-info .roster-fighter-portrait img {\n  animation: fighter-portrait-flash 0.5s ease-out both;\n}\n\n.roster-fighter-info .roster-stat {\n  animation: fighter-stat-reveal 0.35s ease-out both;\n}\n\n.roster-fighter-info .roster-stat:nth-child(1) {\n  animation-delay: 0.04s;\n}\n\n.roster-fighter-info .roster-stat:nth-child(2) {\n  animation-delay: 0.09s;\n}\n\n.roster-fighter-info .roster-stat:nth-child(3) {\n  animation-delay: 0.14s;\n}\n\n.roster-fighter-info .roster-stat:nth-child(4) {\n  animation-delay: 0.19s;\n}\n\n.roster-fighter-info .roster-moves {\n  animation: fighter-moves-reveal 0.35s ease-out 0.2s both;\n}\n\n/* Smoothly animate stat bars when their values change */\n\n.roster-stat-fill {\n  height: 100%;\n  border-radius: 3px;\n  transition: width 0.55s cubic-bezier(0.16, 1, 0.3, 1);\n  box-shadow: 0 0 10px currentColor;\n}\n\n/* Keyframes */\n\n@keyframes fighter-info-impact {\n  0% {\n    opacity: 0.35;\n    transform: translateY(10px) scale(0.97);\n    filter: brightness(0.75);\n  }\n\n  65% {\n    opacity: 1;\n    transform: translateY(-2px) scale(1.01);\n    filter: brightness(1.2);\n  }\n\n  100% {\n    opacity: 1;\n    transform: translateY(0) scale(1);\n    filter: brightness(1);\n  }\n}\n\n@keyframes fighter-portrait-flash {\n  0% {\n    opacity: 0.6;\n    transform: scale(0.92);\n    filter: brightness(0.6) saturate(0.7);\n  }\n\n  60% {\n    opacity: 1;\n    transform: scale(1.035);\n    filter: brightness(1.3) saturate(1.2);\n  }\n\n  100% {\n    opacity: 1;\n    transform: scale(1);\n    filter: brightness(1) saturate(1);\n  }\n}\n\n@keyframes fighter-stat-reveal {\n  from {\n    opacity: 0;\n    transform: translateX(-8px);\n  }\n\n  to {\n    opacity: 1;\n    transform: translateX(0);\n  }\n}\n\n@keyframes fighter-moves-reveal {\n  from {\n    opacity: 0;\n    transform: translateY(6px);\n  }\n\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n/* Keep the animations working with reduced-motion enabled */\n\n@media (prefers-reduced-motion: reduce) {\n  .roster-fighter-info {\n    animation: fighter-info-impact 0.42s ease-out both !important;\n  }\n\n  .roster-fighter-info .roster-fighter-portrait img {\n    animation: fighter-portrait-flash 0.5s ease-out both !important;\n  }\n\n  .roster-fighter-info .roster-stat {\n    animation: fighter-stat-reveal 0.35s ease-out both !important;\n  }\n\n  .roster-fighter-info .roster-moves {\n    animation: fighter-moves-reveal 0.35s ease-out 0.2s both !important;\n  }\n\n  .roster-stat-fill {\n    transition: width 0.55s ease !important;\n  }\n}\n\n/* Display multiple fighter previews in team-selection mode. */\n\n.roster-team-preview > * {\n  min-width: 0;\n}\n\n@media (max-width: 900px) {\n}\n\n.p2-cursor {\n  background: #13d5ff;\n  color: #07111f;\n  border: 1px solid #13d5ff;\n  box-shadow: 0 0 12px rgb(19 213 255 / 45%);\n}\n\n/* Highlight the fighter currently browsed with the keyboard */\n\n.roster-tile.keyboard-highlighted {\n  outline: 3px solid #13d5ff;\n  outline-offset: 3px;\n  box-shadow: 0 0 14px rgba(19, 213, 255, 0.55);\n  transform: translateY(-3px);\n  z-index: 1;\n}\n\n/* =========================================\n   2V2 PREVIEW CLEANUP\n   ========================================= */\n\n.roster-team-preview {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 14px;\n  align-items: start;\n}\n\n.roster-team-preview > .roster-fighter-info {\n  min-width: 0;\n  padding: 12px;\n  border: 1px solid #34415a;\n  border-radius: 8px;\n  background:\n    linear-gradient(145deg, #182338, #0b1220);\n}\n\n/* Smaller portrait so the card has room for its stats. */\n\n.roster-team-preview .roster-fighter-layout {\n  grid-template-columns: minmax(0, 1fr);\n  gap: 10px;\n}\n\n.roster-team-preview .roster-fighter-portrait {\n  width: 100%;\n  height: 145px;\n  border: 1px solid #34415a;\n  border-radius: 6px;\n  background:\n    radial-gradient(ellipse, #26364e, #0b1220 75%);\n}\n\n.roster-team-preview .roster-fighter-details h2 {\n  margin: 4px 0 10px;\n  font-size: clamp(18px, 1.5vw, 25px);\n  overflow-wrap: anywhere;\n}\n\n.roster-team-preview .roster-fighter-description {\n  min-height: 24px;\n  margin-bottom: 5px;\n  font-size: 9px;\n  line-height: 1.4;\n  letter-spacing: 1px;\n}\n\n.roster-team-preview .roster-stat-list {\n  gap: 10px;\n  margin: 12px 0;\n}\n\n.roster-team-preview .roster-stat-heading {\n  gap: 5px;\n  font-size: 10px;\n  letter-spacing: 0.5px;\n}\n\n.roster-team-preview .roster-stat-heading strong {\n  font-size: 11px;\n}\n\n.roster-team-preview .roster-stat-track {\n  height: 10px;\n}\n\n.roster-team-preview .roster-moves {\n  gap: 5px;\n  margin-top: 12px;\n}\n\n.roster-team-preview .roster-moves span {\n  max-width: 100%;\n  overflow-wrap: anywhere;\n  padding: 6px;\n  font-size: 9px;\n}\n\n@media (max-width: 900px) {\n  .roster-team-preview {\n    grid-template-columns: minmax(0, 1fr);\n  }\n\n  .roster-team-preview .roster-fighter-layout {\n    grid-template-columns: 100px minmax(0, 1fr);\n    align-items: center;\n  }\n\n  .roster-team-preview .roster-fighter-portrait {\n    height: 145px;\n  }\n}\n\n@media (max-width: 520px) {\n  .roster-team-preview .roster-fighter-layout {\n    grid-template-columns: 85px minmax(0, 1fr);\n    gap: 10px;\n  }\n\n  .roster-team-preview .roster-fighter-portrait {\n    height: 125px;\n  }\n}\n\n.secret-fighter-placeholder {\n  width: 100%;\n  height: 100%;\n  min-height: 100px;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  padding: 10px;\n  text-align: center;\n  background: linear-gradient(145deg, #172333, #080d16);\n  border: 1px solid rgba(19, 213, 255, 0.35);\n  color: #13d5ff;\n}\n\n.secret-fighter-placeholder span {\n  font-size: 9px;\n  letter-spacing: 1px;\n}\n\n.secret-fighter-placeholder strong {\n  font-size: 14px;\n  font-weight: 900;\n}\n\n/* =========================================\n   WILD CARDS — CHARACTER SELECTION\n   Homepage green + gold visual identity\n========================================= */\n\n.character-select-screen {\n  --select-lime: #a5f51b;\n  --select-gold: #f6d84a;\n  --select-red: #ff3159;\n  --select-cyan: #13d5ff;\n\n  min-height: 100vh;\n  color: #fff9e9;\n  background:\n    radial-gradient(\n      ellipse at 50% 12%,\n      rgba(165, 245, 27, 0.13),\n      transparent 42%\n    ),\n    radial-gradient(\n      ellipse at 50% 85%,\n      rgba(246, 216, 74, 0.045),\n      transparent 50%\n    ),\n    linear-gradient(145deg, #17251a, #101811 48%, #080d1c);\n  font-family: \"Rajdhani\", sans-serif;\n}\n\n.character-select-screen h1,\n.character-select-screen h2,\n.character-select-screen h3,\n.character-select-screen button,\n.character-select-screen .select-match-info,\n.character-select-screen .select-eyebrow,\n.character-select-screen .roster-stat-heading,\n.character-select-screen .roster-tile strong {\n  font-family: \"Oxanium\", sans-serif;\n}\n\n/* HEADER AND TITLE */\n\n.select-back-button,\n.roster-nav-button {\n  border-color: rgba(165, 245, 27, 0.35);\n  background: #17231a;\n  color: #f4f0d9;\n  font-family: \"Oxanium\", sans-serif;\n}\n\n.select-back-button:hover,\n.roster-nav-button:hover:not(:disabled) {\n  border-color: var(--select-lime);\n  color: var(--select-lime);\n  box-shadow: 0 0 14px rgba(165, 245, 27, 0.15);\n}\n\n.select-match-info span {\n  border-color: rgba(246, 216, 74, 0.3);\n  background: rgba(246, 216, 74, 0.055);\n  color: var(--select-gold);\n  font-family: \"Oxanium\", sans-serif;\n}\n\n.select-eyebrow {\n  color: var(--select-lime);\n}\n\n.select-heading h1 {\n  color: #fff9e9;\n  text-shadow:\n    3px 3px 0 #26351c,\n    0 0 22px rgba(165, 245, 27, 0.18);\n}\n\n.select-heading > p:last-child {\n  color: #c1cbb8;\n  font-size: 15px;\n}\n\n/* PLAYER AND CPU PANELS */\n\n.roster-side {\n  border: 1px solid rgba(165, 245, 27, 0.2);\n  background:\n    linear-gradient(\n      145deg,\n      rgba(35, 51, 31, 0.96),\n      rgba(12, 19, 17, 0.98)\n    );\n  box-shadow:\n    inset 0 0 25px rgba(165, 245, 27, 0.025),\n    0 12px 28px rgba(0, 0, 0, 0.2);\n}\n\n.player-side {\n  border-top: 3px solid var(--select-lime);\n}\n\n.cpu-side {\n  border-top: 3px solid var(--select-red);\n}\n\n.player-label {\n  color: #14200c;\n  background: var(--select-lime);\n  box-shadow: 0 0 16px rgba(165, 245, 27, 0.25);\n}\n\n.cpu-label {\n  color: white;\n  background: var(--select-red);\n  box-shadow: 0 0 16px rgba(255, 49, 89, 0.25);\n}\n\n.roster-side-heading h2 {\n  color: #fff7df;\n}\n\n.roster-side-heading p {\n  color: #b0bda8;\n}\n\n/* FIGHTER INFORMATION */\n\n.player-side .roster-fighter-info {\n  --fighter-accent: var(--select-lime);\n}\n\n.cpu-side .roster-fighter-info {\n  --fighter-accent: var(--select-red);\n}\n\n.roster-fighter-info.lee {\n  --fighter-accent: var(--select-lime);\n}\n\n.roster-fighter-description {\n  color: var(--fighter-accent);\n}\n\n.roster-fighter-info h2 {\n  color: #fff8e7;\n  font-family: \"Oxanium\", sans-serif;\n  text-shadow: 0 0 14px rgba(165, 245, 27, 0.08);\n}\n\n.roster-stat-list > div {\n  border-color: rgba(165, 245, 27, 0.15);\n  background: rgba(9, 17, 13, 0.75);\n}\n\n.roster-stat-list span {\n  color: #b3c0a9;\n}\n\n.roster-stat-list strong {\n  color: var(--fighter-accent);\n}\n\n.roster-stat-heading {\n  color: #e8e8d6;\n}\n\n.roster-stat-heading strong {\n  color: #fff7df;\n}\n\n.roster-stat-track {\n  border-color: #40513a;\n  background: #111b14;\n}\n\n.roster-moves p {\n  color: var(--select-gold);\n}\n\n.roster-moves span {\n  border-color: rgba(246, 216, 74, 0.2);\n  background: #19241a;\n  color: #f2edda;\n}\n\n/* CPU PLACEHOLDER */\n\n.cpu-placeholder {\n  background:\n    radial-gradient(\n      ellipse,\n      rgba(255, 49, 89, 0.09),\n      transparent 70%\n    );\n}\n\n.cpu-placeholder > span {\n  color: var(--select-red);\n}\n\n.cpu-placeholder strong {\n  color: #ff8294;\n}\n\n.cpu-placeholder p {\n  color: #aeb8a7;\n}\n\n/* VERSUS DIVIDER */\n\n.versus-divider {\n  color: var(--select-gold);\n  text-shadow: 0 0 18px rgba(246, 216, 74, 0.3);\n}\n\n/* ROSTER GRID */\n\n.roster-title-row h2 {\n  color: var(--select-gold);\n}\n\n.roster-title-row > span {\n  color: #b2bea9;\n}\n\n/* Fighter tiles use lime as the default accent.\n   CPU selection remains red. */\n\n.roster-tile {\n  --tile-accent: var(--select-lime);\n\n  border-color: rgba(165, 245, 27, 0.2);\n  background:\n    radial-gradient(\n      ellipse at 50% 30%,\n      rgba(165, 245, 27, 0.12),\n      transparent 72%\n    ),\n    linear-gradient(145deg, #1b2b1d, #0d1511);\n  color: #fff8e6;\n}\n\n.roster-tile.mina,\n.roster-tile.lee {\n  --tile-accent: var(--select-lime);\n}\n\n.roster-tile-info {\n  background: linear-gradient(\n    135deg,\n    rgba(35, 51, 31, 0.98),\n    rgba(13, 21, 16, 0.98)\n  );\n}\n\n.roster-tile-info > strong {\n  color: #fff8e6;\n}\n\n.roster-tile-description {\n  color: #bdc9b4;\n}\n\n/* Player selection */\n\n.roster-tile.p1-selected {\n  border-color: var(--select-lime);\n  box-shadow:\n    0 0 10px rgba(165, 245, 27, 0.45),\n    0 0 24px rgba(165, 245, 27, 0.2);\n}\n\n.roster-tile.p1-selected .roster-tile-info {\n  background: linear-gradient(\n    135deg,\n    rgba(165, 245, 27, 0.16),\n    #17251a 75%\n  );\n}\n\n/* CPU selection */\n\n.roster-tile.cpu-selected {\n  border-color: var(--select-red);\n  box-shadow:\n    inset 0 0 22px rgba(255, 49, 89, 0.1),\n    0 0 14px rgba(255, 49, 89, 0.25);\n}\n\n.roster-tile.cpu-selected:not(.p1-selected) {\n  --tile-accent: var(--select-red);\n}\n\n/* Both players selecting the same fighter */\n\n.roster-tile.p1-selected.cpu-selected {\n  border-color: var(--select-gold);\n  box-shadow: 0 0 16px rgba(246, 216, 74, 0.25);\n}\n\n/* Selection cursors */\n\n.p1-cursor {\n  background: var(--select-lime);\n  color: #14200c;\n}\n\n.cpu-cursor {\n  background: var(--select-red);\n  color: white;\n}\n\n.p2-cursor {\n  background: var(--select-cyan);\n  color: #07111f;\n  border-color: var(--select-cyan);\n}\n\n/* Keyboard selection */\n\n.roster-tile.keyboard-highlighted {\n  outline-color: var(--select-gold);\n  box-shadow: 0 0 15px rgba(246, 216, 74, 0.35);\n}\n\n/* Navigation and footer */\n\n.roster-controls p {\n  color: #b5c0ac;\n}\n\n.select-footer {\n  border-top-color: rgba(165, 245, 27, 0.2);\n}\n\n.select-footer p {\n  color: #b9c4b0;\n}\n\n.select-footer strong {\n  color: var(--select-gold);\n}\n\n/* CONFIRM BUTTON */\n\n.confirm-fighter-button {\n  border: 1px solid #ffe77a;\n  background: linear-gradient(135deg, #f6d84a, #e8ad25);\n  color: #211d0c;\n  box-shadow:\n    4px 4px 0 #87651b,\n    0 0 16px rgba(246, 216, 74, 0.13);\n  font-family: \"Oxanium\", sans-serif;\n  font-weight: 800;\n}\n\n.confirm-fighter-button:hover:not(:disabled) {\n  border-color: #fff3a4;\n  background: linear-gradient(135deg, #ffe978, #f6c83c);\n  color: #171708;\n  box-shadow:\n    0 0 25px rgba(246, 216, 74, 0.35),\n    4px 4px 0 #87651b;\n  filter: brightness(1.06);\n}\n\n@keyframes confirm-button-ready {\n  0%, 100% {\n    box-shadow: 4px 4px 0 #87651b;\n  }\n  50% {\n    box-shadow:\n      0 0 17px rgba(246, 216, 74, 0.2),\n      4px 4px 0 #87651b;\n  }\n}\n\n/* LOCKED FIGHTERS */\n\n.fighter-lock-overlay {\n  background: rgba(5, 12, 7, 0.68);\n}\n\n.fighter-lock-icon {\n  border-color: rgba(246, 216, 74, 0.75);\n  background: rgba(13, 21, 16, 0.95);\n  color: var(--select-gold);\n  box-shadow: 0 0 14px rgba(246, 216, 74, 0.12);\n}\n\n.fighter-lock-overlay strong {\n  color: var(--select-gold);\n}\n\n.fighter-unavailable:hover {\n  border-color: var(--select-gold);\n}\n\n/* SECRET FIGHTER PLACEHOLDER */\n\n.secret-fighter-placeholder {\n  background: linear-gradient(145deg, #26351f, #0d1510);\n  border-color: rgba(246, 216, 74, 0.35);\n  color: var(--select-gold);\n}\n\n/* 2V2 PREVIEW PANELS */\n\n.roster-team-preview > .roster-fighter-info {\n  border-color: rgba(165, 245, 27, 0.2);\n  background: linear-gradient(145deg, #1c2b1d, #0c1510);\n}\n\n.roster-team-preview .roster-fighter-portrait {\n  border-color: rgba(165, 245, 27, 0.2);\n  background: radial-gradient(\n    ellipse,\n    #293b25,\n    #0b140e 75%\n  );\n}\n\n/* Keep focus accessible */\n\n.character-select-screen button:focus-visible {\n  outline-color: var(--select-gold);\n  outline-offset: 3px;\n}\n\n/* RESPONSIVE POLISH */\n\n@media (max-width: 520px) {\n  .select-heading h1 {\n    font-size: clamp(27px, 8vw, 38px);\n  }\n\n  .select-match-info span {\n    color: var(--select-gold);\n  }\n}\n\n/* Local PvP team selection */\n\n.roster-tile.p2-selected {\n  border-color: #ff3159;\n  box-shadow: 0 0 0 2px rgba(255, 49, 89, 0.35), 0 0 22px rgba(255, 49, 89, 0.22);\n}\n\n.roster-tile.p2-selected .roster-tile-info {\n  border-top-color: #ff3159;\n}\n\n.roster-cursor.p2-cursor {\n  left: auto;\n  right: 0;\n  background: #ff3159;\n  color: #fff;\n  box-shadow: 0 0 14px rgba(255, 49, 89, 0.55);\n}\n\n.pvp-team-select {\n  width: 100%;\n  margin: 8px 0;\n  padding: 9px 12px;\n  border: 1px solid #52627c;\n  background: rgba(14, 24, 42, 0.9);\n  color: #cbd5e1;\n  font: inherit;\n  font-weight: 800;\n  letter-spacing: 1px;\n  cursor: pointer;\n}\n\n.pvp-team-select.is-active {\n  border-color: #13d5ff;\n  color: #13d5ff;\n  box-shadow: 0 0 12px rgba(19, 213, 255, 0.2);\n}\n\n.cpu-side .pvp-team-select.is-active {\n  border-color: #ff3159;\n  color: #ff3159;\n  box-shadow: 0 0 12px rgba(255, 49, 89, 0.2);\n}\n\n.pvp-confirm-row {\n  display: flex;\n  justify-content: center;\n  gap: 14px;\n  width: min(100%, 720px);\n  margin: 20px auto;\n}\n\n.pvp-confirm-row > button {\n  flex: 1;\n}\n\n.pvp-confirm-row .p2-confirm-button:not(:disabled) {\n  border-color: #ff3159;\n  background: linear-gradient(135deg, #a91638, #ff3159);\n}\n\n@media (max-width: 640px) {\n  .pvp-confirm-row {\n    flex-direction: column;\n  }\n}\n\n/* In local 2v2, P2 is displayed on the left and P1 on the right. */\n\n.versus-selection.local-pvp-team-order {\n  flex-direction: row-reverse;\n}\n\n@media (max-width: 760px) {\n  .versus-selection.local-pvp-team-order {\n    flex-direction: column;\n  }\n}\n\n.customize-loadout-button { display:block;width:calc(100% - 24px);max-width:420px;margin:16px auto 4px;padding:12px 16px;color:#10170c;background:linear-gradient(110deg,#c8ff52,#ffe45c);border:1px solid #f7ffb0;box-shadow:0 4px 0 #6d7d2c;font-family:Oxanium,sans-serif;font-size:11px;font-weight:900;letter-spacing:1.2px;cursor:pointer;transition:transform .18s,filter .18s; }\n\n.customize-loadout-button:hover { transform:translateY(-2px);filter:brightness(1.08); }\n\n/* Animated loadout gate: block match confirmation until every player fighter\n   has at least three currently equipped attacks. */\n\n.attack-gate-backdrop {\n  position: fixed;\n  inset: 0;\n  z-index: 100000;\n  display: grid;\n  place-items: center;\n  padding: 20px;\n  background: rgba(3, 8, 6, .78);\n  backdrop-filter: blur(7px);\n  animation: attack-gate-fade-in .2s ease-out both;\n}\n\n.attack-gate-popup {\n  position: relative;\n  width: min(100%, 470px);\n  padding: 30px 28px 26px;\n  overflow: hidden;\n  text-align: center;\n  border: 1px solid rgba(246, 216, 74, .78);\n  border-top: 4px solid #f6d84a;\n  background:\n    radial-gradient(ellipse at 50% 0%, rgba(246,216,74,.17), transparent 62%),\n    linear-gradient(145deg, #1d2a1c, #080e0b 78%);\n  box-shadow: 0 0 0 1px rgba(246,216,74,.12), 0 22px 70px rgba(0,0,0,.65), 0 0 34px rgba(246,216,74,.13);\n  animation: attack-gate-enter .42s cubic-bezier(.18,.9,.25,1.2) both;\n}\n\n.attack-gate-emblem {\n  display: grid;\n  place-items: center;\n  width: 58px;\n  height: 58px;\n  margin: 0 auto 13px;\n  border: 1px solid #f6d84a;\n  border-radius: 50%;\n  color: #f6d84a;\n  background: rgba(246,216,74,.1);\n  font-size: 27px;\n  box-shadow: 0 0 24px rgba(246,216,74,.2), inset 0 0 15px rgba(246,216,74,.1);\n  animation: attack-gate-pulse 1.8s ease-in-out infinite;\n}\n\n.attack-gate-eyebrow {\n  margin: 0 0 8px;\n  color: #f6d84a;\n  font: 800 10px Oxanium, sans-serif;\n  letter-spacing: 2.4px;\n}\n\n.attack-gate-popup h2 {\n  margin: 0 0 12px;\n  color: #fff4c4;\n  font: 900 clamp(22px, 5vw, 29px) Oxanium, sans-serif;\n  text-shadow: 0 0 18px rgba(246,216,74,.18);\n}\n\n.attack-gate-popup > p:not(.attack-gate-eyebrow) {\n  margin: 0 auto 17px;\n  max-width: 370px;\n  color: #d4ddce;\n  font-size: 14px;\n  line-height: 1.6;\n}\n\n.attack-gate-requirement {\n  display: block;\n  margin: 0 auto 20px;\n  color: #baff57;\n  font: 900 12px Oxanium, sans-serif;\n  letter-spacing: 1.4px;\n}\n\n.attack-gate-popup > button {\n  width: 100%;\n  padding: 12px 16px;\n  border: 1px solid #fff0a0;\n  background: linear-gradient(110deg, #c8ff52, #f6d84a);\n  color: #12190c;\n  font: 900 12px Oxanium, sans-serif;\n  letter-spacing: 1.2px;\n  cursor: pointer;\n  box-shadow: 0 4px 0 #65772b;\n  transition: transform .18s ease, filter .18s ease;\n}\n\n.attack-gate-popup > button:hover {\n  transform: translateY(-2px);\n  filter: brightness(1.08);\n}\n\n@keyframes attack-gate-fade-in {\n  from { opacity: 0; }\n  to { opacity: 1; }\n}\n\n@keyframes attack-gate-enter {\n  from { opacity: 0; transform: translateY(22px) scale(.92); }\n  to { opacity: 1; transform: translateY(0) scale(1); }\n}\n\n@keyframes attack-gate-pulse {\n  0%, 100% { box-shadow: 0 0 18px rgba(246,216,74,.16), inset 0 0 12px rgba(246,216,74,.08); }\n  50% { box-shadow: 0 0 30px rgba(246,216,74,.32), inset 0 0 18px rgba(246,216,74,.16); }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .attack-gate-backdrop, .attack-gate-popup, .attack-gate-emblem { animation: none; }\n}\n\n/* Smooth exit for both automatic timeout and manual dismissal. */\n\n.attack-gate-backdrop.is-closing {\n  animation: attack-gate-fade-out .36s ease-in forwards;\n  pointer-events: none;\n}\n\n.attack-gate-popup.is-closing {\n  animation: attack-gate-exit .36s cubic-bezier(.4, 0, .8, .3) forwards;\n}\n\n@keyframes attack-gate-fade-out {\n  from { opacity: 1; backdrop-filter: blur(7px); }\n  to { opacity: 0; backdrop-filter: blur(0); }\n}\n\n@keyframes attack-gate-exit {\n  from { opacity: 1; transform: translateY(0) scale(1); }\n  to { opacity: 0; transform: translateY(14px) scale(.96); }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .attack-gate-backdrop.is-closing,\n  .attack-gate-popup.is-closing { animation: none; }\n}\n\n/* EMPTY FIGHTER SLOTS — never imply a default character is selected */\n\n.fighter-unselected-placeholder {\n  min-width: 0;\n  min-height: 245px;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 10px;\n  padding: 18px 12px;\n  text-align: center;\n  border: 1px dashed #8a9aaf66;\n  border-radius: 9px;\n  background:\n    radial-gradient(ellipse at 50% 40%,#ffffff0b,transparent 68%),\n    linear-gradient(145deg,#101a29,#0a111d);\n  box-shadow: inset 0 0 22px #0005;\n}\n\n.fighter-unselected-placeholder .unselected-question {\n  width: 66px;\n  height: 66px;\n  display: grid;\n  place-items: center;\n  border: 1px solid #8fa2bb66;\n  border-radius: 50%;\n  color: #a9bad0;\n  background: #0a1422;\n  font: 900 44px Oxanium,sans-serif;\n  text-shadow: 0 0 18px #a9bad055;\n}\n\n.fighter-unselected-placeholder strong {\n  color: #e0e8f4;\n  font: 900 .72rem Oxanium,sans-serif;\n  letter-spacing: 1px;\n}\n\n.fighter-unselected-placeholder small {\n  color: #8293aa;\n  font: 700 .62rem Rajdhani,sans-serif;\n  letter-spacing: .7px;\n}\n\n.roster-team-preview > .fighter-unselected-placeholder {\n  min-height: 320px;\n  border-color: #a5f51b55;\n  background: radial-gradient(ellipse at 50% 40%,#a5f51b0c,transparent 70%),#0b140f;\n}\n\n.cpu-side .fighter-unselected-placeholder {\n  border-color: #ff315966;\n}\n\n.cpu-side .fighter-unselected-placeholder .unselected-question {\n  color: #ff8797;\n  border-color: #ff315966;\n  text-shadow: 0 0 18px #ff315955;\n}\n\n@media(max-width:900px) {\n  .roster-team-preview > .fighter-unselected-placeholder { min-height: 240px; }\n}\n\n.cpu-placeholder-team {\n  display: grid;\n  grid-template-columns: repeat(2,minmax(0,1fr));\n  align-items: center;\n  gap: 10px;\n}\n\n.cpu-placeholder-team > p { grid-column: 1 / -1; margin: 0; }\n\n.cpu-unidentified-slot {\n  min-width: 0;\n  min-height: 210px;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 9px;\n  padding: 12px 8px;\n  border: 1px dashed #ff315966;\n  border-radius: 8px;\n  background: radial-gradient(ellipse at 50% 40%,#ff31590d,transparent 70%),#0d111c;\n}\n\n.cpu-unidentified-slot > span {\n  width: 58px;\n  height: 58px;\n  display: grid;\n  place-items: center;\n  border: 1px solid #ff315966;\n  border-radius: 50%;\n  color: #ff8797;\n  background: #160d17;\n  font: 900 38px Oxanium,sans-serif;\n  text-shadow: 0 0 16px #ff315955;\n}\n\n.cpu-unidentified-slot > strong {\n  color: #ff9aa9;\n  font: 900 .65rem Oxanium,sans-serif;\n  letter-spacing: .7px;\n}\n\n.cpu-unidentified-slot > small { color:#8c9aaf; font:700 .58rem Oxanium,sans-serif; }\n\n@media(max-width:520px) {\n  .cpu-unidentified-slot { min-height: 170px; }\n  .cpu-unidentified-slot > span { width:46px; height:46px; font-size:30px; }\n}\n\n/* Character lock-in reveal before the stage-select screen. */\n\n.character-chosen-countdown {\n  position:absolute;\n  z-index:80;\n  top:clamp(170px,31vh,300px);\n  left:50%;\n  width:min(540px,calc(100% - 32px));\n  transform:translateX(-50%);\n  display:grid;\n  place-items:center;\n  padding:0;\n  background:transparent;\n  pointer-events:none;\n  animation:chosen-overlay-in .28s ease-out both;\n}\n\n.character-chosen-card {\n  width:100%;\n  padding:clamp(14px,2vw,22px);\n  border:1px solid rgba(255,220,93,.78);\n  border-radius:13px;\n  background:linear-gradient(155deg,rgba(23,39,27,.96),rgba(9,18,13,.96));\n  box-shadow:0 0 0 1px #0008,0 0 28px rgba(255,210,80,.22),0 14px 42px #0009;\n  text-align:center;\n  pointer-events:auto;\n  animation:chosen-card-in .42s cubic-bezier(.2,.8,.2,1) both;\n}\n\n.character-chosen-kicker {\n  color:#ffe16b;\n  font:900 9px Oxanium,sans-serif;\n  letter-spacing:3px;\n}\n\n.character-chosen-card h2 {\n  margin:7px 0 10px;\n  color:#f7f0d5;\n  font:1000 clamp(16px,2.5vw,23px)/1.1 Oxanium,sans-serif;\n  letter-spacing:1px;\n}\n\n.character-chosen-names {\n  display:flex;\n  flex-direction:column;\n  gap:5px;\n  color:#b8c8b9;\n  font:800 10px Oxanium,sans-serif;\n  letter-spacing:.8px;\n}\n\n.character-chosen-number {\n  display:block;\n  margin:7px auto 2px;\n  color:#ffe16b;\n  font:1000 clamp(46px,7vw,66px)/.95 Oxanium,sans-serif;\n  text-shadow:0 0 20px rgba(255,220,93,.48),0 3px 0 #624d19;\n  animation:chosen-number-pulse .95s ease-in-out infinite alternate;\n}\n\n.character-chosen-card p {\n  margin:5px 0 0;\n  color:#a1b49f;\n  font:900 8px Oxanium,sans-serif;\n  letter-spacing:2px;\n}\n\n.character-chosen-actions {\n  display:flex;\n  justify-content:center;\n  flex-wrap:wrap;\n  gap:8px;\n  margin-top:12px;\n}\n\n.character-chosen-actions button {\n  min-height:32px;\n  padding:7px 11px;\n  border:1px solid rgba(255,220,93,.48);\n  border-radius:6px;\n  background:linear-gradient(180deg,#34432b,#182319);\n  color:#f5e9b8;\n  cursor:pointer;\n  font:900 9px Oxanium,sans-serif;\n  letter-spacing:.7px;\n  transition:transform .16s ease,border-color .16s ease,filter .16s ease;\n}\n\n.character-chosen-actions button:hover {\n  transform:translateY(-2px);\n  border-color:#ffe16b;\n  filter:brightness(1.2);\n}\n\n.character-chosen-actions button:focus-visible {\n  outline:2px solid #fff0a6;\n  outline-offset:2px;\n}\n\n@keyframes chosen-overlay-in { from{opacity:0} to{opacity:1} }\n\n@keyframes chosen-card-in { from{opacity:0;transform:translateY(18px) scale(.96)} to{opacity:1;transform:translateY(0) scale(1)} }\n\n@keyframes chosen-number-pulse { from{transform:scale(.96);filter:brightness(.9)} to{transform:scale(1.04);filter:brightness(1.3)} }\n\n\n"],["STYLE",{},"\n@import url(\"https://fonts.googleapis.com/css2?family=Oxanium:wght@400;500;600;700;800&family=Rajdhani:wght@400;500;600;700&display=swap\");\n\n/* ==========================================\n   WILD CARDS — INVENTORY\n========================================== */\n\n.inventory-screen {\n  --inv-gold: #ffe45c;\n  --inv-lime: #c8ff52;\n  --inv-ivory: #fff4c2;\n  --inv-sage: #c5c9b7;\n  --inv-dark: #10141c;\n  --inv-panel: rgba(15, 23, 25, 0.96);\n\n  min-height: 100vh;\n  padding: 30px clamp(16px, 5vw, 75px);\n  color: var(--inv-ivory);\n  background:\n    radial-gradient(ellipse at 15% 5%, rgba(165, 245, 27, 0.12), transparent 38%),\n    radial-gradient(ellipse at 90% 65%, rgba(255, 228, 92, 0.07), transparent 35%),\n    linear-gradient(145deg, #18221b, #10141c 60%, #090e15);\n  font-family: \"Rajdhani\", sans-serif;\n}\n\n.inventory-screen *,\n.inventory-screen *::before,\n.inventory-screen *::after {\n  box-sizing: border-box;\n}\n\n/* HEADER */\n\n.inventory-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 20px;\n  max-width: 1450px;\n  margin: 0 auto 40px;\n}\n\n.inventory-back-button {\n  padding: 11px 20px;\n  color: var(--inv-ivory);\n  background: rgba(12, 18, 27, 0.85);\n  border: 1px solid rgba(255, 228, 92, 0.4);\n  border-left: 4px solid var(--inv-lime);\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: 1.5px;\n  cursor: pointer;\n  transition: 180ms ease;\n}\n\n.inventory-back-button:hover {\n  color: var(--inv-gold);\n  border-color: var(--inv-gold);\n  transform: translateX(-3px);\n}\n\n.inventory-title {\n  text-align: right;\n}\n\n.inventory-title p {\n  margin: 0;\n  color: var(--inv-lime);\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: 4px;\n}\n\n.inventory-title h1 {\n  margin: 5px 0;\n  color: var(--inv-ivory);\n  font-family: \"Oxanium\", sans-serif;\n  font-size: clamp(30px, 5vw, 49px);\n  font-weight: 800;\n  letter-spacing: 2px;\n  text-shadow: 0 0 20px rgba(255, 228, 92, 0.12);\n}\n\n/* NAVIGATION */\n\n.inventory-navigation {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 10px;\n  max-width: 1450px;\n  margin: 0 auto;\n  padding-bottom: 15px;\n  border-bottom: 1px solid rgba(255, 228, 92, 0.2);\n}\n\n.inventory-tab {\n  padding: 13px 21px;\n  color: var(--inv-sage);\n  background: rgba(17, 25, 27, 0.92);\n  border: 1px solid rgba(255, 228, 92, 0.2);\n  border-bottom: 3px solid transparent;\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 11px;\n  font-weight: 700;\n  letter-spacing: 1.3px;\n  cursor: pointer;\n  transition: 180ms ease;\n}\n\n.inventory-tab:hover:not(:disabled) {\n  color: var(--inv-gold);\n  border-color: rgba(255, 228, 92, 0.6);\n}\n\n.inventory-tab.active {\n  color: var(--inv-gold);\n  background: rgba(255, 228, 92, 0.09);\n  border-color: rgba(255, 228, 92, 0.65);\n  border-bottom-color: var(--inv-gold);\n}\n\n.inventory-tab:disabled {\n  opacity: 0.4;\n  cursor: not-allowed;\n}\n\n.inventory-tab span {\n  display: block;\n  margin-top: 4px;\n  color: #a7a28a;\n  font-size: 8px;\n}\n\n/* MAIN CONTENT */\n\n.inventory-content {\n  max-width: 1450px;\n  margin: 0 auto;\n  padding-top: 35px;\n}\n\n.inventory-welcome {\n  margin-bottom: 28px;\n}\n\n.inventory-welcome h2 {\n  margin: 0 0 10px;\n  color: var(--inv-gold);\n  font-family: \"Oxanium\", sans-serif;\n  font-size: clamp(21px, 3vw, 29px);\n  font-weight: 800;\n  letter-spacing: 1.5px;\n}\n\n.inventory-welcome p {\n  max-width: 650px;\n  margin: 0 0 13px;\n  color: var(--inv-sage);\n  font-size: 15px;\n  line-height: 1.6;\n}\n\n.inventory-character-count {\n  color: var(--inv-lime);\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 10px;\n  font-weight: 800;\n  letter-spacing: 1.5px;\n}\n\n/* EMPTY STATES */\n\n.inventory-empty {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  min-height: 260px;\n  margin-top: 35px;\n  padding: 25px;\n  border: 1px dashed rgba(255, 228, 92, 0.35);\n  background: rgba(17, 25, 27, 0.75);\n  text-align: center;\n}\n\n.inventory-empty span {\n  color: var(--inv-gold);\n  font-size: 40px;\n}\n\n.inventory-empty h3 {\n  color: var(--inv-ivory);\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 18px;\n  font-weight: 800;\n  letter-spacing: 2px;\n}\n\n.inventory-empty p {\n  color: var(--inv-sage);\n}\n\n/* CHARACTER COLLECTION */\n\n.inventory-character-section {\n  margin-top: 35px;\n}\n\n.inventory-section-heading {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 12px;\n  margin-bottom: 18px;\n}\n\n.inventory-section-heading h3 {\n  margin: 0;\n  color: var(--inv-ivory);\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 15px;\n  font-weight: 800;\n  letter-spacing: 1.5px;\n}\n\n.inventory-section-heading span {\n  color: var(--inv-gold);\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 10px;\n  font-weight: 800;\n  letter-spacing: 1px;\n}\n\n.inventory-character-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(145px, 1fr));\n  gap: 18px;\n}\n\n.inventory-character-card {\n  position: relative;\n  padding: 0;\n  overflow: hidden;\n  color: var(--inv-ivory);\n  background: linear-gradient(155deg, #27342a, #111a1c 75%);\n  border: 1px solid rgba(255, 228, 92, 0.2);\n  border-bottom: 3px solid rgba(200, 255, 82, 0.35);\n  text-align: left;\n  cursor: pointer;\n  transition: 180ms ease;\n}\n\n.inventory-character-card:hover {\n  transform: translateY(-5px);\n  border-color: var(--inv-gold);\n  box-shadow: 0 10px 25px rgba(0, 0, 0, 0.3);\n}\n\n.inventory-character-card.selected {\n  border-color: var(--inv-lime);\n  border-bottom-color: var(--inv-lime);\n  box-shadow:\n    inset 0 0 20px rgba(200, 255, 82, 0.07),\n    0 0 17px rgba(200, 255, 82, 0.12);\n}\n\n.inventory-character-image {\n  width: 100%;\n  aspect-ratio: 125 / 190;\n  overflow: hidden;\n  background: #18221d;\n}\n\n.inventory-character-image img {\n  display: block;\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n\n.inventory-character-info {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  padding: 12px;\n}\n\n.inventory-character-info strong {\n  color: var(--inv-gold);\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 14px;\n  font-weight: 800;\n}\n\n.inventory-character-info span {\n  color: var(--inv-sage);\n  font-size: 11px;\n  letter-spacing: 0.5px;\n}\n\n.inventory-selected-label {\n  display: block;\n  padding: 8px;\n  color: #172015;\n  background: var(--inv-lime);\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 9px;\n  font-weight: 900;\n  letter-spacing: 1.5px;\n  text-align: center;\n}\n\n/* SELECTED CHARACTER PROFILE */\n\n.inventory-character-details {\n  margin-top: 45px;\n  padding: clamp(17px, 3vw, 30px);\n  background: linear-gradient(145deg, rgba(31, 43, 34, 0.96), rgba(11, 18, 21, 0.98));\n  border: 1px solid rgba(255, 228, 92, 0.25);\n  border-top: 3px solid var(--inv-lime);\n}\n\n.inventory-details-heading {\n  margin-bottom: 25px;\n}\n\n.inventory-details-heading p {\n  margin: 0;\n  color: var(--inv-lime);\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 10px;\n  font-weight: 800;\n  letter-spacing: 2px;\n}\n\n.inventory-details-heading h2 {\n  margin: 8px 0;\n  color: var(--inv-gold);\n  font-family: \"Oxanium\", sans-serif;\n  font-size: clamp(25px, 4vw, 34px);\n  font-weight: 800;\n}\n\n.inventory-details-heading span {\n  color: var(--inv-sage);\n  font-size: 15px;\n}\n\n.inventory-details-layout {\n  display: grid;\n  grid-template-columns: minmax(180px, 280px) minmax(0, 1fr);\n  gap: 30px;\n}\n\n.inventory-details-portrait {\n  position: relative;\n  overflow: hidden;\n  background: #18221d;\n  border: 1px solid rgba(200, 255, 82, 0.3);\n}\n\n.inventory-details-portrait img {\n  display: block;\n  width: 100%;\n  height: 100%;\n  max-height: 430px;\n  object-fit: cover;\n}\n\n.inventory-equipped-portrait-label {\n  display: block;\n  padding: 10px;\n  color: #172015;\n  background: var(--inv-lime);\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 9px;\n  font-weight: 900;\n  letter-spacing: 1.5px;\n  text-align: center;\n}\n\n/* COMBAT INFORMATION */\n\n.inventory-details-content h3 {\n  margin: 0 0 15px;\n  color: var(--inv-gold);\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 13px;\n  font-weight: 800;\n  letter-spacing: 1.5px;\n}\n\n.inventory-character-stats {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 12px;\n  margin-bottom: 30px;\n}\n\n.inventory-character-stats div {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  padding: 16px;\n  background: rgba(255, 228, 92, 0.045);\n  border: 1px solid rgba(255, 228, 92, 0.15);\n}\n\n.inventory-character-stats span {\n  color: var(--inv-sage);\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 9px;\n  font-weight: 700;\n  letter-spacing: 1px;\n}\n\n.inventory-character-stats strong {\n  color: var(--inv-lime);\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 22px;\n  font-weight: 800;\n}\n\n/* ATTACK LIST */\n\n.inventory-attacks-list {\n  display: grid;\n  gap: 9px;\n  margin-bottom: 30px;\n}\n\n.inventory-attack-item {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 15px;\n  padding: 13px 15px;\n  color: var(--inv-ivory);\n  background: rgba(255, 255, 255, 0.035);\n  border-left: 3px solid var(--inv-lime);\n  border-bottom: 1px solid rgba(255, 228, 92, 0.1);\n}\n\n.inventory-attack-item strong {\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 12px;\n}\n\n.inventory-attack-item span {\n  color: var(--inv-gold);\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 10px;\n  font-weight: 800;\n  white-space: nowrap;\n}\n\n.inventory-skins-placeholder {\n  padding: 20px;\n  background: rgba(255, 255, 255, 0.035);\n  border: 1px dashed rgba(255, 228, 92, 0.25);\n}\n\n.inventory-skins-placeholder p {\n  color: var(--inv-sage);\n}\n\n.inventory-skins-placeholder span {\n  color: var(--inv-gold);\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 10px;\n  font-weight: 800;\n  letter-spacing: 1px;\n}\n\n/* CHARACTER SKINS */\n\n.inventory-skins-section {\n  margin-top: 35px;\n  padding: 22px;\n  background: rgba(9, 16, 18, 0.65);\n  border: 1px solid rgba(255, 228, 92, 0.2);\n}\n\n.inventory-skins-heading {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 15px;\n  margin-bottom: 20px;\n}\n\n.inventory-skins-heading p {\n  margin: 0 0 5px;\n  color: var(--inv-lime);\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 9px;\n  font-weight: 800;\n  letter-spacing: 2px;\n}\n\n.inventory-skins-heading h3 {\n  margin: 0;\n  color: var(--inv-gold);\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 15px;\n  font-weight: 800;\n}\n\n.inventory-skins-heading > span {\n  color: var(--inv-gold);\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 10px;\n  font-weight: 800;\n  white-space: nowrap;\n}\n\n.inventory-skin-grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(190px, 1fr));\n  gap: 18px;\n}\n\n.inventory-skin-card {\n  overflow: hidden;\n  background: rgba(12, 18, 19, 0.96);\n  border: 1px solid rgba(255, 228, 92, 0.16);\n  transition: border-color 180ms ease, transform 180ms ease;\n}\n\n.inventory-skin-card.skin-owned {\n  border-color: rgba(200, 255, 82, 0.4);\n}\n\n.inventory-skin-card.skin-owned:hover {\n  transform: translateY(-3px);\n  border-color: var(--inv-lime);\n}\n\n.inventory-skin-image {\n  position: relative;\n  width: 100%;\n  aspect-ratio: 125 / 190;\n  overflow: hidden;\n  background: #18221d;\n}\n\n.inventory-skin-image > img {\n  display: block;\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n}\n\n.inventory-skin-card.skin-locked .inventory-skin-image > img {\n  filter: grayscale(1) brightness(0.35) blur(5px);\n  transform: scale(1.04);\n}\n\n.inventory-skin-lock {\n  position: absolute;\n  inset: 0;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 9px;\n  color: var(--inv-gold);\n  background: rgba(0, 0, 0, 0.25);\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 11px;\n  font-weight: 800;\n  letter-spacing: 2px;\n}\n\n.inventory-skin-lock span {\n  font-size: 30px;\n}\n\n.inventory-skin-equipped {\n  position: absolute;\n  top: 10px;\n  left: 10px;\n  padding: 6px 9px;\n  color: #172015;\n  background: var(--inv-lime);\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 9px;\n  font-weight: 900;\n  letter-spacing: 1px;\n}\n\n.inventory-skin-info {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 9px;\n  padding: 13px;\n}\n\n.inventory-skin-info > strong {\n  color: var(--inv-gold);\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 13px;\n  font-weight: 800;\n}\n\n.inventory-skin-info p {\n  min-height: 38px;\n  margin: 0;\n  color: var(--inv-sage);\n  font-size: 12px;\n  line-height: 1.5;\n}\n\n.inventory-skin-character {\n  color: var(--inv-lime);\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 10px;\n  font-weight: 800;\n  text-transform: uppercase;\n  letter-spacing: 1px;\n}\n\n/* SKIN ACTIONS */\n\n.inventory-skin-button {\n  width: 100%;\n  padding: 11px;\n  border: 1px solid transparent;\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 10px;\n  font-weight: 800;\n  letter-spacing: 1px;\n  cursor: pointer;\n  transition: 180ms ease;\n}\n\n.inventory-skin-button.equip {\n  color: #172015;\n  background: var(--inv-gold);\n  border-color: var(--inv-gold);\n}\n\n.inventory-skin-button.equip:hover {\n  background: #fff1a0;\n  box-shadow: 0 0 15px rgba(255, 228, 92, 0.25);\n}\n\n.inventory-skin-button.unequip {\n  color: var(--inv-ivory);\n  background: rgba(200, 255, 82, 0.08);\n  border-color: rgba(200, 255, 82, 0.4);\n}\n\n.inventory-skin-button.unequip:hover {\n  color: #172015;\n  background: var(--inv-lime);\n}\n\n.inventory-skin-button.locked {\n  color: #8d9384;\n  background: #202822;\n  border-color: #374237;\n  cursor: not-allowed;\n}\n\n.inventory-no-skins {\n  padding: 25px;\n  border: 1px dashed rgba(255, 228, 92, 0.25);\n  text-align: center;\n}\n\n.inventory-no-skins span {\n  color: var(--inv-gold);\n  font-size: 30px;\n}\n\n.inventory-no-skins p {\n  color: var(--inv-sage);\n  font-size: 13px;\n}\n\n/* RARITY COLORS\n   Keep rarity tiers distinct from the main UI palette. */\n\n.skin-rarity-badge {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: fit-content;\n  padding: 5px 10px;\n  border: 1px solid currentColor;\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 9px;\n  font-weight: 800;\n  letter-spacing: 1px;\n}\n\n.rarity-common {\n  color: #c5cbd3;\n  background: rgba(197, 203, 211, 0.12);\n}\n\n.rarity-uncommon {\n  color: #70e6a2;\n  background: rgba(80, 216, 144, 0.12);\n}\n\n.rarity-rare {\n  color: #69c8ff;\n  background: rgba(66, 186, 255, 0.12);\n}\n\n.rarity-epic {\n  color: #c99aff;\n  background: rgba(189, 121, 255, 0.12);\n}\n\n.rarity-legendary {\n  color: #ffe45c;\n  background: rgba(255, 228, 92, 0.12);\n}\n\n/* SKIN GALLERY */\n\n.inventory-gallery-section {\n  width: 100%;\n}\n\n.skin-rarity-key {\n  margin: 25px 0 35px;\n  padding: 20px;\n  background: rgba(15, 23, 25, 0.82);\n  border: 1px solid rgba(255, 228, 92, 0.2);\n}\n\n.skin-rarity-list {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 10px;\n  margin-top: 15px;\n}\n\n.skin-rarity-key > p {\n  margin-top: 12px;\n  color: var(--inv-sage);\n  font-size: 13px;\n}\n\n/* RESPONSIVE */\n\n@media (max-width: 800px) {\n  .inventory-details-layout {\n    grid-template-columns: 1fr;\n  }\n\n  .inventory-details-portrait {\n    width: 100%;\n    max-width: 280px;\n    margin: 0 auto;\n  }\n\n  .inventory-details-portrait img {\n    height: auto;\n  }\n}\n\n@media (max-width: 650px) {\n  .inventory-header {\n    align-items: flex-start;\n  }\n\n  .inventory-title h1 {\n    font-size: 30px;\n  }\n\n  .inventory-skins-heading {\n    align-items: flex-start;\n    flex-direction: column;\n  }\n\n  .inventory-skins-section {\n    padding: 15px;\n  }\n\n  .inventory-character-stats {\n    grid-template-columns: 1fr;\n  }\n}\n\n@media (max-width: 420px) {\n  .inventory-header {\n    flex-direction: column-reverse;\n  }\n\n  .inventory-title {\n    text-align: left;\n  }\n\n  .inventory-navigation {\n    gap: 7px;\n  }\n\n  .inventory-tab {\n    flex: 1;\n    padding: 11px 9px;\n    font-size: 9px;\n  }\n\n  .inventory-character-grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: 10px;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .inventory-character-card,\n  .inventory-skin-card,\n  .inventory-tab,\n  .inventory-back-button,\n  .inventory-skin-button {\n    transition: none;\n  }\n}\n\n/* Clickable attack collection and full move breakdown */\n\n.inventory-attack-item {\n  width: 100%;\n  display: flex;\n  align-items: center;\n  gap: 13px;\n  text-align: left;\n  cursor: pointer;\n  color: inherit;\n  font: inherit;\n  border: 1px solid rgba(255, 228, 92, .2);\n  transition: transform .18s ease, border-color .18s ease, background .18s ease;\n}\n\n.inventory-attack-item:hover, .inventory-attack-item:focus-visible {\n  transform: translateY(-2px);\n  border-color: var(--inv-gold, #ffe45c);\n  background: rgba(255, 228, 92, .08);\n  outline: none;\n}\n\n.inventory-attack-thumb {\n  width: 58px;\n  height: 58px;\n  object-fit: cover;\n  border-radius: 7px;\n  flex: 0 0 58px;\n}\n\n.inventory-attack-name { display: flex; flex: 1; min-width: 0; flex-direction: column; gap: 3px; }\n\n.inventory-attack-name small { font-size: .68rem; letter-spacing: .12em; opacity: .62; }\n\n.inventory-attack-modal-backdrop {\n  position: fixed; inset: 0; z-index: 9999; display: grid; place-items: center;\n  padding: 22px; background: rgba(0,0,0,.82); backdrop-filter: blur(7px);\n}\n\n.inventory-attack-modal {\n  position: relative; width: min(850px, 100%); max-height: min(88vh, 900px);\n  overflow-y: auto; padding: 28px; color: #f7f2df;\n  background: linear-gradient(145deg, #172126, #0c1118 72%);\n  border: 1px solid rgba(255,228,92,.48); border-radius: 16px;\n  box-shadow: 0 24px 90px rgba(0,0,0,.65), 0 0 28px rgba(255,228,92,.08);\n}\n\n.inventory-attack-close {\n  position: sticky; top: 0; float: right; z-index: 2; width: 38px; height: 38px;\n  margin: -8px -8px 0 10px; border: 1px solid rgba(255,255,255,.2);\n  border-radius: 50%; color: #fff; background: #252e34; font-size: 26px; cursor: pointer;\n}\n\n.inventory-attack-modal-heading { display: flex; align-items: center; gap: 22px; margin-bottom: 22px; }\n\n.inventory-attack-modal-heading img, .inventory-attack-no-image {\n  width: 170px; height: 150px; flex: 0 0 170px; object-fit: cover;\n  border-radius: 10px; border: 1px solid rgba(255,228,92,.35);\n}\n\n.inventory-attack-no-image { display: grid; place-items: center; color: #aaa; background: #202a30; font-size: .8rem; }\n\n.inventory-attack-modal-heading p { margin: 0 0 7px; color: #ffe45c; font-size: .75rem; letter-spacing: .16em; }\n\n.inventory-attack-modal-heading h2 { margin: 0 0 8px; font-family: Oxanium, sans-serif; font-size: clamp(1.5rem, 4vw, 2.2rem); }\n\n.inventory-attack-modal-heading span { color: #c8d0ce; line-height: 1.5; }\n\n.inventory-attack-core-stats, .inventory-effect-grid {\n  display: grid; grid-template-columns: repeat(auto-fit, minmax(125px, 1fr)); gap: 9px;\n}\n\n.inventory-attack-core-stats { margin-bottom: 20px; }\n\n.inventory-attack-core-stats > div, .inventory-effect-card {\n  display: flex; flex-direction: column; gap: 5px; padding: 11px 13px;\n  background: rgba(255,255,255,.045); border: 1px solid rgba(255,255,255,.1); border-radius: 8px;\n}\n\n.inventory-attack-core-stats span, .inventory-effect-card strong {\n  color: #aebbb8; font-size: .7rem; letter-spacing: .1em;\n}\n\n.inventory-attack-core-stats strong { color: #ffe45c; font: 700 1.2rem Oxanium, sans-serif; }\n\n.inventory-effect-group { margin: 18px 0; padding: 14px; border-left: 3px solid #829095; background: rgba(255,255,255,.025); border-radius: 5px; }\n\n.inventory-effect-group h4 { margin: 0 0 11px; font: 700 .9rem Oxanium, sans-serif; letter-spacing: .1em; }\n\n.inventory-effect-group.positive { border-color: #68e69a; }\n\n.inventory-effect-group.positive h4 { color: #82f2ad; }\n\n.inventory-effect-group.negative { border-color: #ff6474; }\n\n.inventory-effect-group.negative h4 { color: #ff8792; }\n\n.inventory-effect-group.warning { border-color: #ffc45d; }\n\n.inventory-effect-group.warning h4 { color: #ffd080; }\n\n.inventory-effect-group.modifier { border-color: #73cfff; }\n\n.inventory-effect-group.modifier h4 { color: #8cdbff; }\n\n.inventory-effect-card span { color: #fff; font-size: .95rem; overflow-wrap: anywhere; }\n\n.inventory-effect-note, .inventory-no-effects { padding: 11px 14px; color: #d6d2b9; background: rgba(255,228,92,.07); border-radius: 7px; }\n\n@media (max-width: 600px) {\n  .inventory-attack-modal { padding: 18px; }\n  .inventory-attack-modal-heading { align-items: flex-start; flex-direction: column; }\n  .inventory-attack-modal-heading img, .inventory-attack-no-image { width: 100%; height: 190px; flex-basis: auto; }\n  .inventory-attack-item { gap: 8px; }\n  .inventory-attack-thumb { width: 46px; height: 46px; flex-basis: 46px; }\n}\n\n/* WILD CARDS — attack cards and loadout editor */\n\n.inventory-attack-item { cursor:pointer;min-width:0;border:1px solid rgba(255,228,92,.18);border-left:3px solid var(--inv-lime);border-radius:5px;transition:transform .18s,border-color .18s,background .18s; }\n\n.inventory-attack-item:hover,.inventory-attack-item:focus-visible { transform:translateY(-2px);border-color:var(--inv-gold);background:rgba(255,228,92,.09);outline:none; }\n\n.inventory-attack-item .inventory-attack-thumb { width:64px;height:64px;object-fit:cover;border-radius:4px;flex:0 0 64px; }\n\n.inventory-attack-name { display:flex;flex:1;min-width:0;flex-direction:column;gap:4px; }\n\n.inventory-attack-name small { color:var(--inv-lime);font-size:9px;letter-spacing:1px; }\n\n.attack-loadout-editor { max-width:1250px;margin:0 auto;padding:10px 0 40px; }\n\n.loadout-intro { margin:25px 0;text-align:center; }\n\n.loadout-intro p,.loadout-character-picker,.loadout-section header,.loadout-slot-counter span { color:var(--inv-lime);font-family:Oxanium,sans-serif;font-size:10px;font-weight:800;letter-spacing:2px; }\n\n.loadout-intro h2 { color:var(--inv-gold);font-family:Oxanium,sans-serif;font-size:clamp(26px,4vw,42px);font-weight:900; }\n\n.loadout-intro span { color:var(--inv-sage); }\n\n.loadout-character-picker { display:flex;align-items:center;gap:15px;flex-wrap:wrap;margin:20px 0; }\n\n.loadout-character-picker select { min-width:220px;padding:11px 14px;color:var(--inv-ivory);background:#101820;border:1px solid #ffe45c66;font:700 13px Oxanium,sans-serif; }\n\n.loadout-character-picker option { background:#101820; }\n\n.loadout-slot-counter { display:flex;align-items:center;gap:15px;padding:14px 18px;margin:18px 0;background:linear-gradient(90deg,#24341d,#111a1b);border:1px solid #c8ff5255; }\n\n.loadout-slot-counter strong { color:var(--inv-gold);font:900 28px Oxanium,sans-serif; }\n\n.loadout-section { margin:22px 0;padding:18px;background:#0a1215b8;border:1px solid #ffe45c2e; }\n\n.loadout-section header { display:flex;justify-content:space-between;gap:10px;align-items:center;margin-bottom:14px; }\n\n.loadout-section header h3 { margin:0;color:var(--inv-gold);font:800 14px Oxanium,sans-serif; }\n\n.loadout-section header span { color:var(--inv-sage);font-size:9px; }\n\n.loadout-attack-grid { display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:12px; }\n\n.loadout-attack-card { display:grid;grid-template-columns:88px minmax(0,1fr);min-height:112px;overflow:hidden;background:linear-gradient(135deg,#1b2926,#101720);border:1px solid #ffe45c44; }\n\n.loadout-attack-art { position:relative;min-height:112px;background:#080e12; }\n\n.loadout-attack-art img { width:100%;height:100%;position:absolute;inset:0;object-fit:cover; }\n\n.loadout-attack-art>span { display:grid;place-items:center;height:100%;font-size:28px;color:var(--inv-gold); }\n\n.loadout-attack-art b { position:absolute;left:0;right:0;bottom:8px;text-align:center;background:#8e1c2b;color:#fff;font:800 10px Oxanium,sans-serif;padding:5px; }\n\n.loadout-attack-info { display:flex;flex-direction:column;align-items:flex-start;justify-content:center;gap:7px;padding:10px;min-width:0; }\n\n.loadout-attack-info strong { color:var(--inv-ivory);font:800 12px Oxanium,sans-serif;overflow-wrap:anywhere; }\n\n.loadout-attack-info span { color:var(--inv-sage);font-size:10px; }\n\n.loadout-attack-info button,.loadout-save-button { padding:7px 10px;color:#111a10;background:var(--inv-lime);border:0;font:800 9px Oxanium,sans-serif;letter-spacing:1px;cursor:pointer; }\n\n.loadout-attack-info button:disabled { opacity:.35;cursor:not-allowed; }\n\n.loadout-attack-info .loadout-remove { color:#fff;background:#922c3a; }\n\n.loadout-attack-card.is-locked { filter:saturate(.45);border-color:#ff647466; }\n\n.loadout-empty { color:var(--inv-sage);font-size:13px; }\n\n.loadout-save-message { color:var(--inv-lime);font:800 12px Oxanium,sans-serif;text-align:center; }\n\n.loadout-save-button { display:block;min-width:220px;margin:24px auto;padding:15px 25px;background:var(--inv-gold);font-size:12px;box-shadow:0 5px 0 #8d782b; }\n\n@media(max-width:600px){.inventory-attack-item{gap:8px;padding:9px}.inventory-attack-item .inventory-attack-thumb{width:48px;height:48px;flex-basis:48px}.loadout-attack-grid{grid-template-columns:1fr}.loadout-character-picker{align-items:flex-start;flex-direction:column}.loadout-character-picker select{width:100%}}\n\n/* TRADING-CARD ATTACK COLLECTION — WILD CARDS */\n\n.inventory-attacks-list { grid-template-columns: repeat(auto-fill,minmax(205px,1fr)); gap:16px; }\n\n.inventory-attack-item { position:relative;display:flex;flex-direction:column;align-items:stretch;justify-content:flex-start;gap:0;min-height:270px;padding:0;overflow:hidden;text-align:left;background:linear-gradient(155deg,#27342a 0%,#111a1c 65%,#080e12 100%);border:2px solid rgba(255,228,92,.65);border-radius:12px;box-shadow:inset 0 0 0 3px rgba(255,228,92,.08),0 8px 18px rgba(0,0,0,.35);transition:transform .18s,border-color .18s,box-shadow .18s; }\n\n.inventory-attack-item:hover,.inventory-attack-item:focus-visible { transform:translateY(-5px) rotate(-.5deg);border-color:var(--inv-gold);box-shadow:0 12px 25px rgba(0,0,0,.45),0 0 15px rgba(255,228,92,.15);outline:none; }\n\n.inventory-attack-item .inventory-attack-thumb { display:block;width:100%;height:160px;flex:0 0 160px;object-fit:cover;border-radius:0;border-bottom:2px solid var(--inv-gold); }\n\n.inventory-attack-name { display:flex;flex-direction:column;gap:7px;padding:12px 12px 6px;min-width:0; }\n\n.inventory-attack-name strong { color:var(--inv-gold);font:900 13px Oxanium,sans-serif;line-height:1.25; }\n\n.inventory-attack-name small { color:var(--inv-lime);font:800 8px Oxanium,sans-serif;letter-spacing:1.4px; }\n\n.inventory-attack-item>span:last-child { display:flex;justify-content:space-between;align-items:center;margin:auto 12px 12px;padding-top:9px;border-top:1px solid #ffe45c44;color:var(--inv-ivory);font:800 9px Oxanium,sans-serif; }\n\n.inventory-attack-item.is-locked { border-color:#b94d5a;background:linear-gradient(155deg,#292126,#141519 70%,#080e12); }\n\n.inventory-attack-item.is-locked .inventory-attack-thumb { filter:grayscale(.65) brightness(.58); }\n\n.inventory-attack-lock-ribbon { position:absolute;top:12px;right:-27px;z-index:2;width:112px;padding:6px 0;transform:rotate(38deg);text-align:center;color:#fff;background:#9e2637;border-top:1px solid #ffb3ba;border-bottom:1px solid #ffb3ba;font:900 9px Oxanium,sans-serif;letter-spacing:1.5px;box-shadow:0 3px 9px #0008; }\n\n.inventory-attack-unlock-panel { display:flex;justify-content:space-between;align-items:center;gap:14px;flex-wrap:wrap;margin-top:22px;padding:16px;background:linear-gradient(100deg,#301c25,#171519);border:1px solid #ff6474; }\n\n.inventory-attack-unlock-panel span { color:#ff9ca7;font:800 10px Oxanium,sans-serif;letter-spacing:1.3px; }\n\n.inventory-attack-unlock-panel button { padding:11px 16px;color:#fff;background:#a52b3d;border:1px solid #ff9ca7;font:900 10px Oxanium,sans-serif;letter-spacing:1px;cursor:pointer; }\n\n.inventory-attack-unlock-panel button:hover { background:#c83b50; }\n\n.loadout-attack-grid { grid-template-columns:repeat(auto-fill,minmax(190px,1fr));gap:16px; }\n\n.loadout-attack-card { position:relative;display:flex;flex-direction:column;min-height:0;overflow:hidden;background:linear-gradient(155deg,#27342a,#111a1c 68%,#080e12);border:2px solid rgba(255,228,92,.65);border-radius:12px;box-shadow:inset 0 0 0 3px rgba(255,228,92,.07),0 8px 18px rgba(0,0,0,.32);transition:transform .18s,border-color .18s,box-shadow .18s; }\n\n.loadout-attack-card:hover { transform:translateY(-4px);border-color:var(--inv-gold);box-shadow:0 12px 22px #0008,0 0 14px #ffe45c22; }\n\n.loadout-attack-art { position:relative;width:100%;height:165px;min-height:165px;flex:0 0 165px;background:#080e12;border-bottom:2px solid var(--inv-gold); }\n\n.loadout-attack-art img { position:absolute;inset:0;width:100%;height:100%;object-fit:cover; }\n\n.loadout-attack-info { flex:1;align-items:stretch;justify-content:space-between;padding:12px;gap:10px; }\n\n.loadout-attack-info strong { color:var(--inv-gold);font:900 13px Oxanium,sans-serif;line-height:1.25; }\n\n.loadout-attack-info span { color:var(--inv-sage);font:800 9px Oxanium,sans-serif;letter-spacing:.5px; }\n\n.loadout-attack-info button { width:100%;min-height:34px;font-size:9px; }\n\n.loadout-attack-info .loadout-festival-exclusive { color:#fff2bd;background:linear-gradient(135deg,#8e2435,#5d1726);border:1px solid #ff9eaa;box-shadow:0 0 12px #ff315933;line-height:1.4; }\n\n.loadout-attack-info .loadout-festival-exclusive:hover { background:linear-gradient(135deg,#b83249,#782033);box-shadow:0 0 16px #ff315966; }\n\n.loadout-attack-card.is-locked { border-color:#b94d5a;background:linear-gradient(155deg,#292126,#141519 70%,#080e12); }\n\n.loadout-attack-card.is-locked .loadout-attack-art img { filter:grayscale(.65) brightness(.58); }\n\n.loadout-attack-art b { top:12px;bottom:auto;left:auto;right:-27px;width:112px;padding:6px 0;transform:rotate(38deg);border-top:1px solid #ffb3ba;border-bottom:1px solid #ffb3ba;color:#fff;background:#9e2637;font:900 9px Oxanium,sans-serif;letter-spacing:1.5px; }\n\n@media(max-width:600px){.inventory-attacks-list,.loadout-attack-grid{grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}.inventory-attack-item{min-height:235px}.inventory-attack-item .inventory-attack-thumb{height:125px;flex-basis:125px}.loadout-attack-art{height:125px;min-height:125px;flex-basis:125px}.loadout-attack-info{padding:9px}.inventory-attack-name{padding:9px 9px 5px}.inventory-attack-name strong,.loadout-attack-info strong{font-size:11px}}\n\n/* WILD CARDS — full fighter cards in the Attack Loadouts collection */\n\n.loadout-character-collection { display:flex;flex-direction:column;gap:34px;max-width:1320px;margin:0 auto; }\n\n.loadout-character-collection .attack-loadout-editor { width:100%;max-width:none;margin:0;padding:22px 20px 28px;background:linear-gradient(145deg,#17231fdd,#0b1115f2);border:1px solid rgba(255,228,92,.36);border-radius:16px;box-shadow:0 12px 30px #0005,inset 0 0 0 3px #ffe45c0a; }\n\n.loadout-character-banner { display:grid;grid-template-columns:150px minmax(0,1fr) auto;align-items:center;gap:22px;padding:0 0 20px;border-bottom:1px solid #ffe45c44; }\n\n.loadout-character-portrait { width:150px;height:185px;overflow:hidden;border:3px solid var(--inv-gold);border-radius:9px;background:#080e12;box-shadow:0 0 18px #ffe45c22; }\n\n.loadout-character-portrait img { width:100%;height:100%;object-fit:cover;object-position:center top; }\n\n.loadout-character-heading p { margin:0 0 7px;color:var(--inv-lime);font:800 10px Oxanium,sans-serif;letter-spacing:2px; }\n\n.loadout-character-heading h2 { margin:0;color:var(--inv-gold);font:900 clamp(25px,4vw,38px) Oxanium,sans-serif;text-transform:uppercase; }\n\n.loadout-character-heading span { display:block;margin-top:8px;color:var(--inv-sage);font-size:12px;letter-spacing:1px; }\n\n.loadout-header-actions { display:flex;flex-direction:column;align-items:flex-end;gap:10px;min-width:190px; }\n\n.loadout-character-banner .loadout-slot-counter { flex-direction:column;align-items:flex-end;gap:4px;margin:0;white-space:nowrap; }\n\n.loadout-character-banner .loadout-slot-counter strong { font-size:30px; }\n\n.loadout-character-banner .loadout-slot-counter span { text-align:right; }\n\n.loadout-header-actions .loadout-save-button { display:block;width:100%;min-width:190px;margin:0;padding:12px 16px;background:var(--inv-gold);font-size:10px;box-shadow:0 4px 0 #8d782b; }\n\n.loadout-header-actions .loadout-save-message { margin:0;font-size:10px; }\n\n.loadout-character-collection .loadout-section { margin:18px 0 0;padding:14px;background:#080e12a8;border-radius:10px; }\n\n@media(max-width:700px) {\n  .loadout-character-collection .attack-loadout-editor { padding:14px 10px 20px; }\n  .loadout-character-banner { grid-template-columns:100px minmax(0,1fr);gap:13px; }\n  .loadout-character-portrait { width:100px;height:130px; }\n  .loadout-header-actions { grid-column:1 / -1;flex-direction:row;align-items:center;justify-content:space-between;flex-wrap:wrap;min-width:0; }\n  .loadout-character-banner .loadout-slot-counter { flex-direction:row;align-items:center;justify-content:flex-start; }\n  .loadout-character-banner .loadout-slot-counter span { text-align:left; }\n  .loadout-header-actions .loadout-save-button { width:auto;min-width:180px; }\n}\n\n/* Attack loadout: select a fighter first, then open that fighter's cards */\n\n.loadout-character-browser { width:100%;max-width:1320px;margin:0 auto; }\n\n.loadout-roster-heading { margin:6px 0 24px;text-align:center; }\n\n.loadout-roster-heading p { margin:0 0 6px;color:var(--inv-lime);font:800 11px Oxanium,sans-serif;letter-spacing:3px; }\n\n.loadout-roster-heading h2 { margin:0;color:var(--inv-gold);font:900 clamp(24px,4vw,36px) Oxanium,sans-serif; }\n\n.loadout-roster-heading span { display:block;margin-top:8px;color:var(--inv-sage);font-size:13px; }\n\n.loadout-character-select-grid { display:grid;grid-template-columns:repeat(auto-fill,minmax(175px,1fr));gap:18px; }\n\n.loadout-character-select-card { min-width:0;padding:0;overflow:hidden;text-align:left;cursor:pointer;color:inherit;background:linear-gradient(155deg,#1b2b25,#090f13);border:1px solid rgba(255,228,92,.38);border-radius:11px;box-shadow:0 7px 20px #0005;transition:transform .18s ease,border-color .18s ease,box-shadow .18s ease; }\n\n.loadout-character-select-card:hover,.loadout-character-select-card:focus-visible { transform:translateY(-5px);border-color:var(--inv-gold);box-shadow:0 0 18px #ffe45c33,0 12px 24px #0007;outline:none; }\n\n.loadout-character-select-art { position:relative;height:220px;overflow:hidden;background:#080e12; }\n\n.loadout-character-select-art img { display:block;width:100%;height:100%;object-fit:cover;object-position:center top;transition:transform .25s ease; }\n\n.loadout-character-select-card:hover .loadout-character-select-art img { transform:scale(1.045); }\n\n.loadout-character-select-art span { position:absolute;right:0;bottom:0;left:0;padding:9px 8px;text-align:center;color:#10140d;background:linear-gradient(90deg,#f4d65b,#fff0a1,#d8ae36);font:900 11px Oxanium,sans-serif;letter-spacing:1.2px;opacity:0;transform:translateY(100%);transition:opacity .18s ease,transform .18s ease; }\n\n.loadout-character-select-card:hover .loadout-character-select-art span,.loadout-character-select-card:focus-visible .loadout-character-select-art span { opacity:1;transform:translateY(0); }\n\n.loadout-character-select-info { display:flex;flex-direction:column;gap:5px;padding:12px 13px 14px; }\n\n.loadout-character-select-info strong { color:var(--inv-gold);font:900 17px Oxanium,sans-serif;text-transform:uppercase; }\n\n.loadout-character-select-info small { color:var(--inv-sage);font:700 10px Oxanium,sans-serif;letter-spacing:1px; }\n\n.loadout-back-to-roster { display:inline-flex;align-items:center;gap:8px;margin:0 0 16px;padding:10px 15px;color:var(--inv-gold);background:#101b18;border:1px solid #ffe45c66;border-radius:7px;font:800 12px Oxanium,sans-serif;letter-spacing:1px;cursor:pointer; }\n\n.loadout-back-to-roster:hover { background:#26352a;border-color:var(--inv-gold); }\n\n@media(max-width:560px) {\n .loadout-character-select-grid { grid-template-columns:repeat(2,minmax(0,1fr));gap:11px; }\n .loadout-character-select-art { height:175px; }\n}\n\n/* Reset controls in the fighter attack-loadout editor. */\n\n.loadout-action-buttons { display:grid;gap:8px;width:100%; }\n\n.loadout-header-actions .loadout-action-buttons .loadout-save-button { min-width:190px; }\n\n.loadout-reset-button { width:100%;padding:10px 14px;color:#ffe9a0;background:#22251c;border:1px solid #ffe45c88;font:800 9px Oxanium,sans-serif;letter-spacing:1px;cursor:pointer;transition:background .18s,border-color .18s; }\n\n.loadout-reset-button:hover { background:#3a3420;border-color:var(--inv-gold); }\n"],["STYLE",{},"\n\n@import url(\"https://fonts.googleapis.com/css2?family=Oxanium:wght@400;500;600;700;800&family=Rajdhani:wght@400;500;600;700&display=swap\");\n/* =========================================================\n   WILD CARDS — 1v1 BATTLE UI\n   Clean layout system based on the TeamBattle.css architecture.\n   Combat state and React markup remain owned by their components.\n   ========================================================= */\n/* ---------- Global shell ---------- */\nhtml,\nbody,\n#root {\n  min-height: 100%;\n  margin: 0;\n}\nbody {\n  background: #080d16;\n  color: #f1f5ff;\n  font-family: Rajdhani, Arial, sans-serif;\n}\n#gameContainer {\n  position: relative;\n  min-height: 100vh;\n  padding: 10px 18px 18px;\n  color: #f1f5ff;\n  background:\n    radial-gradient(ellipse at 50% 38%, #183022 0%, transparent 66%),\n    linear-gradient(180deg, #0b1710 0%, #0a1711 54%, #080d16 100%);\n  box-sizing: border-box;\n}\n#gameContainer *,\n#gameContainer *::before,\n#gameContainer *::after {\n  box-sizing: border-box;\n}\n#gameContainer button {\n  font: inherit;\n}\n#gameContainer button:focus-visible,\n#gameContainer [tabindex=\"0\"]:focus-visible {\n  outline: 2px solid #f4f7ff;\n  outline-offset: 3px;\n}\n/* ---------- Main battle grid ---------- */\n#battleLayout {\n  position: relative;\n  display: grid;\n  grid-template-columns: minmax(0, 0.27fr) minmax(0, 0.73fr);\n  grid-template-rows: 42px minmax(350px, 1fr) minmax(270px, 32vh);\n  grid-template-areas:\n    \"header header\"\n    \"arena arena\"\n    \"log attacks\";\n  gap: 10px;\n  width: 100%;\n  min-height: calc(100vh - 30px);\n  height: calc(100vh - 28px);\n  max-width: 1780px;\n  margin: 0 auto;\n  font-family: Rajdhani, Arial, sans-serif;\n}\n.solo-battle-header {\n  grid-area: header;\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);\n  align-items: center;\n  gap: 14px;\n  min-width: 0;\n}\n.solo-battle-header h1 {\n  margin: 0;\n  color: #f4f2d9;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: clamp(17px, 1.7vw, 25px);\n  font-weight: 900;\n  letter-spacing: 2px;\n  text-align: center;\n  white-space: nowrap;\n  text-shadow: 0 0 14px #dfff8a25;\n}\n.solo-battle-header h1 span {\n  margin-left: 8px;\n  color: #f1d34b;\n  font-size: 0.62em;\n  letter-spacing: 1px;\n}\n.solo-team-label {\n  display: flex;\n  align-items: center;\n  min-width: 0;\n  min-height: 30px;\n  padding: 5px 14px;\n  border: 1px solid #ffffff10;\n  border-radius: 8px;\n  background: #102016b8;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: 10px;\n  font-weight: 900;\n  font-style: italic;\n  letter-spacing: 2px;\n}\n.solo-opponent-label {\n  justify-content: center;\n  color: #ff7187;\n}\n.solo-player-label {\n  justify-content: center;\n  color: #50e6ff;\n}\n/* ---------- Arena and fighter units ---------- */\n#battleLayout > #battleArena {\n  grid-area: arena;\n  position: relative;\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);\n  align-items: stretch;\n  justify-items: stretch;\n  gap: clamp(18px, 5vw, 90px);\n  min-width: 0;\n  min-height: 0;\n  padding: 16px clamp(24px, 7vw, 110px) 12px;\n  overflow: visible;\n  border: 1px solid #1a805b;\n  border-radius: 13px;\n  background:\n    radial-gradient(ellipse at 50% 55%, #1b3826a0 0%, transparent 66%),\n    linear-gradient(145deg, #102117, #0c1a12 70%, #0c1912);\n  box-shadow:\n    inset 0 0 28px #0005,\n    0 0 12px #12d98c20;\n  isolation: isolate;\n}\n#battleLayout > #battleArena::before {\n  content: \"\";\n  position: absolute;\n  z-index: -1;\n  inset: 0;\n  border-radius: inherit;\n  opacity: 0.22;\n  background: repeating-linear-gradient(\n    0deg,\n    transparent 0 48px,\n    #d8e9ff0b 49px 50px\n  );\n  pointer-events: none;\n}\n.story-battle-background {\n  position: absolute;\n  z-index: -1;\n  inset: 0;\n  border-radius: inherit;\n  background-position: center;\n  background-size: cover;\n  opacity: 0.2;\n  pointer-events: none;\n}\n#battleLayout > #battleArena > #opponentSection,\n#battleLayout > #battleArena > #characterSection {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  align-items: stretch;\n  justify-content: flex-start;\n  gap: clamp(7px, 1.2vh, 13px);\n  width: 100%;\n  max-width: 460px;\n  min-width: 0;\n  min-height: 0;\n  height: 100%;\n  margin: 0 auto;\n}\n#battleLayout > #battleArena > #opponentSection {\n  grid-column: 1;\n  grid-row: 1;\n}\n#battleLayout > #battleArena > #characterSection {\n  grid-column: 2;\n  grid-row: 1;\n}\n#battleLayout .solo-fighter-unit {\n  position: relative;\n  display: flex;\n  flex: 1 1 auto;\n  flex-direction: column;\n  align-items: stretch;\n  justify-content: flex-start;\n  gap: clamp(7px, 1.2vh, 13px);\n  width: 100%;\n  max-width: none;\n  min-width: 0;\n  min-height: 0;\n  height: 100%;\n  margin: 0;\n  padding: 0;\n  overflow: visible;\n  color: #f5f8ff;\n  background: transparent;\n  border: 0;\n  border-radius: 0;\n  box-shadow: none;\n  clip-path: none;\n  filter: none;\n  isolation: isolate;\n}\n#battleLayout .solo-fighter-unit::before,\n#battleLayout .solo-fighter-unit::after {\n  content: none;\n}\n#battleLayout #opponent {\n  --fighter-accent: #ff526b;\n}\n#battleLayout #character {\n  --fighter-accent: #20d9ff;\n}\n/* Compact top HUD — same hierarchy as the 2v2 fighter HUD. */\n#battleLayout .solo-fighter-hud {\n  position: relative;\n  z-index: 5;\n  display: flex;\n  flex: 0 0 auto;\n  flex-direction: column;\n  gap: 6px;\n  width: 100%;\n  min-width: 0;\n  padding: 9px 11px;\n  border: 1px solid #ffffff20;\n  border-top: 2px solid var(--fighter-accent);\n  border-radius: 9px;\n  background: linear-gradient(145deg, #111c2bef, #080f1bef);\n  box-shadow: 0 5px 18px #0005;\n}\n.solo-fighter-name-row {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n  min-width: 0;\n  margin-bottom: 1px;\n}\n.solo-fighter-name-row h2 {\n  min-width: 0;\n  overflow: hidden;\n  flex: 1;\n  margin: 0;\n  color: #fff;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: clamp(13px, 1.2vw, 18px);\n  font-weight: 900;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.solo-fighter-name-row > span {\n  flex: 0 0 auto;\n  color: var(--fighter-accent);\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: 8px;\n  font-weight: 900;\n  letter-spacing: 1px;\n}\n.solo-resource-row {\n  display: grid;\n  grid-template-columns: 22px minmax(0, 1fr) auto;\n  align-items: center;\n  gap: 7px;\n  min-width: 0;\n  color: #dbe7f6;\n  font-size: 10px;\n  font-weight: 800;\n}\n.solo-resource-row > span {\n  color: #dbe7f6;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: 9px;\n  font-weight: 900;\n}\n.solo-resource-row b {\n  min-width: 54px;\n  color: #edf4ff;\n  font-size: 9px;\n  font-variant-numeric: tabular-nums;\n  text-align: right;\n}\n.solo-resource-track {\n  height: 9px;\n  min-width: 0;\n  overflow: hidden;\n  border: 1px solid #ffffff12;\n  border-radius: 99px;\n  background: #263247;\n  box-shadow: inset 0 1px 3px #0009;\n}\n.solo-resource-fill {\n  height: 100%;\n  border-radius: inherit;\n  transition: width 260ms ease;\n}\n.solo-resource-health .solo-resource-fill {\n  background: linear-gradient(90deg, #ff3159, #ff9b78);\n  box-shadow: 0 0 9px #ff526b70;\n}\n.solo-resource-mana .solo-resource-fill {\n  background: linear-gradient(90deg, #167bff, #20d9ff);\n  box-shadow: 0 0 9px #20d9ff70;\n}\n.solo-segment-group {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);\n  gap: 12px;\n  padding-top: 6px;\n  border-top: 1px solid #ffffff14;\n}\n.solo-segment-row {\n  display: grid;\n  grid-template-columns: 24px minmax(0, 1fr) auto;\n  align-items: center;\n  gap: 5px;\n  min-width: 0;\n}\n.solo-segment-row > span {\n  color: #c9d6e6;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: 8px;\n  font-weight: 900;\n  letter-spacing: 0.5px;\n}\n.solo-segment-row > b {\n  color: #e5edf8;\n  font-size: 8px;\n  font-variant-numeric: tabular-nums;\n}\n.solo-segments {\n  display: grid;\n  grid-auto-columns: minmax(4px, 1fr);\n  grid-auto-flow: column;\n  gap: 3px;\n  min-width: 0;\n}\n.solo-segments i {\n  display: block;\n  height: 9px;\n  min-width: 0;\n  border: 1px solid #526176;\n  border-radius: 2px;\n  background: #263247;\n}\n.solo-segment-row.cooldown .solo-segments i.filled {\n  border-color: #ffd477;\n  background: linear-gradient(180deg, #ffe3a0, #f3a83c);\n  box-shadow: 0 0 7px #ffb94a66;\n}\n.solo-segment-row.recovery .solo-segments i.filled {\n  border-color: #8dffc4;\n  background: linear-gradient(180deg, #8affc0, #23b978);\n  box-shadow: 0 0 7px #39dc9866;\n}\n.solo-segments small {\n  color: #7d8ca2;\n  font-size: 9px;\n}\n/* Character artwork is independent of the HUD: no card outline. */\n#battleLayout .solo-fighter-art {\n  position: relative;\n  display: flex;\n  flex: 1 1 auto;\n  align-items: flex-end;\n  justify-content: center;\n  width: 100%;\n  min-width: 0;\n  min-height: 140px;\n  height: auto;\n  padding: 0;\n  overflow: visible;\n  border: 0;\n  border-radius: 0;\n  outline: 0;\n  background: transparent;\n  box-shadow: none;\n  cursor: default;\n  isolation: isolate;\n  transition: filter 180ms ease, transform 180ms ease;\n}\n#battleLayout .solo-fighter-art::before {\n  content: \"\";\n  position: absolute;\n  z-index: -1;\n  right: 12%;\n  bottom: 2px;\n  left: 12%;\n  height: 22px;\n  border-radius: 50%;\n  background: #000b;\n  filter: blur(13px);\n}\n#battleLayout .solo-fighter-art::after {\n  content: none;\n}\n#battleLayout .solo-fighter-art img {\n  display: block;\n  width: auto;\n  height: 100%;\n  max-width: min(100%, 340px);\n  max-height: 100%;\n  object-fit: contain;\n  object-position: center bottom;\n  border: 0;\n  border-radius: 0;\n  outline: 0;\n  background: transparent;\n  filter: drop-shadow(0 0 8px color-mix(in srgb, var(--fighter-accent) 35%, transparent)) drop-shadow(0 9px 14px #000c);\n  transition: filter 180ms ease, transform 180ms ease;\n}\n#battleLayout #opponentSection .solo-fighter-art img {\n  filter: drop-shadow(0 0 8px #ff526b55) drop-shadow(0 9px 14px #000c);\n}\n#battleLayout #characterSection .solo-fighter-art img {\n  filter: drop-shadow(0 0 8px #20d9ff55) drop-shadow(0 9px 14px #000c);\n}\n#battleLayout .solo-fighter-art:hover img,\n#battleLayout .solo-fighter-art:focus-visible img {\n  filter: drop-shadow(0 0 14px color-mix(in srgb, var(--fighter-accent) 65%, transparent)) drop-shadow(0 9px 14px #000c);\n  transform: scale(1.025);\n}\n/* Fighter status tooltip appears over the artwork on hover/focus. */\n#battleLayout .solo-fighter-tooltip {\n  position: absolute;\n  z-index: 40;\n  top: 12px;\n  left: 50%;\n  display: none;\n  width: min(330px, 94%);\n  padding: 11px;\n  transform: translateX(-50%);\n  border: 1px solid color-mix(in srgb, var(--fighter-accent) 65%, transparent);\n  border-radius: 9px;\n  color: #eaf3ff;\n  background: #091321f5;\n  box-shadow: 0 10px 28px #000b, 0 0 18px color-mix(in srgb, var(--fighter-accent) 18%, transparent);\n  pointer-events: none;\n}\n#battleLayout .solo-fighter-art:hover .solo-fighter-tooltip,\n#battleLayout .solo-fighter-art:focus .solo-fighter-tooltip,\n#battleLayout .solo-fighter-art:focus-within .solo-fighter-tooltip {\n  display: block;\n}\n.solo-fighter-tooltip header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n  margin-bottom: 8px;\n  padding-bottom: 6px;\n  border-bottom: 1px solid #ffffff20;\n}\n.solo-fighter-tooltip header strong {\n  overflow: hidden;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: 12px;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.solo-fighter-tooltip header span,\n.solo-fighter-tooltip small {\n  color: #94a9c0;\n  font-size: 8px;\n  letter-spacing: 0.8px;\n}\n.solo-tooltip-grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 5px;\n}\n.solo-tooltip-grid > div {\n  display: flex;\n  justify-content: space-between;\n  gap: 8px;\n  padding: 5px 6px;\n  border-radius: 4px;\n  background: #ffffff09;\n}\n.solo-tooltip-grid span {\n  color: #9eb1c7;\n  font-size: 8px;\n  font-weight: 800;\n}\n.solo-tooltip-grid b {\n  color: #fff;\n  font-size: 9px;\n}\n.solo-tooltip-effects {\n  display: grid;\n  gap: 4px;\n  margin-top: 8px;\n  padding-top: 7px;\n  border-top: 1px solid #ffffff20;\n}\n.solo-tooltip-effects strong {\n  color: #80e9ff;\n  font-size: 8px;\n  letter-spacing: 1px;\n}\n.solo-tooltip-effects span {\n  color: #c4d4e6;\n  font-size: 9px;\n}\n.solo-fighter-tooltip > small {\n  display: block;\n  margin-top: 7px;\n}\n/* ---------- Combat feedback and action animations ---------- */\n#battleLayout .solo-impact-overlay {\n  position: absolute;\n  z-index: 25;\n  inset: 0;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  overflow: visible;\n  pointer-events: none;\n}\n.solo-damage-number {\n  color: #fff;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: clamp(30px, 4vw, 58px);\n  font-weight: 1000;\n  line-height: 1;\n  text-shadow: 0 3px 2px #000, 0 0 16px #ff3159;\n  animation: solo-damage-pop 1450ms cubic-bezier(.16,.8,.25,1) both;\n}\n.solo-damage-number.damage-tier-effective {\n  color: #fff2a8;\n  animation: solo-damage-effective 1500ms ease-out both;\n}\n.solo-damage-number.damage-tier-heavy {\n  color: #ffd18a;\n  animation: solo-damage-heavy 1.6s cubic-bezier(.2,.8,.2,1) both;\n}\n.solo-damage-number.damage-tier-fatal {\n  color: #fff;\n  font-size: clamp(34px, 4.8vw, 68px);\n  text-shadow: 0 0 8px #fff, 0 0 24px #ff3159, 0 0 42px #ff3159;\n  animation: solo-damage-fatal 1.8s ease-out both;\n}\n.solo-impact-overlay > span {\n  padding: 5px 10px;\n  border: 1px solid #ffffff50;\n  border-radius: 5px;\n  color: #fff;\n  background: #08111de8;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: 11px;\n  font-weight: 1000;\n  letter-spacing: 1px;\n  animation: solo-status-pop 1300ms ease-out both;\n}\n.solo-effect-label {\n  position: absolute;\n  z-index: 28;\n  top: 16%;\n  left: 50%;\n  padding: 5px 9px;\n  transform: translateX(-50%);\n  border: 1px solid currentColor;\n  border-radius: 5px;\n  color: #8fffc0;\n  background: #07140ff0;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: 10px;\n  font-weight: 900;\n  white-space: nowrap;\n  animation: solo-status-pop 1500ms ease-out both;\n}\n.solo-effect-label.effect-defense { color: #c2c9d3; }\n.solo-effect-label.effect-agility { color: #f4d35e; }\n.solo-effect-label.effect-mana,\n.solo-effect-label.effect-manaregen { color: #45d9ff; }\n.solo-effect-label.effect-health,\n.solo-effect-label.effect-maximumhealth { color: #ff7187; }\n.solo-effect-label.effect-stun { color: #c49aff; }\n#battleLayout .combat-effect-damage {\n  animation: solo-hit-flash 1120ms ease-out;\n}\n#battleLayout .combat-effect-blocked {\n  animation: solo-block-shake 1220ms ease-out;\n}\n#battleLayout .combat-effect-evaded {\n  animation: solo-evade-shift 1160ms ease-out;\n}\n#battleLayout .combat-effect-status {\n  animation: solo-status-glow 1450ms ease-out;\n}\n#battleLayout .combat-effect-attack {\n  animation: solo-attacker-pulse 1020ms ease-out;\n}\n#battleLayout .fighter-stunned img {\n  animation: solo-stunned 850ms ease-in-out infinite;\n  filter: drop-shadow(0 0 14px #b78aff) grayscale(.25) !important;\n}\n.solo-combat-messages {\n  position: absolute;\n  z-index: 32;\n  right: 5px;\n  bottom: 6px;\n  left: 5px;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 4px;\n  pointer-events: none;\n}\n.combat-popup {\n  max-width: 95%;\n  padding: 5px 10px;\n  border: 1px solid #ffffff35;\n  border-radius: 5px;\n  color: #fff;\n  background: #091321eF;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: 9px;\n  font-weight: 900;\n  text-align: center;\n  box-shadow: 0 4px 12px #0008;\n  animation: solo-popup-rise 2.4s ease-out both;\n}\n.combat-popup.attack,\n.combat-popup.hit { border-color: #ff526b; }\n.combat-popup.blocked { border-color: #d6dce5; }\n.combat-popup.evaded { border-color: #58dcff; }\n.combat-popup.buff { border-color: #45d995; color: #9bffc6; }\n.combat-popup.debuff { border-color: #ff7187; color: #ff9aa8; }\n/* ---------- Bottom panels: compact log + priority attack options ---------- */\n#battleLayout > #combatLog {\n  grid-area: log;\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n  min-height: 0;\n  width: 100%;\n  height: 100%;\n  margin: 0;\n  overflow: hidden;\n  border: 1px solid #8ddf2750;\n  border-radius: 12px;\n  background: linear-gradient(145deg, #17271b, #0d1710);\n  box-shadow: 0 5px 18px #0006;\n}\n#combatLogHeader {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 8px;\n  padding: 9px 11px;\n  border-bottom: 1px solid #ffffff18;\n  border-radius: 11px 11px 0 0;\n  color: #dfffa0;\n  background: #1a2b1d;\n}\n#combatLogHeader h4 {\n  margin: 0;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: 10px;\n  font-weight: 900;\n  letter-spacing: 1px;\n}\n#combatLogHeader span {\n  color: #a9bba8;\n  font-size: 9px;\n}\n#combatLogEntries {\n  flex: 1 1 auto;\n  min-height: 0;\n  padding: 6px 10px;\n  overflow-y: auto;\n  scrollbar-color: #50694d #101a13;\n  scrollbar-width: thin;\n}\n#emptyCombatLog {\n  margin: 5px 0;\n  color: #b8c6b9;\n  font-size: 11px;\n}\n.combat-log-entry {\n  display: flex;\n  flex-direction: column;\n  gap: 3px;\n  padding: 6px 1px;\n  border-bottom: 1px solid #ffffff0d;\n}\n.combat-log-time {\n  color: #b4ed65;\n  font-size: 8px;\n  font-variant-numeric: tabular-nums;\n}\n.combat-log-text {\n  color: #c3d0c4;\n  font-size: 9px;\n  line-height: 1.35;\n}\n.combat-log-entry.hit .combat-log-text,\n.combat-log-entry.attack .combat-log-text { color: #ff9aa8; }\n.combat-log-entry.buff .combat-log-text { color: #8fffc0; }\n.combat-log-entry.debuff .combat-log-text { color: #ff9aa8; }\n#battleLayout > #battleAttackPanel {\n  grid-area: attacks;\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n  min-height: 0;\n  width: 100%;\n  height: 100%;\n  margin: 0;\n  overflow: hidden;\n  border: 1px solid #8ddf2750;\n  border-radius: 12px;\n  background: linear-gradient(145deg, #17271b, #0d1710);\n  box-shadow: 0 5px 18px #0006;\n}\n#battleLayout > #battleAttackPanel > #attackSection {\n  display: flex;\n  flex: 1 1 auto;\n  flex-direction: column;\n  min-width: 0;\n  min-height: 0;\n  width: 100%;\n  margin: 0;\n  overflow: hidden;\n  border: 0;\n  border-radius: 11px;\n  background: transparent;\n  box-shadow: none;\n}\n#battleLayout #attack {\n  display: flex;\n  flex: 1 1 auto;\n  flex-direction: column;\n  min-width: 0;\n  min-height: 0;\n  margin: 0;\n  overflow: hidden;\n  color: #f1f5ff;\n  border: 0;\n  border-radius: 11px;\n  background: transparent;\n  box-shadow: none;\n}\n#battleLayout #attackHeader {\n  flex: 0 0 auto;\n  padding: 8px 12px;\n  color: #f4f2d9;\n  border: 0;\n  border-bottom: 2px solid #a5ff19;\n  background: linear-gradient(90deg, #2c4726, #1b2b1d 75%);\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: 12px;\n  font-weight: 1000;\n  letter-spacing: 2px;\n  text-transform: uppercase;\n}\n#battleLayout #attackBody {\n  flex: 1 1 auto;\n  min-width: 0;\n  min-height: 0;\n  padding: 8px 10px 5px;\n  overflow: hidden;\n}\n#battleLayout #attackList {\n  display: flex;\n  align-items: stretch;\n  gap: 9px;\n  width: 100%;\n  height: 100%;\n  min-height: 0;\n  padding: 3px 3px 8px;\n  overflow-x: auto;\n  overflow-y: visible;\n  scrollbar-color: #87958c #101a13;\n  scrollbar-width: thin;\n}\n#battleLayout .attack-card-wrapper {\n  position: relative;\n  display: flex;\n  flex: 0 0 158px;\n  width: 158px;\n  min-width: 158px;\n  min-height: 0;\n}\n#battleLayout .attack-card {\n  position: relative;\n  display: flex;\n  flex: 1 1 auto;\n  flex-direction: column;\n  align-items: stretch;\n  gap: 4px;\n  width: 100%;\n  min-width: 0;\n  min-height: 0;\n  height: 100%;\n  padding: 7px !important;\n  overflow: hidden;\n  color: #e8efff !important;\n  text-align: left;\n  border: 1px solid #465b7c !important;\n  border-radius: 8px !important;\n  background: linear-gradient(160deg, #1b2940, #0b101c) !important;\n  box-shadow: 0 5px 12px #00000040;\n  cursor: pointer;\n  transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;\n}\n#battleLayout .attack-card:not(:disabled):hover {\n  transform: translateY(-3px);\n  border-color: #20dfff !important;\n  box-shadow: 0 0 18px #20dfff35;\n}\n#battleLayout .attack-card:disabled {\n  opacity: 0.42;\n  filter: grayscale(.55);\n  cursor: not-allowed;\n}\n#battleLayout .attack-card .attack-image,\n#battleLayout .attack-card [id^=\"attackImage\"] {\n  display: block;\n  flex: 0 0 auto;\n  width: 100%;\n  height: clamp(58px, 9vh, 86px);\n  max-height: 86px;\n  margin: 0 0 2px;\n  object-fit: cover;\n  border: 1px solid #536b91;\n  border-radius: 5px;\n}\n#battleLayout .attack-card h5,\n#battleLayout .attack-card [id^=\"attackName\"] {\n  flex: 0 0 auto;\n  min-height: 0;\n  margin: 1px 0 3px;\n  color: #f6f8ff;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: 10px;\n  font-weight: 900;\n  line-height: 1.2;\n  text-align: center;\n}\n#battleLayout .attack-stats {\n  display: flex;\n  flex: 0 0 auto;\n  flex-direction: column;\n  gap: 4px;\n  margin: 0;\n  padding: 0;\n}\n#battleLayout .attack-stats span,\n#battleLayout .attack-cost span {\n  display: block;\n  overflow-wrap: anywhere;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: 8px;\n  font-weight: 900;\n  line-height: 1.25;\n  text-align: center;\n}\n#battleLayout .attack-damage {\n  padding: 4px 3px;\n  border-radius: 4px;\n  color: #ff7187;\n  background: #ff31591c;\n}\n#battleLayout .attack-speed {\n  padding: 4px 3px;\n  border: 1px solid #13d5ff;\n  border-radius: 4px;\n  color: #50e6ff;\n  background: #13d5ff12;\n}\n#battleLayout .attack-cost {\n  display: flex;\n  flex: 0 0 auto;\n  flex-direction: column;\n  gap: 4px;\n  margin-top: 3px;\n  padding: 0;\n}\n#battleLayout .attack-mana-cost {\n  color: #58dcff;\n}\n#battleLayout .attack-sacrifice-cost {\n  color: #ff7187;\n}\n#battleLayout .attack-availability-info {\n  padding: 3px;\n  border: 1px solid #e7a74788;\n  border-radius: 4px;\n  color: #ffc76e;\n  background: #e7a74712;\n}\n#battleLayout .attack-limited .attack-availability-info,\n#battleLayout .attack-limited-cooldown .attack-availability-info {\n  color: #ff9aa8;\n  border-color: #ff526b70;\n}\n#battleLayout .attack-unavailable {\n  opacity: 0.38;\n  filter: grayscale(.7);\n}\n#battleLayout .attack-effects-popup {\n  position: absolute;\n  z-index: 45;\n  right: 0;\n  bottom: calc(100% + 6px);\n  display: none;\n  width: max-content;\n  max-width: 230px;\n  padding: 9px;\n  border: 1px solid #ffffff35;\n  border-radius: 7px;\n  color: #f4f8ff;\n  background: #091321f5;\n  box-shadow: 0 6px 18px #000a;\n  font-size: 9px;\n  pointer-events: none;\n}\n#battleLayout .attack-card-wrapper:hover .attack-effects-popup,\n#battleLayout .attack-card-wrapper:focus-within .attack-effects-popup {\n  display: block;\n}\n.attack-effects-popup h6 {\n  margin: 0 0 6px;\n  color: #fff;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: 9px;\n  font-weight: 900;\n}\n.attack-effect-group {\n  display: grid;\n  gap: 4px;\n  margin-top: 5px;\n}\n.attack-effect-list {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 4px;\n}\n.attack-effect-heading,\n.attack-effect {\n  font-size: 8px;\n  font-weight: 900;\n}\n.buff-heading,\n.attack-effect.buff { color: #55e6a5; }\n.debuff-heading,\n.attack-effect.debuff { color: #ff7187; }\n.stun-card-overlay {\n  position: absolute;\n  z-index: 5;\n  inset: 7px 7px auto;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 3px;\n  padding: 7px 4px;\n  border: 1px solid #c49aff;\n  border-radius: 5px;\n  color: #eadbff;\n  background: #171026eF;\n  text-align: center;\n}\n.stun-card-overlay strong { font-size: 9px; }\n.stun-card-overlay small { font-size: 7px; }\n/* Finish turn remains attached to the attack selection panel. */\n#battleLayout .solo-finish-turn-button {\n  flex: 0 0 auto;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 12px;\n  width: calc(100% - 16px);\n  min-height: 37px;\n  margin: 4px 8px 8px;\n  border: 1px solid #ffe45b;\n  border-radius: 8px;\n  color: #171508;\n  background: linear-gradient(110deg, #fff078, #e5b82e);\n  box-shadow: 0 0 12px #ffe45b30;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: 12px;\n  font-weight: 1000;\n  letter-spacing: 1.2px;\n  cursor: pointer;\n  transition: filter 160ms ease, transform 160ms ease;\n}\n#battleLayout .solo-finish-turn-button:hover:not(:disabled) {\n  filter: brightness(1.08);\n  transform: translateY(-1px);\n}\n#battleLayout .solo-finish-turn-button:disabled {\n  opacity: .4;\n  cursor: not-allowed;\n}\n#battleLayout .solo-finish-turn-button span { font-size: 17px; }\n/* Optional standalone Character finish-turn control. */\n#finishTurnArea {\n  display: flex;\n  justify-content: center;\n  width: 100%;\n  padding: 8px;\n}\n#finishTurnButton {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 3px;\n  width: 104px;\n  min-height: 94px;\n  padding: 10px;\n  border: 3px solid #45e5ff;\n  border-radius: 50%;\n  outline: 2px solid #0879db;\n  outline-offset: 3px;\n  color: #fff;\n  background: radial-gradient(circle at 35% 25%, #198fff, #07418c 70%, #06152f);\n  box-shadow: 0 0 12px #12bfff99, 0 0 28px #12bfff30, inset 0 0 15px #50d9ff40;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: 12px;\n  font-weight: 900;\n  cursor: pointer;\n}\n#finishTurnButton:disabled { opacity: .4; cursor: not-allowed; }\n#finishTurnArrow { font-size: 18px; }\n/* ---------- Incoming attack / defend / evade prompt ---------- */\n#aiAttackSection {\n  position: fixed;\n  z-index: 1000;\n  top: 50%;\n  left: 50%;\n  width: min(390px, calc(100vw - 28px));\n  max-height: min(88vh, 760px);\n  overflow-y: auto;\n  padding: 0;\n  transform: translate(-50%, -50%);\n  border: 1px solid #ff7187;\n  border-radius: 13px;\n  color: #f5f8ff;\n  background: linear-gradient(145deg, #17243a, #0b1220 75%);\n  box-shadow: 0 0 0 100vmax #0009, 0 0 28px #ff31594a, 0 18px 55px #000b;\n  animation: solo-incoming-enter 220ms ease-out both;\n}\n#aiAttackCard {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n  padding: 13px;\n}\n#aiAttackHeader {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  color: #ff9aa8;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: 11px;\n  font-weight: 1000;\n  letter-spacing: 1.2px;\n}\n.attack-warning-dot {\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n  background: #ff526b;\n  box-shadow: 0 0 12px #ff526b;\n  animation: solo-warning-pulse 700ms ease-in-out infinite alternate;\n}\n#defenseTimer {\n  display: grid;\n  gap: 5px;\n}\n#defenseTimerText {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  color: #b9c9dd;\n  font-size: 9px;\n  font-weight: 900;\n  letter-spacing: 1px;\n}\n#defenseTimerText strong {\n  color: #fff;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: 14px;\n}\n#defenseTimerTrack {\n  height: 6px;\n  overflow: hidden;\n  border-radius: 99px;\n  background: #263247;\n}\n#defenseTimerFill {\n  height: 100%;\n  border-radius: inherit;\n  background: linear-gradient(90deg, #f2cf53, #ff526b);\n  transition: width 250ms linear;\n}\n#defenseTimer.timer-warning #defenseTimerText strong { color: #ffd477; }\n#defenseTimer.timer-critical #defenseTimerText strong { color: #ff526b; animation: solo-warning-pulse 400ms infinite alternate; }\n#aiAttackInfo {\n  display: grid;\n  gap: 8px;\n}\n#aiAttackName {\n  margin: 0;\n  color: #fff;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: 16px;\n  text-align: center;\n}\n.incoming-attack-image {\n  display: grid;\n  place-items: center;\n  max-height: 110px;\n}\n.incoming-attack-image img {\n  max-width: 100%;\n  max-height: 105px;\n  object-fit: contain;\n  border: 1px solid #ffffff20;\n  border-radius: 6px;\n}\n#aiAttackStats {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 6px;\n}\n.attack-threat-badge,\n.attack-cost-badge {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 3px;\n  padding: 7px 4px;\n  border: 1px solid #ffffff20;\n  border-radius: 6px;\n  background: #ffffff08;\n  text-align: center;\n}\n.threat-label {\n  color: #aebed1;\n  font-size: 8px;\n  font-weight: 900;\n  letter-spacing: .8px;\n}\n.attack-threat-badge strong,\n.attack-cost-badge strong {\n  color: #fff;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: 15px;\n}\n.threat-rating {\n  color: #c3d1e2;\n  font-size: 8px;\n  font-weight: 800;\n}\n.attack-cost-badge strong { color: #58dcff; }\n.incoming-player-status {\n  display: grid;\n  gap: 7px;\n  padding: 8px;\n  border: 1px solid #ffffff18;\n  border-radius: 7px;\n  background: #0003;\n}\n.incoming-resource-line { display: grid; gap: 4px; }\n.incoming-status-heading {\n  display: flex;\n  justify-content: space-between;\n  color: #ff9aa8;\n  font-size: 8px;\n  font-weight: 900;\n}\n.incoming-status-heading strong { color: #fff; }\n.incoming-mana-heading { color: #58dcff; }\n.incoming-health-track {\n  height: 6px;\n  overflow: hidden;\n  border-radius: 99px;\n  background: #263247;\n}\n.incoming-health-fill {\n  height: 100%;\n  border-radius: inherit;\n  background: linear-gradient(90deg, #ff3159, #ff9b78);\n}\n.incoming-mana-track { background: #263247; }\n.incoming-mana-fill {\n  height: 100%;\n  border-radius: inherit;\n  background: linear-gradient(90deg, #167bff, #20d9ff);\n}\n#defensiveActions {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 7px;\n}\n#defensiveActions button {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n  min-height: 37px;\n  padding: 7px 5px;\n  border: 1px solid #ffffff25;\n  border-radius: 6px;\n  color: #fff;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: 9px;\n  font-weight: 1000;\n  letter-spacing: .5px;\n  background: #142033;\n  cursor: pointer;\n  transition: transform 150ms ease, filter 150ms ease;\n}\n#defensiveActions button:hover:not(:disabled) {\n  filter: brightness(1.15);\n  transform: translateY(-1px);\n}\n#defensiveActions button:disabled { opacity: .38; cursor: not-allowed; }\n#defendButton {\n  border-color: #50dfff80;\n  background: linear-gradient(135deg, #07547b, #087f9d);\n}\n#evadeButton {\n  border-color: #ff718780;\n  background: linear-gradient(135deg, #85243a, #571b30);\n}\n#takeDamageButton {\n  grid-column: 1 / -1;\n  border-color: #ff9b5c80;\n  background: linear-gradient(135deg, #77361f, #492216);\n}\n/* ---------- Round intro, K.O. and results overlays ---------- */\n#roundIntroOverlay,\n.battle-ko-overlay,\n.battle-finish-overlay {\n  position: fixed;\n  z-index: 2000;\n  inset: 0;\n  display: grid;\n  place-items: center;\n  padding: 18px;\n  background: #050911f5;\n  backdrop-filter: blur(8px);\n}\n#roundIntroContent {\n  width: min(760px, 94vw);\n  padding: clamp(18px, 3vw, 34px);\n  border: 1px solid #a5ff1970;\n  border-radius: 16px;\n  background: linear-gradient(145deg, #17271b, #0b1510);\n  box-shadow: 0 0 35px #a5ff1920, 0 20px 60px #000a;\n  text-align: center;\n  animation: solo-overlay-enter 420ms ease-out both;\n}\n#roundIntroEyebrow,\n.battle-ko-eyebrow,\n.battle-finish-eyebrow {\n  color: #a5ff19;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: 10px;\n  font-weight: 900;\n  letter-spacing: 3px;\n  text-transform: uppercase;\n}\n#roundIntroContent > h1 {\n  margin: 8px 0 22px;\n  color: #fff;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: clamp(34px, 6vw, 64px);\n  font-weight: 1000;\n  text-shadow: 0 0 22px #a5ff1950;\n}\n.battle-intro-matchup,\n.battle-finish-versus {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);\n  align-items: center;\n  gap: clamp(8px, 2vw, 22px);\n}\n.battle-intro-fighter,\n.battle-finish-side {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 7px;\n  min-width: 0;\n}\n.battle-intro-label,\n.battle-finish-side h2 {\n  color: #b9c9dd;\n  font-size: 9px;\n  font-weight: 900;\n  letter-spacing: 1.5px;\n}\n.battle-intro-fighter img {\n  width: auto;\n  height: clamp(105px, 19vh, 180px);\n  max-width: 100%;\n  object-fit: contain;\n  filter: drop-shadow(0 0 12px #ffffff25);\n}\n.battle-intro-fighter strong {\n  color: #fff;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: 13px;\n}\n.battle-intro-healthbar {\n  width: min(190px, 100%);\n  height: 7px;\n  overflow: hidden;\n  border-radius: 99px;\n  background: #293247;\n}\n.battle-intro-healthbar-fill {\n  height: 100%;\n  border-radius: inherit;\n  background: linear-gradient(90deg, #ff3159, #ff9b78);\n}\n.battle-intro-hp { color: #c2d0e1; font-size: 9px; }\n.battle-intro-vs,\n.battle-finish-vs {\n  color: #f3d85a;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: 17px;\n  font-weight: 1000;\n}\n#roundIntroLine {\n  width: 65%;\n  height: 2px;\n  margin: 20px auto 12px;\n  background: linear-gradient(90deg, transparent, #a5ff19, transparent);\n}\n#roundIntroContent > p {\n  margin: 0;\n  color: #f3d85a;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: 12px;\n  font-weight: 900;\n  letter-spacing: 3px;\n}\n#roundIntroOverlay.is-fading-out,\n.battle-ko-overlay.is-fading-out,\n.battle-finish-overlay.is-fading-out {\n  animation: solo-overlay-fade 450ms ease-in both;\n}\n.battle-ko-overlay {\n  background: radial-gradient(ellipse, #531323ee, #05060df7 72%);\n}\n.battle-ko-content,\n.battle-finish-overlay > *:not(.battle-finish-flash) {\n  position: relative;\n  z-index: 1;\n  text-align: center;\n}\n.battle-ko-portrait {\n  width: auto;\n  height: min(34vh, 260px);\n  max-width: 70vw;\n  object-fit: contain;\n  filter: grayscale(.3) drop-shadow(0 0 20px #ff3159);\n  animation: solo-ko-portrait 850ms ease-out both;\n}\n.battle-ko-title,\n.battle-finish-title {\n  margin: 8px 0;\n  color: #fff;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: clamp(48px, 10vw, 100px);\n  font-weight: 1000;\n  line-height: 1;\n  text-shadow: 0 0 10px #fff, 0 0 35px #ff3159;\n}\n.battle-ko-name,\n.battle-finish-message {\n  color: #fff;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: 17px;\n  font-weight: 900;\n}\n.battle-ko-subtitle,\n.battle-finish-footer {\n  color: #ff9aa8;\n  font-size: 10px;\n  font-weight: 900;\n  letter-spacing: 2px;\n}\n.battle-finish-overlay {\n  overflow-y: auto;\n  background: radial-gradient(ellipse, #172c20f5, #050911fa 72%);\n}\n.battle-finish-overlay.finish-defeat { background: radial-gradient(ellipse, #471426f5, #050911fa 72%); }\n.battle-finish-title { font-size: clamp(42px, 8vw, 76px); }\n.battle-finish-side h2 { margin: 0; color: #b9c9dd; font-family: Oxanium, Arial, sans-serif; }\n.battle-finish-card {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 7px;\n  min-width: 120px;\n  padding: 10px;\n  border: 1px solid #ffffff25;\n  border-radius: 9px;\n  background: #0b1422;\n}\n.battle-finish-card img {\n  width: auto;\n  height: clamp(90px, 17vh, 150px);\n  max-width: 120px;\n  object-fit: contain;\n}\n.battle-finish-card strong { color: #fff; font-size: 12px; }\n.battle-finish-card span { color: #a5ff19; font-size: 9px; font-weight: 900; }\n.battle-finish-footer { margin-top: 20px; }\n.battle-ko-flash,\n.battle-finish-flash {\n  position: absolute;\n  inset: 0;\n  background: #fff;\n  opacity: 0;\n  pointer-events: none;\n  animation: solo-screen-flash 700ms ease-out both;\n}\n/* ---------- Pause control placement ---------- */\n.battle-pause-trigger {\n  position: fixed;\n  z-index: 1500;\n  top: 12px;\n  right: 14px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  min-width: 104px;\n  min-height: 42px;\n  padding: 8px 13px;\n  border: 2px solid #fff0a0;\n  border-radius: 10px;\n  color: #171508;\n  background: linear-gradient(110deg, #fff078, #e5b82e);\n  box-shadow: 0 0 12px #ffe45b75, 0 5px 16px #0007;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: 12px;\n  font-weight: 1000;\n  letter-spacing: 1px;\n  cursor: pointer;\n}\n.battle-pause-trigger:hover { filter: brightness(1.08); transform: translateY(-1px); }\n.battle-pause-icon { font-size: 15px; }\n/* ---------- Responsive layout ---------- */\n@media (max-width: 1100px) {\n  #gameContainer { padding: 9px; }\n  #battleLayout {\n    height: auto;\n    min-height: calc(100vh - 18px);\n    grid-template-columns: minmax(0, 0.27fr) minmax(0, 0.73fr);\n    grid-template-rows: 40px minmax(350px, 52vh) minmax(270px, auto);\n  }\n  #battleLayout > #battleArena { padding: 14px clamp(16px, 4vw, 45px); gap: clamp(12px, 3vw, 35px); }\n  #battleLayout > #battleArena > #opponentSection,\n  #battleLayout > #battleArena > #characterSection { max-width: 420px; }\n  #battleLayout .solo-fighter-art img { max-width: min(100%, 300px); }\n}\n@media (max-width: 700px) {\n  #battleLayout {\n    height: auto;\n    min-height: calc(100vh - 18px);\n    grid-template-columns: minmax(0, 1fr);\n    grid-template-rows: 38px minmax(330px, 48vh) 125px minmax(280px, auto);\n    grid-template-areas:\n      \"header\"\n      \"arena\"\n      \"log\"\n      \"attacks\";\n    gap: 8px;\n  }\n  .solo-battle-header { gap: 5px; }\n  .solo-battle-header h1 { font-size: 13px; letter-spacing: 1px; }\n  .solo-battle-header h1 span { display: block; margin: 2px 0 0; text-align: center; }\n  .solo-team-label { min-height: 27px; padding: 5px 4px; font-size: 8px; letter-spacing: 1px; }\n  #battleLayout > #battleArena { gap: 9px; padding: 10px 8px; }\n  #battleLayout > #battleArena > #opponentSection,\n  #battleLayout > #battleArena > #characterSection { max-width: none; gap: 7px; }\n  #battleLayout .solo-fighter-hud { padding: 7px; gap: 5px; }\n  .solo-fighter-name-row h2 { font-size: 11px; }\n  .solo-resource-row { grid-template-columns: 17px minmax(0, 1fr) auto; gap: 4px; font-size: 8px; }\n  .solo-resource-row b { min-width: 39px; font-size: 8px; }\n  .solo-segment-group { grid-template-columns: 1fr; gap: 4px; }\n  #battleLayout .solo-fighter-art img { max-width: 100%; }\n  #battleLayout > #combatLog { max-height: 125px; }\n  #battleLayout > #battleAttackPanel { min-height: 280px; }\n  #battleLayout .attack-card-wrapper { flex-basis: 145px; width: 145px; min-width: 145px; }\n  #battleLayout .solo-finish-turn-button { min-height: 35px; }\n  .battle-pause-trigger { top: 6px; right: 7px; min-width: 76px; min-height: 32px; padding: 5px 8px; font-size: 9px; }\n}\n@media (max-height: 720px) and (min-width: 701px) {\n  #battleLayout {\n    grid-template-rows: 36px minmax(290px, 1fr) minmax(245px, 34vh);\n    gap: 8px;\n  }\n  #battleLayout .solo-fighter-art img { max-width: min(100%, 290px); }\n  #battleLayout .solo-fighter-hud { padding: 7px 9px; gap: 4px; }\n  #battleLayout .attack-card .attack-image { height: 58px; }\n}\n/* ---------- Motion keyframes ---------- */\n@keyframes solo-damage-pop {\n  0% { opacity: 0; transform: translateY(24px) scale(.5); }\n  25% { opacity: 1; transform: translateY(-8px) scale(1.18); }\n  70% { opacity: 1; transform: translateY(-18px) scale(1); }\n  100% { opacity: 0; transform: translateY(-34px) scale(.92); }\n}\n@keyframes solo-damage-effective {\n  0% { opacity: 0; transform: scale(.45) rotate(-8deg); }\n  25% { opacity: 1; transform: scale(1.3) rotate(3deg); }\n  45% { transform: scale(1) rotate(-2deg); }\n  100% { opacity: 0; transform: translateY(-25px) scale(.92); }\n}\n@keyframes solo-damage-heavy {\n  0% { opacity: 0; transform: scale(.3); }\n  20% { opacity: 1; transform: scale(1.45); }\n  32% { transform: translateX(-7px) scale(1.2); }\n  44% { transform: translateX(7px) scale(1.1); }\n  56% { transform: translateX(-4px) scale(1.05); }\n  100% { opacity: 0; transform: translateY(-32px) scale(.95); }\n}\n@keyframes solo-damage-fatal {\n  0% { opacity: 0; transform: scale(.2); }\n  16% { opacity: 1; transform: scale(1.55); }\n  25% { transform: translateX(-12px) rotate(-3deg) scale(1.35); }\n  35% { transform: translateX(12px) rotate(3deg) scale(1.25); }\n  45% { transform: translateX(-9px) rotate(-2deg) scale(1.15); }\n  58% { transform: translateX(7px) rotate(1deg) scale(1.05); }\n  100% { opacity: 0; transform: translateY(-45px) scale(.9); }\n}\n@keyframes solo-status-pop {\n  0% { opacity: 0; transform: translateY(12px) scale(.85); }\n  20%, 75% { opacity: 1; transform: translateY(0) scale(1); }\n  100% { opacity: 0; transform: translateY(-8px) scale(.96); }\n}\n@keyframes solo-hit-flash {\n  0%, 100% { filter: none; }\n  18%, 55% { filter: drop-shadow(0 0 18px #ff3159) brightness(1.35) saturate(1.5); }\n}\n@keyframes solo-block-shake {\n  0%, 100% { transform: translateX(0); }\n  15%, 45%, 75% { transform: translateX(-5px); }\n  30%, 60%, 90% { transform: translateX(5px); }\n}\n@keyframes solo-evade-shift {\n  0% { opacity: 1; transform: translateX(0) skewX(0); }\n  35% { opacity: .65; transform: translateX(22px) skewX(-5deg); }\n  70% { opacity: .85; transform: translateX(-8px) skewX(2deg); }\n  100% { opacity: 1; transform: translateX(0) skewX(0); }\n}\n@keyframes solo-status-glow {\n  0%, 100% { filter: none; }\n  35%, 65% { filter: drop-shadow(0 0 18px #9dffbd) brightness(1.22); }\n}\n@keyframes solo-attacker-pulse {\n  0%, 100% { filter: none; }\n  40% { filter: drop-shadow(0 0 16px #20d9ff) brightness(1.18); }\n}\n@keyframes solo-stunned {\n  0%, 100% { transform: translateX(0) rotate(0); }\n  25% { transform: translateX(-3px) rotate(-1deg); }\n  75% { transform: translateX(3px) rotate(1deg); }\n}\n@keyframes solo-popup-rise {\n  0% { opacity: 0; transform: translateY(12px) scale(.92); }\n  15%, 75% { opacity: 1; transform: translateY(0) scale(1); }\n  100% { opacity: 0; transform: translateY(-12px) scale(.96); }\n}\n@keyframes solo-incoming-enter {\n  from { opacity: 0; transform: translate(-50%, -46%) scale(.96); }\n  to { opacity: 1; transform: translate(-50%, -50%) scale(1); }\n}\n@keyframes solo-warning-pulse {\n  from { opacity: .55; filter: brightness(.8); }\n  to { opacity: 1; filter: brightness(1.5); }\n}\n@keyframes solo-overlay-enter {\n  from { opacity: 0; transform: translateY(14px) scale(.97); }\n  to { opacity: 1; transform: translateY(0) scale(1); }\n}\n@keyframes solo-overlay-fade {\n  to { opacity: 0; visibility: hidden; }\n}\n@keyframes solo-ko-portrait {\n  from { opacity: 0; transform: translateY(25px) scale(.85); }\n  to { opacity: 1; transform: translateY(0) scale(1); }\n}\n@keyframes solo-screen-flash {\n  0% { opacity: .85; }\n  100% { opacity: 0; }\n}\n@media (prefers-reduced-motion: reduce) {\n  #battleLayout *,\n  #battleLayout *::before,\n  #battleLayout *::after,\n  #roundIntroOverlay *,\n  .battle-ko-overlay *,\n  .battle-finish-overlay * {\n    animation-duration: .01ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: .01ms !important;\n  }\n\n  /* Fighter movement is essential combat feedback, so preserve this one short lunge. */\n  #battleLayout .solo-fighter-art:has(.impact-attack) img {\n    animation: team-attack-lunge .24s cubic-bezier(.18,.9,.25,1) both !important;\n  }\n  #battleLayout .player-fighter-section .solo-fighter-art:has(.impact-attack) img {\n    animation-name: team-attack-lunge-left !important;\n  }\n}\n/* ---------- Remastered 1v1 result presentation ---------- */\n.wild-result-screen {\n  --result-accent: #13d5ff;\n  --result-glow: #13d5ff88;\n  position: fixed;\n  z-index: 10020;\n  inset: 0;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 10px;\n  overflow: auto;\n  padding: clamp(18px, 3vh, 34px);\n  color: #fff9e9;\n  text-align: center;\n  background: radial-gradient(ellipse at 50% 40%, #183326 0%, #0b1510 48%, #050a10 100%);\n  animation: wild-result-enter 500ms ease-out both;\n}\n.wild-result-screen.result-defeat { --result-accent: #ff3159; --result-glow: #ff315988; }\n.wild-result-flash { position: absolute; inset: 0; z-index: 0; pointer-events: none; background: var(--result-accent); animation: wild-result-flash 850ms ease-out both; }\n.wild-result-eyebrow,.wild-result-title,.wild-result-subtitle,.wild-result-matchup,.wild-result-stats,.wild-result-actions,.wild-result-footer { position: relative; z-index: 1; }\n.wild-result-eyebrow { margin: 0; color: var(--result-accent); font: 900 11px Oxanium, sans-serif; letter-spacing: .32em; }\n.wild-result-title { margin: 0; font: italic 1000 clamp(42px, 7vw, 88px)/.95 Oxanium, sans-serif; text-shadow: 0 0 14px var(--result-glow), 0 0 38px var(--result-glow); animation: wild-result-title 850ms cubic-bezier(.16,1,.3,1) both; }\n.wild-result-subtitle { margin: 0 0 8px; color: #d5e2d6; font: 800 11px Rajdhani, sans-serif; letter-spacing: .2em; }\n.wild-result-matchup { display: grid; grid-template-columns: minmax(0,1fr) 55px minmax(0,1fr); align-items: center; gap: clamp(8px,2vw,24px); width: min(920px,100%); }\n.wild-result-side { min-width: 0; }\n.wild-result-side-label { display: block; margin-bottom: 9px; color: var(--result-accent); font: 900 12px Oxanium,sans-serif; letter-spacing: .2em; }\n.wild-result-character { display: flex; flex-direction: column; align-items: center; min-width: 0; padding: 10px; border: 1px solid #ffffff30; border-radius: 16px; background: linear-gradient(150deg,#17271eeF,#09131beF); box-shadow: 0 12px 32px #0008; animation: wild-result-card-in 850ms cubic-bezier(.16,1,.3,1) both; }\n.wild-result-character img { display: block; width: min(100%,230px); height: clamp(145px,30vh,270px); object-fit: contain; filter: drop-shadow(0 0 16px var(--result-glow)); }\n.wild-result-character strong { margin-top: 7px; font: 900 clamp(12px,1.5vw,17px) Oxanium,sans-serif; overflow-wrap: anywhere; }\n.wild-result-character span { margin-top: 5px; color: var(--result-accent); font: 900 10px Rajdhani,sans-serif; letter-spacing: .12em; }\n.wild-result-defeated .wild-result-character { filter: grayscale(1); opacity: .72; animation-delay: 180ms; }\n.wild-result-defeated .wild-result-character img { filter: grayscale(1) brightness(.72); }\n.wild-result-winner .wild-result-character { border-color: var(--result-accent); box-shadow: 0 0 24px var(--result-glow),0 12px 32px #0008; animation-delay: 420ms; }\n.wild-result-divider { color: #fff; font: italic 1000 25px Oxanium,sans-serif; text-shadow: 0 0 15px var(--result-glow); }\n.wild-result-stats { display: grid; grid-template-columns: repeat(7,minmax(0,1fr)); gap: 8px; width: min(920px,100%); margin-top: 4px; }\n.wild-result-stats > div { display: flex; flex-direction: column; gap: 4px; padding: 9px 6px; border: 1px solid #ffffff22; border-radius: 9px; background: #0d1a17d9; }\n.wild-result-stats span { color: #a9b9ad; font: 800 9px Rajdhani,sans-serif; letter-spacing: .1em; }\n.wild-result-stats strong { color: #fff; font: 900 16px Oxanium,sans-serif; }\n.wild-result-stats .wild-result-score { border-color: var(--result-accent); box-shadow: inset 0 0 14px var(--result-glow); }\n.wild-result-score strong { color: var(--result-accent); }\n.wild-result-actions { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin-top: 6px; }\n.wild-result-actions button { min-width: 170px; padding: 12px 20px; border: 1px solid var(--result-accent); border-radius: 10px; color: #071019; background: linear-gradient(135deg,#fff18a,#e6b82e); box-shadow: 0 0 16px #f6d84a55; font: 1000 12px Oxanium,sans-serif; letter-spacing: .1em; cursor: pointer; transition: transform .18s ease,filter .18s ease,box-shadow .18s ease; }\n.wild-result-actions button:hover { transform: translateY(-3px); filter: brightness(1.12); box-shadow: 0 0 24px var(--result-glow); }\n.wild-result-actions .wild-result-menu { color: #e9f6ff; background: linear-gradient(135deg,#1c4560,#102338); border-color: #36cfff; }\n.wild-result-footer { margin: 0; color: #8b9a91; font: 800 9px Rajdhani,sans-serif; letter-spacing: .25em; }\n.wild-result-particles { position: absolute; inset: 0; overflow: hidden; pointer-events: none; }\n.wild-result-particles i { position: absolute; top: -12%; left: calc(var(--particle,1) * 8%); width: 7px; height: 18px; border-radius: 2px; background: var(--result-accent); opacity: .7; animation: wild-result-confetti 3.8s linear infinite; }\n.wild-result-particles i:nth-child(2n) { background: #f6d84a; animation-delay: -.8s; }\n.wild-result-particles i:nth-child(3n) { background: #fff; animation-delay: -1.6s; }\n.wild-result-particles i:nth-child(1) { left: 7%; }\n.wild-result-particles i:nth-child(2) { left: 16%; }\n.wild-result-particles i:nth-child(3) { left: 25%; }\n.wild-result-particles i:nth-child(4) { left: 34%; }\n.wild-result-particles i:nth-child(5) { left: 43%; }\n.wild-result-particles i:nth-child(6) { left: 52%; }\n.wild-result-particles i:nth-child(7) { left: 61%; }\n.wild-result-particles i:nth-child(8) { left: 70%; }\n.wild-result-particles i:nth-child(9) { left: 79%; }\n.wild-result-particles i:nth-child(10) { left: 88%; }\n.wild-result-particles i:nth-child(11) { left: 94%; }\n.wild-result-particles i:nth-child(12) { left: 4%; }\n@keyframes wild-result-enter { from { opacity:0; } to { opacity:1; } }\n@keyframes wild-result-flash { 0% { opacity:.55; } 100% { opacity:0; } }\n@keyframes wild-result-title { 0% { opacity:0; transform:scale(1.6) rotate(-5deg); } 70% { opacity:1; transform:scale(.96) rotate(1deg); } 100% { opacity:1; transform:scale(1); } }\n@keyframes wild-result-card-in { from { opacity:0; transform:translateY(45px) scale(.8); } 75% { opacity:1; transform:translateY(-5px) scale(1.03); } to { opacity:1; transform:translateY(0) scale(1); } }\n@keyframes wild-result-confetti { 0% { transform:translateY(-10vh) rotate(0); } 100% { transform:translateY(115vh) rotate(540deg); } }\n@media(max-width:650px) { .wild-result-screen { justify-content:flex-start; padding-top:55px; } .wild-result-matchup { grid-template-columns:minmax(0,1fr) 28px minmax(0,1fr); gap:5px; } .wild-result-character { padding:6px; } .wild-result-character img { height:clamp(115px,24vh,190px); } .wild-result-divider { font-size:16px; } .wild-result-stats { grid-template-columns:repeat(2,minmax(0,1fr)); } .wild-result-stats .wild-result-score { grid-column:1/-1; } .wild-result-actions { width:100%; } .wild-result-actions button { flex:1; min-width:130px; } }\n@media(prefers-reduced-motion:reduce) { .wild-result-screen *, .wild-result-screen *::before, .wild-result-screen *::after { animation-duration:.01ms!important; animation-iteration-count:1!important; transition-duration:.01ms!important; } }\n/* Shared top-right combat notifications, matching the team-battle presentation. */\n#combatPopupContainer { position:fixed; z-index:10001; top:18px; right:18px; left:auto; bottom:auto; display:flex; flex-direction:column; align-items:flex-end; gap:8px; width:min(390px,calc(100vw - 36px)); pointer-events:none; }\n#combatPopupContainer .combat-popup { width:fit-content; max-width:100%; padding:11px 15px; border:1px solid #20d9ff80; border-left:4px solid #20d9ff; border-radius:11px; color:#f4fbff; background:linear-gradient(145deg,#14283bF2,#091522F5); box-shadow:0 8px 24px #0009,0 0 18px #20d9ff24; font:900 11px Oxanium,sans-serif; letter-spacing:.04em; text-align:left; animation:teamCombatPopupEnter 2.5s ease both; }\n#combatPopupContainer .combat-popup.attack,#combatPopupContainer .combat-popup.hit { border-color:#ff526b; border-left-color:#ff3159; box-shadow:0 0 18px #ff315933; }\n#combatPopupContainer .combat-popup.blocked { border-color:#cbd5e1; border-left-color:#aab4c2; }\n#combatPopupContainer .combat-popup.evaded { border-color:#58dcff; border-left-color:#13d5ff; }\n#combatPopupContainer .combat-popup.buff { border-color:#45d995; border-left-color:#35d987; }\n#combatPopupContainer .combat-popup.debuff { border-color:#ff7187; border-left-color:#ff3159; }\n@keyframes teamCombatPopupEnter { 0% { opacity:0; transform:translateX(24px) scale(.96); } 12%,78% { opacity:1; transform:translateX(0) scale(1); } 100% { opacity:0; transform:translateX(18px) scale(.97); } }\n/* Keep all 1v1 attack details visible and give the cards the pause-menu finish. */\n#battleLayout > #battleAttackPanel { overflow:visible; }\n#battleLayout > #battleAttackPanel > #attackSection { min-height:0; overflow:visible; }\n#battleLayout #attack { min-height:0; overflow:visible; }\n#battleLayout #attackBody { min-height:0; overflow:visible; padding:8px 10px 12px; }\n#battleLayout #attackList { display:flex; flex:1 1 auto; flex-wrap:nowrap; align-items:stretch; gap:10px; min-width:0; min-height:0; overflow-x:auto; overflow-y:visible; padding:8px 5px 14px; }\n#battleLayout .attack-card-wrapper { position:relative; display:flex; flex:0 0 166px; width:166px; min-width:166px; min-height:240px; }\n#battleLayout .attack-card { display:flex; flex:1 1 auto; flex-direction:column; align-items:center; gap:6px; width:100%; min-width:0!important; min-height:240px; height:100%; padding:9px!important; overflow:visible; border:1px solid #20d9ff75!important; border-radius:13px!important; color:#f4f8ff!important; background:linear-gradient(155deg,#172b40,#091522 75%)!important; box-shadow:0 5px 16px #0007,inset 0 0 14px #20d9ff0d; font-family:Oxanium,sans-serif; text-align:center; white-space:normal; transition:transform .18s ease,border-color .18s ease,box-shadow .18s ease,filter .18s ease; }\n#battleLayout .attack-card:not(:disabled):hover { z-index:3; transform:translateY(-5px); border-color:#f6d84a!important; box-shadow:0 0 0 1px #f6d84a55,0 0 22px #f6d84a3b; filter:brightness(1.1); }\n#battleLayout .attack-card:disabled { opacity:.48; filter:saturate(.55); }\n#battleLayout .attack-card .attack-image { flex:0 0 86px; width:100%; height:86px; min-height:86px; object-fit:cover; border:1px solid #ffffff35; border-radius:8px; background:#020811; }\n#battleLayout .attack-card .attack-name { flex:0 0 auto; width:100%; color:#fff; font-size:11px; font-weight:900; line-height:1.2; }\n#battleLayout .attack-card .attack-damage { display:flex; justify-content:center; width:100%; padding:5px 4px; border:1px solid #ff315955; border-radius:6px; color:#ff8194; background:#ff31591c; font-size:9px; font-weight:900; }\n#battleLayout .attack-card .attack-speed { display:flex; justify-content:center; width:100%; padding:5px 4px; border:1px solid #13d5ff70; border-radius:6px; color:#66e7ff; background:#13d5ff14; font-size:9px; font-weight:900; }\n#battleLayout .attack-card .attack-cost { display:flex; flex-direction:column; align-items:center; gap:4px; width:100%; margin-top:auto; padding:6px 5px; border:1px solid #f6d84a55; border-radius:7px; color:#ffe58b; background:#f6d84a12; font-size:8px; font-weight:900; line-height:1.3; }\n#battleLayout .attack-card .attack-cost span { display:block; }\n#battleLayout .attack-card.attack-sacrifice { border-color:#ff3159!important; box-shadow:inset 0 0 16px #ff31591a; }\n#battleLayout .attack-card.attack-cooldown { border-color:#f6a43a!important; }\n#battleLayout .attack-card.attack-limited { border-color:#a5f51b!important; }\n#battleLayout .attack-card.attack-limited-cooldown { border-color:#f6a43a!important; }\n#battleLayout .attack-card-wrapper .attack-effects-popup { position:absolute; z-index:8; left:50%; bottom:calc(100% + 8px); display:none; width:max-content; max-width:min(240px,80vw); transform:translateX(-50%); padding:10px; border:1px solid #f6d84a88; border-radius:10px; color:#fff; background:linear-gradient(145deg,#1b2b35,#080f19); box-shadow:0 8px 25px #000b,0 0 16px #f6d84a25; }\n#battleLayout .attack-card-wrapper:hover .attack-effects-popup,#battleLayout .attack-card-wrapper:focus-within .attack-effects-popup { display:block; }\n#battleLayout .solo-combat-messages { display:none; }\n#battleLayout .solo-fighter-art .solo-impact-overlay { z-index:40; }\n#battleLayout .solo-fighter-art .solo-impact-overlay > span { font-size:clamp(11px,1.2vw,16px); padding:7px 13px; border-radius:8px; box-shadow:0 0 18px #000a,0 0 18px var(--effect-glow,#20d9ff55); }\n#battleLayout .solo-fighter-art.combat-effect-blocked img { animation:solo-block-shake .42s ease-in-out; }\n#battleLayout .solo-fighter-art.combat-effect-evaded img { animation:solo-evade-shift .55s ease-out; }\n#battleLayout .solo-fighter-art.combat-effect-damage img { animation:solo-hit-flash .65s ease-out; }\n#battleLayout .solo-fighter-art.combat-effect-status img { animation:solo-status-glow .8s ease-out; }\n#battleLayout .solo-fighter-art.combat-effect-attack img { animation:solo-attacker-pulse .48s ease-out; }\n#battleLayout .solo-fighter-art.fighter-stunned img { animation:solo-stunned .5s ease-in-out infinite; }\n#battleLayout .attack-card h5 { flex:0 0 auto; width:100%; margin:0; color:#fff; font:900 11px Oxanium,sans-serif; line-height:1.2; overflow-wrap:anywhere; }\n#battleLayout .attack-card .attack-stats { display:flex; flex-direction:column; flex:0 0 auto; gap:5px; width:100%; }\n#battleLayout .attack-card .attack-cost { flex:0 0 auto; }\n/* Shared result-screen layout: supports both solo fighters and full teams. */\n.wild-result-character-group {\n  display: flex;\n  align-items: stretch;\n  justify-content: center;\n  gap: clamp(6px, 1vw, 14px);\n  min-width: 0;\n}\n.wild-result-character-group .wild-result-character {\n  flex: 1 1 0;\n  min-width: 0;\n  max-width: 245px;\n}\n.wild-result-character-group .wild-result-character img {\n  width: 100%;\n  max-width: 230px;\n}\n.wild-result-defeated .wild-result-character-group .wild-result-character {\n  filter: grayscale(1);\n  opacity: .72;\n}\n.wild-result-defeat-atmosphere {\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  background:\n    radial-gradient(ellipse at 50% 80%, #ff31591c, transparent 55%),\n    linear-gradient(180deg, transparent 60%, #0008);\n  animation: wild-defeat-atmosphere 4s ease-in-out infinite alternate;\n}\n@keyframes wild-defeat-atmosphere {\n  from { opacity: .45; }\n  to { opacity: .9; }\n}\n@media(max-width:650px) {\n  .wild-result-character-group { flex-direction: column; align-items: center; }\n  .wild-result-character-group .wild-result-character { width: min(100%, 230px); }\n}\n/* Match the 2v2 impact language exactly in 1v1. */\n#battleLayout .solo-fighter-art:has(.impact-damage) img { animation: team-hit-flash 1.08s ease-out, team-hit-shake 1.02s ease-out; }\n#battleLayout .solo-fighter-art:has(.impact-blocked)::before {\n  content:\"🛡 BLOCKED\";\n  position:absolute;\n  z-index:35;\n  left:50%;\n  top:43%;\n  padding:6px 12px;\n  transform:translate(-50%,-50%);\n  border:1px solid #d9f2ff;\n  border-radius:7px;\n  color:#f5fbff;\n  background:linear-gradient(145deg,#34516aee,#101d2fee);\n  box-shadow:0 0 12px #9bdcff,inset 0 0 12px #d9f2ff55;\n  font:900 11px Oxanium,Arial,sans-serif;\n  letter-spacing:1px;\n  pointer-events:none;\n  animation:solo-shield-flash .72s ease-out both;\n}\n#battleLayout .solo-fighter-art:has(.impact-blocked) img { animation: team-block-pulse .58s ease-out; }\n#battleLayout .solo-fighter-art:has(.impact-evaded) img { animation: team-evade-dodge .52s ease-out; }\n#battleLayout .solo-fighter-art:has(.impact-attack) img { animation: team-attack-lunge .24s cubic-bezier(.18,.9,.25,1); }\n#battleLayout .solo-fighter-art:has(.damage-tier-fatal) img { animation: team-fatal-recoil 1.95s cubic-bezier(.15,.75,.2,1), team-hit-flash 1.08s ease-out; }\n#battleLayout .solo-fighter-art:has(.damage-tier-heavy) img { animation: team-heavy-recoil 1.4s ease-out, team-hit-flash 1.08s ease-out; }\n#battleLayout .solo-fighter-art:has(.impact-damage)::after {\n  content:\"\";\n  position:absolute;\n  z-index:8;\n  inset:5px;\n  border:3px solid transparent;\n  border-radius:12px;\n  background:conic-gradient(#ff3159,#ffb52e,#f7ed52,#5bff8a,#35eaff,#5574ff,#d45bff,#ff3159) border-box;\n  -webkit-mask:linear-gradient(#000 0 0) padding-box,linear-gradient(#000 0 0);\n  -webkit-mask-composite:xor;\n  mask-composite:exclude;\n  pointer-events:none;\n  animation:team-spectrum-ring 1.75s linear both;\n}\n@keyframes team-hit-flash {0%,100%{filter:brightness(1)}20%,55%{filter:brightness(1.8) sepia(1) saturate(5) hue-rotate(315deg)}}\n@keyframes team-hit-shake {0%,100%{transform:translateX(0)}20%,60%{transform:translateX(-5px)}40%,80%{transform:translateX(5px)}}\n@keyframes team-block-pulse {0%{filter:brightness(1)}35%{filter:brightness(1.8) drop-shadow(0 0 24px #b9e8ff)}100%{filter:brightness(1)}}\n@keyframes team-evade-dodge {0%,100%{transform:translateX(0);opacity:1}45%{transform:translateX(24px);opacity:.55}}\n@keyframes team-attack-lunge {0%,100%{transform:translateX(0) scale(1)}45%{transform:translateX(36px) scale(1.055)}}\n@keyframes team-fatal-recoil {0%{transform:translateY(0) rotate(0) scale(1)}18%{transform:translateY(-9px) rotate(-3deg) scale(1.04)}48%{transform:translateY(12px) rotate(5deg) scale(.97)}68%{transform:translateY(6px) rotate(-3deg)}100%{transform:translateY(0) rotate(0) scale(1)}}\n@keyframes team-heavy-recoil {0%,100%{transform:translateX(0)}25%{transform:translateX(-7px) rotate(-2deg)}50%{transform:translateX(6px) rotate(2deg)}75%{transform:translateX(-3px)}}\n@keyframes team-spectrum-ring {0%{opacity:0;transform:scale(.94) rotate(0)}25%{opacity:1}100%{opacity:0;transform:scale(1.04) rotate(360deg)}}\n/* Damage counters and status labels use the same timing and motion as 2v2. */\n#battleLayout .solo-damage-number {\n  font-size:clamp(22px,2.5vw,42px);\n  -webkit-text-stroke:1px #300b13;\n  text-shadow:0 3px 0 #26060b,0 0 12px #ff3159,0 0 26px #ff3159;\n  animation:team-impact-pop 1.7s cubic-bezier(.15,.8,.25,1) both;\n}\n#battleLayout .solo-damage-number.damage-tier-effective { color:#fff; animation:team-impact-effective 1.8s ease-out both; }\n#battleLayout .solo-damage-number.damage-tier-heavy { color:#ffe7a3; font-size:clamp(28px,3.2vw,50px); animation:team-impact-heavy 1.95s ease-out both; }\n#battleLayout .solo-damage-number.damage-tier-fatal { color:#fff; font-size:clamp(30px,3.8vw,58px); text-shadow:0 0 12px #ff3159,0 0 30px #ff3159,0 0 55px #ff3159; animation:team-impact-fatal 2.3s ease-out both; }\n#battleLayout .solo-impact-overlay > span { padding:4px 9px; border:1px solid #ffffff70; border-radius:5px; color:#fff; background:#07101be8; font-size:10px; font-weight:1000; letter-spacing:1px; animation:team-impact-label .8s ease-out both; }\n#battleLayout .solo-effect-label { top:18%; padding:4px 8px; border:0; border-radius:5px; color:#fff; background:#111d2bea; font-size:9px; font-weight:1000; animation:team-impact-status 1.05s ease-out both; }\n#battleLayout .solo-effect-label.effect-defense { color:#c2c9d3; }\n#battleLayout .solo-effect-label.effect-agility { color:#f4d35e; }\n#battleLayout .solo-effect-label.effect-mana,#battleLayout .solo-effect-label.effect-manaregen { color:#45d9ff; }\n#battleLayout .solo-effect-label.effect-health,#battleLayout .solo-effect-label.effect-maximumhealth { color:#ff7187; }\n#battleLayout .solo-effect-label.effect-stun { color:#c49aff; }\n@keyframes team-impact-pop {0%{opacity:0;transform:translateY(20px) scale(.5)}18%{opacity:1;transform:translateY(-5px) scale(1.18)}75%{opacity:1}100%{opacity:0;transform:translateY(-48px) scale(.95)}}\n@keyframes team-impact-effective {0%{opacity:0;transform:scale(.5)}18%{opacity:1;transform:scale(1.2)}30%,45%{transform:translateX(-3px) rotate(-2deg)}38%,53%{transform:translateX(3px) rotate(2deg)}100%{opacity:0;transform:translateY(-50px)}}\n@keyframes team-impact-heavy {0%{opacity:0;transform:scale(.35) rotate(-8deg)}18%{opacity:1;transform:scale(1.3) rotate(3deg)}28%,45%{transform:translateX(-7px)}36%,54%{transform:translateX(7px)}100%{opacity:0;transform:translateY(-58px)}}\n@keyframes team-impact-fatal {0%{opacity:0;transform:scale(.2) rotate(-12deg)}14%{opacity:1;transform:scale(1.45) rotate(3deg)}24%,42%,60%{transform:translateX(-10px) scale(1.1)}33%,51%,69%{transform:translateX(10px) scale(1.1)}100%{opacity:0;transform:translateY(-65px) scale(.85)}}\n@keyframes team-impact-label {0%{opacity:0;transform:scale(.6)}20%{opacity:1;transform:scale(1.1)}100%{opacity:0;transform:translateY(-18px)}}\n@keyframes team-impact-status {0%,100%{opacity:0;transform:translate(-50%,8px) scale(.85)}25%,70%{opacity:1;transform:translate(-50%,0) scale(1)}}\n#battleLayout .solo-fighter-art:has(.impact-attack) img { animation:team-attack-lunge .24s cubic-bezier(.18,.9,.25,1); }\n#battleLayout .player-fighter-section .solo-fighter-art:has(.impact-attack) img { animation-name:team-attack-lunge-left; }\n@keyframes team-attack-lunge-left {0%,100%{transform:translateX(0) scale(1)}45%{transform:translateX(-36px) scale(1.055)}}\n/* Prevent the older solo container animations from competing with the shared fighter animations. */\n#battleLayout .solo-fighter-art.combat-effect-damage,\n#battleLayout .solo-fighter-art.combat-effect-blocked,\n#battleLayout .solo-fighter-art.combat-effect-evaded,\n#battleLayout .solo-fighter-art.combat-effect-attack { animation:none !important; }\n#battleLayout .solo-fighter-art:has(.effect-defense) { filter:drop-shadow(0 0 13px #aeb7c4aa); }\n#battleLayout .solo-fighter-art:has(.effect-agility) { filter:drop-shadow(0 0 13px #ffe45baa); }\n#battleLayout .solo-fighter-art:has(.effect-manaRegen) { filter:drop-shadow(0 0 13px #35bfffaa); }\n#battleLayout .solo-fighter-art:has(.effect-stun) { filter:drop-shadow(0 0 16px #b56cffcc); }\n#battleLayout .solo-fighter-art:has(.impact-blocked) img {\n  transform-origin:center bottom;\n  animation:team-defensive-brace .38s cubic-bezier(.18,.9,.25,1) both;\n  filter:brightness(1.35) drop-shadow(0 0 13px #d9f2ff) drop-shadow(0 0 25px #73cfffaa);\n}\n@keyframes solo-shield-flash {\n  0% { opacity:0; filter:blur(3px); }\n  18%,62% { opacity:1; filter:blur(0); }\n  100% { opacity:0; }\n}\n@keyframes team-defensive-brace {\n  0%,100% { transform:translateY(0) rotate(0) scale(1); }\n  22% { transform:translateY(6px) rotate(-3deg) scale(.965); }\n  48% { transform:translateY(-2px) rotate(1deg) scale(1.025); }\n  70% { transform:translateY(1px) scale(.99); }\n}\n/* Round intro: preserve the classic face-off entrance and KO state. */\n#roundIntroContent .battle-intro-opponent img {\n  animation: intro-slide-opponent 720ms cubic-bezier(.18,.82,.22,1) both;\n}\n#roundIntroContent .battle-intro-player img {\n  animation: intro-slide-player 720ms cubic-bezier(.18,.82,.22,1) both;\n}\n#roundIntroContent .battle-intro-opponent .battle-intro-healthbar,\n#roundIntroContent .battle-intro-opponent .battle-intro-hp,\n#roundIntroContent .battle-intro-player .battle-intro-healthbar,\n#roundIntroContent .battle-intro-player .battle-intro-hp {\n  animation: intro-health-reveal 900ms ease-out both;\n}\n#roundIntroContent .battle-intro-opponent:has(.battle-intro-healthbar-fill[style*=\"width: 0%\"]) img,\n#roundIntroContent .battle-intro-player:has(.battle-intro-healthbar-fill[style*=\"width: 0%\"]) img {\n  filter: grayscale(1) brightness(.58) drop-shadow(0 0 12px #ff315966);\n}\n@keyframes intro-slide-opponent {\n  from { opacity:0; transform:translateX(-85px) scale(.9); }\n  to { opacity:1; transform:translateX(0) scale(1); }\n}\n@keyframes intro-slide-player {\n  from { opacity:0; transform:translateX(85px) scale(.9); }\n  to { opacity:1; transform:translateX(0) scale(1); }\n}\n@keyframes intro-health-reveal {\n  from { opacity:0; transform:scaleX(.35); }\n  to { opacity:1; transform:scaleX(1); }\n}\n/* Shared portrait lightning: same electric sweep in solo and team battles. */\n#battleLayout .solo-portrait-wrapper {\n  position:relative; display:flex; align-items:center; justify-content:center;\n  flex:1 1 auto; align-self:stretch; width:100%; height:100%;\n  min-width:0; min-height:140px; max-height:100%; overflow:hidden;\n  border-radius:12px; isolation:isolate;\n}\n#battleLayout .solo-portrait-wrapper > img { position:relative; z-index:1; max-width:100%; max-height:100%; }\n#battleLayout .solo-portrait-wrapper.fighter-stunned { animation:stunned-fighter-shake .35s infinite; }\n#battleLayout .solo-portrait-wrapper.fighter-stunned > img {\n  filter:drop-shadow(0 0 5px #13d5ff) drop-shadow(0 0 14px rgba(19,213,255,.9)) !important;\n  animation:stunned-electric-glow 1s ease-in-out infinite alternate !important;\n}\n#battleLayout .solo-portrait-wrapper.fighter-stunned::after {\n  content:\"\"; position:absolute; z-index:3; inset:0; border-radius:inherit;\n  pointer-events:none;\n  background:linear-gradient(110deg,transparent 25%,rgba(19,213,255,.1) 40%,rgba(255,255,255,.85) 50%,rgba(19,213,255,.35) 58%,transparent 75%);\n  background-size:250% 100%; animation:portrait-lightning-sweep 1.7s linear infinite;\n}\n@keyframes stunned-fighter-shake { 0%,100%{transform:translateX(0)} 25%{transform:translateX(-2px)} 75%{transform:translateX(2px)} }\n@keyframes stunned-electric-glow { from{filter:drop-shadow(0 0 5px #13d5ff) drop-shadow(0 0 10px rgba(19,213,255,.55))} to{filter:drop-shadow(0 0 8px #13d5ff) drop-shadow(0 0 16px rgba(19,213,255,.95))} }\n@keyframes portrait-lightning-sweep { from{background-position:100% 0} to{background-position:-150% 0} }\n@media(prefers-reduced-motion:reduce){#battleLayout .solo-portrait-wrapper.fighter-stunned,#battleLayout .solo-portrait-wrapper.fighter-stunned::after,#battleLayout .solo-portrait-wrapper.fighter-stunned > img{animation-duration:.01ms!important;animation-iteration-count:1!important}}\n/* Dramatic stun announcement: distinct from ordinary status popups. */\n#battleLayout .solo-impact-overlay > .solo-stunned-callout {\n  position:relative;\n  z-index:45;\n  padding:9px 20px;\n  border:2px solid #d7a8ff;\n  border-radius:9px;\n  color:#fff;\n  background:linear-gradient(135deg,#5a1b91f5,#170b2df5);\n  box-shadow:0 0 10px #c58aff,0 0 28px #a34dff, inset 0 0 14px #e6c4ff55;\n  font-family:Oxanium,Arial,sans-serif;\n  font-size:clamp(18px,2.4vw,32px);\n  font-weight:1000;\n  font-style:italic;\n  letter-spacing:.14em;\n  text-shadow:0 2px 0 #310b55,0 0 12px #fff;\n  animation:solo-stunned-hero 1.35s cubic-bezier(.16,1,.3,1) both;\n}\n@keyframes solo-stunned-hero {\n  0% { opacity:0; transform:translateY(28px) scale(.35) rotate(-8deg); filter:blur(5px); }\n  18% { opacity:1; transform:translateY(-5px) scale(1.2) rotate(2deg); filter:blur(0); }\n  32%,48% { transform:translateX(-4px) rotate(-2deg) scale(1.08); }\n  40%,56% { transform:translateX(4px) rotate(2deg) scale(1.08); }\n  78% { opacity:1; transform:translateY(-8px) scale(1); }\n  100% { opacity:0; transform:translateY(-36px) scale(.92); }\n}\n/* The pre-results winner/defeated face-off is intentionally a separate scene. */\n.battle-finish-overlay {\n  gap:clamp(8px,1.5vh,16px);\n  padding:clamp(16px,3vh,34px);\n}\n.battle-finish-versus {\n  width:min(1120px,94vw);\n  gap:clamp(12px,3vw,42px);\n}\n.battle-finish-side { flex:1 1 0; }\n.battle-finish-card {\n  width:min(100%,390px);\n  min-width:0;\n  min-height:clamp(260px,48vh,500px);\n  justify-content:flex-end;\n  padding:clamp(12px,2vw,24px);\n  border:1px solid #ffffff35;\n  border-radius:16px;\n  background:linear-gradient(155deg,#17263aee,#080e19f5);\n  box-shadow:0 12px 34px #0009,inset 0 0 24px #ffffff08;\n  overflow:hidden;\n}\n.battle-finish-card img {\n  width:100%;\n  height:clamp(210px,43vh,420px);\n  max-width:100%;\n  object-fit:contain;\n  object-position:center bottom;\n}\n.battle-finish-card strong { font-size:clamp(14px,1.7vw,21px); letter-spacing:.06em; }\n.battle-finish-card span { font-size:clamp(10px,1vw,13px); letter-spacing:.12em; }\n.battle-finish-card.is-defeated-card {\n  border-color:#aeb7c766;\n  background:linear-gradient(155deg,#242832f2,#0a0d13f7);\n  animation:finish-defeated-enter .9s cubic-bezier(.16,1,.3,1) both;\n}\n.battle-finish-card.is-defeated-card img {\n  filter:grayscale(1) brightness(.58) contrast(1.08);\n  animation:finish-defeated-image .9s .12s cubic-bezier(.16,1,.3,1) both;\n}\n.battle-finish-card.is-defeated-card strong,\n.battle-finish-card.is-defeated-card span { color:#aeb7c7; }\n.battle-finish-card.is-winning-card {\n  border-color:#a5ff1988;\n  box-shadow:0 0 24px #a5ff1928,0 12px 34px #0009,inset 0 0 24px #a5ff190c;\n  animation:finish-winner-enter .85s cubic-bezier(.16,1,.3,1) both;\n}\n.battle-finish-card.is-winning-card img {\n  filter:drop-shadow(0 0 18px #a5ff1966);\n}\n@keyframes finish-defeated-enter {\n  0% { opacity:0; transform:translateY(-35px) rotate(-3deg) scale(1.08); filter:grayscale(0); }\n  55% { opacity:1; transform:translateY(8px) rotate(1deg) scale(.98); }\n  75% { transform:translateY(-3px) rotate(0) scale(1.01); }\n  100% { opacity:1; transform:translateY(0) rotate(0) scale(1); }\n}\n@keyframes finish-defeated-image {\n  0% { filter:grayscale(0) brightness(1); }\n  45% { filter:grayscale(.45) brightness(.8); }\n  100% { filter:grayscale(1) brightness(.58) contrast(1.08); }\n}\n@keyframes finish-winner-enter {\n  0% { opacity:0; transform:translateY(35px) scale(.9); }\n  65% { opacity:1; transform:translateY(-5px) scale(1.025); }\n  100% { opacity:1; transform:translateY(0) scale(1); }\n}\n@media(max-width:620px) {\n  .battle-finish-versus { gap:7px; }\n  .battle-finish-card { min-height:clamp(190px,38vh,300px); padding:8px; }\n  .battle-finish-card img { height:clamp(145px,31vh,260px); }\n  .battle-finish-vs { font-size:12px; }\n}\n/* Persistent stun indicator: remains until every disabled move recovers. */\n#battleLayout .solo-stun-status,.team-battle .team-stun-status { position:absolute;z-index:14;left:50%;top:52%;display:flex;flex-direction:column;align-items:center;gap:3px;width:max-content;max-width:94%;padding:8px 13px;transform:translate(-50%,-50%);border:2px solid #d7a8ff;border-radius:8px;color:#fff;background:linear-gradient(135deg,#5a1b91ed,#170b2df0);box-shadow:0 0 12px #c58aff,0 0 26px #a34dff,inset 0 0 12px #e6c4ff55;text-align:center;pointer-events:none;animation:stun-status-enter .42s cubic-bezier(.16,1,.3,1) both; }\n#battleLayout .solo-stun-status strong,.team-battle .team-stun-status strong { font:1000 italic clamp(14px,1.8vw,22px) Oxanium,Arial,sans-serif;letter-spacing:.12em;text-shadow:0 0 10px #fff; }\n#battleLayout .solo-stun-status small,.team-battle .team-stun-status small { color:#ead7ff;font:900 8px Oxanium,Arial,sans-serif;letter-spacing:.1em;white-space:nowrap; }\n@keyframes stun-status-enter { from { opacity:0;transform:translate(-50%,-35%) scale(.65); } to { opacity:1;transform:translate(-50%,-50%) scale(1); } }\n#battleLayout .solo-stun-status small { animation:stun-count-fade 2.6s ease-out both; }\n@keyframes stun-count-fade { 0%,65% { opacity:1;transform:translateY(0); } 100% { opacity:0;transform:translateY(-7px); } }\n/* WILD CARDS — STORY MODE RESULTS PRESENTATION */\n#storyResultsScreen { position:fixed; inset:0; z-index:1500; display:grid; place-items:center; overflow:auto; padding:24px; background:radial-gradient(ellipse at 50% 22%,#24425a88,transparent 55%),linear-gradient(145deg,#070d18f5,#101c2df7 55%,#080d16f8); }\n#storyResultsScreen::before { content:\"\"; position:fixed; inset:0; pointer-events:none; opacity:.5; background:repeating-linear-gradient(135deg,transparent 0 34px,#ffffff05 35px 36px); }\n#storyResultsScreen .story-results-content { position:relative; width:min(720px,100%); padding:clamp(24px,4vw,42px); border:1px solid #d5bd5e; border-radius:22px 5px; background:linear-gradient(145deg,#1a3048f5,#0b1422f8); box-shadow:0 25px 80px #000c,0 0 0 5px #d5bd5e15,0 0 35px #13d5ff20,inset 0 1px 0 #fff2; text-align:center; animation:story-result-enter .65s cubic-bezier(.16,1,.3,1) both; }\n#storyResultsScreen .story-results-eyebrow { margin:0 0 10px; color:#13d5ff; font:900 .75rem Oxanium,sans-serif; letter-spacing:4px; }\n#storyResultsScreen .story-results-victory,#storyResultsScreen .story-results-defeat { margin:8px 0 12px; font:1000 clamp(2.8rem,9vw,5.5rem) Oxanium,sans-serif; letter-spacing:3px; line-height:1; }\n#storyResultsScreen .story-results-victory { color:#fff0a1; text-shadow:0 4px 0 #8b6720,0 0 22px #f5d56a88; }\n#storyResultsScreen .story-results-defeat { color:#ff7187; text-shadow:0 4px 0 #651d2b,0 0 22px #ff315988; }\n#storyResultsScreen .story-results-message { color:#d3dfed; font:700 clamp(1rem,2.4vw,1.3rem) Rajdhani,sans-serif; }\n#storyResultsScreen .story-results-stats { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; margin:26px 0 18px; }\n#storyResultsScreen .story-results-stats>div { display:grid; gap:7px; padding:17px 12px; border:1px solid #45647e; border-radius:10px 3px; background:linear-gradient(145deg,#142a40,#091522); box-shadow:inset 0 1px 0 #ffffff15; }\n#storyResultsScreen .story-results-stats span { color:#9eb9d2; font:900 .7rem Oxanium,sans-serif; letter-spacing:1.5px; }\n#storyResultsScreen .story-results-stats strong { color:#fff; font:1000 clamp(1.8rem,5vw,2.8rem) Oxanium,sans-serif; text-shadow:0 0 14px #13d5ff55; }\n#storyResultsScreen .story-results-completion { display:inline-block; margin:4px 0 22px; padding:9px 18px; color:#111827; background:linear-gradient(90deg,#fff0a1,#e5b938); border:1px solid #fff4b9; border-radius:5px; font:1000 .85rem Oxanium,sans-serif; letter-spacing:2px; box-shadow:0 0 18px #f5d56a44; }\n#storyResultsScreen .story-results-actions { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:10px; margin-top:22px; }\n#storyResultsScreen .story-results-actions button { min-height:48px; padding:10px; color:#f4f8ff; background:linear-gradient(180deg,#25435d,#14283d); border:1px solid #5c86a4; border-bottom:3px solid #091522; border-radius:8px 3px; box-shadow:inset 0 1px 0 #ffffff25,0 3px 0 #050b12; font:900 .76rem Oxanium,sans-serif; letter-spacing:.7px; cursor:pointer; transition:transform .14s,filter .14s,box-shadow .14s; }\n#storyResultsScreen .story-results-actions button:first-child { color:#111827; background:linear-gradient(180deg,#fff0a1,#e5b938); border-color:#fff0a1; border-bottom-color:#89651b; }\n#storyResultsScreen .story-results-actions button:last-child { background:linear-gradient(180deg,#853847,#4b1b2a); border-color:#e47c8a; border-bottom-color:#2a1019; }\n#storyResultsScreen .story-results-actions button:hover { transform:translateY(-2px); filter:brightness(1.15); box-shadow:0 5px 0 #050b12,0 0 18px #13d5ff55; }\n@keyframes story-result-enter { from { opacity:0; transform:translateY(28px) scale(.96); } to { opacity:1; transform:translateY(0) scale(1); } }\n@media(max-width:560px){#storyResultsScreen{padding:12px}#storyResultsScreen .story-results-content{padding:22px 14px}.story-results-actions{grid-template-columns:1fr!important}.story-results-stats{gap:8px!important}}\n/* 1V1 — EMPTY MATCH SETUP, CENTERED AND EXPLICIT */\n.battle-setup-error-screen {\n  position: fixed;\n  inset: 0;\n  z-index: 12000;\n  display: grid;\n  place-items: center;\n  min-height: 100vh;\n  padding: 24px;\n  color: #f4f8ff;\n  background:\n    radial-gradient(ellipse at 50% 42%,#1b344c 0%,transparent 52%),\n    linear-gradient(145deg,#070d18,#111b2b 55%,#070d18);\n}\n.battle-setup-error-card {\n  width: min(100%,520px);\n  margin: auto;\n  padding: clamp(26px,5vw,42px);\n  text-align: center;\n  border: 1px solid #e2c15e88;\n  border-radius: 18px 5px;\n  background: linear-gradient(145deg,#1b3047,#0a1220);\n  box-shadow: 0 24px 80px #000c,0 0 34px #e2c15e22,inset 0 1px 0 #ffffff18;\n}\n.battle-setup-error-icon {\n  width: 66px;\n  height: 66px;\n  display: grid;\n  place-items: center;\n  margin: 0 auto 18px;\n  border: 1px solid #e2c15e;\n  border-radius: 50%;\n  color: #ffe58a;\n  background: #111c2c;\n  font: 900 40px Oxanium,sans-serif;\n  box-shadow: 0 0 22px #e2c15e33;\n}\n.battle-setup-error-eyebrow {\n  margin: 0 0 8px;\n  color: #64ddff;\n  font: 900 .7rem Oxanium,sans-serif;\n  letter-spacing: 2.5px;\n}\n.battle-setup-error-card h1 {\n  margin: 0;\n  color: #f5d56a;\n  font: 900 clamp(1.6rem,5vw,2.25rem) Oxanium,sans-serif;\n}\n.battle-setup-error-card p:not(.battle-setup-error-eyebrow) {\n  max-width: 390px;\n  margin: 14px auto 24px;\n  color: #b9c8da;\n  font: 600 1rem Rajdhani,sans-serif;\n  line-height: 1.55;\n}\n.battle-setup-error-card button {\n  min-height: 48px;\n  padding: 12px 20px;\n  border: 1px solid #fff0a1;\n  border-bottom: 3px solid #80652c;\n  border-radius: 7px 3px;\n  color: #17202b;\n  background: linear-gradient(180deg,#fff0a1,#e5b938);\n  font: 900 .8rem Oxanium,sans-serif;\n  cursor: pointer;\n  transition: transform 160ms ease,filter 160ms ease;\n}\n.battle-setup-error-card button:hover { transform:translateY(-2px); filter:brightness(1.08); }\n/* Gentle idle motion: keep the HUD readable while making each fighter feel present. */\n#battleLayout .solo-fighter-hud {\n  animation: solo-hud-float 5.2s ease-in-out infinite;\n  will-change: transform;\n}\n#battleLayout #opponentSection .solo-fighter-hud { animation-delay: -2.6s; }\n#battleLayout .solo-portrait-wrapper > img {\n  transform-origin: center bottom;\n  animation: solo-fighter-idle 3.8s ease-in-out infinite;\n  will-change: transform;\n}\n#battleLayout .solo-hud-pointer {\n  position: relative;\n  z-index: 7;\n  align-self: center;\n  width: 0;\n  height: 0;\n  margin: -1px 0 -2px;\n  border-top: 9px solid #8deeff;\n  border-right: 8px solid transparent;\n  border-left: 8px solid transparent;\n  filter: drop-shadow(0 2px 3px #000b) drop-shadow(0 0 5px #20d9ff88);\n  animation: solo-hud-float 5.2s ease-in-out infinite;\n  pointer-events: none;\n}\n#battleLayout #opponentSection .solo-hud-pointer {\n  border-top-color: #ff8193;\n  filter: drop-shadow(0 2px 3px #000b) drop-shadow(0 0 5px #ff315988);\n  animation-delay: -2.6s;\n}\n@keyframes solo-hud-float {\n  0%, 100% { transform: translateY(0); }\n  50% { transform: translateY(-4px); }\n}\n@keyframes solo-fighter-idle {\n  0%, 100% { transform: translateY(0) scale(1); }\n  50% { transform: translateY(-5px) scale(1.008); }\n}\n@media (prefers-reduced-motion: reduce) {\n  #battleLayout .solo-fighter-hud,\n  #battleLayout .solo-portrait-wrapper > img { animation: none !important; }\n}\n/* Compact 1v1 attack cards so cost details fit inside the fixed battle viewport. */\n@media (min-width: 701px) {\n  #battleLayout #attackBody { padding: 5px 8px 7px; }\n  #battleLayout #attackList { padding: 3px 4px 6px; gap: 8px; }\n  #battleLayout .attack-card-wrapper { min-height: 0; }\n  #battleLayout .attack-card {\n    min-height: 0;\n    height: 100%;\n    gap: 3px;\n    padding: 6px !important;\n  }\n  #battleLayout .attack-card .attack-image,\n  #battleLayout .attack-card [id^=\"attackImage\"] {\n    height: clamp(42px, 7vh, 66px);\n    max-height: 66px;\n    margin-bottom: 0;\n  }\n  #battleLayout .attack-card h5,\n  #battleLayout .attack-card [id^=\"attackName\"] { margin: 0 0 2px; }\n  #battleLayout .attack-stats { gap: 2px; }\n  #battleLayout .attack-damage,\n  #battleLayout .attack-speed { padding: 3px 2px; }\n  #battleLayout .attack-cost { gap: 2px; margin-top: 1px; }\n  #battleLayout .attack-stats span,\n  #battleLayout .attack-cost span { font-size: 8px; line-height: 1.15; }\n}\n/* Good-hit prismatic wash: only effective hits (20+ damage) tint the fighter artwork. */\n#battleLayout .solo-fighter-art:has(.damage-tier-effective) .solo-portrait-wrapper::before {\n  content:\"\";\n  position:absolute;\n  z-index:2;\n  inset:0;\n  pointer-events:none;\n  background:linear-gradient(115deg,\n    #ff315966 0%,\n    #ffb52e66 18%,\n    #f7ed5266 34%,\n    #5bff8a66 50%,\n    #35eaff66 66%,\n    #5574ff66 82%,\n    #d45bff66 100%);\n  background-size:250% 100%;\n  mix-blend-mode:screen;\n  opacity:0;\n  animation:solo-prismatic-image-hit .9s ease-out both;\n}\n@keyframes solo-prismatic-image-hit {\n  0% { opacity:0; background-position:0% 50%; }\n  22% { opacity:.72; }\n  100% { opacity:0; background-position:100% 50%; }\n}\n/* Shorter impact feedback and restorative visuals. */\n.solo-damage-number { animation-duration:1.18s !important; }\n.solo-damage-number.damage-tier-effective { animation-duration:.86s !important; }\n.solo-damage-number.damage-tier-heavy,.solo-damage-number.damage-tier-fatal { animation-duration:.95s !important; }\n.solo-impact-overlay > span,.solo-effect-label { animation-duration:.82s !important; }\n#battleLayout .combat-effect-damage,#battleLayout .combat-effect-blocked,#battleLayout .combat-effect-evaded,#battleLayout .combat-effect-status,#battleLayout .combat-effect-attack { animation-duration:.72s !important; }\n#battleLayout .combat-effect-heal { animation:solo-heal-glow .82s ease-out both !important; }\n.solo-impact-overlay.impact-heal .solo-damage-number { color:#9dffbf; text-shadow:0 0 8px #37ff86,0 0 25px #19d66b; }\n.solo-impact-overlay.impact-debuff-drain .solo-damage-number { color:#ff9b70; text-shadow:0 0 10px #ff642e,0 0 25px #ff3159; }\n@keyframes solo-heal-glow {0%,100%{filter:brightness(1)}25%,65%{filter:brightness(1.8) drop-shadow(0 0 22px #42ff91)}}\n/* A compact 120 x 190 durability-drain overlay, clipped to the portrait itself. */\n.durability-drain-visual {\n  position:absolute;\n  z-index:7;\n  width:min(120px,100%);\n  height:min(190px,100%);\n  left:50%;\n  top:50%;\n  transform:translate(-50%,-50%);\n  overflow:hidden;\n  pointer-events:none;\n  border-radius:5px;\n  background:\n    linear-gradient(180deg,transparent 0%,#ff8a3d18 28%,#ff4b2b72 72%,#160a0c66 100%),\n    repeating-linear-gradient(0deg,transparent 0 12px,#ffd28b32 13px 14px);\n  box-shadow:inset 0 0 16px #ff632d88;\n  clip-path:inset(0 0 0 0);\n  animation:durability-drain-collapse .5s cubic-bezier(.55,.05,.8,.45) both;\n}\n.durability-drain-visual::before {\n  content:\"\";\n  position:absolute;\n  inset:0;\n  background:linear-gradient(105deg,transparent 0 30%,#ffe2a5 43%,#ff6b32 51%,#7d1b24 60%,transparent 72%);\n  transform:translateX(-110%);\n  animation:durability-drain-sweep .5s ease-in both;\n}\n.durability-drain-visual i {\n  position:absolute;\n  left:8%;\n  width:84%;\n  height:2px;\n  background:#ffe1a1;\n  box-shadow:0 0 8px #ff5a29;\n  animation:durability-drain-crack .5s ease-out both;\n}\n.durability-drain-visual i:nth-child(1){top:30%;animation-delay:0ms}\n.durability-drain-visual i:nth-child(2){top:52%;animation-delay:55ms}\n.durability-drain-visual i:nth-child(3){top:74%;animation-delay:110ms}\n@keyframes durability-drain-collapse {\n  0%{opacity:0;clip-path:inset(0 0 0 0)}\n  18%{opacity:1}\n  65%{opacity:.92;clip-path:inset(0 0 35% 0)}\n  100%{opacity:0;clip-path:inset(0 0 100% 0)}\n}\n@keyframes durability-drain-sweep {\n  0%{transform:translateX(-110%);opacity:0}\n  22%{opacity:1}\n  100%{transform:translateX(110%);opacity:0}\n}\n@keyframes durability-drain-crack {\n  0%{opacity:0;transform:scaleX(.1)}\n  35%{opacity:1;transform:scaleX(1)}\n  100%{opacity:0;transform:translateX(8px) scaleX(.3)}\n}\n/* Character portrait card: the frame stays fixed while only the artwork drifts gently. */\n#battleLayout .solo-portrait-wrapper {\n  position:relative;\n  flex:0 1 190px;\n  width:min(120px,100%);\n  height:min(190px,100%);\n  min-height:140px;\n  max-width:120px;\n  max-height:190px;\n  align-self:center;\n  margin-inline:auto;\n  overflow:hidden;\n  box-sizing:border-box;\n  border:1px solid color-mix(in srgb,var(--fighter-accent) 62%,#ffffff 8%);\n  border-radius:10px;\n  background:linear-gradient(155deg,#17263b 0%,#0a1220 70%,#070d17 100%);\n  box-shadow:0 7px 18px #0009,inset 0 0 0 2px #ffffff08,inset 0 0 18px color-mix(in srgb,var(--fighter-accent) 13%,transparent);\n}\n#battleLayout .solo-portrait-wrapper > img {\n  display:block;\n  width:100%;\n  height:100%;\n  max-width:100%;\n  max-height:100%;\n  object-fit:contain;\n  object-position:center bottom;\n  transform-origin:center bottom;\n  animation:solo-fighter-card-idle 6.8s ease-in-out infinite;\n}\n#battleLayout .solo-portrait-wrapper.fighter-stunned > img {\n  animation:stunned-electric-glow 1s ease-in-out infinite alternate !important;\n}\n@keyframes solo-fighter-card-idle {\n  0%,100% { transform:translateY(0) scale(1); }\n  50% { transform:translateY(-1.5px) scale(1.004); }\n}\n/* Restore the large portrait-card scale from the original battle layout.\n   The card owns the frame; the artwork fills the card instead of shrinking inside it. */\n#battleLayout .solo-portrait-wrapper {\n  position:relative;\n  display:block;\n  flex:0 0 auto;\n  align-self:center;\n  width:clamp(205px,19vw,250px);\n  height:clamp(300px,36vh,380px);\n  min-width:0;\n  min-height:0;\n  max-width:min(250px,100%);\n  max-height:100%;\n  margin-inline:auto;\n  overflow:hidden;\n  box-sizing:border-box;\n  border:1px solid color-mix(in srgb,var(--fighter-accent) 70%,#ffffff 12%);\n  border-radius:11px;\n  background:#091321;\n  box-shadow:0 8px 22px #0009,0 0 12px color-mix(in srgb,var(--fighter-accent) 20%,transparent),inset 0 0 0 1px #ffffff12;\n}\n#battleLayout .solo-portrait-wrapper > img {\n  position:relative;\n  z-index:1;\n  display:block;\n  width:100%;\n  height:100%;\n  max-width:none;\n  max-height:none;\n  object-fit:cover;\n  object-position:center center;\n  border:0;\n  border-radius:0;\n  background:transparent;\n  transform-origin:center center;\n  animation:solo-fighter-card-idle 6.8s ease-in-out infinite;\n}\n#battleLayout .solo-fighter-art:hover .solo-portrait-wrapper > img,\n#battleLayout .solo-fighter-art:focus-visible .solo-portrait-wrapper > img {\n  transform:scale(1.01);\n}\n#battleLayout .solo-portrait-wrapper.fighter-stunned > img {\n  animation:stunned-electric-glow 1s ease-in-out infinite alternate !important;\n}\n#battleLayout .solo-portrait-wrapper .durability-drain-visual {\n  width:100%;\n  height:100%;\n  border-radius:inherit;\n}\n#battleLayout .solo-fighter-art { align-items:center; }\n@media (max-height:720px) and (min-width:701px) {\n  #battleLayout .solo-portrait-wrapper { width:clamp(190px,17vw,225px); height:min(34vh,310px); }\n}\n@media (max-width:700px) {\n  #battleLayout .solo-portrait-wrapper { width:min(42vw,205px); height:clamp(245px,34vh,310px); }\n}\n/* Fit every attack detail inside the actual attack-options viewport. */\n#battleLayout > #battleAttackPanel {\n  display:flex;\n  flex-direction:column;\n  min-height:0;\n  overflow:hidden;\n}\n#battleLayout > #battleAttackPanel > #attackSection,\n#battleLayout #attack,\n#battleLayout #attackBody {\n  display:flex;\n  flex:1 1 auto;\n  flex-direction:column;\n  min-height:0;\n  overflow:hidden;\n}\n#battleLayout #attackBody { padding:5px 8px 4px; }\n#battleLayout #attackList {\n  flex:1 1 auto;\n  align-items:stretch;\n  height:auto;\n  min-height:0;\n  padding:4px 4px 7px;\n  gap:8px;\n  overflow-x:auto;\n  overflow-y:hidden;\n}\n#battleLayout .attack-card-wrapper {\n  flex:0 0 145px;\n  width:145px;\n  min-width:145px;\n  min-height:0;\n  height:100%;\n}\n#battleLayout .attack-card {\n  box-sizing:border-box;\n  justify-content:flex-start;\n  align-items:stretch;\n  gap:3px;\n  min-height:0;\n  height:100%;\n  padding:6px !important;\n  overflow:hidden;\n  border-radius:10px !important;\n  white-space:normal;\n}\n#battleLayout .attack-card .attack-image,\n#battleLayout .attack-card [id^=\"attackImage\"] {\n  flex:0 0 52px;\n  width:100%;\n  height:52px;\n  min-height:52px;\n  max-height:52px;\n  margin:0;\n  object-fit:cover;\n}\n#battleLayout .attack-card h5,\n#battleLayout .attack-card [id^=\"attackName\"] {\n  display:-webkit-box;\n  flex:0 0 auto;\n  min-height:24px;\n  max-height:24px;\n  margin:1px 0;\n  overflow:hidden;\n  -webkit-box-orient:vertical;\n  -webkit-line-clamp:2;\n  font-size:9px;\n  line-height:1.15;\n}\n#battleLayout .attack-card .attack-stats {\n  display:flex;\n  flex:0 0 auto;\n  flex-direction:column;\n  gap:3px;\n  width:100%;\n}\n#battleLayout .attack-card .attack-damage,\n#battleLayout .attack-card .attack-speed {\n  display:flex;\n  flex:0 0 auto;\n  justify-content:center;\n  min-height:17px;\n  padding:3px 2px;\n  border-radius:5px;\n  font-size:8px;\n  line-height:1.1;\n}\n#battleLayout .attack-card .attack-cost {\n  display:flex;\n  flex:0 0 auto;\n  flex-direction:column;\n  gap:2px;\n  width:100%;\n  margin-top:auto;\n  padding:4px 3px;\n  border-radius:5px;\n  font-size:7px;\n  line-height:1.15;\n  overflow-wrap:anywhere;\n}\n#battleLayout .attack-card .attack-cost span {\n  display:block;\n  font-size:7px;\n  line-height:1.15;\n}\n#battleLayout .attack-card-wrapper .attack-effects-popup { z-index:20; }\n@media (max-width:700px) {\n  #battleLayout .attack-card-wrapper { flex-basis:138px; width:138px; min-width:138px; }\n  #battleLayout .attack-card .attack-image { flex-basis:48px; height:48px; min-height:48px; }\n}\n/* Defensive callouts must remain fully inside the large portrait card. */\n#battleLayout .solo-fighter-art:has(.impact-blocked)::before,\n#battleLayout .solo-fighter-art:has(.impact-evaded)::before {\n  position:absolute;\n  z-index:45;\n  left:50%;\n  top:50%;\n  width:max-content;\n  max-width:calc(100% - 18px);\n  box-sizing:border-box;\n  padding:7px 11px;\n  transform:translate(-50%,-50%);\n  white-space:nowrap;\n  text-align:center;\n  font-size:clamp(10px,1vw,13px);\n  letter-spacing:.06em;\n}\n#battleLayout .solo-fighter-art:has(.impact-evaded)::before {\n  content:\"💨 EVADED\";\n  border:1px solid #78eaff;\n  border-radius:7px;\n  color:#e9fbff;\n  background:linear-gradient(145deg,#174d62ee,#101d2fee);\n  box-shadow:0 0 12px #58dcff,inset 0 0 12px #d9f2ff33;\n  animation:solo-shield-flash 1.05s ease-out both;\n}\n#battleLayout .solo-fighter-art:has(.impact-blocked)::before {\n  animation:solo-shield-flash 1.05s ease-out both;\n}\n#battleLayout .solo-impact-overlay > span { animation-duration:1.9s; }\n#battleLayout .solo-effect-label { animation-duration:2.1s; }\n/* Keep the solo portrait attached to its full fighter card during attack/evade. */\n#battleLayout .solo-fighter-art:has(.impact-attack) {\n  animation:solo-card-attack-lunge .24s cubic-bezier(.18,.9,.25,1) both !important;\n}\n#battleLayout .player-fighter-section .solo-fighter-art:has(.impact-attack) {\n  animation-name:solo-card-attack-lunge-left !important;\n}\n#battleLayout .solo-fighter-art:has(.impact-attack) img,\n#battleLayout .solo-fighter-art:has(.impact-attack) .solo-portrait-wrapper {\n  animation:none !important;\n  transform:none !important;\n}\n#battleLayout .solo-fighter-art:has(.impact-evaded) {\n  animation:solo-card-evade-dodge .52s cubic-bezier(.2,.75,.25,1) both !important;\n}\n#battleLayout .solo-fighter-art:has(.impact-evaded) img,\n#battleLayout .solo-fighter-art:has(.impact-evaded) .solo-portrait-wrapper {\n  animation:none !important;\n  transform:none !important;\n}\n@keyframes solo-card-attack-lunge {\n  0%,100% { transform:translateX(0) scale(1); }\n  45% { transform:translateX(36px) scale(1.035); }\n}\n@keyframes solo-card-attack-lunge-left {\n  0%,100% { transform:translateX(0) scale(1); }\n  45% { transform:translateX(-36px) scale(1.035); }\n}\n@keyframes solo-card-evade-dodge {\n  0%,100% { transform:translateX(0) scale(1); }\n  42% { transform:translateX(24px) scale(.985); }\n  68% { transform:translateX(17px) scale(.99); }\n}\n"],["STYLE",{},"\n.festival-completion-popup {\n  display: flex;\n  align-items: center;\n  gap: 16px;\n  padding: 18px 22px;\n  background: linear-gradient(135deg, #171b29, #252b3b);\n  border: 1px solid #13d5ff;\n  border-left: 5px solid #13d5ff;\n  border-radius: 10px;\n  box-shadow:\n    0 0 12px rgba(19, 213, 255, 0.35),\n    0 8px 25px rgba(0, 0, 0, 0.5);\n}\n\n.festival-completion-icon {\n  font-size: 36px;\n  min-width: 45px;\n  text-align: center;\n  filter: drop-shadow(0 0 7px rgba(19, 213, 255, 0.5));\n}\n\n.festival-completion-content {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.festival-completion-label {\n  color: #13d5ff;\n  font-size: 10px;\n  font-weight: 900;\n  letter-spacing: 2px;\n}\n\n.festival-completion-content h3 {\n  margin: 0;\n  color: white;\n  font-size: 18px;\n  font-weight: 900;\n  text-transform: uppercase;\n}\n\n.festival-completion-content p {\n  margin: 0;\n  color: #c3c9d5;\n  font-size: 12px;\n}\n\n.festival-completion-points {\n  margin-top: 5px;\n  color: #ffe16b;\n  font-size: 12px;\n  font-weight: 900;\n  letter-spacing: 1px;\n}\n\n@keyframes festival-popup-enter {\n  from {\n    opacity: 0;\n    transform: translate(-50%, -20px) scale(0.95);\n  }\n\n  to {\n    opacity: 1;\n    transform: translate(-50%, 0) scale(1);\n  }\n}\n\n.festival-completion-container {\n  position: fixed;\n  top: 100px;\n  left: 50%;\n  transform: translateX(-50%);\n  z-index: 100000;\n  width: min(420px, calc(100vw - 30px));\n  pointer-events: none;\n  animation: festival-popup-enter 0.4s ease-out;\n  transition:\n    opacity 0.5s ease,\n    transform 0.5s ease;\n}\n\n.festival-completion-container.festival-popup-exit {\n  opacity: 0;\n  transform: translate(-50%, -20px);\n}"],["STYLE",{},"/* Shared round-intro screen. This is the former 2v2 intro design,\n   now used by both solo and team battles. */\n.round-intro {\n  position: fixed;\n  inset: 0;\n  z-index: 10000;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 18px;\n  padding: 24px;\n  overflow: hidden;\n  color: #fff;\n  text-align: center;\n  background:\n    radial-gradient(ellipse at 20% 50%, rgba(255, 49, 89, .22), transparent 45%),\n    radial-gradient(ellipse at 80% 50%, rgba(19, 213, 255, .20), transparent 45%),\n    rgba(3, 7, 17, .97);\n  opacity: 0;\n  visibility: hidden;\n  transition: opacity .6s ease, visibility 0s linear .6s;\n}\n.round-intro.is-visible {\n  opacity: 1;\n  visibility: visible;\n  transition: opacity .45s ease-out, visibility 0s linear 0s;\n}\n.round-intro.is-hiding {\n  opacity: 0;\n  visibility: visible;\n  pointer-events: none;\n  transition: opacity .6s ease, visibility 0s linear 0s;\n}\n.round-intro__eyebrow {\n  color: #a9b7ca;\n  font-size: .8rem;\n  font-weight: 800;\n  letter-spacing: .35em;\n}\n.round-intro__round {\n  margin: 0;\n  font-size: clamp(2rem, 5vw, 4rem);\n  font-weight: 1000;\n  font-style: italic;\n  letter-spacing: .08em;\n  text-shadow: 0 0 24px rgba(255,255,255,.2);\n}\n.round-intro__matchup {\n  width: min(1100px, 100%);\n  display: grid;\n  grid-template-columns: minmax(0,1fr) auto minmax(0,1fr);\n  align-items: center;\n  gap: clamp(12px,3vw,40px);\n}\n.round-intro__team { min-width: 0; }\n.round-intro__label {\n  margin-bottom: 14px;\n  font-size: .85rem;\n  font-weight: 900;\n  letter-spacing: .16em;\n}\n.round-intro__team--cpu .round-intro__label { color: #ff3159; }\n.round-intro__team--player .round-intro__label { color: #13d5ff; }\n.round-intro__fighters {\n  display: flex;\n  justify-content: center;\n  gap: clamp(8px,2vw,22px);\n}\n.round-intro__fighter {\n  flex: 1;\n  min-width: 0;\n  max-width: 190px;\n  animation: roundIntroFighterIn .65s ease-out both;\n  animation-delay: calc(var(--fighter-index, 0) * 90ms);\n}\n.round-intro__team--player .round-intro__fighter {\n  animation-name: roundIntroFighterInRight;\n}\n.round-intro__fighter img {\n  display: block;\n  width: 100%;\n  height: clamp(130px,24vh,250px);\n  object-fit: contain;\n  filter: drop-shadow(0 0 16px rgba(255,255,255,.12));\n}\n.round-intro__team--cpu .round-intro__fighter img { filter: drop-shadow(0 0 18px rgba(255,49,89,.35)); }\n.round-intro__team--player .round-intro__fighter img { filter: drop-shadow(0 0 18px rgba(19,213,255,.35)); }\n.round-intro__name {\n  display: block;\n  margin-top: 8px;\n  color: #fff;\n  font-weight: 800;\n  overflow-wrap: anywhere;\n}\n.round-intro__status {\n  display: inline-block;\n  margin-top: 6px;\n  padding: 4px 7px;\n  border-radius: 5px;\n  font-size: clamp(.65rem,1.2vw,.85rem);\n  font-weight: 900;\n  font-variant-numeric: tabular-nums;\n}\n.round-intro__status.status-alive { color: #8fffc0; background: #176b4933; border: 1px solid #43d995; }\n.round-intro__status.status-ko {\n  color: #ff7187;\n  background: #b5092b33;\n  border: 1px solid #ff3159;\n  letter-spacing: .12em;\n  text-shadow: 0 0 8px #ff315966;\n}\n.round-intro__fighter.is-defeated img { filter: grayscale(1) brightness(.65); opacity: .75; }\n.round-intro__healthbar {\n  width: min(100%,160px);\n  height: 9px;\n  margin: 8px auto 0;\n  overflow: hidden;\n  background: #10131c;\n  border: 1px solid #ffffff55;\n  border-radius: 999px;\n  box-shadow: inset 0 1px 3px #0009;\n}\n.round-intro__healthbar-fill {\n  height: 100%;\n  border-radius: inherit;\n  transition: width 350ms ease, background-color 250ms ease, box-shadow 250ms ease;\n}\n.round-intro__healthbar.health-healthy .round-intro__healthbar-fill { background: #35df83; box-shadow: 0 0 8px #35df8380; }\n.round-intro__healthbar.health-warning .round-intro__healthbar-fill { background: #f4d438; box-shadow: 0 0 8px #f4d43880; }\n.round-intro__healthbar.health-danger .round-intro__healthbar-fill { background: #ff343f; box-shadow: 0 0 9px #ff343f99; }\n.round-intro__healthbar.health-critical .round-intro__healthbar-fill { background: #690018; box-shadow: 0 0 7px #690018; }\n.round-intro__fighter.is-defeated .round-intro__healthbar-fill { background: #25252b; box-shadow: none; }\n.round-intro__vs {\n  color: #fff;\n  font-size: clamp(2.5rem,7vw,5rem);\n  font-weight: 1000;\n  font-style: italic;\n  text-shadow: 0 0 12px rgba(255,255,255,.35), 0 0 32px rgba(255,49,89,.2);\n  animation: roundIntroVsPulse 1s ease-in-out infinite alternate;\n}\n.round-intro__footer {\n  color: #d5deeb;\n  font-size: .9rem;\n  font-weight: 900;\n  letter-spacing: .35em;\n  animation: roundIntroFooterPulse 1s ease-in-out infinite alternate;\n}\n@keyframes roundIntroFighterIn { from { opacity: 0; transform: translateX(-85px) scale(.9); } to { opacity: 1; transform: translateX(0) scale(1); } }\n@keyframes roundIntroFighterInRight { from { opacity: 0; transform: translateX(85px) scale(.9); } to { opacity: 1; transform: translateX(0) scale(1); } }\n@keyframes roundIntroVsPulse { from { opacity: .75; transform: scale(.96); } to { opacity: 1; transform: scale(1.04); } }\n@keyframes roundIntroFooterPulse { from { opacity: .65; } to { opacity: 1; } }\n@media (max-width: 650px) {\n  .round-intro { gap: 14px; padding: 14px; }\n  .round-intro__matchup { gap: 5px; }\n  .round-intro__fighters { gap: 5px; }\n  .round-intro__fighter img { height: clamp(110px,22vh,180px); }\n  .round-intro__label { font-size: .68rem; letter-spacing: .1em; }\n  .round-intro__name { font-size: .75rem; }\n  .round-intro__status { font-size: .6rem; padding: 3px 4px; }\n}\n@media (prefers-reduced-motion: reduce) {\n  .round-intro *, .round-intro *::before, .round-intro *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; }\n  .round-intro__healthbar-fill { transition: none; }\n}\n"],["STYLE",{},"/* One knockout cutscene shared by 1v1 and 2v2. */\n.wild-ko-overlay {\n  --ko-color:#ff3159;\n  --ko-glow:rgba(255,49,89,.7);\n  position:fixed; inset:0; z-index:10030; display:flex; align-items:center; justify-content:center;\n  overflow:hidden; isolation:isolate;\n  background:radial-gradient(ellipse at center,#33101b 0%,#100810 48%,#03050b 100%);\n  animation:wildKoScreenEnter .35s ease-out both;\n}\n.wild-ko-overlay.ko-player { --ko-color:#13d5ff; --ko-glow:rgba(19,213,255,.65); }\n.wild-ko-overlay.is-fading-out { animation:wildKoScreenExit .5s ease-in forwards; pointer-events:none; }\n.wild-ko-flash { position:absolute; inset:0; z-index:-1; background:#fff; pointer-events:none; animation:wildKoFlash .65s ease-out both; }\n.wild-ko-content { position:relative; display:flex; flex-direction:column; align-items:center; justify-content:center; width:min(92vw,700px); text-align:center; animation:wildKoImpact .7s cubic-bezier(.16,1,.3,1) both; }\n.wild-ko-eyebrow { margin:0 0 8px; color:var(--ko-color); font-size:clamp(.75rem,2vw,1rem); font-weight:900; letter-spacing:.35em; text-transform:uppercase; text-shadow:0 0 18px var(--ko-glow); animation:wildKoTextReveal .4s .15s both; }\n.wild-ko-portrait { display:block; width:clamp(150px,27vw,260px); height:clamp(190px,34vw,330px); object-fit:contain; object-position:center bottom; filter:grayscale(1) drop-shadow(0 0 22px var(--ko-glow)); transform-origin:center bottom; animation:wildKoFall .75s .1s cubic-bezier(.2,.7,.3,1) both; }\n.wild-ko-title { position:relative; z-index:2; margin:-18px 0 0; color:#fff; font-size:clamp(4.5rem,15vw,9rem); font-weight:1000; font-style:italic; line-height:.95; letter-spacing:-.07em; -webkit-text-stroke:2px var(--ko-color); text-shadow:4px 4px 0 #5d071b,0 0 14px var(--ko-glow),0 0 38px var(--ko-glow); animation:wildKoTitleImpact .55s .25s cubic-bezier(.16,1,.3,1) both; }\n.wild-ko-name { margin:18px 0 0; color:#fff; font-size:clamp(1.25rem,4vw,2.3rem); font-weight:950; letter-spacing:.12em; text-transform:uppercase; text-shadow:0 3px 12px #000; animation:wildKoTextReveal .4s .4s both; }\n.wild-ko-subtitle { margin:8px 0 0; color:var(--ko-color); font-size:clamp(.7rem,2vw,.95rem); font-weight:900; letter-spacing:.3em; animation:wildKoTextReveal .4s .55s both; }\n@keyframes wildKoScreenEnter { from{opacity:0} to{opacity:1} }\n@keyframes wildKoScreenExit { from{opacity:1} to{opacity:0} }\n@keyframes wildKoFlash { 0%{opacity:.95} 100%{opacity:0} }\n@keyframes wildKoImpact { 0%{opacity:0;transform:scale(1.18)} 45%{opacity:1;transform:scale(.96)} 100%{opacity:1;transform:scale(1)} }\n@keyframes wildKoTextReveal { from{opacity:0;transform:translateY(18px)} to{opacity:1;transform:translateY(0)} }\n@keyframes wildKoFall { 0%{opacity:0;transform:translateY(-65px) rotate(-8deg) scale(1.12)} 55%{opacity:1;transform:translateY(12px) rotate(4deg) scale(.96)} 75%{transform:translateY(-5px) rotate(-2deg)} 100%{opacity:1;transform:translateY(0) rotate(0) scale(1)} }\n@keyframes wildKoTitleImpact { 0%{opacity:0;transform:scale(2.2) rotate(-8deg)} 65%{opacity:1;transform:scale(.9) rotate(2deg)} 100%{opacity:1;transform:scale(1) rotate(0)} }\n@media(prefers-reduced-motion:reduce){.wild-ko-overlay *,.wild-ko-overlay *::before,.wild-ko-overlay *::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}\n"],["STYLE",{},".battle-pause-overlay {\n  position: fixed; inset: 0; z-index: 5000; display: grid; place-items: center;\n  padding: 18px; overflow-y: auto; background: rgba(2, 6, 14, .88);\n  backdrop-filter: blur(8px);\n}\n.battle-pause-panel {\n  width: min(760px, 100%); max-height: min(90vh, 900px); overflow: auto;\n  padding: 22px; color: #f4f7ff; background: linear-gradient(145deg,#14243a,#080e19 70%);\n  border: 2px solid #d5bd5e; box-shadow: 0 0 35px #d5bd5e35, inset 0 0 25px #0008;\n}\n.battle-pause-header { text-align:center; }\n.battle-pause-header span { color:#13d5ff; font:800 .78rem Oxanium,sans-serif; letter-spacing:4px; }\n.battle-pause-header h2 { margin:4px 0 16px; color:#f5d56a; font:900 2.2rem Oxanium,sans-serif; letter-spacing:3px; }\n.battle-pause-tabs { display:flex; gap:8px; margin-bottom:16px; }\n.battle-pause-tabs button,.battle-pause-actions button,.battle-pause-close,.battle-pause-reset {\n  min-height:42px; padding:10px 14px; color:#eaf4ff; background:#14263b;\n  border:1px solid #31516d; font:800 .82rem Oxanium,sans-serif; letter-spacing:1px; cursor:pointer;\n}\n.battle-pause-tabs button { flex:1; }\n.battle-pause-tabs button.active,.battle-pause-actions button.primary {\n  color:#111827; background:#d5bd5e; border-color:#f5df8b;\n}\n.battle-pause-actions { display:grid; gap:10px; }\n.battle-pause-actions button { min-height:50px; }\n.battle-pause-actions button.danger { color:#fff; background:#762f3b; border-color:#d85a6b; }\n.battle-pause-settings { max-height:55vh; overflow:auto; padding:2px 4px 10px; }\n.battle-pause-settings > p { color:#a9bad0; font:600 .88rem Rajdhani,sans-serif; }\n.battle-pause-player-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:14px; }\n.battle-pause-player { min-width:0; padding:12px; background:#0a1422; border:1px solid #29465f; }\n.battle-pause-player h3 { margin:0 0 12px; color:#13d5ff; font:800 1rem Oxanium,sans-serif; }\n.battle-pause-player h4 { margin:14px 0 6px; color:#e8c85e; font:800 .72rem Oxanium,sans-serif; letter-spacing:1px; }\n.battle-pause-bind-row { display:flex; align-items:center; justify-content:space-between; gap:8px; min-height:34px; border-bottom:1px solid #ffffff12; color:#c8d5e5; font:600 .82rem Rajdhani,sans-serif; }\n.battle-pause-bind { min-width:64px; padding:5px 8px; color:#fff; background:#1a3047; border:1px solid #41627e; font:800 .78rem Oxanium,sans-serif; cursor:pointer; }\n.battle-pause-message { color:#f5d56a!important; }\n.battle-pause-reset { margin-top:10px; width:100%; }\n.battle-pause-audio-row,.battle-pause-mute { display:flex; align-items:center; justify-content:space-between; gap:18px; padding:13px 4px; border-bottom:1px solid #ffffff20; }\n.battle-pause-audio-row > span:first-child,.battle-pause-mute > span { display:grid; gap:3px; }\n.battle-pause-audio-row strong,.battle-pause-mute strong { color:#f2f6ff; font:800 .9rem Oxanium,sans-serif; }\n.battle-pause-audio-row small,.battle-pause-mute small { color:#9eb0c7; font:600 .78rem Rajdhani,sans-serif; }\n.battle-pause-audio-row > span:last-child { display:flex; align-items:center; gap:10px; min-width:42%; }\n.battle-pause-audio-row input { width:100%; accent-color:#d5bd5e; }\n.battle-pause-audio-row output { min-width:42px; color:#f5d56a; text-align:right; font-weight:800; }\n.battle-pause-mute input { width:20px; height:20px; accent-color:#d5bd5e; }\n.battle-pause-close { width:100%; margin-top:14px; color:#111827; background:#13d5ff; border-color:#13d5ff; }\n.battle-pause-trigger { position:absolute; top:14px; right:18px; z-index:20; width:42px; height:42px; color:#f5d56a; background:#101b2b; border:1px solid #d5bd5e; border-radius:50%; font-size:1.25rem; cursor:pointer; }\n@media(max-width:620px) {\n .battle-pause-panel { padding:14px; }\n .battle-pause-player-grid { grid-template-columns:1fr; }\n .battle-pause-audio-row { align-items:flex-start; flex-direction:column; gap:8px; }\n .battle-pause-audio-row > span:last-child { width:100%; }\n .battle-pause-trigger { top:8px; right:8px; }\n}\n\n\n/* Prominent arcade pause control */\n.battle-pause-trigger {\n  position: fixed !important;\n  top: 16px !important;\n  right: 18px !important;\n  z-index: 1400 !important;\n  display: inline-flex !important;\n  align-items: center;\n  justify-content: center;\n  gap: 9px;\n  width: auto !important;\n  min-width: 112px;\n  height: 48px !important;\n  padding: 0 17px !important;\n  color: #101522 !important;\n  background: linear-gradient(180deg, #ffe98b 0%, #e7b936 100%) !important;\n  border: 2px solid #fff0a8 !important;\n  border-radius: 9px !important;\n  box-shadow: 0 0 0 3px #e7b93645, 0 5px 0 #8d6418, 0 0 24px #ffd84f99 !important;\n  font: 900 1rem Oxanium, sans-serif !important;\n  letter-spacing: 1.5px;\n  cursor: pointer;\n  transition: transform .15s ease, box-shadow .15s ease, filter .15s ease;\n}\n.battle-pause-trigger:hover {\n  transform: translateY(-2px) scale(1.04);\n  filter: brightness(1.08);\n  box-shadow: 0 0 0 4px #e7b93655, 0 7px 0 #8d6418, 0 0 30px #ffd84fcc !important;\n}\n.battle-pause-trigger:active { transform: translateY(2px); box-shadow: 0 2px 0 #8d6418 !important; }\n.battle-pause-icon { font-size: 1.25rem; line-height: 1; }\n.battle-pause-back {\n  width: 100%; min-height: 40px; margin-bottom: 14px; padding: 8px 12px;\n  color: #eaf4ff; background: #14263b; border: 1px solid #31516d;\n  font: 800 .8rem Oxanium,sans-serif; letter-spacing: 1px; cursor: pointer;\n}\n.battle-pause-all-settings { max-height: 65vh; }\n.battle-pause-audio-section { margin-top: 24px; padding-top: 14px; border-top: 2px solid #d5bd5e66; }\n.battle-pause-audio-section h3 { margin: 0; color: #e8c85e; font: 900 1rem Oxanium,sans-serif; letter-spacing: 1.5px; }\n@media(max-width:620px) {\n  .battle-pause-trigger { top: 8px !important; right: 8px !important; min-width: 96px; height: 42px !important; padding: 0 12px !important; }\n}\n\n\n/* =========================================================\n   WILD CARDS — ARCADE MENU POLISH\n   Shared raised, beveled treatment for every pause-menu button\n   ========================================================= */\n.battle-pause-panel {\n  position: relative;\n  width: min(680px, 100%);\n  max-height: min(88vh, 860px);\n  padding: clamp(18px, 3vw, 30px);\n  overflow: auto;\n  isolation: isolate;\n  border: 1px solid #d9bd62;\n  border-radius: 22px 5px 22px 5px;\n  background:\n    linear-gradient(115deg, #1a3048 0%, #101c2d 42%, #080f1b 100%);\n  box-shadow:\n    0 22px 70px #000c,\n    0 0 0 5px #d5bd5e18,\n    0 0 34px #d5bd5e30,\n    inset 0 1px 0 #fff2,\n    inset 0 -12px 28px #0006;\n}\n.battle-pause-panel::before,\n.battle-pause-panel::after {\n  content: \"\";\n  position: absolute;\n  z-index: -1;\n  pointer-events: none;\n}\n.battle-pause-panel::before {\n  top: 0;\n  left: 24px;\n  right: 24px;\n  height: 3px;\n  background: linear-gradient(90deg, transparent, #f4d66f 18%, #13d5ff 82%, transparent);\n  box-shadow: 0 0 14px #13d5ff80;\n}\n.battle-pause-panel::after {\n  top: 0;\n  right: 0;\n  width: 5px;\n  height: 100%;\n  background: linear-gradient(180deg, #13d5ff, #d5bd5e 48%, transparent);\n  opacity: .75;\n}\n.battle-pause-header {\n  position: relative;\n  margin: -2px -2px 20px;\n  padding: 10px 12px 14px;\n  border-bottom: 1px solid #d5bd5e55;\n  background: linear-gradient(90deg, #d5bd5e12, transparent 72%);\n}\n.battle-pause-header span {\n  color: #13d5ff;\n  text-shadow: 0 0 12px #13d5ff70;\n}\n.battle-pause-header h2 {\n  margin: 5px 0 0;\n  font-size: clamp(2rem, 5vw, 2.65rem);\n  text-shadow: 0 3px 0 #795a1e, 0 0 18px #f5d56a55;\n}\n\n/* Consistent arcade buttons: raised face, bright edge, pressed state. */\n.battle-pause-actions button,\n.battle-pause-close,\n.battle-pause-reset,\n.battle-pause-back,\n.battle-pause-bind {\n  position: relative;\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  min-height: 48px;\n  padding: 11px 16px;\n  color: #f4f8ff;\n  background: linear-gradient(180deg, #25435d 0%, #14283d 100%);\n  border: 1px solid #5c86a4;\n  border-bottom: 3px solid #091522;\n  border-radius: 8px 3px 8px 3px;\n  box-shadow: inset 0 1px 0 #ffffff25, 0 3px 0 #050b12, 0 0 12px #13d5ff12;\n  font: 900 .86rem Oxanium, sans-serif;\n  letter-spacing: 1.1px;\n  text-align: center;\n  text-shadow: 0 1px 2px #0009;\n  cursor: pointer;\n  transition: transform .14s ease, filter .14s ease, box-shadow .14s ease, border-color .14s ease;\n}\n.battle-pause-actions button:hover,\n.battle-pause-close:hover,\n.battle-pause-reset:hover,\n.battle-pause-back:hover,\n.battle-pause-bind:hover {\n  transform: translateY(-2px);\n  filter: brightness(1.15);\n  border-color: #13d5ff;\n  box-shadow: inset 0 1px 0 #ffffff35, 0 5px 0 #050b12, 0 0 18px #13d5ff55;\n}\n.battle-pause-actions button:active,\n.battle-pause-close:active,\n.battle-pause-reset:active,\n.battle-pause-back:active,\n.battle-pause-bind:active {\n  transform: translateY(2px);\n  border-bottom-width: 1px;\n  box-shadow: inset 0 2px 5px #0008, 0 1px 0 #050b12;\n}\n.battle-pause-actions button.primary,\n.battle-pause-close {\n  color: #111827;\n  background: linear-gradient(180deg, #fff0a1 0%, #e5b938 100%);\n  border-color: #fff0a1;\n  border-bottom-color: #89651b;\n  text-shadow: 0 1px 0 #fff7;\n  box-shadow: inset 0 1px 0 #fff9, 0 3px 0 #89651b, 0 0 16px #f5d56a35;\n}\n.battle-pause-actions button.primary:hover,\n.battle-pause-close:hover {\n  border-color: #fff8ce;\n  box-shadow: inset 0 1px 0 #fff9, 0 5px 0 #89651b, 0 0 24px #f5d56a90;\n}\n.battle-pause-actions button.danger {\n  color: #fff;\n  background: linear-gradient(180deg, #b94355 0%, #702738 100%);\n  border-color: #f17a89;\n  border-bottom-color: #421421;\n  box-shadow: inset 0 1px 0 #ffffff30, 0 3px 0 #421421, 0 0 14px #e34b6330;\n}\n.battle-pause-actions button.danger:hover {\n  border-color: #ffabb5;\n  box-shadow: inset 0 1px 0 #ffffff40, 0 5px 0 #421421, 0 0 22px #e34b6380;\n}\n.battle-pause-actions { gap: 12px; }\n.battle-pause-actions button { min-height: 54px; font-size: .94rem; }\n.battle-pause-back { width: 100%; }\n.battle-pause-reset { width: 100%; }\n.battle-pause-bind {\n  min-width: 72px;\n  min-height: 34px;\n  padding: 5px 9px;\n  color: #b9f3ff;\n  font-size: .76rem;\n  letter-spacing: .5px;\n}\n.battle-pause-player,\n.battle-pause-audio-section {\n  border-radius: 12px 3px 12px 3px;\n  background: linear-gradient(145deg, #0e1c2c, #091321);\n  box-shadow: inset 0 1px 0 #ffffff12, 0 8px 18px #0003;\n}\n.battle-pause-player { border-color: #315b76; }\n.battle-pause-audio-section {\n  padding: 18px;\n  border: 1px solid #d5bd5e55;\n}\n@media(max-width:620px) {\n  .battle-pause-panel {\n    width: 100%;\n    max-height: 90vh;\n    border-radius: 16px 4px 16px 4px;\n  }\n  .battle-pause-actions button { min-height: 50px; }\n}\n\n\n/* Dedicated visual-effects settings, separate from audio controls. */\n.battle-pause-visual-section {\n  margin-top: 18px;\n  padding: 18px;\n  border: 1px solid #13d5ff55;\n  border-radius: 12px 3px 12px 3px;\n  background: linear-gradient(145deg, #10283a, #091522);\n  box-shadow: inset 0 1px 0 #ffffff12, 0 8px 18px #0003;\n}\n.battle-pause-visual-section h3 {\n  margin: 0;\n  color: #54e5ff;\n  font: 900 1rem Oxanium, sans-serif;\n  letter-spacing: 1.5px;\n  text-shadow: 0 0 12px #13d5ff55;\n}\n.battle-pause-visual-section > p {\n  margin: 7px 0 12px;\n  color: #9eb0c7;\n  font: 600 .82rem Rajdhani, sans-serif;\n}\n.battle-pause-visual-toggle {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 18px;\n  padding: 14px 12px;\n  border: 1px solid #13d5ff38;\n  border-radius: 8px;\n  background: #071321;\n  cursor: pointer;\n}\n.battle-pause-visual-toggle > span {\n  display: grid;\n  gap: 4px;\n  max-width: 540px;\n}\n.battle-pause-visual-toggle strong {\n  color: #f2f6ff;\n  font: 900 .92rem Oxanium, sans-serif;\n}\n.battle-pause-visual-toggle small {\n  color: #a9bad0;\n  font: 600 .8rem Rajdhani, sans-serif;\n  line-height: 1.4;\n}\n.battle-pause-visual-toggle input {\n  flex: 0 0 auto;\n  width: 22px;\n  height: 22px;\n  accent-color: #13d5ff;\n  cursor: pointer;\n}\n@media(max-width:620px) {\n  .battle-pause-visual-toggle { align-items: flex-start; }\n}\n\n\n/* Quality preset controls inside the dedicated Visual Effects panel. */\n.battle-pause-quality-control {\n  display: grid;\n  gap: 10px;\n  margin: 12px 0 14px;\n  padding: 13px;\n  border: 1px solid #13d5ff38;\n  border-radius: 9px;\n  background: #071321;\n}\n.battle-pause-quality-heading {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 10px;\n}\n.battle-pause-quality-heading strong {\n  color: #eaf8ff;\n  font: 900 .78rem Oxanium, sans-serif;\n  letter-spacing: 1px;\n}\n.battle-pause-quality-heading small {\n  color: #54e5ff;\n  font: 800 .72rem Oxanium, sans-serif;\n}\n.battle-pause-quality-options {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 8px;\n}\n.battle-pause-quality-button {\n  display: grid;\n  gap: 4px;\n  min-width: 0;\n  min-height: 58px;\n  padding: 9px 6px;\n  border: 1px solid #35536b;\n  border-bottom: 3px solid #07101a;\n  border-radius: 7px;\n  color: #eaf4ff;\n  background: linear-gradient(180deg, #1b3046, #102033);\n  cursor: pointer;\n}\n.battle-pause-quality-button strong {\n  font: 900 .78rem Oxanium, sans-serif;\n  letter-spacing: 1px;\n}\n.battle-pause-quality-button small {\n  color: #9eb0c7;\n  font: 700 .68rem Rajdhani, sans-serif;\n}\n.battle-pause-quality-button:hover {\n  border-color: #13d5ff;\n  filter: brightness(1.12);\n}\n.battle-pause-quality-button.is-selected {\n  color: #06131e;\n  border-color: #73edff;\n  background: linear-gradient(180deg, #9af1ff, #24cce9);\n  box-shadow: 0 0 14px #13d5ff55;\n}\n.battle-pause-quality-button.is-selected small { color: #123748; }\n.battle-pause-quality-note {\n  margin: 0 !important;\n  color: #8fa6bd !important;\n  font: 600 .75rem/1.45 Rajdhani, sans-serif !important;\n}\n@media(max-width:520px) {\n  .battle-pause-quality-options { grid-template-columns: 1fr; }\n  .battle-pause-quality-button { min-height: 46px; }\n  .battle-pause-quality-heading { align-items: flex-start; flex-direction: column; }\n}\n"],["STYLE",{},".wild-combo-anchor {\n  position: fixed;\n  z-index: 1450;\n  top: clamp(76px, 12vh, 132px);\n  left: 50%;\n  width: min(430px, 88vw);\n  transform: translateX(-50%);\n  pointer-events: none;\n  perspective: 900px;\n}\n.wild-combo-popup {\n  position: relative;\n  display: grid;\n  justify-items: center;\n  gap: 3px;\n  overflow: hidden;\n  padding: 13px 25px 12px;\n  border: 2px solid var(--combo-edge, #f7ed52);\n  border-radius: 10px 3px 10px 3px;\n  color: #fff;\n  background: linear-gradient(115deg, #081522f5, #172d43f5 55%, #081522f5);\n  box-shadow: 0 0 0 3px #ffffff12, 0 0 22px var(--combo-glow, #f7ed5288), inset 0 0 20px #ffffff12;\n  text-align: center;\n  transform-origin: center;\n  isolation: isolate;\n}\n.wild-combo-popup::before {\n  content: \"\";\n  position: absolute;\n  z-index: -1;\n  inset: -50%;\n  background: linear-gradient(110deg, transparent 35%, var(--combo-glow, #f7ed52) 50%, transparent 65%);\n  opacity: .22;\n  transform: translateX(-65%) rotate(12deg);\n  animation: combo-light-sweep 1.6s ease-in-out infinite;\n}\n.wild-combo-eyebrow {\n  color: var(--combo-edge, #f7ed52);\n  font: 900 9px Oxanium, sans-serif;\n  letter-spacing: .24em;\n}\n.wild-combo-popup strong {\n  color: #fff;\n  font: 1000 italic clamp(23px, 5vw, 39px) Oxanium, sans-serif;\n  letter-spacing: .035em;\n  line-height: 1.05;\n  text-shadow: 0 2px 0 #000, 0 0 12px var(--combo-glow, #f7ed52);\n}\n.wild-combo-subtitle {\n  color: #d8e8f5;\n  font: 900 8px Oxanium, sans-serif;\n  letter-spacing: .2em;\n}\n.wild-combo-spark {\n  position: absolute;\n  width: 7px;\n  height: 7px;\n  background: var(--combo-edge, #f7ed52);\n  box-shadow: 0 0 12px var(--combo-glow, #f7ed52);\n  transform: rotate(45deg);\n}\n.wild-combo-spark-one { top: 12px; left: 13px; }\n.wild-combo-spark-two { right: 13px; bottom: 12px; }\n.combo-stage-3 { --combo-edge:#54eaff; --combo-glow:#35dfffaa; animation: combo-hit-three .58s cubic-bezier(.16,1,.3,1) both; }\n.combo-stage-4 { --combo-edge:#a5f51b; --combo-glow:#a5f51baa; animation: combo-hit-four .62s cubic-bezier(.16,1,.3,1) both; }\n.combo-stage-5 { --combo-edge:#f7ed52; --combo-glow:#f7ed52bb; animation: combo-hit-five .66s cubic-bezier(.16,1,.3,1) both; }\n.combo-stage-6 { --combo-edge:#ffb52e; --combo-glow:#ff8b32bb; animation: combo-hit-six .7s cubic-bezier(.16,1,.3,1) both; }\n.combo-stage-7 { --combo-edge:#ff668f; --combo-glow:#ff3159bb; animation: combo-hit-seven .74s cubic-bezier(.16,1,.3,1) both; }\n.combo-stage-8 { --combo-edge:#c58aff; --combo-glow:#a34dffcc; animation: combo-hit-eight .78s cubic-bezier(.16,1,.3,1) both; }\n.combo-stage-10 { --combo-edge:#fff; --combo-glow:#6deaff; animation: combo-hit-ten 1.8s ease-in-out infinite; }\n@keyframes combo-light-sweep { 0%,100% { transform:translateX(-65%) rotate(12deg); } 50% { transform:translateX(65%) rotate(12deg); } }\n@keyframes combo-hit-three { 0% { opacity:0; transform:translateY(-35px) scale(.45) rotate(-7deg); filter:blur(5px); } 55% { opacity:1; transform:translateY(4px) scale(1.12) rotate(2deg); filter:blur(0); } 100% { transform:translateY(0) scale(1); } }\n@keyframes combo-hit-four { 0% { opacity:0; transform:translateX(-75px) skewX(-16deg) scale(.8); } 45% { opacity:1; transform:translateX(8px) skewX(4deg) scale(1.08); } 100% { transform:translateX(0) skewX(0) scale(1); } }\n@keyframes combo-hit-five { 0% { opacity:0; transform:scale(1.7); filter:brightness(2); } 35% { opacity:1; transform:scale(.88); } 65% { transform:scale(1.08); } 100% { transform:scale(1); filter:brightness(1); } }\n@keyframes combo-hit-six { 0% { opacity:0; transform:translateY(45px) rotate(8deg) scale(.6); } 40% { opacity:1; transform:translateY(-8px) rotate(-3deg) scale(1.14); } 70% { transform:translateY(3px) rotate(1deg); } 100% { transform:translateY(0) rotate(0) scale(1); } }\n@keyframes combo-hit-seven { 0% { opacity:0; transform:translateX(65px) scale(.55); filter:blur(8px); } 30%,55% { opacity:1; transform:translateX(-5px) scale(1.12); filter:blur(0); } 42%,68% { transform:translateX(5px) scale(1.04); } 100% { transform:translateX(0) scale(1); } }\n@keyframes combo-hit-eight { 0% { opacity:0; transform:rotateY(80deg) scale(.7); } 50% { opacity:1; transform:rotateY(-12deg) scale(1.12); } 100% { transform:rotateY(0) scale(1); } }\n@keyframes combo-hit-ten { 0%,100% { transform:scale(1); filter:brightness(1); box-shadow:0 0 0 3px #ffffff12,0 0 22px #6deaff99,inset 0 0 20px #ffffff12; } 50% { transform:scale(1.045); filter:brightness(1.35); box-shadow:0 0 0 5px #ffffff22,0 0 38px #6deaffdd,0 0 70px #d45bff66,inset 0 0 28px #ffffff2a; } }\n\n/* The prismatic color is now tied to an active combo, not to damage size. */\n#gameContainer.solo-combo-active #battleLayout #opponentSection .solo-portrait-wrapper,\n.team-battle.team-combo-active .fighter-opponent .fighter-portrait-wrapper {\n  position: relative;\n  overflow: hidden;\n  isolation: isolate;\n}\n#gameContainer.solo-combo-active #battleLayout #opponentSection .solo-portrait-wrapper::before,\n.team-battle.team-combo-active .fighter-opponent .fighter-portrait-wrapper::before {\n  content: \"\";\n  position: absolute;\n  z-index: 3;\n  inset: 0;\n  border-radius: inherit;\n  pointer-events: none;\n  background: linear-gradient(115deg,#ff315966 0%,#ffb52e66 18%,#f7ed5266 34%,#5bff8a66 50%,#35eaff66 66%,#5574ff66 82%,#d45bff66 100%) !important;\n  background-size: 250% 100% !important;\n  mix-blend-mode: screen !important;\n  animation: combo-portrait-rainbow 1.5s linear infinite !important;\n}\n@keyframes combo-portrait-rainbow {\n  from { opacity: .18; background-position: 0% 50%; }\n  50% { opacity: .72; }\n  to { opacity: .18; background-position: 100% 50%; }\n}\n@media (prefers-reduced-motion: reduce) {\n  .wild-combo-popup, .wild-combo-popup::before,\n  #gameContainer.solo-combo-active #battleLayout #opponentSection .solo-portrait-wrapper::before,\n  .team-battle.team-combo-active .fighter-opponent .fighter-portrait-wrapper::before { animation: none !important; }\n}\n\n\n/* Combo-ending performance callout */\n.wild-combo-break-anchor {\n  position: fixed;\n  z-index: 1451;\n  top: clamp(76px, 12vh, 132px);\n  left: 50%;\n  width: min(430px, 88vw);\n  transform: translateX(-50%);\n  pointer-events: none;\n  perspective: 900px;\n}\n.wild-combo-break-popup {\n  --break-edge: #54eaff;\n  --break-glow: #35dfff88;\n  position: relative;\n  display: grid;\n  justify-items: center;\n  gap: 3px;\n  overflow: hidden;\n  padding: 13px 25px 12px;\n  border: 2px solid var(--break-edge);\n  border-radius: 4px 12px 4px 12px;\n  color: #fff;\n  background: linear-gradient(115deg, #081522f7, #172d43f7 55%, #081522f7);\n  box-shadow: 0 0 0 3px #ffffff12, 0 0 25px var(--break-glow), inset 0 0 20px #ffffff12;\n  text-align: center;\n  isolation: isolate;\n  animation: combo-break-enter .72s cubic-bezier(.16,1,.3,1) both;\n}\n.wild-combo-break-popup::before {\n  content: \"\";\n  position: absolute;\n  z-index: -1;\n  inset: -50%;\n  background: linear-gradient(110deg, transparent 35%, var(--break-glow) 50%, transparent 65%);\n  transform: translateX(-65%) rotate(12deg);\n  animation: combo-break-sweep 1.1s ease-out both;\n}\n.wild-combo-break-eyebrow {\n  color: #d9e8f4;\n  font: 900 9px Oxanium, sans-serif;\n  letter-spacing: .24em;\n}\n.wild-combo-break-popup > strong {\n  color: #fff;\n  font: 1000 italic clamp(21px, 4.8vw, 36px) Oxanium, sans-serif;\n  line-height: 1.05;\n  text-shadow: 0 2px 0 #000, 0 0 12px var(--break-glow);\n}\n.wild-combo-break-rating {\n  color: var(--break-edge);\n  font: 1000 italic clamp(25px, 5.5vw, 43px) Oxanium, sans-serif;\n  letter-spacing: .035em;\n  line-height: 1.08;\n  text-shadow: 0 2px 0 #000, 0 0 17px var(--break-glow);\n}\n.wild-combo-break-subtitle {\n  color: #d8e8f5;\n  font: 900 8px Oxanium, sans-serif;\n  letter-spacing: .2em;\n}\n.wild-combo-break-spark {\n  position: absolute;\n  width: 7px;\n  height: 7px;\n  background: var(--break-edge);\n  box-shadow: 0 0 12px var(--break-glow);\n  transform: rotate(45deg);\n}\n.wild-combo-break-spark.spark-a { top: 12px; left: 13px; }\n.wild-combo-break-spark.spark-b { right: 13px; bottom: 12px; }\n.combo-break-nice { --break-edge:#54eaff; --break-glow:#35dfffaa; animation: combo-break-nice .72s cubic-bezier(.16,1,.3,1) both; }\n.combo-break-excellent { --break-edge:#f7ed52; --break-glow:#f7c52ebb; animation: combo-break-excellent .82s cubic-bezier(.16,1,.3,1) both; }\n.combo-break-epic { --break-edge:#ff668f; --break-glow:#ff3159dd; animation: combo-break-epic .9s cubic-bezier(.16,1,.3,1) both; }\n.combo-break-crazy { --break-edge:#fff; --break-glow:#6deaff; border:2px solid transparent; background:linear-gradient(115deg,#081522f7,#172d43f7 55%,#081522f7) padding-box,linear-gradient(90deg,#ff3159,#ffb52e,#f7ed52,#5bff8a,#35eaff,#5574ff,#d45bff,#ff3159) border-box; background-size:auto,300% 100%; animation:combo-break-crazy 1.2s ease-in-out infinite; }\n@keyframes combo-break-enter { 0% { opacity:0; transform:translateY(-25px) scale(.7); filter:blur(5px); } 55% { opacity:1; transform:translateY(4px) scale(1.08); filter:blur(0); } 100% { transform:translateY(0) scale(1); } }\n@keyframes combo-break-sweep { from { transform:translateX(-75%) rotate(12deg); opacity:0; } 35% { opacity:.3; } to { transform:translateX(75%) rotate(12deg); opacity:0; } }\n@keyframes combo-break-nice { 0% { opacity:0; transform:translateY(-10px) scale(.9); } 45% { opacity:1; transform:translateY(3px) scale(1.02); } 100% { transform:translateY(0) scale(1); } }\n@keyframes combo-break-excellent { 0% { opacity:0; transform:scale(1.35); filter:brightness(1.8); } 55% { opacity:1; transform:scale(.96); } 100% { transform:scale(1); filter:brightness(1); } }\n@keyframes combo-break-epic { 0% { opacity:0; transform:translateX(55px) skewX(-12deg) scale(.7); filter:blur(6px); } 38% { opacity:1; transform:translateX(-7px) skewX(3deg) scale(1.14); filter:blur(0) brightness(1.6); } 62% { transform:translateX(5px) skewX(-2deg) scale(1.04); } 100% { transform:translateX(0) skewX(0) scale(1); filter:brightness(1); } }\n@keyframes combo-break-crazy { 0%,100% { opacity:1; transform:translate(0,0) scale(1); filter:brightness(1.1) hue-rotate(0deg); background-position:0 0,0% 50%; box-shadow:0 0 18px #ff3159,0 0 36px #35eaff,inset 0 0 22px #ffffff22; } 20% { transform:translate(-3px,1px) scale(1.035); filter:brightness(1.55) hue-rotate(70deg); } 40% { transform:translate(3px,-2px) scale(1.015); background-position:0 0,45% 50%; } 60% { transform:translate(-2px,2px) scale(1.04); filter:brightness(1.7) hue-rotate(190deg); } 80% { transform:translate(2px,-1px) scale(1.02); background-position:0 0,100% 50%; } }\n@media (prefers-reduced-motion: reduce) { .wild-combo-break-popup, .wild-combo-break-popup::before { animation:none !important; } }\n"],["STYLE",{},"\n@import url(\"https://fonts.googleapis.com/css2?family=Oxanium:wght@400;500;600;700;800&family=Rajdhani:wght@400;500;600;700&display=swap\");\n/* Teambattle.css */\n.team-battle *,\n.team-battle *::before,\n.team-battle *::after {\n  box-sizing: border-box;\n}\n.team-battle button {\n  color: inherit;\n  font: inherit;\n}\n.team-battle button:focus-visible {\n  outline: 2px solid white;\n  outline-offset: 2px;\n}\n.battle-header h1 {\n  margin: 0;\n  text-align: center;\n  font-size: clamp(17px, 1.7vw, 25px);\n  letter-spacing: 2px;\n  text-shadow: 0 0 14px #20d9ff55;\n}\n.battle-header h1 span {\n  margin-left: 8px;\n  color: var(--muted);\n  font-size: 0.62em;\n  letter-spacing: 1px;\n}\n.header-team-label {\n  color: var(--muted);\n  font-size: 12px;\n  font-weight: 800;\n  letter-spacing: 2px;\n}\n.cpu-label { color: #ff7187; }\n.player-label { color: #50e6ff; text-align: right; }\n.battlefield::before {\n  content: \"\";\n  position: absolute;\n  z-index: -1;\n  inset: 0;\n  opacity: 0.24;\n  background: repeating-linear-gradient(\n    0deg,\n    transparent 0 48px,\n    #d8e9ff0b 49px 50px\n  );\n}\n.battle-team {\n  display: flex;\n  min-width: 0;\n  min-height: 0;\n  flex-direction: column;\n  gap: 12px;\n}\n.team-heading {\n  display: flex;\n  align-items: center;\n  gap: 9px;\n  min-height: 25px;\n  color: #ff7187;\n}\n.player-team .team-heading {\n  justify-content: flex-end;\n  color: #50e6ff;\n}\n.team-heading h2 {\n  margin: 0;\n  font-size: 13px;\n  letter-spacing: 2px;\n}\n.team-indicator {\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n  background: currentColor;\n  box-shadow: 0 0 12px currentColor;\n}\n.player-team .fighter-card { border-color: #20d9ff70; }\nbutton.fighter-card { width: 100%; cursor: pointer; }\n.fighter-card:hover:not(:disabled) { transform: translateY(-2px); }\n.fighter-card.is-selected {\n  border: 2px solid var(--cyan);\n  box-shadow: 0 0 20px #20d9ff42;\n}\n.fighter-card.is-defeated {\n  opacity: 0.4;\n  filter: grayscale(1);\n}\n.fighter-card.is-blocking {\n  animation: block-flash 650ms ease-out;\n}\n.fighter-card-heading {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 4px;\n}\n.fighter-card-heading h3 {\n  margin: 0;\n  overflow: hidden;\n  font-size: clamp(12px, 1vw, 16px);\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.selected-mark {\n  color: var(--cyan);\n  font-size: 9px;\n  font-weight: 800;\n  letter-spacing: 1px;\n}\n.fighter-bars {\n  display: grid;\n  gap: 7px;\n}\n.resource-row {\n  display: grid;\n  grid-template-columns: 22px minmax(0, 1fr) auto;\n  align-items: center;\n  gap: 6px;\n  font-size: 10px;\n}\n.resource-label {\n  font-weight: 800;\n  color: #dbe7f6;\n}\n.resource-value {\n  color: #b5c4d7;\n  font-variant-numeric: tabular-nums;\n}\n.resource-track {\n  height: 7px;\n  overflow: hidden;\n  border-radius: 8px;\n  background: #253247;\n}\n.resource-fill {\n  height: 100%;\n  border-radius: inherit;\n  transition: width 250ms ease;\n}\n.health-fill { background: linear-gradient(90deg, #ff3159, #ff9b78); }\n.mana-fill { background: linear-gradient(90deg, #167bff, #20d9ff); }\n.fighter-stats {\n  display: flex;\n  justify-content: space-between;\n  gap: 5px;\n  padding-top: 7px;\n  border-top: 1px solid #ffffff16;\n  color: var(--muted);\n  font-size: 10px;\n}\n.fighter-stats b {\n  color: #f5f8ff;\n}\n.battle-center {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 11px;\n  min-width: 0;\n  text-align: center;\n}\n.versus-mark {\n  display: grid;\n  width: 48px;\n  height: 48px;\n  place-items: center;\n  border: 1px solid #ffffff35;\n  border-radius: 50%;\n  color: #e9f4ff;\n  font-size: 15px;\n  font-weight: 900;\n  letter-spacing: 2px;\n  background: #0a1220bb;\n  box-shadow: 0 0 22px #20d9ff20;\n}\n.battle-center p {\n  max-width: 190px;\n  margin: 0;\n  color: #c3d1e2;\n  font-size: 11px;\n  line-height: 1.45;\n}\n.combat-log {\n  display: flex;\n  flex-direction: column;\n  padding: 11px;\n}\n.combat-log header {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding-bottom: 8px;\n  border-bottom: 1px solid #ffffff16;\n  color: #e7f5ff;\n  font-size: 11px;\n  font-weight: 800;\n  letter-spacing: 1.5px;\n}\n.log-dot {\n  width: 7px;\n  height: 7px;\n  border-radius: 50%;\n  background: var(--cyan);\n  box-shadow: 0 0 8px var(--cyan);\n}\n.combat-log-messages {\n  min-height: 0;\n  overflow-y: auto;\n  padding-top: 5px;\n}\n.combat-log-messages p {\n  margin: 5px 0;\n  color: #aebed1;\n  font-size: 10px;\n  line-height: 1.35;\n}\n.player-attack-panel.is-inactive { opacity: 0.66; }\n.player-attack-panel.is-active { border-color: #20d9ff9c; }\n.attack-panel-header h3 {\n  overflow: hidden;\n  margin: 0;\n  font-size: 13px;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.attack-panel-header span {\n  color: var(--cyan);\n  font-size: 9px;\n  font-weight: 800;\n  letter-spacing: 1.3px;\n}\n.attack-grid {\n  flex: 1;\n  min-height: 0;\n  overflow-y: auto;\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  align-content: start;\n  gap: 6px;\n}\n.attack-button {\n  min-width: 0;\n  min-height: 44px;\n  padding: 6px;\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  gap: 4px;\n  border: 1px solid #31516a;\n  border-radius: 7px;\n  background: linear-gradient(145deg, #14283c, #0b1422);\n  text-align: center;\n  cursor: pointer;\n}\n.attack-button strong {\n  overflow: hidden;\n  font-size: 10px;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.attack-button span {\n  color: #a9bfd2;\n  font-size: 9px;\n}\n.attack-button:not(:disabled):hover {\n  border-color: var(--cyan);\n  background: #12354a;\n}\n.attack-button:disabled {\n  opacity: 0.35;\n  cursor: not-allowed;\n}\n.finish-turn-button,\n.confirm-target-button {\n  flex: 0 0 auto;\n  width: 100%;\n  padding: 8px;\n  border: 1px solid #20d9ff9c;\n  border-radius: 7px;\n  background: linear-gradient(90deg, #07547b, #087f9d);\n  color: white;\n  font-size: 10px;\n  font-weight: 900;\n  letter-spacing: 1px;\n  cursor: pointer;\n}\n.finish-turn-button:disabled { opacity: 0.38; cursor: not-allowed; }\n/* Compact incoming prompt; only the current queued attack is shown. */\n.incoming-topline .timer-urgent { color: #ff3159 !important; }\n.incoming-fighter {\n  min-width: 0;\n  padding: 5px;\n  border: 1px solid #ffffff20;\n  border-radius: 7px;\n  background: #0003;\n}\n.incoming-fighter img {\n  width: 100%;\n  height: 45px;\n  object-fit: contain;\n}\n.incoming-fighter strong,\n.incoming-fighter small {\n  display: block;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.incoming-fighter strong { margin-top: 2px; font-size: 10px; }\n.incoming-fighter small { margin-top: 3px; color: var(--muted); font-size: 8px; letter-spacing: 1px; }\n.incoming-arrow { color: var(--red); font-size: 18px; font-weight: 900; }\n.incoming-attack h3 {\n  margin: 8px 0 3px;\n  font-size: 13px;\n}\n.incoming-attack > p {\n  margin: 0;\n  color: #c1cede;\n  font-size: 9px;\n}\n.defense-actions {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 7px;\n  margin-top: 9px;\n}\n.defense-actions button {\n  padding: 8px 4px;\n  border: 0;\n  border-radius: 6px;\n  font-size: 10px;\n  font-weight: 900;\n  cursor: pointer;\n}\n.defend-button { background: var(--cyan); color: #06131c !important; }\n.evade-button { background: var(--red); color: white !important; }\n.defense-actions button:disabled { opacity: 0.38; cursor: not-allowed; }\n.target-modal-backdrop {\n  position: fixed;\n  z-index: 50;\n  inset: 0;\n  display: grid;\n  place-items: center;\n  padding: 16px;\n  background: #02050bd9;\n}\n.target-modal {\n  width: min(440px, 94vw);\n  max-height: 90vh;\n  overflow-y: auto;\n  padding: 22px;\n  border: 1px solid #20d9ff88;\n  border-radius: 14px;\n  background: #0b1321;\n  box-shadow: 0 0 28px #20d9ff20;\n  text-align: center;\n}\n.target-modal .eyebrow {\n  margin: 0 0 6px;\n  color: var(--cyan);\n  font-size: 10px;\n  font-weight: 900;\n  letter-spacing: 2px;\n}\n.target-modal h2 { margin: 0; font-size: 22px; }\n.target-modal > p { color: var(--muted); font-size: 13px; }\n.target-choice-group {\n  margin: 12px 0;\n  padding: 10px;\n  border: 1px solid #ffffff1e;\n  border-radius: 8px;\n}\n.target-choice-group h3 { margin: 0 0 7px; font-size: 14px; }\n.target-choice-button {\n  width: 100%;\n  margin-top: 5px;\n  padding: 9px;\n  border: 1px solid #ffffff25;\n  border-radius: 6px;\n  background: #142033;\n  cursor: pointer;\n}\n.target-choice-button.is-selected {\n  border-color: var(--cyan);\n  background: #10384a;\n}\n.target-choice-button:disabled { opacity: 0.4; cursor: not-allowed; }\n.confirm-target-button { margin-top: 8px; }\n.modal-message { margin-bottom: 0; }\n@keyframes card-enter {\n  from { opacity: 0; transform: translate(-50%, -47%) scale(0.97); }\n  to { opacity: 1; transform: translate(-50%, -50%) scale(1); }\n}\n@keyframes block-flash {\n  0% { box-shadow: 0 0 22px white; }\n  100% { box-shadow: 0 8px 24px #0005; }\n}\n@media (max-width: 900px) {\n  .team-battle {\n    padding: 9px;\n    grid-template-rows: 38px minmax(0, 1fr) 175px;\n    gap: 8px;\n  }\n\n  .battlefield { gap: 5px; padding: 9px; }\n  .fighter-grid { gap: 6px; }\n  .fighter-card { padding: 7px; gap: 6px; }\n  .fighter-portrait { height: clamp(55px, 12vh, 115px); }\n  .battle-bottom { grid-template-columns: minmax(130px, 0.8fr) 1fr 1fr; gap: 6px; }\n  .incoming-attack { width: min(320px, 48%); }\n}\n@media (max-height: 700px) and (min-width: 621px) {\n  .team-battle {\n    min-height: 0;\n    padding-top: 7px;\n    padding-bottom: 8px;\n    grid-template-rows: 34px minmax(0, 1fr) 160px;\n    gap: 7px;\n  }\n\n  .fighter-card { gap: 5px; padding: 7px; }\n  .fighter-portrait { height: clamp(48px, 11vh, 100px); }\n  .battlefield { padding: 9px; }\n  .incoming-fighter img { height: 34px; }\n}\n@media (max-width: 620px) {\n  .team-battle {\n    height: auto;\n    min-height: 100vh;\n    overflow: visible;\n    grid-template-rows: auto minmax(560px, auto) auto;\n  }\n\n  .battle-header { grid-template-columns: 1fr auto 1fr; gap: 5px; }\n  .header-team-label { font-size: 8px; letter-spacing: 1px; }\n  .battle-header h1 { font-size: 14px; letter-spacing: 1px; }\n  .battle-header h1 span { display: block; margin: 3px 0 0; }\n\n  .battlefield {\n    grid-template-columns: 1fr;\n    grid-template-rows: 1fr 45px 1fr;\n    gap: 5px;\n  }\n\n  .battle-team { gap: 5px; }\n  .team-heading { min-height: 18px; }\n  .team-heading h2 { font-size: 10px; }\n  .fighter-card { height: 100%; }\n  .battle-center { flex-direction: row; }\n  .versus-mark { width: 34px; height: 34px; font-size: 11px; }\n  .battle-center p { max-width: 220px; }\n\n  .battle-bottom { grid-template-columns: 1fr; }\n  .combat-log { min-height: 100px; }\n  .player-attack-panel { min-height: 155px; }\n\n  .incoming-attack {\n    width: min(330px, 88%);\n    max-height: 82%;\n  }\n}\n@media (prefers-reduced-motion: reduce) {\n  *,\n  *::before,\n  *::after {\n    scroll-behavior: auto !important;\n    animation-duration: 0.01ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: 0.01ms !important;\n  }\n}\n.fighter-stat-bars {\n  display: grid;\n  gap: 5px;\n  padding-top: 7px;\n  border-top: 1px solid #ffffff16;\n}\n.stat-bar-row {\n  display: grid;\n  grid-template-columns: 38px minmax(0, 1fr) 22px;\n  align-items: center;\n  gap: 6px;\n  color: var(--muted);\n  font-size: 9px;\n}\n.stat-bar-row b {\n  color: #f5f8ff;\n  text-align: right;\n}\n.stat-bar-track {\n  height: 5px;\n  overflow: hidden;\n  border-radius: 6px;\n  background: #253247;\n}\n.stat-defense .stat-bar-fill { background: #a0a0a0; }\n.stat-agility .stat-bar-fill { background: #f4c542; }\n.stat-regen .stat-bar-fill { background: #38d996; }\n.stat-recovery .stat-bar-fill { background: #8214ff; }\n.stat-cooldown .stat-bar-fill { background: #f4f4f4; }\n.stat-bar-fill {\n  height: 100%;\n  border-radius: inherit;\n  background: linear-gradient(90deg, #167bff, #20d9ff);\n  transition: width 250ms ease;\n}\n/* Narrower fighter cards and contained portraits */\n/* Keep the two cards usable on smaller screens */\n@media (max-width: 620px) {\n  .fighter-grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .fighter-portrait { height: clamp(65px, 12vh, 100px);\n    max-width: 150px;\n  }\n}\n.fighter-grid {\n  flex: 1;\n  min-height: 0;\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 270px));\n  align-items: center;\n  gap: 12px;\n  justify-content: center;\n}\n.fighter-portrait {\n  width: 100%;\n  height: clamp(75px, 16vh, 150px);\n  min-height: 0;\n  object-fit: contain;\n  object-position: center;\n  border-radius: 7px;\n  background: #0003;\n  max-width: 130px;\n  align-self: center;\n}\n.team-attack-card:not(:disabled):hover {\n  border-color: var(--cyan);\n  background: #12354a;\n}\n.team-attack-card:disabled {\n  opacity: 0.4;\n  cursor: not-allowed;\n}\n.team-attack-image-placeholder {\n  display: grid;\n  place-items: center;\n  color: var(--muted);\n  font-size: 9px;\n}\n.team-attack-damage,\n.team-attack-cost {\n  color: #c2d2e4;\n  font-size: 9px;\n  text-align: center;\n}\n.team-attack-cost {\n  color: #58dcff;\n  font-weight: 700;\n}\n.team-attack-effects {\n  position: absolute;\n  z-index: 4;\n  bottom: calc(100% + 5px);\n  left: 0;\n  width: max-content;\n  max-width: 220px;\n  display: none;\n  padding: 8px;\n  border: 1px solid #ffffff30;\n  border-radius: 7px;\n  background: #0b1321;\n  box-shadow: 0 5px 18px #0009;\n  font-size: 9px;\n}\n.team-attack-wrapper:hover .team-attack-effects,\n.team-attack-wrapper:focus-within .team-attack-effects {\n  display: block;\n}\n.team-effect-heading,\n.team-effect {\n  display: inline-block;\n  margin: 2px;\n}\n.team-effect-heading {\n  font-weight: 900;\n}\n.buff-heading,\n.team-effect.buff {\n  color: #55e6a5;\n}\n.debuff-heading,\n.team-effect.debuff {\n  color: #ff7187;\n}\n@media (max-width: 620px) {\n  .team-attack-grid {\n    grid-auto-columns: minmax(115px, 40vw);\n  }\n}\n/* Give the attack panels and cards room to breathe */\n.attack-panel-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: baseline;\n  gap: 6px;\n  flex: 0 0 auto;\n}\n.team-attack-name {\n  width: 100%;\n  overflow: hidden;\n  font-size: 10px;\n  text-align: center;\n  text-overflow: ellipsis;\n  white-space: normal;\n  line-height: 1.2;\n}\n@media (max-width: 850px) {\n}\n.team-attack-image,\n.team-attack-image-placeholder {\n  width: 100%;\n  height: 64px;\n  flex: 0 0 58px;\n  border-radius: 5px;\n  object-fit: contain;\n  background: #0004;\n  flex-basis: 64px;\n}\n@media (max-width: 850px) {\n\n  .player-attack-panel {\n    min-height: 260px;\n  }\n}\n.finish-turn-button { /* overrides margin-top: auto */\n  flex: 0 0 auto;\n  margin-top: 8px;\n}\n/* Shorten the battlefield so the attack panels fit higher on screen */\n@media (max-height: 800px) {\n  .battlefield {\n    height: 52vh;\n  }\n}\n@media (max-width: 850px) {\n}\n/* Keep the battle and controls together in the viewport */\n.battle-header {\n  display: grid;\n  grid-template-columns: 1fr auto 1fr;\n  align-items: center;\n  gap: 16px;\n  flex: 0 0 auto;\n}\n.combat-log,\n.player-attack-panel {\n  min-width: 0;\n  min-height: 0;\n  overflow: hidden;\n  border: 1px solid #20d9ff45;\n  border-radius: 11px;\n  background: var(--panel);\n  box-shadow: 0 5px 20px #0003;\n  height: 100%;\n}\n@media (max-height: 800px) {\n}\n@media (max-width: 850px) {\n  .team-battle {\n    height: auto;\n    min-height: 100vh;\n    overflow-y: visible;\n    overflow: visible;\n  }\n\n  .battlefield {\n    height: auto;\n    min-height: 420px;\n    flex: none;\n  }\n\n  .battle-bottom {\n    grid-template-columns: 1fr;\n    flex: none;\n    overflow: visible;\n  }\n}\n.team-battle {\n  --cyan: #20d9ff;\n  --red: #ff3f61;\n  --panel: rgba(8, 16, 31, 0.96);\n  --muted: #9baec5;\n\n  width: 100%;\n  height: 100vh;\n  min-height: 0;\n  overflow: hidden;\n  padding: 14px 22px 18px;\n  display: flex;\n  grid-template-rows: 46px minmax(0, 1fr) 190px;\n  gap: 12px;\n  color: #f5f8ff;\n  font-family: Arial, Helvetica, sans-serif;\n  background:\n    radial-gradient(ellipse at 50% 45%, rgba(33, 72, 105, 0.34), transparent 54%),\n    linear-gradient(135deg, #080d18, #111827 52%, #080d18);\n  box-sizing: border-box;\n  overflow-y: auto;\n  flex-direction: column;\n  position: relative;\n}\n.team-battle #combatPopupContainer {\n  position: fixed;\n  top: 50%;\n  left: 50%;\n  right: auto;\n  bottom: auto;\n  transform: translate(-50%, -50%);\n  z-index: 10001;\n\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 8px;\n  width: min(420px, calc(100vw - 32px));\n  pointer-events: none;\n}\n.team-battle .combat-popup {\n  animation: combatPopupAnimation 3.1s ease-in-out both;\n}\n@media (max-width: 600px) {\n  .team-battle #combatPopupContainer {\n    top: 12px;\n    right: 12px;\n    max-width: calc(100vw - 24px);\n  }\n}\n.fighter-card {\n  min-width: 0;\n  height: min(100%, 340px);\n  overflow: hidden;\n  display: flex;\n  flex-direction: column;\n  gap: 9px;\n  padding: 10px;\n  border: 1px solid #ff3f6170;\n  border-radius: 12px;\n  background: linear-gradient(155deg, #172033f5, #090f1cf5);\n  text-align: left;\n  box-shadow: 0 8px 24px #0005;\n  transition: border-color 160ms ease, transform 160ms ease, box-shadow 160ms ease;\n  width: 100%;\n  justify-self: center;\n  position: relative;\n}\n.fighter-card-content {\n  display: flex;\n  flex-direction: column;\n  gap: 0.75rem;\n  width: 100%;\n  min-width: 0;\n}\n.fighter-effects {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 5px;\n  margin-top: 6px;\n  position: absolute;\n  left: 10px;\n  right: 10px;\n  bottom: 10px;\n  max-height: 56px;\n  overflow-y: auto;\n  z-index: 2;\n  pointer-events: none;\n}\n.fighter-effect {\n  padding: 3px 6px;\n  border-radius: 4px;\n  font-size: 0.68rem;\n  font-weight: 700;\n  line-height: 1.2;\n}\n.fighter-effect.buff {\n  color: #8fffc0;\n  background: #137a49;\n  border: 1px solid #35d987;\n}\n.fighter-effect.debuff {\n  color: #ff9aa8;\n  background: #a51e3d;\n  border: 1px solid #ff5263;\n}\n.ally-attack-popup {\n  position: absolute;\n  z-index: 20;\n  top: 50%;\n  left: 50%;\n  width: min(390px, calc(100% - 32px));\n  padding: 20px;\n  overflow: hidden;\n  color: #fff;\n  text-align: center;\n  background: linear-gradient(145deg, #18243b, #101522 75%);\n  border: 1px solid rgba(91, 211, 255, 0.65);\n  border-radius: 18px;\n  box-shadow:\n    0 0 28px rgba(38, 185, 255, 0.28),\n    0 18px 55px rgba(0, 0, 0, 0.55);\n  transform: translate(-50%, -50%);\n  animation: ally-popup-in 220ms ease-out both;\n}\n.ally-popup-label {\n  margin-bottom: 16px;\n  color: #75e3ff;\n  font-size: 0.78rem;\n  font-weight: 800;\n  letter-spacing: 0.16em;\n}\n.ally-popup-matchup {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n}\n.ally-popup-fighter {\n  display: flex;\n  min-width: 0;\n  flex: 1;\n  flex-direction: column;\n  align-items: center;\n  gap: 6px;\n}\n.ally-popup-fighter img {\n  width: 72px;\n  height: 72px;\n  object-fit: cover;\n  border: 2px solid rgba(117, 227, 255, 0.75);\n  border-radius: 50%;\n}\n.ally-popup-fighter strong {\n  max-width: 100%;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.ally-popup-fighter small {\n  color: #9ba9c2;\n  font-size: 0.68rem;\n  letter-spacing: 0.12em;\n}\n.ally-popup-arrow {\n  color: #75e3ff;\n  font-size: 1.6rem;\n  animation: ally-arrow-pulse 700ms ease-in-out infinite alternate;\n}\n.ally-popup-attack-name {\n  margin-top: 16px;\n  color: #fff;\n  font-size: 1.05rem;\n  font-weight: 800;\n  text-shadow: 0 0 12px rgba(117, 227, 255, 0.45);\n}\n.ally-popup-timer {\n  height: 3px;\n  margin-top: 16px;\n  overflow: hidden;\n  background: rgba(255, 255, 255, 0.12);\n  border-radius: 99px;\n}\n.ally-popup-timer span {\n  display: block;\n  width: 100%;\n  height: 100%;\n  background: #75e3ff;\n  transform-origin: left;\n  animation: ally-popup-countdown 2s linear forwards;\n}\n@keyframes ally-popup-in {\n  from {\n    opacity: 0;\n    transform: translate(-50%, -46%) scale(0.96);\n  }\n  to {\n    opacity: 1;\n    transform: translate(-50%, -50%) scale(1);\n  }\n}\n@keyframes ally-popup-countdown {\n  to {\n    transform: scaleX(0);\n  }\n}\n@keyframes ally-arrow-pulse {\n  to {\n    transform: translateX(4px);\n    opacity: 0.65;\n  }\n}\n/* Override broad/global image rules inside battle popups */\n.ally-attack-popup .ally-popup-portrait,\n.incoming-attack .incoming-portrait {\n  display: block;\n  width: 76px;\n  height: 76px;\n  max-width: 76px;\n  max-height: 76px;\n  flex: 0 0 76px;\n  object-fit: contain;\n  object-position: center;\n  border-radius: 50%;\n  background: #101a2b;\n}\n/* Keep popup columns from stretching the portraits */\n.ally-popup-fighter,\n.incoming-fighter {\n  min-width: 0;\n}\n.ally-popup-fighter img,\n.incoming-fighter img {\n  box-sizing: border-box;\n}\n.ally-popup-outcome {\n  margin-top: 10px;\n  color: #8fffc0;\n  font-size: 12px;\n  font-weight: 800;\n}\n/* Local co-op: show incoming attacks as independent stacked cards. */\nbattlefield > .local-coop-incoming {\n  width: min(330px, 38%);\n  max-height: 46%;\n}\n@media (max-width: 620px) {\n  .battlefield > .local-coop-incoming {\n    width: min(330px, 88%);\n    max-height: 46%;\n  }\n}\n.player-attack-popup {\n  position: absolute;\n  z-index: 20;\n  top: 50%;\n  left: 50%;\n  width: min(390px, calc(100% - 32px));\n  max-height: 94%;\n  overflow-y: auto;\n  padding: 20px;\n  color: #fff;\n  text-align: center;\n  background: linear-gradient(145deg, #18243b, #101522 75%);\n  border: 1px solid rgba(91, 211, 255, 0.65);\n  border-radius: 18px;\n  box-shadow:\n    0 0 0 100vmax #0005,\n    0 0 28px rgba(38, 185, 255, 0.28),\n    0 18px 55px rgba(0, 0, 0, 0.55);\n  transform: translate(-50%, -50%);\n  animation: ally-popup-in 220ms ease-out both;\n}\n#combatPopupContainer {\n  position: fixed;\n  top: 50%;\n  left: 50%;\n  right: auto;\n  bottom: auto;\n  transform: translate(-50%, -50%);\n  z-index: 10001;\n}\n/* Final local-co-op card positions */\n.take-damage-button {\n  flex: 1 1 100%;\n  min-height: 38px;\n  padding: 0.6rem 1rem;\n  border: 1px solid #ff6b78;\n  border-radius: 8px;\n  background: linear-gradient(135deg, #7f2637, #4b1828);\n  color: #fff;\n  font: inherit;\n  font-size: 0.78rem;\n  font-weight: 700;\n  letter-spacing: 0.04em;\n  text-transform: uppercase;\n  cursor: pointer;\n  transition:\n    background 160ms ease,\n    border-color 160ms ease,\n    transform 160ms ease,\n    box-shadow 160ms ease;\n}\n.take-damage-button:hover:not(:disabled) {\n  transform: translateY(-1px);\n  border-color: #ff9aa3;\n  background: linear-gradient(135deg, #a83248, #681f35);\n  box-shadow: 0 0 14px rgb(255 70 100 / 30%);\n}\n.take-damage-button:focus-visible {\n  outline: 2px solid #ffd1d6;\n  outline-offset: 2px;\n}\n.take-damage-button:disabled {\n  opacity: 0.45;\n  cursor: not-allowed;\n}\n/* Damage threat colors */\n.threat-very-safe { color: #65e6a3; }\n.threat-safe { color: #9be66b; }\n.threat-moderate { color: #f4d35e; }\n.threat-hazardous { color: #ffad5c; }\n.threat-dangerous { color: #ff765e; }\n.threat-life-threatening { color: #ff4f70; }\n.threat-death { color: #e9d5ff; }\n/* =========================================\n   SPEED THREAT COLORS — TEAM BATTLE\n========================================= */\n.incoming-threats .speed-easy,\n.incoming-threats .speed-avoidable,\n.incoming-threats .speed-challenging,\n.incoming-threats .speed-fast,\n.incoming-threats .speed-very-fast,\n.incoming-threats .speed-unavoidable,\n.incoming-threats .speed-guaranteed {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  padding: 5px 9px;\n  border: 1px solid currentColor;\n  border-radius: 6px;\n  font-size: 10px;\n  font-weight: 900;\n  letter-spacing: 0.6px;\n  text-transform: uppercase;\n  text-shadow: 0 0 7px currentColor;\n  transition:\n    background 0.2s ease,\n    box-shadow 0.2s ease;\n}\n.incoming-threats .speed-easy {\n  color: #65e6a3;\n  background: rgb(56 189 119 / 12%);\n}\n.incoming-threats .speed-avoidable {\n  color: #9be66b;\n  background: rgb(120 214 75 / 12%);\n}\n.incoming-threats .speed-challenging {\n  color: #ffe16b;\n  background: rgb(231 197 47 / 12%);\n}\n.incoming-threats .speed-fast {\n  color: #ffad5c;\n  background: rgb(255 129 56 / 12%);\n}\n.incoming-threats .speed-very-fast {\n  color: #ff7888;\n  background: rgb(237 65 78 / 14%);\n}\n.incoming-threats .speed-unavoidable {\n  color: #ff526e;\n  background: rgb(255 49 89 / 15%);\n  box-shadow: 0 0 8px rgb(255 49 89 / 15%);\n}\n.incoming-threats .speed-guaranteed {\n  color: #ffffff;\n  background: rgb(255 49 89 / 20%);\n  border-color: #ff3159;\n  box-shadow: 0 0 10px rgb(255 49 89 / 25%);\n}\n.team-attack-speed {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  gap: 5px;\n  padding: 5px 9px;\n\n  color: #13d5ff;\n  background: linear-gradient(145deg, #102d3a, #101923);\n  border: 1px solid #13d5ff;\n  border-radius: 6px;\n\n  font-size: 11px;\n  font-weight: 900;\n  letter-spacing: 0.7px;\n  text-transform: uppercase;\n\n  text-shadow: 0 0 7px rgb(19 213 255 / 45%);\n  box-shadow: 0 0 8px rgb(19 213 255 / 15%);\n}\n/* Incoming attack warning card */\n.incoming-attack {\n  position: absolute;\n  z-index: 5;\n  top: 50%;\n  left: 50%;\n  width: min(360px, 42%);\n  max-height: 94%;\n  overflow-y: auto;\n  padding: 14px;\n  transform: translate(-50%, -50%);\n  border: 1px solid #ff526f;\n  border-radius: 14px;\n  background:\n    linear-gradient(145deg, rgb(53 15 31 / 97%), rgb(11 15 27 / 98%));\n  box-shadow:\n    0 0 22px rgb(255 49 89 / 24%),\n    inset 0 0 18px rgb(255 49 89 / 7%);\n  text-align: center;\n  animation: card-enter 220ms ease-out both;\n}\n.incoming-topline {\n  display: flex;\n  justify-content: space-between;\n  gap: 8px;\n  color: #ff8295;\n  font-size: 11px;\n  font-weight: 900;\n  letter-spacing: 1.4px;\n  align-items: center;\n  padding-bottom: 8px;\n  border-bottom: 1px solid rgb(255 82 111 / 25%);\n}\n.incoming-topline span:first-child::before {\n  content: \"\";\n  display: inline-block;\n  width: 7px;\n  height: 7px;\n  margin-right: 7px;\n  border-radius: 50%;\n  background: #ff526f;\n  box-shadow: 0 0 9px #ff526f;\n  vertical-align: 1px;\n}\n.incoming-topline span:last-child {\n  color: #65eaff;\n  font-size: 16px;\n  font-variant-numeric: tabular-nums;\n  font-weight: 900;\n}\n.incoming-matchup {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) 22px minmax(0, 1fr);\n  align-items: center;\n  gap: 5px;\n  margin-top: 10px;\n  color: #eaf3ff;\n  font-size: 12px;\n  font-weight: 800;\n}\n.incoming-matchup .incoming-arrow {\n  color: #ff526f;\n  text-shadow: 0 0 10px rgb(255 82 111 / 70%);\n}\n.incoming-attack-image {\n  display: block;\n  width: min(100%, 230px);\n  height: 105px;\n  margin: 10px auto 6px;\n  object-fit: contain;\n  border-radius: 9px;\n  background:\n    radial-gradient(ellipse, rgb(255 82 111 / 15%), transparent 70%),\n    #080d18;\n  border: 1px solid rgb(255 255 255 / 12%);\n  filter: drop-shadow(0 0 8px rgb(255 82 111 / 25%));\n}\n.incoming-attack > h3 {\n  margin: 7px 0;\n  color: #fff;\n  font-size: 14px;\n  text-shadow: 0 0 12px rgb(255 255 255 / 18%);\n}\n.incoming-threats {\n  display: flex;\n  flex-wrap: wrap;\n  justify-content: center;\n  gap: 6px;\n  margin-top: 7px;\n  margin: 8px 0 10px;\n}\n.incoming-threats span {\n  padding: 5px 7px;\n  border: 1px solid currentColor;\n  border-radius: 5px;\n  font-size: 9px;\n  font-weight: 900;\n  letter-spacing: 0.35px;\n  background: rgb(0 0 0 / 25%);\n}\n.incoming-attack .defense-actions {\n  gap: 7px;\n  margin-top: 10px;\n}\n.incoming-attack .defense-actions button {\n  min-height: 38px;\n  transition: transform 140ms ease, filter 140ms ease, box-shadow 140ms ease;\n}\n.incoming-attack .defense-actions button:hover:not(:disabled) {\n  transform: translateY(-2px);\n  filter: brightness(1.12);\n  box-shadow: 0 4px 12px rgb(0 0 0 / 28%);\n}\n.incoming-attack .defense-actions button:disabled {\n  filter: grayscale(0.6);\n}\n.incoming-outcome {\n  margin-top: 10px;\n  padding-top: 9px;\n  border-top: 1px solid #ffffff25;\n  color: #8fffc0;\n  font-size: 11px;\n  font-weight: 800;\n}\n.timer-urgent {\n  color: #ff3159 !important;\n  animation: threat-pulse 650ms ease-in-out infinite alternate;\n}\n@keyframes threat-pulse {\n  to {\n    opacity: 0.55;\n    text-shadow: 0 0 12px #ff3159;\n  }\n}\n/* Two local-co-op cards: keep them compact enough to avoid covering the field */\n.battlefield > .local-coop-incoming {\n  width: min(360px, 38%);\n  max-height: 48%;\n  overflow-y: auto;\n}\n@media (max-width: 620px) {\n  .incoming-attack,\n  .battlefield > .local-coop-incoming {\n    width: min(360px, 90%);\n  }\n\n  .incoming-attack-image {\n    height: 82px;\n  }\n}\n.team-battle .battlefield > .incoming-attack.local-coop-incoming {\n  max-height: none !important;\n  overflow: visible !important;\n  padding: 20px !important;\n}\n@media (max-width: 620px) {\n  .team-battle .battlefield > .incoming-attack.local-coop-incoming {\n    max-height: none !important;\n    overflow: visible !important;\n    padding: 16px !important;\n  }\n}\n.battlefield > .local-coop-incoming.is-first {\n  top: 50% !important;\n  bottom: auto !important;\n  transform: translate(-50%, -50%) !important;\n  left: 27% !important;\n}\n.battlefield > .local-coop-incoming.is-second {\n  top: 50% !important;\n  bottom: auto !important;\n  transform: translate(-50%, -50%) !important;\n  left: 73% !important;\n}\n@media (max-width: 620px) {\n  .battlefield > .local-coop-incoming.is-first {\n    left: 50% !important;\n    top: 27% !important;\n  }\n\n  .battlefield > .local-coop-incoming.is-second {\n    left: 50% !important;\n    top: 73% !important;\n  }\n}\n/* =========================================\n   TEAM BATTLE — ROUND INTRO\n========================================= */\n.team-round-intro__eyebrow {\n  color: #a9b7ca;\n  font-size: 0.8rem;\n  font-weight: 800;\n  letter-spacing: 0.35em;\n}\n.team-round-intro__round {\n  margin: 0;\n  font-size: clamp(2rem, 5vw, 4rem);\n  font-weight: 1000;\n  font-style: italic;\n  letter-spacing: 0.08em;\n  text-shadow: 0 0 24px rgba(255, 255, 255, 0.2);\n}\n.team-round-intro__matchup {\n  width: min(1100px, 100%);\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);\n  align-items: center;\n  gap: clamp(12px, 3vw, 40px);\n}\n.team-round-intro__team {\n  min-width: 0;\n}\n.team-round-intro__label {\n  margin-bottom: 14px;\n  font-size: 0.85rem;\n  font-weight: 900;\n  letter-spacing: 0.16em;\n}\n.team-round-intro__team--cpu .team-round-intro__label {\n  color: #ff3159;\n}\n.team-round-intro__team--player .team-round-intro__label {\n  color: #13d5ff;\n}\n.team-round-intro__fighters {\n  display: flex;\n  justify-content: center;\n  gap: clamp(8px, 2vw, 22px);\n}\n.team-round-intro__fighter {\n  flex: 1;\n  min-width: 0;\n  max-width: 190px;\n  animation: teamFighterEntrance 0.65s ease-out both;\n}\n.team-round-intro__team--player .team-round-intro__fighter {\n  animation-name: teamFighterEntranceRight;\n}\n.team-round-intro__fighter img {\n  display: block;\n  width: 100%;\n  height: clamp(130px, 24vh, 250px);\n  object-fit: contain;\n  filter: drop-shadow(0 0 16px rgba(255, 255, 255, 0.12));\n}\n.team-round-intro__team--cpu .team-round-intro__fighter img {\n  filter: drop-shadow(0 0 18px rgba(255, 49, 89, 0.35));\n}\n.team-round-intro__team--player .team-round-intro__fighter img {\n  filter: drop-shadow(0 0 18px rgba(19, 213, 255, 0.35));\n}\n.team-round-intro__fighter span {\n  display: block;\n  margin-top: 8px;\n  overflow-wrap: anywhere;\n  font-size: clamp(0.75rem, 1.4vw, 1rem);\n  font-weight: 800;\n}\n.team-round-intro__vs {\n  color: #fff;\n  font-size: clamp(2.5rem, 7vw, 5rem);\n  font-weight: 1000;\n  font-style: italic;\n  text-shadow:\n    0 0 12px rgba(255, 255, 255, 0.35),\n    0 0 32px rgba(255, 49, 89, 0.2);\n  animation: teamVsPulse 1s ease-in-out infinite alternate;\n}\n.team-round-intro__footer {\n  color: #d5deeb;\n  font-size: 0.9rem;\n  font-weight: 900;\n  letter-spacing: 0.35em;\n  animation: teamFooterPulse 1s ease-in-out infinite alternate;\n}\n@keyframes teamIntroFadeIn {\n  from {\n    opacity: 0;\n  }\n  to {\n    opacity: 1;\n  }\n}\n@keyframes teamFighterEntrance {\n  from {\n    opacity: 0;\n    transform: translateX(-55px) scale(0.9);\n  }\n  to {\n    opacity: 1;\n    transform: translateX(0) scale(1);\n  }\n}\n@keyframes teamFighterEntranceRight {\n  from {\n    opacity: 0;\n    transform: translateX(55px) scale(0.9);\n  }\n  to {\n    opacity: 1;\n    transform: translateX(0) scale(1);\n  }\n}\n@keyframes teamVsPulse {\n  from {\n    transform: scale(0.96);\n  }\n  to {\n    transform: scale(1.08);\n  }\n}\n@keyframes teamFooterPulse {\n  from {\n    opacity: 0.55;\n  }\n  to {\n    opacity: 1;\n  }\n}\n@media (max-width: 600px) {\n  .team-round-intro {\n    gap: 14px;\n    padding: 14px;\n\n  }\n\n  .team-round-intro__matchup {\n    gap: 8px;\n  }\n\n  .team-round-intro__fighter img {\n    height: clamp(100px, 19vh, 170px);\n  }\n\n  .team-round-intro__label {\n    font-size: 0.65rem;\n    letter-spacing: 0.08em;\n  }\n\n  .team-round-intro__footer {\n    font-size: 0.75rem;\n  }\n}\n.error-screen {\n  display: grid;\n  height: auto;\n  min-height: 100vh;\n  padding: 24px;\n  place-items: center;\n  background:\n    radial-gradient(ellipse at 50% 35%, rgba(118, 46, 66, 0.28), transparent 55%),\n    #101116;\n  color: #f5f1f2;\n}\n.error-card {\n  width: min(100%, 480px);\n  padding: 40px 32px;\n  text-align: center;\n  border: 1px solid rgba(255, 115, 133, 0.35);\n  border-radius: 18px;\n  background: linear-gradient(145deg, #242127, #17171d);\n  box-shadow: 0 24px 70px rgba(0, 0, 0, 0.48);\n}\n.error-icon {\n  width: 56px;\n  height: 56px;\n  display: grid;\n  place-items: center;\n  margin: 0 auto 20px;\n  border: 2px solid #ff7185;\n  border-radius: 50%;\n  color: #ff7185;\n  font-size: 30px;\n  font-weight: 800;\n}\n.error-eyebrow {\n  margin: 0 0 10px;\n  color: #ff9aa8;\n  font-size: 0.75rem;\n  font-weight: 800;\n  letter-spacing: 0.18em;\n}\n.error-card h2 {\n  margin: 0;\n  font-size: clamp(1.6rem, 5vw, 2.2rem);\n}\n.error-message {\n  max-width: 360px;\n  margin: 14px auto 26px;\n  color: #c8c2c7;\n  line-height: 1.6;\n}\n.error-back-button {\n  padding: 12px 20px;\n  border: 0;\n  border-radius: 8px;\n  background: #ff7185;\n  color: #20151a;\n  font: inherit;\n  font-weight: 800;\n  cursor: pointer;\n  transition: transform 150ms ease, background 150ms ease;\n}\n.error-back-button:hover {\n  transform: translateY(-2px);\n  background: #ff91a0;\n}\n.error-back-button:focus-visible {\n  outline: 3px solid #fff;\n  outline-offset: 3px;\n}\n/* TEAM BATTLE — ROUND INTRO */\n.team-round-intro {\n\n  /* Prevent the old entrance animation from overriding opacity. */\n  position: fixed;\n  inset: 0;\n  transition:\n    opacity 0.6s ease,\n    visibility 0s linear 0.6s;\n  z-index: 10000;\n\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 18px;\n  padding: 24px;\n  overflow: hidden;\n\n  color: #fff;\n  text-align: center;\n\n  background:\n    radial-gradient(\n      ellipse at 20% 50%,\n      rgba(255, 49, 89, 0.22),\n      transparent 45%\n    ),\n    radial-gradient(\n      ellipse at 80% 50%,\n      rgba(19, 213, 255, 0.20),\n      transparent 45%\n    ),\n    rgba(3, 7, 17, 0.97);\n  animation: none !important;\n\n  opacity: 0;\n  visibility: hidden;\n}\n.team-round-intro.is-visible {\n  opacity: 1;\n  visibility: visible;\n  transition:\n    opacity 0.45s ease-out,\n    visibility 0s linear 0s;\n}\n.team-round-intro.is-hiding {\n  opacity: 0;\n  visibility: visible;\n  pointer-events: none;\n  transition:\n    opacity 0.6s ease,\n    visibility 0s linear 0s;\n}\n/* Knocked-out fighter indicator */\n.fighter-ko-badge {\n  position: absolute;\n  top: 42%;\n  left: 50%;\n  z-index: 5;\n  transform: translate(-50%, -50%) rotate(-8deg);\n\n  padding: 6px 14px;\n  color: #fff;\n  background: #b5092b;\n  border: 2px solid #ff7187;\n  border-radius: 6px;\n\n  font-size: clamp(1.2rem, 2.5vw, 2rem);\n  font-weight: 1000;\n  font-style: italic;\n  letter-spacing: 0.12em;\n  text-shadow: 0 2px 8px #000;\n  box-shadow: 0 0 18px #ff315966;\n\n  pointer-events: none;\n}\n.fighter-card.is-defeated .fighter-portrait {\n  filter: grayscale(1);\n}\n/* ================================\n   TEAM BATTLE — K.O. CUTSCENE\n================================ */\n.team-ko-overlay {\n  position: fixed;\n  inset: 0;\n  z-index: 9999;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  overflow: hidden;\n  isolation: isolate;\n  background:\n    radial-gradient(ellipse at center, #33101b 0%, #100810 48%, #03050b 100%);\n  animation: teamKoScreenEnter 0.35s ease-out both;\n}\n.team-ko-overlay.ko-opponent {\n  --ko-color: #ff3159;\n  --ko-glow: rgba(255, 49, 89, 0.7);\n}\n.team-ko-overlay.ko-player {\n  --ko-color: #13d5ff;\n  --ko-glow: rgba(19, 213, 255, 0.65);\n}\n.team-ko-flash {\n  position: absolute;\n  inset: 0;\n  z-index: -1;\n  background: white;\n  pointer-events: none;\n  animation: teamKoFlash 0.65s ease-out both;\n}\n.team-ko-content {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  width: min(92vw, 700px);\n  text-align: center;\n  animation: teamKoImpact 0.7s cubic-bezier(0.16, 1, 0.3, 1) both;\n}\n.team-ko-eyebrow {\n  margin: 0 0 8px;\n  color: var(--ko-color);\n  font-size: clamp(0.75rem, 2vw, 1rem);\n  font-weight: 900;\n  letter-spacing: 0.35em;\n  text-transform: uppercase;\n  text-shadow: 0 0 18px var(--ko-glow);\n  animation: teamKoTextReveal 0.4s 0.15s both;\n}\n.team-ko-portrait {\n  display: block;\n  width: clamp(150px, 27vw, 260px);\n  height: clamp(190px, 34vw, 330px);\n  object-fit: contain;\n  object-position: center bottom;\n  filter:\n    grayscale(1)\n    drop-shadow(0 0 22px var(--ko-glow));\n  transform-origin: center bottom;\n  animation: teamKoFall 0.75s 0.1s cubic-bezier(0.2, 0.7, 0.3, 1) both;\n}\n.team-ko-title {\n  position: relative;\n  z-index: 2;\n  margin: -18px 0 0;\n  color: #fff;\n  font-size: clamp(4.5rem, 15vw, 9rem);\n  font-weight: 1000;\n  font-style: italic;\n  line-height: 0.95;\n  letter-spacing: -0.07em;\n  -webkit-text-stroke: 2px var(--ko-color);\n  text-shadow:\n    4px 4px 0 #5d071b,\n    0 0 14px var(--ko-glow),\n    0 0 38px var(--ko-glow);\n  animation: teamKoTitleImpact 0.55s 0.25s cubic-bezier(0.16, 1, 0.3, 1) both;\n}\n.team-ko-name {\n  margin: 18px 0 0;\n  color: #fff;\n  font-size: clamp(1.25rem, 4vw, 2.3rem);\n  font-weight: 950;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  text-shadow: 0 3px 12px #000;\n  animation: teamKoTextReveal 0.4s 0.4s both;\n}\n.team-ko-subtitle {\n  margin: 8px 0 0;\n  color: var(--ko-color);\n  font-size: clamp(0.7rem, 2vw, 0.95rem);\n  font-weight: 900;\n  letter-spacing: 0.3em;\n  animation: teamKoTextReveal 0.4s 0.55s both;\n}\n@keyframes teamKoScreenEnter {\n  from {\n    opacity: 0;\n  }\n  to {\n    opacity: 1;\n  }\n}\n@keyframes teamKoFlash {\n  0% {\n    opacity: 0.95;\n  }\n  100% {\n    opacity: 0;\n  }\n}\n@keyframes teamKoImpact {\n  0% {\n    opacity: 0;\n    transform: scale(0.72) translateY(24px);\n  }\n  65% {\n    opacity: 1;\n    transform: scale(1.04) translateY(-3px);\n  }\n  100% {\n    opacity: 1;\n    transform: scale(1) translateY(0);\n  }\n}\n@keyframes teamKoFall {\n  0% {\n    opacity: 0;\n    transform: translateY(-35px) rotate(5deg) scale(1.08);\n  }\n  55% {\n    opacity: 1;\n    transform: translateY(8px) rotate(-3deg) scale(0.96);\n  }\n  75% {\n    transform: translateY(-3px) rotate(1deg) scale(1.01);\n  }\n  100% {\n    opacity: 1;\n    transform: translateY(0) rotate(0) scale(1);\n  }\n}\n@keyframes teamKoTitleImpact {\n  0% {\n    opacity: 0;\n    transform: scale(2.2) rotate(-8deg);\n  }\n  65% {\n    opacity: 1;\n    transform: scale(0.88) rotate(2deg);\n  }\n  100% {\n    opacity: 1;\n    transform: scale(1) rotate(0);\n  }\n}\n@keyframes teamKoTextReveal {\n  from {\n    opacity: 0;\n    transform: translateY(12px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n@media (prefers-reduced-motion: reduce) {\n  .team-ko-overlay,\n  .team-ko-flash,\n  .team-ko-content,\n  .team-ko-portrait,\n  .team-ko-title,\n  .team-ko-eyebrow,\n  .team-ko-name,\n  .team-ko-subtitle {\n    animation-duration: 0.01ms;\n    animation-delay: 0ms;\n  }\n}\n/* Fade the K.O. cutscene out before React removes it */\n.team-ko-overlay.is-fading-out {\n  animation: teamKoScreenExit 0.5s ease-in forwards;\n}\n@keyframes teamKoScreenExit {\n  from {\n    opacity: 1;\n  }\n\n  to {\n    opacity: 0;\n  }\n}\n.team-round-intro__name {\n  display: block;\n  margin-top: 8px;\n  color: #fff;\n  font-weight: 800;\n}\n.team-round-intro__status {\n  display: inline-block;\n  margin-top: 6px;\n  padding: 4px 7px;\n  border-radius: 5px;\n  font-size: clamp(0.65rem, 1.2vw, 0.85rem);\n  font-weight: 900;\n  font-variant-numeric: tabular-nums;\n}\n.team-round-intro__status.status-alive {\n  color: #8fffc0;\n  background: #176b4933;\n  border: 1px solid #43d995;\n}\n.team-round-intro__status.status-ko {\n  color: #ff7187;\n  background: #b5092b33;\n  border: 1px solid #ff3159;\n  letter-spacing: 0.12em;\n  text-shadow: 0 0 8px #ff315966;\n}\n.team-round-intro__fighter.is-defeated img {\n  filter: grayscale(1) brightness(0.65);\n  opacity: 0.75;\n}\n.team-round-intro__healthbar {\n  width: min(100%, 160px);\n  height: 9px;\n  margin: 8px auto 0;\n  overflow: hidden;\n  background: #10131c;\n  border: 1px solid #ffffff55;\n  border-radius: 999px;\n  box-shadow: inset 0 1px 3px #0009;\n}\n.team-round-intro__healthbar-fill {\n  height: 100%;\n  border-radius: inherit;\n  transition:\n    width 350ms ease,\n    background-color 250ms ease,\n    box-shadow 250ms ease;\n}\n.team-round-intro__healthbar.health-healthy\n  .team-round-intro__healthbar-fill {\n  background: #35df83;\n  box-shadow: 0 0 8px #35df8380;\n}\n.team-round-intro__healthbar.health-warning\n  .team-round-intro__healthbar-fill {\n  background: #f4d438;\n  box-shadow: 0 0 8px #f4d43880;\n}\n.team-round-intro__healthbar.health-danger\n  .team-round-intro__healthbar-fill {\n  background: #ff343f;\n  box-shadow: 0 0 9px #ff343f99;\n}\n.team-round-intro__healthbar.health-critical\n  .team-round-intro__healthbar-fill {\n  background: #690018;\n  box-shadow: 0 0 7px #690018;\n}\n.team-round-intro__fighter.is-defeated\n  .team-round-intro__healthbar-fill {\n  background: #25252b;\n  box-shadow: none;\n}\n@media (prefers-reduced-motion: reduce) {\n  .team-round-intro__healthbar-fill {\n    transition: none;\n  }\n}\n.team-finish-overlay {\n  position: fixed;\n  inset: 0;\n  z-index: 10002;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  overflow: hidden;\n  padding: 24px;\n  color: #fff;\n  text-align: center;\n  background:\n    radial-gradient(ellipse at center, #222b40 0%, #0a0d17 65%, #020309 100%);\n  animation: teamFinishEnter 450ms ease-out both;\n}\n.team-finish-overlay.finish-victory {\n  --finish-color: #13d5ff;\n  --finish-glow: #13d5ff88;\n}\n.team-finish-overlay.finish-defeat {\n  --finish-color: #ff3159;\n  --finish-glow: #ff315988;\n}\n.team-finish-flash {\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  background: var(--finish-color);\n  animation: teamFinishFlash 650ms ease-out both;\n}\n.team-finish-eyebrow,\n.team-finish-title,\n.team-finish-message,\n.team-finish-versus,\n.team-finish-side,\n.team-finish-footer {\n  position: relative;\n  z-index: 1;\n}\n.team-finish-eyebrow {\n  margin: 0 0 8px;\n  color: var(--finish-color);\n  font-size: 0.8rem;\n  font-weight: 900;\n  letter-spacing: 0.35em;\n}\n.team-finish-title {\n  margin: 0;\n  font-size: clamp(3.5rem, 10vw, 7rem);\n  font-weight: 1000;\n  font-style: italic;\n  line-height: 0.95;\n  text-shadow: 0 0 16px var(--finish-glow), 0 0 40px var(--finish-glow);\n  animation: teamFinishTitleImpact 700ms cubic-bezier(.16, 1, .3, 1) both;\n}\n.team-finish-message {\n  margin: 12px 0 26px;\n  color: #e3eaf6;\n  font-size: clamp(0.65rem, 1.7vw, 0.95rem);\n  font-weight: 800;\n  letter-spacing: 0.12em;\n}\n.team-finish-versus {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);\n  align-items: center;\n  gap: clamp(10px, 3vw, 32px);\n  width: min(100%, 1000px);\n}\n.team-finish-side {\n  min-width: 0;\n}\n.team-finish-side h2 {\n  margin: 0 0 14px;\n  color: var(--finish-color);\n  font-size: clamp(0.8rem, 2vw, 1.2rem);\n  font-weight: 950;\n  letter-spacing: 0.18em;\n}\n.team-finish-cards {\n  display: flex;\n  justify-content: center;\n  gap: clamp(8px, 1.5vw, 18px);\n}\n.team-finish-card {\n  display: flex;\n  flex: 1;\n  flex-direction: column;\n  align-items: center;\n  min-width: 0;\n  max-width: 190px;\n  padding: 8px;\n  background: #111827cc;\n  border: 1px solid #ffffff30;\n  border-radius: 10px;\n  animation: teamFinishCardWin 750ms cubic-bezier(.16, 1, .3, 1) both;\n  animation-delay: calc(350ms + var(--card-index, 0) * 130ms);\n}\n.winning-side .team-finish-card {\n  border-color: var(--finish-color);\n  box-shadow: 0 0 22px var(--finish-glow);\n}\n.defeated-side .team-finish-card {\n  filter: grayscale(1);\n  opacity: 0.7;\n  animation-name: teamFinishCardLose;\n}\n.team-finish-card img {\n  display: block;\n  width: 100%;\n  height: clamp(100px, 22vh, 210px);\n  object-fit: contain;\n}\n.team-finish-card strong {\n  margin-top: 8px;\n  font-size: clamp(0.65rem, 1.5vw, 0.95rem);\n  overflow-wrap: anywhere;\n}\n.team-finish-card span {\n  margin-top: 6px;\n  color: var(--finish-color);\n  font-size: 0.75rem;\n  font-weight: 900;\n}\n.defeated-side .team-finish-card span {\n  color: #ff7187;\n}\n.team-finish-vs {\n  color: #fff;\n  font-size: clamp(1.6rem, 4vw, 3rem);\n  font-weight: 1000;\n  font-style: italic;\n  text-shadow: 0 0 16px var(--finish-glow);\n}\n.team-finish-footer {\n  margin: 26px 0 0;\n  color: #aab7ca;\n  font-size: 0.7rem;\n  font-weight: 800;\n  letter-spacing: 0.3em;\n  animation: teamFinishFooterPulse 1s ease-in-out infinite alternate;\n}\n@keyframes teamFinishEnter {\n  from { opacity: 0; }\n  to { opacity: 1; }\n}\n@keyframes teamFinishFlash {\n  0% { opacity: 0.75; }\n  100% { opacity: 0; }\n}\n@keyframes teamFinishTitleImpact {\n  0% { opacity: 0; transform: scale(1.7) rotate(-5deg); }\n  65% { opacity: 1; transform: scale(0.94) rotate(1deg); }\n  100% { opacity: 1; transform: scale(1) rotate(0); }\n}\n@keyframes teamFinishCardWin {\n  from { opacity: 0; transform: translateY(65px) scale(0.75); }\n  70% { opacity: 1; transform: translateY(-8px) scale(1.04); }\n  to { opacity: 1; transform: translateY(0) scale(1); }\n}\n@keyframes teamFinishCardLose {\n  from { opacity: 0; transform: translateY(-45px) rotate(-5deg); }\n  to { opacity: 0.7; transform: translateY(12px) rotate(3deg); }\n}\n@keyframes teamFinishFooterPulse {\n  to { opacity: 0.55; }\n}\n@media (max-width: 620px) {\n  .team-finish-overlay {\n    padding: 12px;\n  }\n\n  .team-finish-versus {\n    gap: 7px;\n  }\n\n  .team-finish-card {\n    padding: 4px;\n  }\n\n  .team-finish-card img {\n    height: clamp(80px, 16vh, 140px);\n  }\n}\n@media (prefers-reduced-motion: reduce) {\n  .team-finish-overlay,\n  .team-finish-flash,\n  .team-finish-title,\n  .team-finish-card,\n  .team-finish-footer {\n    animation-duration: 0.01ms;\n    animation-delay: 0ms;\n  }\n}\n/* Fade out the Team K.O. screen before showing the result screen */\n.team-finish-overlay.is-fading-out {\n  animation: teamFinishFadeOut 0.6s ease-in forwards;\n  pointer-events: none;\n}\n@keyframes teamFinishFadeOut {\n  from {\n    opacity: 1;\n  }\n\n  to {\n    opacity: 0;\n  }\n}\n.battlefield {\n  position: relative;\n  isolation: isolate;\n  min-height: 0;\n  overflow: hidden;\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) minmax(90px, 0.18fr) minmax(0, 1fr);\n  align-items: stretch;\n  gap: 12px;\n  padding: 16px;\n\n  border: 2px solid #13d5ff;\n  border-radius: 14px;\n  background:\n    linear-gradient(90deg, #080e1bd9, #111b2a55 50%, #080e1bd9),\n    radial-gradient(ellipse at center, #293a4d, #101725 72%);\n\n  box-shadow:\n    0 0 8px rgba(19, 213, 255, 0.35),\n    inset 0 0 8px rgba(19, 213, 255, 0.12);\n  height: auto;\n  margin-bottom: 0;\n  flex: 1 1 auto;\n}\n.team-battle-story-background {\n  position: absolute;\n  inset: 0;\n  z-index: -1;\n\n  background-size: cover;\n  background-position: center;\n  background-repeat: no-repeat;\n\n  border-radius: inherit;\n  pointer-events: none;\n}\n/* =========================================\n   TEAM BATTLE — ATTACK CARD AVAILABILITY\n========================================= */\n/* Keep card content in a predictable vertical layout */\n/* Image */\n.team-attack-card .team-attack-image,\n.team-attack-card .team-attack-image-placeholder {\n  flex: 0 0 64px;\n  width: 100%;\n  height: 64px;\n  object-fit: contain;\n}\n/* Name and damage */\n.team-attack-card .team-attack-name {\n  display: block;\n  width: 100%;\n  line-height: 1.2;\n  text-align: center;\n}\n.team-attack-card .team-attack-damage {\n  display: block;\n  width: 100%;\n  line-height: 1.2;\n}\n/* Mana and availability container */\n/* Each availability label */\n.team-attack-availability {\n  display: block;\n  width: 100%;\n  font-size: 8px;\n  font-weight: 900;\n  letter-spacing: 0.4px;\n  line-height: 1.3;\n  text-align: center;\n}\n/* =========================================\n   LIMITED USES — RED\n========================================= */\n.team-attack-card.team-attack-limited {\n  background: linear-gradient(145deg, #391923, #101827);\n  border: 1.5px solid #F04452;\n  box-shadow:\n    0 0 9px rgba(240, 68, 82, 0.25),\n    inset 0 0 15px rgba(100, 15, 25, 0.2);\n}\n.team-attack-limited .team-attack-cost {\n  background: linear-gradient(145deg, #481923, #21131e);\n  border: 1px solid #F04452;\n}\n.team-attack-limited .team-attack-availability {\n  color: #FF6875;\n}\n/* =========================================\n   TURN COOLDOWN — ORANGE\n========================================= */\n.team-attack-card.team-attack-cooldown {\n  background: linear-gradient(145deg, #382516, #101827);\n  border: 1.5px solid #FF9B32;\n  box-shadow:\n    0 0 9px rgba(255, 155, 50, 0.25),\n    inset 0 0 15px rgba(100, 50, 10, 0.2);\n}\n.team-attack-cooldown .team-attack-cost {\n  background: linear-gradient(145deg, #493019, #211a15);\n  border: 1px solid #FF9B32;\n}\n.team-attack-cooldown .team-attack-availability {\n  color: #FFC078;\n}\n/* =========================================\n   BOTH RESTRICTIONS — DARK CRIMSON\n========================================= */\n.team-attack-card.team-attack-limited-cooldown {\n  background: linear-gradient(145deg, #100207, #1B050C 55%, #260711);\n  border: 1.5px solid #A92D48;\n  box-shadow:\n    0 0 9px rgba(169, 45, 72, 0.35),\n    inset 0 0 15px rgba(100, 10, 30, 0.2);\n}\n.team-attack-limited-cooldown .team-attack-cost {\n  background: linear-gradient(145deg, #16030A, #21050D);\n  border: 1px solid #822039;\n}\n.team-attack-limited-cooldown .team-attack-availability {\n  color: #FF7189;\n}\n/* =========================================\n   EXHAUSTED ATTACK\n========================================= */\n.team-attack-card.is-exhausted {\n  filter: grayscale(0.8);\n  opacity: 0.55;\n}\n.team-attack-card.is-exhausted .team-attack-availability {\n  color: #FF7187;\n}\n/* =========================================\n   HEALTH SACRIFICE — OBSIDIAN RED\n========================================= */\n.team-attack-card.team-attack-sacrifice {\n  background:\n    radial-gradient(\n      ellipse at 50% 100%,\n      rgba(120, 0, 20, 0.30),\n      transparent 65%\n    ),\n    linear-gradient(\n      145deg,\n      #160307 0%,\n      #050000 45%,\n      #200509 100%\n    ) !important;\n\n  color: #fff !important;\n  border: 1px solid #8f192c !important;\n\n  box-shadow:\n    inset 0 0 18px rgba(140, 0, 25, 0.20),\n    0 0 8px rgba(140, 0, 25, 0.25);\n}\n.team-attack-card.team-attack-sacrifice:not(:disabled):hover {\n  border-color: #ff3159 !important;\n  box-shadow:\n    inset 0 0 24px rgba(180, 20, 25, 0.28),\n    0 0 12px rgba(255, 49, 89, 0.35);\n}\n.team-attack-sacrifice .team-attack-image {\n  background: #050000 !important;\n}\n/* Sacrifice header */\n.team-attack-card .team-attack-sacrifice-header {\n  display: block;\n  flex: 0 0 auto;\n  width: calc(100% + 14px);\n  box-sizing: border-box;\n  margin: -7px -7px 2px;\n  padding: 6px 3px;\n\n  border-bottom: 1px solid #ff526b;\n  background: linear-gradient(90deg, #a51d35, #5b0b1b, #a51d35);\n\n  color: #fff;\n  font-size: 8px;\n  font-weight: 900;\n  letter-spacing: 1px;\n  line-height: 1.3;\n  text-align: center;\n}\n/* Sacrifice cost */\n.team-attack-card .team-attack-sacrifice-cost {\n  display: block;\n  width: 100%;\n  box-sizing: border-box;\n  padding: 5px 3px;\n\n  border: 1px solid #a51d35;\n  border-radius: 4px;\n\n  background: linear-gradient(90deg, #26050a, #100205, #26050a);\n  color: #ff7187 !important;\n\n  font-size: 8px;\n  font-weight: 900;\n  letter-spacing: 0.4px;\n  line-height: 1.3;\n  text-align: center;\n}\n/* Keep availability text visible on disabled cards */\n.team-attack-card:disabled .team-attack-availability {\n  opacity: 1;\n}\n.heal-target-portrait {\n  width: 38px;\n  height: 38px;\n  object-fit: cover;\n  border-radius: 50%;\n  vertical-align: middle;\n  margin-right: 10px;\n}\n.target-choice-button span {\n  display: block;\n  font-size: 0.8rem;\n  opacity: 0.75;\n  margin-top: 4px;\n}\n/* =========================================\n   2v2 STUNNED ATTACK CARDS\n========================================= */\n.team-attack-card.team-attack-stunned {\n  position: relative;\n  isolation: isolate;\n  overflow: hidden;\n  border: 2px solid #38dfff !important;\n  box-shadow:\n    0 0 10px rgba(19, 213, 255, 0.65),\n    inset 0 0 16px rgba(19, 213, 255, 0.18);\n  animation: stun-card-pulse 1.5s infinite ease-in-out;\n}\n/* Moving light streak */\n.team-attack-card.team-attack-stunned::after {\n  content: \"\";\n  position: absolute;\n  z-index: 4;\n  top: -70%;\n  left: -100%;\n  width: 65%;\n  height: 240%;\n  pointer-events: none;\n\n  background: linear-gradient(\n    90deg,\n    transparent,\n    rgba(19, 213, 255, 0.08),\n    rgba(138, 240, 255, 0.75),\n    rgba(255, 255, 255, 0.95),\n    rgba(19, 213, 255, 0.35),\n    transparent\n  );\n\n  filter: blur(5px);\n  transform: rotate(25deg);\n  animation: stun-light-sweep 2.2s ease-in-out infinite;\n}\n/* Stun label and lock */\n.team-stun-overlay {\n  position: absolute;\n  z-index: 5;\n  inset: 0;\n\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 7px;\n\n  background: rgba(2, 13, 27, 0.78);\n  color: #8af0ff;\n  text-align: center;\n  text-shadow: 0 0 10px #13d5ff;\n  pointer-events: none;\n}\n.team-stun-overlay strong {\n  font-size: 1.05rem;\n  font-weight: 1000;\n  letter-spacing: 3px;\n}\n.team-stun-overlay small {\n  font-size: 0.62rem;\n  font-weight: 800;\n  letter-spacing: 1px;\n}\n/* =========================================\n   2v2 STUNNED FIGHTER PORTRAITS\n========================================= */\n.fighter-portrait-wrapper {\n  position: relative;\n  display: block;\n  width: fit-content;\n  max-width: 100%;\n  margin-inline: auto;\n}\n.fighter-portrait-wrapper.fighter-stunned {\n  animation: stunned-fighter-shake 0.35s infinite;\n}\n.fighter-portrait-wrapper.fighter-stunned img {\n  filter:\n    drop-shadow(0 0 5px #13d5ff)\n    drop-shadow(0 0 14px rgba(19, 213, 255, 0.9));\n\n  animation: stunned-electric-glow 1s ease-in-out infinite alternate;\n}\n/* Moving light across the portrait */\n.fighter-portrait-wrapper.fighter-stunned::after {\n  content: \"\";\n  position: absolute;\n  z-index: 3;\n  inset: 0;\n  pointer-events: none;\n\n  background: linear-gradient(\n    110deg,\n    transparent 25%,\n    rgba(19, 213, 255, 0.1) 40%,\n    rgba(255, 255, 255, 0.85) 50%,\n    rgba(19, 213, 255, 0.35) 58%,\n    transparent 75%\n  );\n\n  background-size: 250% 100%;\n  animation: portrait-lightning-sweep 1.7s linear infinite;\n}\n/* Reuse the same animation timing as 1v1 */\n@keyframes portrait-lightning-sweep {\n  from {\n    background-position: 100% 0;\n  }\n\n  to {\n    background-position: -150% 0;\n  }\n}\n/* Accessibility */\n@media (prefers-reduced-motion: reduce) {\n  .team-attack-card.team-attack-stunned,\n  .team-attack-card.team-attack-stunned::after,\n  .fighter-portrait-wrapper.fighter-stunned,\n  .fighter-portrait-wrapper.fighter-stunned img,\n  .fighter-portrait-wrapper.fighter-stunned::after {\n    animation: none !important;\n  }\n}\n/* =========================================\n   TEAM BATTLE — ATTACK CARD CONTENT VISIBILITY\n========================================= */\n/* Give the bottom battle panels more vertical room */\n.battle-bottom {\n  min-height: 0;\n  display: grid;\n  grid-template-columns: minmax(220px, 0.6fr) minmax(0, 1fr) minmax(0, 1fr);\n  gap: 12px;\n  align-items: stretch;\n  margin-top: 0;\n  padding-bottom: 0;\n  flex: 0 0 330px;\n  overflow: hidden;\n}\n/* Slightly reduce the panel height on shorter screens */\n@media (max-height: 800px) {\n  .battle-bottom {\n    flex-basis: 310px;\n  }\n}\n/* Allow the attack grid to scroll vertically if necessary */\n.team-attack-grid {\n  flex: 1 1 auto;\n  min-height: 0;\n  overflow-x: auto;\n  display: grid;\n  grid-auto-columns: 112px;\n  grid-auto-flow: column;\n  gap: 8px;\n  padding: 2px 2px 14px;\n  overflow-y: auto;\n  grid-auto-rows: 220px;\n  align-content: start;\n}\n/* Give every attack card enough room for its information */\n.team-attack-wrapper {\n  position: relative;\n  min-width: 0;\n  min-height: 220px;\n  height: 220px;\n}\n.team-attack-card {\n  width: 100%;\n  height: 100%;\n  min-height: 220px;\n  padding: 7px;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 5px;\n  border: 1px solid #31516a;\n  border-radius: 8px;\n  background: linear-gradient(145deg, #14283c, #0b1422);\n  cursor: pointer;\n  box-sizing: border-box;\n  justify-content: flex-start;\n  overflow: hidden;\n  text-align: center;\n}\n/* Prevent important information from shrinking */\n.team-attack-card .team-attack-image,\n.team-attack-card .team-attack-image-placeholder,\n.team-attack-card .team-attack-name,\n.team-attack-card .team-attack-damage,\n.team-attack-card .team-attack-speed,\n.team-attack-card .team-attack-cost {\n  flex-shrink: 0;\n}\n/* Make speed information consistently readable */\n.team-attack-card .team-attack-speed {\n  display: block;\n  width: 100%;\n  line-height: 1.3;\n  text-align: center;\n}\n/* Keep mana, uses, cooldown and sacrifice costs visible */\n.team-attack-card .team-attack-cost {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 4px;\n  width: 100%;\n  box-sizing: border-box;\n  margin-top: 3px;\n  padding: 5px 4px;\n  line-height: 1.3;\n  border-radius: 4px;\n  text-align: center;\n  flex: 0 0 auto;\n}\n/* Preserve the attack panel's layout */\n.player-attack-panel {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  padding: 10px;\n  min-width: 0;\n  min-height: 0;\n  height: auto;\n  align-self: start;\n  justify-content: flex-start;\n  overflow: visible;\n}\n/* =========================================\n   WILD CARDS — TEAM BATTLE THEME\n   ========================================= */\n.team-battle {\n  --cyan: #13d5ff;\n  --red: #ff3159;\n  --lime: #a5f51b;\n  --gold: #f6d84a;\n  --panel: rgba(17, 29, 19, 0.97);\n  --muted: #b4c1aa;\n\n  color: #fff9e9;\n  font-family: \"Rajdhani\", sans-serif;\n  background:\n    radial-gradient(\n      ellipse at 50% 35%,\n      rgba(165, 245, 27, 0.12),\n      transparent 55%\n    ),\n    linear-gradient(135deg, #17251a, #0c150e 55%, #080d1c);\n}\n.team-battle h1,\n.team-battle h2,\n.team-battle h3,\n.team-battle button,\n.team-battle .header-team-label,\n.team-battle .attack-panel-header,\n.team-battle .team-heading {\n  font-family: \"Oxanium\", sans-serif;\n}\n/* HEADER */\n.battle-header h1 {\n  color: #fff8e8;\n  text-shadow: 0 0 14px rgba(165, 245, 27, 0.2);\n}\n.battle-header h1 span {\n  color: var(--gold);\n}\n.header-team-label {\n  color: var(--muted);\n}\n.cpu-label {\n  color: #ff7187;\n}\n.player-label {\n  color: #50e6ff;\n}\n/* BATTLEFIELD */\n.battlefield {\n  background:\n    radial-gradient(\n      ellipse at center,\n      rgba(165, 245, 27, 0.07),\n      transparent 65%\n    ),\n    linear-gradient(145deg, #19291b, #0c150f);\n  border-color: rgba(165, 245, 27, 0.18);\n}\n.battlefield::before {\n  background: repeating-linear-gradient(\n    0deg,\n    transparent 0 48px,\n    rgba(165, 245, 27, 0.035) 49px 50px\n  );\n}\n/* TEAM HEADINGS */\n.team-heading {\n  color: #ff7187;\n}\n.player-team .team-heading {\n  color: #50e6ff;\n}\n.team-heading h2 {\n  color: inherit;\n}\n/* FIGHTER CARDS */\n.fighter-card {\n  color: #fff8e8;\n  border-color: rgba(255, 49, 89, 0.3);\n  background:\n    radial-gradient(\n      ellipse at 50% 20%,\n      rgba(255, 49, 89, 0.07),\n      transparent 70%\n    ),\n    linear-gradient(145deg, #263021, #101812);\n}\n.player-team .fighter-card {\n  border-color: rgba(19, 213, 255, 0.35);\n  background:\n    radial-gradient(\n      ellipse at 50% 20%,\n      rgba(19, 213, 255, 0.07),\n      transparent 70%\n    ),\n    linear-gradient(145deg, #1c3029, #101812);\n}\n.fighter-card-heading h3 {\n  color: #fff8e8;\n}\n.fighter-card.is-selected {\n  border-color: var(--lime);\n  box-shadow:\n    0 0 12px rgba(165, 245, 27, 0.35),\n    0 0 22px rgba(165, 245, 27, 0.15);\n}\n.selected-mark {\n  color: var(--lime);\n}\n.fighter-card.is-defeated {\n  opacity: 0.4;\n  filter: grayscale(1);\n}\n/* FIGHTER RESOURCE BARS */\n.resource-label {\n  color: #dce7d4;\n}\n.resource-value {\n  color: #c0cdb6;\n}\n.resource-track {\n  background: #263629;\n}\n.health-fill {\n  background: linear-gradient(90deg, #ff3159, #ff9b78);\n}\n.mana-fill {\n  background: linear-gradient(90deg, #167bff, #20d9ff);\n}\n.fighter-stats,\n.fighter-stat-bars {\n  border-top-color: rgba(255, 255, 255, 0.12);\n  color: var(--muted);\n}\n.fighter-stats b,\n.stat-bar-row b {\n  color: #fff8e8;\n}\n.stat-bar-track {\n  background: #263629;\n}\n/* CENTER VERSUS MARK */\n.versus-mark {\n  border-color: rgba(246, 216, 74, 0.45);\n  color: var(--gold);\n  background: rgba(15, 25, 16, 0.9);\n  box-shadow: 0 0 22px rgba(246, 216, 74, 0.12);\n}\n.battle-center p {\n  color: #c4d0bb;\n}\n/* COMBAT LOG */\n.combat-log,\n.player-attack-panel {\n  border-color: rgba(165, 245, 27, 0.25);\n  background: linear-gradient(145deg, #1b2b1d, #0d160f);\n  box-shadow: 0 5px 20px rgba(0, 0, 0, 0.35);\n}\n.combat-log header {\n  color: var(--gold);\n  border-bottom-color: rgba(246, 216, 74, 0.2);\n}\n.log-dot {\n  background: var(--lime);\n  box-shadow: 0 0 8px var(--lime);\n}\n.combat-log-messages p {\n  color: #c7d2bf;\n}\n/* ATTACK PANEL */\n.player-attack-panel.is-active {\n  border-color: rgba(165, 245, 27, 0.65);\n  box-shadow: 0 0 16px rgba(165, 245, 27, 0.1);\n}\n.attack-panel-header h3 {\n  color: #fff8e8;\n}\n.attack-panel-header span {\n  color: var(--gold);\n}\n.attack-button,\n.team-attack-card {\n  color: #f5f4df;\n  border-color: rgba(165, 245, 27, 0.25);\n  background: linear-gradient(145deg, #263923, #101a13);\n}\n.attack-button strong,\n.team-attack-name {\n  color: #fff8e8;\n}\n.attack-button span,\n.team-attack-speed {\n  color: #c2ceb8;\n}\n.attack-button:not(:disabled):hover,\n.team-attack-card:not(:disabled):hover {\n  border-color: var(--lime);\n  background: linear-gradient(145deg, #354c2b, #172719);\n  box-shadow: 0 0 15px rgba(165, 245, 27, 0.16);\n}\n.attack-button:disabled,\n.team-attack-card:disabled {\n  opacity: 0.38;\n}\n/* TURN BUTTON */\n.finish-turn-button {\n  border-color: #fff1a0;\n  background: linear-gradient(135deg, #fff078, #f6d84a 65%, #d49b23);\n  color: #1a210c;\n  box-shadow: 0 0 16px rgba(246, 216, 74, 0.18);\n}\n.finish-turn-button:hover:not(:disabled) {\n  filter: brightness(1.1);\n  box-shadow: 0 0 22px rgba(246, 216, 74, 0.35);\n}\n/* INCOMING ATTACK — CPU RED */\n.incoming-attack {\n  color: #fff4f3;\n  border-color: #ff526f;\n  background: linear-gradient(\n    145deg,\n    rgba(53, 22, 31, 0.98),\n    rgba(13, 16, 19, 0.98)\n  );\n  box-shadow:\n    0 0 22px rgba(255, 49, 89, 0.2),\n    inset 0 0 18px rgba(255, 49, 89, 0.05);\n}\n.incoming-topline {\n  color: #ff8295;\n  border-bottom-color: rgba(255, 82, 111, 0.25);\n}\n.incoming-topline span:last-child {\n  color: #f6d84a;\n}\n.incoming-attack h3 {\n  color: #fff0f1;\n}\n.incoming-attack > p {\n  color: #d1c5c4;\n}\n/* DEFENSE BUTTONS */\n.defend-button {\n  background: linear-gradient(135deg, #b87914, #e6a52c);\n  color: #211908 !important;\n}\n.evade-button {\n  background: linear-gradient(135deg, #087d51, #0ca66b);\n  color: white !important;\n}\n/* TARGET SELECTION MODAL */\n.target-modal-backdrop {\n  background: rgba(3, 9, 5, 0.88);\n}\n.target-modal {\n  border-color: rgba(165, 245, 27, 0.45);\n  background: linear-gradient(145deg, #263723, #101912);\n  box-shadow: 0 0 28px rgba(165, 245, 27, 0.12);\n}\n.target-modal .eyebrow {\n  color: var(--gold);\n}\n.target-modal h2 {\n  color: #fff8e8;\n}\n.target-modal > p {\n  color: #c1cdb7;\n}\n.target-choice-group {\n  border-color: rgba(255, 255, 255, 0.13);\n}\n.target-choice-button {\n  border-color: rgba(165, 245, 27, 0.2);\n  background: #19291b;\n  color: #fff8e8;\n}\n.target-choice-button.is-selected {\n  border-color: var(--lime);\n  background: #304525;\n  box-shadow: 0 0 12px rgba(165, 245, 27, 0.13);\n}\n.confirm-target-button {\n  background: linear-gradient(135deg, #fff078, #f6d84a);\n  color: #1a210c;\n}\n/* TEAM ROUND INTRO */\n.team-round-intro {\n  background:\n    radial-gradient(\n      ellipse at 20% 50%,\n      rgba(255, 49, 89, 0.18),\n      transparent 45%\n    ),\n    radial-gradient(\n      ellipse at 80% 50%,\n      rgba(165, 245, 27, 0.17),\n      transparent 45%\n    ),\n    rgba(3, 10, 5, 0.97);\n}\n.team-round-intro__eyebrow {\n  color: var(--gold);\n}\n.team-round-intro__vs {\n  color: var(--gold);\n}\n.team-round-intro__team--player .team-round-intro__label {\n  color: #50e6ff;\n}\n.team-round-intro__team--cpu .team-round-intro__label {\n  color: #ff7187;\n}\n.team-round-intro__footer {\n  color: #d1ddc7;\n}\n/* KNOCKOUT OVERLAY */\n.team-ko-overlay {\n  background:\n    radial-gradient(\n      ellipse at center,\n      #263b22 0%,\n      #10190f 48%,\n      #030704 100%\n    );\n}\n.team-ko-overlay.ko-opponent {\n  --ko-color: #ff3159;\n  --ko-glow: rgba(255, 49, 89, 0.7);\n}\n.team-ko-overlay.ko-player {\n  --ko-color: #13d5ff;\n  --ko-glow: rgba(19, 213, 255, 0.65);\n}\n/* TEAM VICTORY / DEFEAT */\n.team-finish-overlay {\n  background:\n    radial-gradient(\n      ellipse at center,\n      #263b22 0%,\n      #10190f 60%,\n      #030704 100%\n    );\n}\n.team-finish-overlay.finish-victory {\n  --finish-color: #a5f51b;\n  --finish-glow: rgba(165, 245, 27, 0.5);\n}\n.team-finish-overlay.finish-defeat {\n  --finish-color: #ff3159;\n  --finish-glow: #ff315988;\n}\n.team-finish-message {\n  color: #e5eddc;\n}\n.team-finish-card {\n  border-color: rgba(165, 245, 27, 0.25);\n  background: linear-gradient(145deg, #243523, #101810);\n}\n/* ERROR SCREEN */\n.team-battle.error-screen {\n  background:\n    radial-gradient(\n      ellipse at 50% 35%,\n      rgba(255, 49, 89, 0.12),\n      transparent 55%\n    ),\n    #101810;\n}\n.team-battle .error-card {\n  border-color: rgba(165, 245, 27, 0.3);\n  background: linear-gradient(145deg, #263723, #111a12);\n}\n.team-battle .error-eyebrow {\n  color: var(--gold);\n}\n.team-battle .error-back-button {\n  background: var(--gold);\n  color: #211d0c;\n}\n/* FOCUS VISIBILITY */\n.team-battle button:focus-visible {\n  outline: 2px solid var(--gold);\n  outline-offset: 3px;\n}\n/* BUTTON POLISH — SOFTER TEAM BATTLE PALETTE */\n.team-battle .defend-button {\n  background: linear-gradient(135deg, #89651f, #b58b3c);\n  border-color: #c5a45c;\n  color: #fff7e5 !important;\n}\n.team-battle .evade-button {\n  background: linear-gradient(135deg, #205b40, #347a55);\n  border-color: #559875;\n  color: #f2fff5 !important;\n}\n.team-battle .take-damage-button {\n  background: linear-gradient(135deg, #702b34, #963d43);\n  border-color: #b65c62;\n  color: #fff4f4;\n}\n.team-battle .defend-button:hover:not(:disabled),\n.team-battle .evade-button:hover:not(:disabled),\n.team-battle .take-damage-button:hover:not(:disabled) {\n  filter: brightness(1.13);\n}\n.team-battle .confirm-target-button {\n  background: linear-gradient(135deg, #d8c36c, #bca44b);\n  border-color: #e3d38d;\n  color: #211e12;\n}\n.team-battle .confirm-target-button:hover {\n  background: linear-gradient(135deg, #ead98b, #d0b85d);\n  box-shadow: 0 0 12px rgba(218, 194, 108, 0.2);\n}\n.team-battle .target-choice-button.is-selected {\n  border-color: #a5c76c;\n  background: #293d29;\n  box-shadow: 0 0 10px rgba(165, 199, 108, 0.12);\n}\n.team-battle .team-attack-card:not(:disabled):hover {\n  border-color: #a5c76c;\n  box-shadow: 0 0 12px rgba(165, 199, 108, 0.12);\n}\n.team-battle .error-back-button {\n  background: #c5ad59;\n  color: #211e12;\n}\n/* Shared in-game pause control */\n.team-battle { position: relative; }\n/* ==========================================================\n   WILD CARDS — FIGHTER HUD REDESIGN\n   Artwork is independent from the compact top resource HUD.\n========================================================== */\n.fighter-grid {\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  align-items: stretch;\n  gap: clamp(10px, 1.5vw, 22px);\n}\n.fighter-unit {\n  position: relative;\n  display: flex;\n  min-width: 0;\n  min-height: 0;\n  flex-direction: column;\n  align-items: stretch;\n  justify-content: flex-start;\n  gap: clamp(5px, 1vh, 11px);\n  width: 100%;\n  max-width: 300px;\n  justify-self: center;\n  color: #f5f8ff;\n}\n.fighter-hud {\n  display: flex;\n  flex: 0 0 auto;\n  flex-direction: column;\n  gap: 5px;\n  width: 100%;\n  padding: 8px 9px;\n  border: 1px solid #ffffff20;\n  border-top: 2px solid #ff526b;\n  border-radius: 8px;\n  background: linear-gradient(145deg, #111c2beF, #080f1beF);\n  box-shadow: 0 5px 18px #0005;\n}\n.player-team .fighter-hud {\n  border-top-color: #20d9ff;\n}\n.fighter-hud-heading {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  min-width: 0;\n  margin-bottom: 2px;\n}\n.fighter-hud-heading h3 {\n  min-width: 0;\n  overflow: hidden;\n  flex: 1;\n  margin: 0;\n  color: #fff;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: clamp(11px, 1vw, 15px);\n  font-weight: 800;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.fighter-control-tag {\n  color: #f6c85f;\n  font-size: 8px;\n  font-weight: 900;\n  letter-spacing: .7px;\n}\n.fighter-hud .resource-row {\n  grid-template-columns: 20px minmax(0, 1fr) auto;\n  gap: 6px;\n  font-size: 9px;\n}\n.fighter-hud .resource-track {\n  height: 9px;\n  border: 1px solid #ffffff12;\n  background: #263247;\n  box-shadow: inset 0 1px 3px #0009;\n}\n.fighter-hud .resource-value {\n  min-width: 52px;\n  color: #e5edf8;\n  font-size: 9px;\n  text-align: right;\n}\n.fighter-charge-row {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 10px;\n  padding-top: 5px;\n  border-top: 1px solid #ffffff14;\n}\n.fighter-segmented-meter {\n  display: grid;\n  grid-template-columns: 24px minmax(0, 1fr) auto;\n  align-items: center;\n  gap: 5px;\n  min-width: 0;\n}\n.fighter-segmented-label {\n  color: #c9d6e6;\n  font-size: 8px;\n  font-weight: 900;\n  letter-spacing: .5px;\n}\n.fighter-segments {\n  display: grid;\n  grid-auto-columns: minmax(4px, 1fr);\n  grid-auto-flow: column;\n  gap: 3px;\n  min-width: 0;\n}\n.fighter-segments > span {\n  height: 9px;\n  min-width: 0;\n  border: 1px solid #ffffff26;\n  border-radius: 2px;\n  background: #263247;\n  box-shadow: inset 0 1px 2px #0007;\n}\n.meter-cooldown .fighter-segments > span.is-filled {\n  border-color: #ffcf70;\n  background: linear-gradient(180deg, #ffe49a, #e99a35);\n  box-shadow: 0 0 7px #ffb94a66;\n}\n.meter-recovery .fighter-segments > span.is-filled {\n  border-color: #8dffc4;\n  background: linear-gradient(180deg, #8affc0, #23b978);\n  box-shadow: 0 0 7px #39dc9866;\n}\n.fighter-segmented-meter > b {\n  color: #e5edf8;\n  font-size: 8px;\n  font-variant-numeric: tabular-nums;\n}\n.fighter-no-segments {\n  color: #7d8ca2;\n  font-size: 9px;\n  font-style: normal;\n}\n.fighter-art-button {\n  position: relative;\n  display: flex;\n  flex: 1 1 auto;\n  align-items: center;\n  justify-content: center;\n  width: 100%;\n  min-width: 0;\n  min-height: 130px;\n  height: auto;\n  padding: 0;\n  overflow: visible;\n  border: 1px solid transparent;\n  border-radius: 10px;\n  background: transparent;\n  box-shadow: none;\n  cursor: pointer;\n  transition: transform 180ms ease, filter 180ms ease;\n}\n.fighter-art-button:hover:not(:disabled),\n.fighter-art-button:focus-visible:not(:disabled) {\n  z-index: 6;\n  transform: translateY(-3px) scale(1.015);\n  outline: none;\n}\n.fighter-portrait-stage {\n  position: relative;\n  display: flex;\n  align-items: flex-end;\n  justify-content: center;\n  width: 100%;\n  height: clamp(155px, 27vh, 285px);\n  min-height: 0;\n  overflow: visible;\n  isolation: isolate;\n}\n.fighter-portrait-stage::after {\n  content: \"\";\n  position: absolute;\n  z-index: -1;\n  right: 10%;\n  bottom: 1px;\n  left: 10%;\n  height: 17px;\n  border-radius: 50%;\n  background: #000b;\n  filter: blur(10px);\n}\n.fighter-portrait-wrapper {\n  position: relative;\n  display: flex;\n  align-items: flex-end;\n  justify-content: center;\n  width: 100%;\n  height: 100%;\n  overflow: visible;\n}\n.fighter-portrait {\n  display: block;\n  width: auto;\n  max-width: min(100%, 250px);\n  height: 100%;\n  max-height: 100%;\n  object-fit: contain;\n  object-position: center bottom;\n  border: 0;\n  border-radius: 0;\n  background: transparent;\n  filter: drop-shadow(0 8px 12px #000b);\n  transition: filter 180ms ease, transform 180ms ease;\n}\n.fighter-art-button:hover .fighter-portrait,\n.fighter-art-button:focus-visible .fighter-portrait {\n  filter: drop-shadow(0 0 12px #20d9ff88) drop-shadow(0 9px 14px #000c);\n  transform: scale(1.025);\n}\n.cpu-team .fighter-unit .fighter-portrait {\n  filter: drop-shadow(0 0 7px #ff526b55) drop-shadow(0 8px 12px #000b);\n}\n.player-team .fighter-unit .fighter-portrait {\n  filter: drop-shadow(0 0 7px #20d9ff55) drop-shadow(0 8px 12px #000b);\n}\n.fighter-unit.is-selected .fighter-hud {\n  border-color: #a5ff19;\n  box-shadow: 0 0 15px #a5ff1938, 0 5px 18px #0005;\n}\n.fighter-unit.is-selected .fighter-art-button {\n  filter: drop-shadow(0 0 13px #a5ff1955);\n}\n.fighter-active-indicator {\n  position: absolute;\n  right: 50%;\n  bottom: 7px;\n  z-index: 2;\n  padding: 3px 8px;\n  transform: translateX(50%);\n  border: 1px solid #b4ff42a8;\n  border-radius: 99px;\n  color: #d4ff79;\n  background: #101a0de8;\n  font-size: 8px;\n  font-weight: 900;\n  letter-spacing: 1px;\n  white-space: nowrap;\n}\n.fighter-info-popup {\n  position: absolute;\n  z-index: 20;\n  right: 0;\n  bottom: calc(100% + 7px);\n  left: 0;\n  display: none;\n  max-height: min(260px, 45vh);\n  overflow-y: auto;\n  padding: 11px;\n  border: 1px solid #50dfffaa;\n  border-radius: 9px;\n  color: #f5f8ff;\n  background: linear-gradient(145deg, #101d2df7, #080e19fa);\n  box-shadow: 0 10px 30px #000c, 0 0 18px #20d9ff25;\n  text-align: left;\n  cursor: default;\n}\n.fighter-art-button:hover .fighter-info-popup,\n.fighter-art-button:focus-visible .fighter-info-popup {\n  display: block;\n}\n.fighter-info-popup-heading {\n  display: flex;\n  align-items: baseline;\n  justify-content: space-between;\n  gap: 8px;\n  padding-bottom: 7px;\n  margin-bottom: 7px;\n  border-bottom: 1px solid #ffffff20;\n}\n.fighter-info-popup-heading strong {\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: 13px;\n}\n.fighter-info-popup-heading > span {\n  color: #58dcff;\n  font-size: 8px;\n  font-weight: 900;\n  letter-spacing: 1px;\n}\n.fighter-info-stat-grid {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 6px 12px;\n}\n.fighter-info-stat-grid > div {\n  display: flex;\n  justify-content: space-between;\n  align-items: baseline;\n  gap: 5px;\n  min-width: 0;\n  font-size: 9px;\n}\n.fighter-info-stat-grid > div span {\n  color: #9eafc4;\n  font-size: 8px;\n  font-weight: 800;\n  letter-spacing: .4px;\n}\n.fighter-info-stat-grid > div b {\n  color: #fff;\n  font-size: 10px;\n  font-variant-numeric: tabular-nums;\n}\n.fighter-info-effects {\n  display: grid;\n  gap: 4px;\n  margin-top: 8px;\n  padding-top: 7px;\n  border-top: 1px solid #ffffff20;\n}\n.fighter-info-effects > strong {\n  color: #58dcff;\n  font-size: 8px;\n  letter-spacing: 1px;\n}\n.fighter-info-effects > span {\n  color: #b8f4d2;\n  font-size: 9px;\n}\n.fighter-info-stun {\n  margin-top: 7px;\n  color: #ff8797;\n  font-size: 9px;\n  font-weight: 900;\n  letter-spacing: 1px;\n}\n.fighter-info-hint {\n  display: block;\n  margin-top: 8px;\n  color: #71849b;\n  font-size: 8px;\n}\n.fighter-art-button.is-defeated {\n  opacity: .42;\n  filter: grayscale(1);\n  cursor: not-allowed;\n}\n.fighter-unit.is-defeated .fighter-hud {\n  opacity: .55;\n  filter: grayscale(.8);\n}\n.fighter-art-button.is-blocking {\n  animation: block-flash 650ms ease-out;\n}\n.fighter-art-button.has-stunned-attacks .fighter-portrait {\n  filter: grayscale(.45) drop-shadow(0 0 9px #b56cff88);\n}\n.team-attack-effects {\n  top: auto;\n  bottom: calc(100% + 7px);\n  max-width: min(240px, 75vw);\n  max-height: 220px;\n  overflow-y: auto;\n  padding: 10px;\n  border-color: #50dfff88;\n  background: linear-gradient(145deg, #101d2df7, #080e19fa);\n  text-align: left;\n}\n.team-effects-title {\n  margin: 0 0 6px;\n  color: #58dcff;\n  font-size: 9px;\n  font-weight: 900;\n  letter-spacing: 1px;\n}\n.team-effects-group {\n  margin-top: 5px;\n}\n.team-effect.heal,\n.heal-heading {\n  color: #8dffc4;\n}\n.team-attack-wrapper:focus-within .team-attack-effects {\n  display: block;\n}\n@media (max-width: 900px) {\n  .fighter-unit { gap: 5px; }\n  .fighter-hud { padding: 6px; gap: 4px; }\n  .fighter-charge-row { gap: 5px; }\n  .fighter-portrait-stage { height: clamp(125px, 23vh, 205px); }\n  .fighter-portrait { max-width: min(100%, 190px); }\n}\n@media (max-height: 700px) and (min-width: 621px) {\n  .fighter-portrait-stage { height: clamp(105px, 21vh, 175px); }\n  .fighter-hud { gap: 3px; padding: 5px 7px; }\n  .fighter-hud .resource-track { height: 7px; }\n  .fighter-segments > span { height: 7px; }\n}\n@media (max-width: 620px) {\n  .fighter-grid { gap: 6px; }\n  .fighter-unit { max-width: none; gap: 5px; }\n  .fighter-hud { padding: 6px; }\n  .fighter-hud-heading h3 { font-size: 10px; }\n  .fighter-hud .resource-row { grid-template-columns: 17px minmax(0, 1fr) auto; gap: 4px; }\n  .fighter-hud .resource-value { min-width: 42px; font-size: 8px; }\n  .fighter-charge-row { grid-template-columns: 1fr; gap: 4px; }\n  .fighter-portrait-stage { height: clamp(105px, 19vh, 165px); }\n  .fighter-info-popup { right: -15%; left: -15%; max-height: 230px; }\n  .fighter-info-stat-grid { gap: 5px 8px; }\n  .fighter-info-stat-grid > div span { font-size: 7px; }\n  .fighter-info-stat-grid > div b { font-size: 9px; }\n}\n/* The active highlight belongs to the fighter unit, not an image frame. */\n.fighter-art-button.is-selected {\n  border: 0;\n  box-shadow: none;\n}\n/* Fighter-specific impact feedback, matching the 1v1 combat language. */\n.fighter-impact-overlay {\n  position: absolute;\n  z-index: 9;\n  inset: 0;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-direction: column;\n  gap: 6px;\n  pointer-events: none;\n}\n.fighter-impact-number {\n  color: #fff;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: clamp(22px, 2.5vw, 42px);\n  font-weight: 1000;\n  line-height: 1;\n  -webkit-text-stroke: 1px #300b13;\n  text-shadow: 0 3px 0 #26060b, 0 0 12px #ff3159, 0 0 26px #ff3159;\n  animation: team-impact-pop 1.7s cubic-bezier(.15,.8,.25,1) both;\n}\n.fighter-impact-number.damage-tier-effective { animation: team-impact-effective 1.8s ease-out both; }\n.fighter-impact-number.damage-tier-heavy { color:#ffe7a3; font-size:clamp(28px,3.2vw,50px); animation:team-impact-heavy 1.95s ease-out both; }\n.fighter-impact-number.damage-tier-fatal { font-size:clamp(30px,3.8vw,58px); color:#fff; text-shadow:0 0 12px #ff3159,0 0 30px #ff3159,0 0 55px #ff3159; animation:team-impact-fatal 2.3s ease-out both; }\n.fighter-impact-overlay > span { padding:4px 9px; border:1px solid #ffffff70; border-radius:5px; color:#fff; background:#07101be8; font-size:10px; font-weight:1000; letter-spacing:1px; animation:team-impact-label 1.4s ease-out both; }\n.fighter-impact-status { position:absolute; left:50%; top:18%; padding:4px 8px; transform:translateX(-50%); border-radius:5px; color:#fff; background:#111d2bea; font-size:9px; font-weight:1000; white-space:nowrap; animation:team-impact-status 1.65s ease-out both; }\n.fighter-art-button:has(.impact-damage) .fighter-portrait { animation:team-hit-flash 1.08s ease-out; }\n.fighter-art-button:has(.impact-damage) { animation:team-hit-shake 1.02s ease-out; }\n.fighter-art-button:has(.impact-blocked) .fighter-portrait { animation:team-block-pulse .58s ease-out; }\n/* Evade the complete fighter card, not just the artwork inside its frame. */\n.fighter-art-button:has(.impact-evaded) { animation:team-card-evade-dodge .52s cubic-bezier(.2,.75,.25,1) both; }\n.fighter-art-button:has(.impact-evaded) .fighter-portrait { animation:none !important; }\n.fighter-art-button:has(.impact-reaction) .fighter-portrait { animation:team-hit-recoil .52s cubic-bezier(.2,.75,.25,1) both; }\n@keyframes team-card-evade-dodge {\n  0%,100% { transform:translateX(0) scale(1); }\n  42% { transform:translateX(24px) scale(.985); }\n  68% { transform:translateX(17px) scale(.99); }\n}\n@keyframes team-hit-recoil {\n  0%,100% { transform:translateX(0) rotate(0); }\n  28% { transform:translateX(-7px) rotate(-2deg); }\n  58% { transform:translateX(5px) rotate(1deg); }\n}\n@keyframes team-impact-pop {0%{opacity:0;transform:translateY(20px) scale(.5)}18%{opacity:1;transform:translateY(-5px) scale(1.18)}75%{opacity:1}100%{opacity:0;transform:translateY(-48px) scale(.95)}}\n@keyframes team-impact-effective {0%{opacity:0;transform:scale(.5)}18%{opacity:1;transform:scale(1.2)}30%,45%{transform:translateX(-3px) rotate(-2deg)}38%,53%{transform:translateX(3px) rotate(2deg)}100%{opacity:0;transform:translateY(-50px)}}\n@keyframes team-impact-heavy {0%{opacity:0;transform:scale(.35) rotate(-8deg)}18%{opacity:1;transform:scale(1.3) rotate(3deg)}28%,45%{transform:translateX(-7px)}36%,54%{transform:translateX(7px)}100%{opacity:0;transform:translateY(-58px)}}\n@keyframes team-impact-fatal {0%{opacity:0;transform:scale(.2) rotate(-12deg)}14%{opacity:1;transform:scale(1.45) rotate(3deg)}24%,42%,60%{transform:translateX(-10px) scale(1.1)}33%,51%,69%{transform:translateX(10px) scale(1.1)}100%{opacity:0;transform:translateY(-65px) scale(.85)}}\n@keyframes team-hit-flash {0%,100%{filter:brightness(1)}20%,55%{filter:brightness(1.8) sepia(1) saturate(5) hue-rotate(315deg)}}\n@keyframes team-hit-shake {0%,100%{transform:translateX(0)}20%,60%{transform:translateX(-5px)}40%,80%{transform:translateX(5px)}}\n@keyframes team-block-pulse {0%{filter:brightness(1)}35%{filter:brightness(1.8) drop-shadow(0 0 24px #b9e8ff)}100%{filter:brightness(1)}}\n@keyframes team-evade-dodge {0%,100%{transform:translateX(0);opacity:1}45%{transform:translateX(24px);opacity:.55}}\n@keyframes team-impact-label {0%{opacity:0;transform:scale(.6)}20%{opacity:1;transform:scale(1.1)}100%{opacity:0;transform:translateY(-18px)}}\n@keyframes team-impact-status {0%,100%{opacity:0;transform:translate(-50%,8px) scale(.85)}25%,70%{opacity:1;transform:translate(-50%,0) scale(1)}}\n.fighter-art-button:has(.damage-tier-fatal) .fighter-portrait { animation: team-fatal-recoil 1.95s cubic-bezier(.15,.75,.2,1); }\n.fighter-art-button:has(.damage-tier-effective) .fighter-portrait { animation:team-heavy-recoil .9s ease-out; }\n.fighter-art-button:has(.damage-tier-heavy) .fighter-portrait { animation: team-fatal-recoil 1.4s cubic-bezier(.15,.75,.2,1); }\n.fighter-art-button:has(.damage-tier-effective) { animation:team-hit-shake .72s ease-out; }\n.fighter-art-button:has(.damage-tier-heavy) { animation:team-hit-shake 1.2s ease-out; }\n.fighter-art-button:has(.damage-tier-fatal) { animation:team-hit-shake 1.35s ease-out; }\n@keyframes team-fatal-recoil {\n  0%{transform:translateY(0) rotate(0) scale(1)}\n  18%{transform:translateY(-9px) rotate(-3deg) scale(1.04)}\n  48%{transform:translateY(12px) rotate(5deg) scale(.97)}\n  68%{transform:translateY(6px) rotate(-3deg)}\n  100%{transform:translateY(0) rotate(0) scale(1)}\n}\n@keyframes team-heavy-recoil {\n  0%,100%{transform:translateX(0)}\n  25%{transform:translateX(-7px) rotate(-2deg)}\n  50%{transform:translateX(6px) rotate(2deg)}\n  75%{transform:translateX(-3px)}\n}\n.fighter-art-button:has(.impact-attack) .fighter-portrait { animation: team-attack-lunge .24s cubic-bezier(.18,.9,.25,1); }\n.player-team .fighter-art-button:has(.impact-attack) .fighter-portrait { animation-name: team-attack-lunge-left; }\n@keyframes team-attack-lunge { 0%,100%{transform:translateX(0) scale(1)}45%{transform:translateX(36px) scale(1.055)} }\n@keyframes team-attack-lunge-left { 0%,100%{transform:translateX(0) scale(1)}45%{transform:translateX(-36px) scale(1.055)} }\n.fighter-art-button:has(.effect-defense) { filter:drop-shadow(0 0 13px #aeb7c4aa); }\n.fighter-art-button:has(.effect-agility) { filter:drop-shadow(0 0 13px #ffe45baa); }\n.fighter-art-button:has(.effect-manaRegen) { filter:drop-shadow(0 0 13px #35bfffaa); }\n.fighter-art-button:has(.effect-stun) { filter:drop-shadow(0 0 16px #b56cffcc); }\n.fighter-art-button:has(.effect-stun) { filter:drop-shadow(0 0 16px #b56cffcc); }\n/* Team battle finish: smoother corners and a weighty defensive brace. */\n.team-battle .battlefield,\n.team-battle .fighter-card,\n.team-battle .fighter-hud,\n.team-battle .fighter-info-popup,\n.team-battle .player-attack-panel,\n.team-battle .combat-log,\n.team-battle .incoming-attack,\n.team-battle .target-modal {\n  border-radius: 14px !important;\n  clip-path: none !important;\n}\n.team-battle .fighter-card {\n  overflow: visible;\n  border-radius: 14px !important;\n}\n.team-battle .fighter-art-button,\n.team-battle .fighter-portrait-stage,\n.team-battle .fighter-portrait-wrapper {\n  border-radius: 12px;\n  clip-path: none !important;\n}\n.team-battle .fighter-art-button:has(.impact-blocked) .fighter-portrait {\n  transform-origin: center bottom;\n  animation: team-defensive-brace .38s cubic-bezier(.18,.9,.25,1) both;\n  filter: brightness(1.35) drop-shadow(0 0 13px #d9f2ff) drop-shadow(0 0 25px #73cfffaa);\n}\n.team-battle .fighter-art-button:has(.impact-blocked) .fighter-portrait-stage::before {\n  content: \"🛡 BLOCKED\";\n  position: absolute;\n  z-index: 6;\n  left: 50%;\n  top: 43%;\n  padding: 6px 12px;\n  transform: translate(-50%,-50%);\n  border: 1px solid #d9f2ff;\n  border-radius: 7px;\n  color: #f5fbff;\n  background: linear-gradient(145deg,#34516aee,#101d2fee);\n  box-shadow: 0 0 12px #9bdcff, inset 0 0 12px #d9f2ff55;\n  font: 900 11px Oxanium,Arial,sans-serif;\n  letter-spacing: 1px;\n  pointer-events: none;\n  animation: team-shield-flash .72s ease-out both;\n}\n@keyframes team-defensive-brace {\n  0%,100% { transform:translateY(0) rotate(0) scale(1); }\n  22% { transform:translateY(6px) rotate(-3deg) scale(.965); }\n  48% { transform:translateY(-2px) rotate(1deg) scale(1.025); }\n  70% { transform:translateY(1px) scale(.99); }\n}\n@keyframes team-shield-flash {\n  0% { opacity:0; filter:blur(3px); }\n  18%,62% { opacity:1; filter:blur(0); }\n  100% { opacity:0; }\n}\n.team-battle .battle-center { min-width:34px; }\n.team-battle .battle-center p {\n  max-width:190px;\n  padding:8px 10px;\n  border:1px solid #ffffff16;\n  border-radius:9px;\n  background:#0c1710bb;\n  font-size:10px;\n}\n.team-battle .fighter-card::before,\n.team-battle .fighter-card::after,\n.team-battle .fighter-unit::before,\n.team-battle .fighter-unit::after {\n  clip-path:none;\n  border-radius:inherit;\n}\n/* Team battle attack cards: match the glowing pause-menu visual language. */\n.team-battle .player-attack-panel { overflow:visible; border:1px solid #a5f51b65; border-radius:14px; background:linear-gradient(145deg,#18291d,#0b1510); box-shadow:0 0 18px #a5f51b16,0 8px 24px #0008; }\n.team-battle .attack-panel-header { padding:8px 10px; border-bottom:2px solid #a5f51b; color:#fff9e9; }\n.team-battle .team-attack-grid { overflow-x:auto; overflow-y:visible; padding:8px 5px 14px; }\n.team-battle .team-attack-wrapper { min-height:232px; height:232px; }\n.team-battle .team-attack-card { min-height:232px; border:1px solid #20d9ff75; border-radius:12px; background:linear-gradient(155deg,#172b40,#091522 75%); box-shadow:0 5px 16px #0007,inset 0 0 14px #20d9ff0d; transition:transform .18s ease,border-color .18s ease,box-shadow .18s ease,filter .18s ease; }\n.team-battle .team-attack-card:not(:disabled):hover { z-index:3; transform:translateY(-5px); border-color:#f6d84a!important; box-shadow:0 0 0 1px #f6d84a55,0 0 22px #f6d84a3b; filter:brightness(1.1); }\n.team-battle .team-attack-card:disabled { opacity:.46; filter:saturate(.55); }\n.team-battle .team-attack-card .team-attack-image { height:78px; flex-basis:78px; border:1px solid #ffffff35; border-radius:8px; background:#020811; }\n.team-battle .team-attack-card .team-attack-name { color:#fff; font:900 10px Oxanium,sans-serif; }\n.team-battle .team-attack-card .team-attack-damage { width:100%; padding:5px 4px; border:1px solid #ff315955; border-radius:6px; color:#ff8194; background:#ff31591c; font:900 9px Oxanium,sans-serif; }\n.team-battle .team-attack-card .team-attack-speed { padding:5px 4px; border:1px solid #13d5ff70; border-radius:6px; color:#66e7ff; background:#13d5ff14; font:900 9px Oxanium,sans-serif; }\n.team-battle .team-attack-card .team-attack-cost { margin-top:auto; padding:6px 5px; border:1px solid #f6d84a55; border-radius:7px; color:#ffe58b; background:#f6d84a12; font:900 8px Oxanium,sans-serif; line-height:1.35; }\n.team-battle .team-attack-card.team-attack-sacrifice { border-color:#ff3159!important; box-shadow:inset 0 0 16px #ff31591a; }\n.team-battle .team-attack-card.team-attack-cooldown { border-color:#f6a43a; }\n.team-battle .team-attack-card.team-attack-limited { border-color:#a5f51b; }\n.team-battle .team-attack-card.team-attack-limited-cooldown { border-color:#f6a43a; }\n.team-battle #combatPopupContainer { top:18px; right:18px; left:auto; bottom:auto; transform:none; align-items:flex-end; }\n/* Prismatic impact ring: shared with the 1v1 battle artwork. */\n.fighter-art-button:has(.impact-damage)::after {\n  content:\"\";\n  position:absolute;\n  z-index:8;\n  inset:5px;\n  border:3px solid transparent;\n  border-radius:12px;\n  background:conic-gradient(#ff3159,#ffb52e,#f7ed52,#5bff8a,#35eaff,#5574ff,#d45bff,#ff3159) border-box;\n  -webkit-mask:linear-gradient(#000 0 0) padding-box,linear-gradient(#000 0 0);\n  -webkit-mask-composite:xor;\n  mask-composite:exclude;\n  pointer-events:none;\n  animation:team-spectrum-ring 1.15s linear both;\n}\n@keyframes team-spectrum-ring {0%{opacity:0;transform:scale(.94) rotate(0)}25%{opacity:1}100%{opacity:0;transform:scale(1.04) rotate(360deg)}}\n/* Keep the electric stun sweep clipped to the portrait frame, not the whole card. */\n.team-battle .fighter-portrait-wrapper {\n  width:min(100%,250px); max-width:100%; min-width:0; height:100%;\n  overflow:hidden; border-radius:10px; isolation:isolate;\n}\n.team-battle .fighter-portrait-wrapper.fighter-stunned::after {\n  inset:0; width:100%; height:100%; border-radius:inherit; overflow:hidden;\n}\n.team-battle .fighter-portrait-wrapper.fighter-stunned img { max-width:100%; }\n/* Team-battle version of the high-impact STUNNED callout. */\n.team-battle .fighter-impact-overlay > .team-stunned-callout {\n  position:relative;\n  z-index:12;\n  padding:8px 16px;\n  border:2px solid #d7a8ff;\n  border-radius:9px;\n  color:#fff;\n  background:linear-gradient(135deg,#5a1b91f5,#170b2df5);\n  box-shadow:0 0 10px #c58aff,0 0 26px #a34dff,inset 0 0 14px #e6c4ff55;\n  font:1000 italic clamp(16px,2vw,27px) Oxanium,Arial,sans-serif;\n  letter-spacing:.13em;\n  text-shadow:0 2px 0 #310b55,0 0 12px #fff;\n  animation:team-stunned-hero 1.35s cubic-bezier(.16,1,.3,1) both;\n}\n@keyframes team-stunned-hero {\n  0% { opacity:0; transform:translateY(24px) scale(.35) rotate(-8deg); filter:blur(5px); }\n  18% { opacity:1; transform:translateY(-4px) scale(1.18) rotate(2deg); filter:blur(0); }\n  34%,50% { transform:translateX(-4px) rotate(-2deg) scale(1.06); }\n  42%,58% { transform:translateX(4px) rotate(2deg) scale(1.06); }\n  80% { opacity:1; transform:translateY(-7px) scale(1); }\n  100% { opacity:0; transform:translateY(-32px) scale(.92); }\n}\n/* Larger team winner/defeated showcase, matching the 1v1 finish beat. */\n.team-finish-overlay {\n  gap:clamp(8px,1.5vh,16px);\n  padding:clamp(14px,2.5vh,30px);\n}\n.team-finish-versus {\n  width:min(1180px,96vw);\n  gap:clamp(10px,2vw,28px);\n}\n.team-finish-cards {\n  align-items:stretch;\n  gap:clamp(8px,1.2vw,16px);\n}\n.team-finish-card {\n  flex:1 1 0;\n  min-width:0;\n  max-width:280px;\n  width:clamp(145px,20vw,280px);\n  min-height:clamp(250px,44vh,440px);\n  padding:clamp(8px,1vw,14px);\n  overflow:hidden;\n}\n.team-finish-card img {\n  width:100%;\n  height:clamp(190px,37vh,360px);\n  max-width:100%;\n  object-fit:contain;\n  object-position:center bottom;\n}\n.team-finish-side.defeated-side .team-finish-card img {\n  filter:grayscale(1) brightness(.58) contrast(1.08);\n}\n@media(max-width:640px) {\n  .team-finish-versus { gap:5px; }\n  .team-finish-card { width:clamp(118px,43vw,190px); min-height:clamp(185px,34vh,270px); }\n  .team-finish-card img { height:clamp(135px,27vh,220px); }\n}\n.team-battle .team-stun-status { top:50%;padding:7px 10px; }\n/* Persistent stun badge styling for the standalone team-battle stylesheet. */\n.team-battle .team-stun-status {\n  position:absolute;\n  z-index:14;\n  left:50%;\n  top:50%;\n  display:flex;\n  flex-direction:column;\n  align-items:center;\n  gap:3px;\n  width:max-content;\n  max-width:94%;\n  padding:7px 10px;\n  transform:translate(-50%,-50%);\n  border:2px solid #d7a8ff;\n  border-radius:8px;\n  color:#fff;\n  background:linear-gradient(135deg,#5a1b91ed,#170b2df0);\n  box-shadow:0 0 12px #c58aff,0 0 26px #a34dff,inset 0 0 12px #e6c4ff55;\n  text-align:center;\n  pointer-events:none;\n  animation:team-stun-status-enter .42s cubic-bezier(.16,1,.3,1) both;\n}\n.team-battle .team-stun-status strong {\n  font:1000 italic clamp(14px,1.8vw,22px) Oxanium,Arial,sans-serif;\n  letter-spacing:.12em;\n  text-shadow:0 0 10px #fff;\n}\n.team-battle .team-stun-status small {\n  color:#ead7ff;\n  font:900 8px Oxanium,Arial,sans-serif;\n  letter-spacing:.1em;\n  white-space:nowrap;\n}\n@keyframes team-stun-status-enter {\n  from { opacity:0;transform:translate(-50%,-35%) scale(.65); }\n  to { opacity:1;transform:translate(-50%,-50%) scale(1); }\n}\n.team-battle .team-stun-status small { animation:team-stun-count-fade 2.6s ease-out both; }\n@keyframes team-stun-count-fade { 0%,65% { opacity:1;transform:translateY(0); } 100% { opacity:0;transform:translateY(-7px); } }\n/* WILD CARDS — PAUSE-MENU QUALITY TARGET SELECTOR */\n.team-battle .target-modal-backdrop { z-index:1600; background:rgba(2,7,15,.88); backdrop-filter:blur(9px); }\n.team-battle .target-modal.battle-pause-panel { width:min(760px,96vw); max-height:min(90vh,900px); padding:clamp(18px,3vw,30px); border:1px solid #d9bd62; border-radius:22px 5px 22px 5px; background:linear-gradient(115deg,#1a3048 0%,#101c2d 42%,#080f1b 100%); box-shadow:0 22px 70px #000c,0 0 0 5px #d5bd5e18,0 0 34px #d5bd5e30,inset 0 1px 0 #fff2,inset 0 -12px 28px #0006; }\n.team-battle .target-modal-header { margin:-2px -2px 16px; padding:10px 12px 14px; border-bottom:1px solid #d5bd5e55; background:linear-gradient(90deg,#d5bd5e12,transparent 72%); text-align:left; }\n.team-battle .target-modal-header span { color:#13d5ff; font:800 .75rem Oxanium,sans-serif; letter-spacing:4px; }\n.team-battle .target-modal-header h2 { margin:5px 0 0; color:#f5d56a; font:900 clamp(1.6rem,4vw,2.3rem) Oxanium,sans-serif; letter-spacing:2px; text-shadow:0 3px 0 #795a1e,0 0 18px #f5d56a55; }\n.team-battle .target-modal-instructions { color:#b8c8dc; text-align:left; font:600 1rem Rajdhani,sans-serif; }\n.team-battle .target-choice-group { margin:16px 0; padding:13px; border:1px solid #42607b88; border-radius:10px; background:#07132199; text-align:left; }\n.team-battle .target-player-heading { display:flex; align-items:center; gap:10px; margin-bottom:10px; }\n.team-battle .target-player-heading>img { width:42px; height:42px; object-fit:cover; border:1px solid #d5bd5e; border-radius:7px; background:#0a1422; }\n.team-battle .target-player-heading h3 { margin:0; color:#f5d56a; font:900 1rem Oxanium,sans-serif; }\n.team-battle .target-player-heading span { color:#91a9c2; font:800 .65rem Oxanium,sans-serif; letter-spacing:1px; }\n.team-battle .target-clear-button { margin-left:auto; min-height:34px; padding:6px 12px; color:#ffdce1; background:linear-gradient(180deg,#853847,#4b1b2a); border:1px solid #e47c8a; border-bottom:3px solid #2a1019; border-radius:7px 3px; font:900 .7rem Oxanium,sans-serif; cursor:pointer; }\n.team-battle .target-opponent-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(190px,1fr)); gap:10px; }\n.team-battle .target-choice-button { display:flex; align-items:center; gap:10px; min-width:0; margin:0; padding:8px; color:#f4f8ff; text-align:left; background:linear-gradient(180deg,#25435d 0%,#14283d 100%); border:1px solid #5c86a4; border-bottom:3px solid #091522; border-radius:8px 3px; box-shadow:inset 0 1px 0 #ffffff25,0 3px 0 #050b12; transition:transform .14s,filter .14s,border-color .14s,box-shadow .14s; }\n.team-battle .target-choice-button:hover { transform:translateY(-2px); filter:brightness(1.15); border-color:#13d5ff; box-shadow:inset 0 1px 0 #ffffff35,0 5px 0 #050b12,0 0 18px #13d5ff55; }\n.team-battle .target-choice-button.is-selected { border-color:#fff0a1; background:linear-gradient(180deg,#705d2d,#26364a); box-shadow:inset 0 1px 0 #fff8,0 3px 0 #89651b,0 0 18px #f5d56a45; }\n.team-battle .target-choice-art { position:relative; display:block; flex:0 0 66px; width:66px; height:72px; overflow:hidden; border:1px solid #d5bd5e77; border-radius:6px; background:#08111d; }\n.team-battle .target-choice-art img { width:100%; height:100%; object-fit:cover; object-position:top center; }\n.team-battle .target-choice-art b { position:absolute; inset:auto 0 0; padding:4px 2px; color:#111827; background:linear-gradient(90deg,#fff0a1,#e5b938); font:900 7px Oxanium,sans-serif; text-align:center; letter-spacing:.3px; }\n.team-battle .target-choice-copy { display:flex; flex-direction:column; gap:5px; min-width:0; }\n.team-battle .target-choice-copy strong { color:#f5d56a; font:900 .9rem Oxanium,sans-serif; overflow-wrap:anywhere; }\n.team-battle .target-choice-copy small { color:#b7c9dc; font:800 .65rem Rajdhani,sans-serif; letter-spacing:.5px; }\n.team-battle .target-modal .confirm-target-button { min-height:48px; margin-top:12px; color:#111827; background:linear-gradient(180deg,#fff0a1 0%,#e5b938 100%); border:1px solid #fff0a1; border-bottom:3px solid #89651b; border-radius:8px 3px; box-shadow:inset 0 1px 0 #fff9,0 3px 0 #89651b,0 0 16px #f5d56a35; font:900 .9rem Oxanium,sans-serif; letter-spacing:1px; }\n.team-battle .target-modal .confirm-target-button:hover { transform:translateY(-2px); box-shadow:inset 0 1px 0 #fff9,0 5px 0 #89651b,0 0 24px #f5d56a90; }\n.team-battle .target-modal .modal-message { color:#f5d56a; font:800 .8rem Oxanium,sans-serif; }\n@media(max-width:520px){.team-battle .target-modal.battle-pause-panel{padding:14px}.team-battle .target-opponent-grid{grid-template-columns:1fr}.team-battle .target-choice-art{flex-basis:58px;width:58px;height:64px}}\n/* WILD CARDS — STORY MODE RESULTS PRESENTATION */\n#storyResultsScreen { position:fixed; inset:0; z-index:1500; display:grid; place-items:center; overflow:auto; padding:24px; background:radial-gradient(ellipse at 50% 22%,#24425a88,transparent 55%),linear-gradient(145deg,#070d18f5,#101c2df7 55%,#080d16f8); }\n#storyResultsScreen::before { content:\"\"; position:fixed; inset:0; pointer-events:none; opacity:.5; background:repeating-linear-gradient(135deg,transparent 0 34px,#ffffff05 35px 36px); }\n#storyResultsScreen .story-results-content { position:relative; width:min(720px,100%); padding:clamp(24px,4vw,42px); border:1px solid #d5bd5e; border-radius:22px 5px; background:linear-gradient(145deg,#1a3048f5,#0b1422f8); box-shadow:0 25px 80px #000c,0 0 0 5px #d5bd5e15,0 0 35px #13d5ff20,inset 0 1px 0 #fff2; text-align:center; animation:story-result-enter .65s cubic-bezier(.16,1,.3,1) both; }\n#storyResultsScreen .story-results-eyebrow { margin:0 0 10px; color:#13d5ff; font:900 .75rem Oxanium,sans-serif; letter-spacing:4px; }\n#storyResultsScreen .story-results-victory,#storyResultsScreen .story-results-defeat { margin:8px 0 12px; font:1000 clamp(2.8rem,9vw,5.5rem) Oxanium,sans-serif; letter-spacing:3px; line-height:1; }\n#storyResultsScreen .story-results-victory { color:#fff0a1; text-shadow:0 4px 0 #8b6720,0 0 22px #f5d56a88; }\n#storyResultsScreen .story-results-defeat { color:#ff7187; text-shadow:0 4px 0 #651d2b,0 0 22px #ff315988; }\n#storyResultsScreen .story-results-message { color:#d3dfed; font:700 clamp(1rem,2.4vw,1.3rem) Rajdhani,sans-serif; }\n#storyResultsScreen .story-results-stats { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; margin:26px 0 18px; }\n#storyResultsScreen .story-results-stats>div { display:grid; gap:7px; padding:17px 12px; border:1px solid #45647e; border-radius:10px 3px; background:linear-gradient(145deg,#142a40,#091522); box-shadow:inset 0 1px 0 #ffffff15; }\n#storyResultsScreen .story-results-stats span { color:#9eb9d2; font:900 .7rem Oxanium,sans-serif; letter-spacing:1.5px; }\n#storyResultsScreen .story-results-stats strong { color:#fff; font:1000 clamp(1.8rem,5vw,2.8rem) Oxanium,sans-serif; text-shadow:0 0 14px #13d5ff55; }\n#storyResultsScreen .story-results-completion { display:inline-block; margin:4px 0 22px; padding:9px 18px; color:#111827; background:linear-gradient(90deg,#fff0a1,#e5b938); border:1px solid #fff4b9; border-radius:5px; font:1000 .85rem Oxanium,sans-serif; letter-spacing:2px; box-shadow:0 0 18px #f5d56a44; }\n#storyResultsScreen .story-results-actions { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:10px; margin-top:22px; }\n#storyResultsScreen .story-results-actions button { min-height:48px; padding:10px; color:#f4f8ff; background:linear-gradient(180deg,#25435d,#14283d); border:1px solid #5c86a4; border-bottom:3px solid #091522; border-radius:8px 3px; box-shadow:inset 0 1px 0 #ffffff25,0 3px 0 #050b12; font:900 .76rem Oxanium,sans-serif; letter-spacing:.7px; cursor:pointer; transition:transform .14s,filter .14s,box-shadow .14s; }\n#storyResultsScreen .story-results-actions button:first-child { color:#111827; background:linear-gradient(180deg,#fff0a1,#e5b938); border-color:#fff0a1; border-bottom-color:#89651b; }\n#storyResultsScreen .story-results-actions button:last-child { background:linear-gradient(180deg,#853847,#4b1b2a); border-color:#e47c8a; border-bottom-color:#2a1019; }\n#storyResultsScreen .story-results-actions button:hover { transform:translateY(-2px); filter:brightness(1.15); box-shadow:0 5px 0 #050b12,0 0 18px #13d5ff55; }\n@keyframes story-result-enter { from { opacity:0; transform:translateY(28px) scale(.96); } to { opacity:1; transform:translateY(0) scale(1); } }\n@media(max-width:560px){#storyResultsScreen{padding:12px}#storyResultsScreen .story-results-content{padding:22px 14px}.story-results-actions{grid-template-columns:1fr!important}.story-results-stats{gap:8px!important}}\n/* Keep the 2v2 missing-team card centered in the viewport, not at the top. */\n.team-battle.error-screen {\n  display: grid !important;\n  grid-template-columns: minmax(0,1fr);\n  align-content: center;\n  justify-items: center;\n  place-items: center;\n  width: 100%;\n  height: auto;\n  min-height: 100vh;\n  overflow: auto;\n  padding: 24px;\n}\n.team-battle.error-screen .error-card {\n  width: min(100%,520px);\n  margin: auto;\n  align-self: center;\n}\n/* Subtle HUD drift and character breathing animation for 2v2 fighters. */\n.team-battle .fighter-hud {\n  animation: team-hud-float 5.4s ease-in-out infinite;\n  will-change: transform;\n}\n.team-battle .fighter-unit:nth-child(even) .fighter-hud { animation-delay: -2.7s; }\n.team-battle .fighter-portrait:not(.fighter-stunned) {\n  transform-origin: center bottom;\n  animation: team-fighter-idle 3.9s ease-in-out infinite;\n  will-change: transform;\n}\n.team-battle .fighter-hud-pointer {\n  position: relative;\n  z-index: 7;\n  align-self: center;\n  width: 0;\n  height: 0;\n  margin: -1px 0 -2px;\n  border-top: 9px solid #8deeff;\n  border-right: 8px solid transparent;\n  border-left: 8px solid transparent;\n  filter: drop-shadow(0 2px 3px #000b) drop-shadow(0 0 5px #20d9ff88);\n  animation: team-hud-float 5.4s ease-in-out infinite;\n  pointer-events: none;\n}\n.team-battle .fighter-opponent .fighter-hud-pointer {\n  border-top-color: #ff8193;\n  filter: drop-shadow(0 2px 3px #000b) drop-shadow(0 0 5px #ff315988);\n}\n.team-battle .fighter-unit:nth-child(even) .fighter-hud-pointer {\n  animation-delay: -2.7s;\n}\n@keyframes team-hud-float {\n  0%, 100% { transform: translateY(0); }\n  50% { transform: translateY(-3px); }\n}\n@keyframes team-fighter-idle {\n  0%, 100% { transform: translateY(0) scale(1); }\n  50% { transform: translateY(-4px) scale(1.008); }\n}\n@media (prefers-reduced-motion: reduce) {\n  .team-battle .fighter-hud,\n  .team-battle .fighter-portrait { animation: none !important; }\n}\n/* Keep the 2v2 finish control fully visible below the attack cards. */\n.team-battle .player-attack-panel .finish-turn-button {\n  position: relative;\n  transform: translateY(-5px);\n  margin-bottom: 2px;\n}\n/* Good-hit prismatic wash: only effective hits (20+ damage) tint the fighter artwork. */\n.team-battle .fighter-art-button:has(.damage-tier-effective) .fighter-portrait-wrapper::before {\n  content:\"\";\n  position:absolute;\n  z-index:2;\n  inset:0;\n  pointer-events:none;\n  background:linear-gradient(115deg,\n    #ff315966 0%,\n    #ffb52e66 18%,\n    #f7ed5266 34%,\n    #5bff8a66 50%,\n    #35eaff66 66%,\n    #5574ff66 82%,\n    #d45bff66 100%);\n  background-size:250% 100%;\n  mix-blend-mode:screen;\n  opacity:0;\n  animation:team-prismatic-image-hit .9s ease-out both;\n}\n@keyframes team-prismatic-image-hit {\n  0% { opacity:0; background-position:0% 50%; }\n  22% { opacity:.72; }\n  100% { opacity:0; background-position:100% 50%; }\n}\n/* Brief impact feedback, with durability-drain and healing states. */\n.fighter-impact-number,.fighter-impact-overlay > span,.fighter-impact-status { animation-duration:1.18s !important; }\n.fighter-art-button:has(.impact-damage) .fighter-portrait,.fighter-art-button:has(.impact-debuff-drain) .fighter-portrait { animation-duration:.55s !important; }\n.fighter-art-button:has(.impact-debuff-drain) .fighter-portrait { filter:brightness(1.22) sepia(.35) saturate(1.8) hue-rotate(325deg); }\n.fighter-art-button:has(.impact-heal) .fighter-portrait { animation:team-heal-glow .82s ease-out both !important; }\n.fighter-impact-overlay.impact-heal .fighter-impact-number { color:#a7ffc5; text-shadow:0 0 9px #35ff83,0 0 25px #19d66b; }\n.fighter-impact-overlay.impact-debuff-drain .fighter-impact-number { color:#ffad83; text-shadow:0 0 9px #ff642e,0 0 25px #ff3159; }\n@keyframes team-heal-glow {0%,100%{filter:brightness(1)}25%,65%{filter:brightness(1.8) drop-shadow(0 0 22px #42ff91)}}\n/* A compact 120 x 190 durability-drain overlay, clipped to the portrait itself. */\n.durability-drain-visual {\n  position:absolute;\n  z-index:7;\n  width:min(120px,100%);\n  height:min(190px,100%);\n  left:50%;\n  top:50%;\n  transform:translate(-50%,-50%);\n  overflow:hidden;\n  pointer-events:none;\n  border-radius:5px;\n  background:\n    linear-gradient(180deg,transparent 0%,#ff8a3d18 28%,#ff4b2b72 72%,#160a0c66 100%),\n    repeating-linear-gradient(0deg,transparent 0 12px,#ffd28b32 13px 14px);\n  box-shadow:inset 0 0 16px #ff632d88;\n  clip-path:inset(0 0 0 0);\n  animation:durability-drain-collapse .5s cubic-bezier(.55,.05,.8,.45) both;\n}\n.durability-drain-visual::before {\n  content:\"\";\n  position:absolute;\n  inset:0;\n  background:linear-gradient(105deg,transparent 0 30%,#ffe2a5 43%,#ff6b32 51%,#7d1b24 60%,transparent 72%);\n  transform:translateX(-110%);\n  animation:durability-drain-sweep .5s ease-in both;\n}\n.durability-drain-visual i {\n  position:absolute;\n  left:8%;\n  width:84%;\n  height:2px;\n  background:#ffe1a1;\n  box-shadow:0 0 8px #ff5a29;\n  animation:durability-drain-crack .5s ease-out both;\n}\n.durability-drain-visual i:nth-child(1){top:30%;animation-delay:0ms}\n.durability-drain-visual i:nth-child(2){top:52%;animation-delay:55ms}\n.durability-drain-visual i:nth-child(3){top:74%;animation-delay:110ms}\n@keyframes durability-drain-collapse {\n  0%{opacity:0;clip-path:inset(0 0 0 0)}\n  18%{opacity:1}\n  65%{opacity:.92;clip-path:inset(0 0 35% 0)}\n  100%{opacity:0;clip-path:inset(0 0 100% 0)}\n}\n@keyframes durability-drain-sweep {\n  0%{transform:translateX(-110%);opacity:0}\n  22%{opacity:1}\n  100%{transform:translateX(110%);opacity:0}\n}\n@keyframes durability-drain-crack {\n  0%{opacity:0;transform:scaleX(.1)}\n  35%{opacity:1;transform:scaleX(1)}\n  100%{opacity:0;transform:translateX(8px) scaleX(.3)}\n}\n/* Character portrait card: keep the frame still and animate only the image inside it. */\n.team-battle .fighter-portrait-wrapper {\n  position:relative;\n  width:min(120px,100%);\n  max-width:120px;\n  height:100%;\n  max-height:190px;\n  min-height:0;\n  aspect-ratio:12 / 19;\n  margin-inline:auto;\n  flex:0 1 190px;\n  overflow:hidden;\n  box-sizing:border-box;\n  border:1px solid color-mix(in srgb,var(--fighter-accent,#ff3f61) 58%,#ffffff 10%);\n  border-radius:10px;\n  background:linear-gradient(155deg,#17263b 0%,#0a1220 70%,#070d17 100%);\n  box-shadow:0 7px 18px #0009,inset 0 0 0 2px #ffffff08,inset 0 0 18px #ff3f6118;\n}\n.team-battle .fighter-portrait-wrapper > .fighter-portrait {\n  display:block;\n  width:100%;\n  height:100%;\n  max-width:100%;\n  max-height:100%;\n  object-fit:contain;\n  object-position:center bottom;\n  transform-origin:center bottom;\n  animation:team-fighter-card-idle 6.8s ease-in-out infinite;\n}\n.team-battle .fighter-portrait-wrapper.fighter-stunned > .fighter-portrait {\n  animation:stunned-electric-glow 1s ease-in-out infinite alternate !important;\n}\n@keyframes team-fighter-card-idle {\n  0%,100% { transform:translateY(0) scale(1); }\n  50% { transform:translateY(-1.5px) scale(1.004); }\n}\n/* Larger framed fighter portraits in team battles; keep each image inside its card. */\n.team-battle .fighter-portrait-stage { align-items:center; }\n.team-battle .fighter-portrait-wrapper {\n  display:block;\n  flex:0 0 auto;\n  width:min(190px,100%);\n  height:min(285px,100%);\n  max-width:190px;\n  max-height:100%;\n  min-height:0;\n  overflow:hidden;\n  box-sizing:border-box;\n  border:1px solid color-mix(in srgb,var(--fighter-accent,#ff3f61) 62%,#ffffff 12%);\n  border-radius:11px;\n  background:#091321;\n  box-shadow:0 7px 18px #0009,inset 0 0 0 1px #ffffff12;\n}\n.team-battle .fighter-portrait-wrapper > .fighter-portrait {\n  display:block;\n  width:100%;\n  height:100%;\n  max-width:none;\n  max-height:none;\n  object-fit:cover;\n  object-position:center center;\n  border:0;\n  border-radius:0;\n  animation:team-fighter-card-idle 6.8s ease-in-out infinite;\n}\n.team-battle .fighter-portrait-wrapper .durability-drain-visual {\n  width:100%;\n  height:100%;\n  border-radius:inherit;\n}\n@media (max-width:900px) {\n  .team-battle .fighter-portrait-wrapper { width:min(160px,100%); height:min(240px,100%); }\n}\n@media (prefers-reduced-motion:reduce) {\n  #battleLayout .solo-portrait-wrapper > img,\n  .team-battle .fighter-art-button:not(:has(.impact-attack)) .fighter-portrait-wrapper > .fighter-portrait {\n    animation:none !important;\n  }\n\n  /* Keep the short directional attack lunge even when decorative motion is reduced. */\n  .team-battle .fighter-art-button:has(.impact-attack) .fighter-portrait {\n    animation:team-attack-lunge .24s cubic-bezier(.18,.9,.25,1) both !important;\n    animation-duration:.24s !important;\n  }\n  .team-battle .player-team .fighter-art-button:has(.impact-attack) .fighter-portrait {\n    animation-name:team-attack-lunge-left !important;\n  }\n}\n/* Defensive callouts are centered and sized to stay within the portrait frame. */\n.team-battle .fighter-portrait-stage::before {\n  max-width:calc(100% - 18px);\n  box-sizing:border-box;\n  white-space:nowrap;\n  text-align:center;\n}\n.team-battle .fighter-art-button:has(.impact-blocked) .fighter-portrait-stage::before,\n.team-battle .fighter-art-button:has(.impact-evaded) .fighter-portrait-stage::before {\n  left:50%;\n  top:50%;\n  width:max-content;\n  padding:7px 11px;\n  transform:translate(-50%,-50%);\n  font-size:clamp(10px,1vw,13px);\n}\n.team-battle .fighter-art-button:has(.impact-evaded) .fighter-portrait-stage::before {\n  content:\"💨 EVADED\";\n  position:absolute;\n  z-index:7;\n  border:1px solid #78eaff;\n  border-radius:7px;\n  color:#e9fbff;\n  background:linear-gradient(145deg,#174d62ee,#101d2fee);\n  box-shadow:0 0 12px #58dcff,inset 0 0 12px #d9f2ff33;\n  animation:team-shield-flash 1.05s ease-out both;\n}\n.team-battle .fighter-art-button:has(.impact-blocked) .fighter-portrait-stage::before {\n  left:50%;\n  top:50%;\n  width:max-content;\n  max-width:calc(100% - 20px);\n  padding:5px 8px;\n  box-sizing:border-box;\n  font-size:clamp(9px,0.85vw,11px);\n  line-height:1.15;\n  white-space:nowrap;\n  text-align:center;\n  transform:translate(-50%,-50%);\n  animation:team-shield-flash 1.05s ease-out both;\n}\n.team-battle .fighter-impact-overlay > span { animation-duration:1.9s; }\n.team-battle .fighter-impact-status { animation-duration:2.1s; }\n.team-battle .durability-drain-visual { animation-duration:.85s; }\n.team-battle .durability-drain-visual::before { animation-duration:.85s; }\n.team-battle .durability-drain-visual i { animation-duration:.85s; }\n/* Stage selection occupies its own in-page tab after fighter confirmation. */\n.stage-select-screen { min-height:100vh; display:flex; flex-direction:column; justify-content:flex-start; }\n.stage-select-screen .wild-stage-select { flex:1; width:min(1480px,calc(100% - 32px)); margin:18px auto 30px; }\n.stage-select-tab-label { justify-self:end; color:#f5d56a; font:900 10px Oxanium,sans-serif; letter-spacing:2px; }\n.stage-select-back { display:block; margin:0 auto 14px; padding:8px 13px; color:#cce8ff; background:#10263a; border:1px solid #527b9a; border-radius:6px; font:900 10px Oxanium,sans-serif; letter-spacing:1px; cursor:pointer; }\n/* Final combat motion pass: the fighter card is the animated unit.\n   The portrait remains anchored inside the card instead of sliding within it. */\n.team-battle .fighter-art-button:has(.impact-attack) {\n  animation:team-card-attack-lunge .24s cubic-bezier(.18,.9,.25,1) both !important;\n}\n.team-battle .player-team .fighter-art-button:has(.impact-attack) {\n  animation-name:team-card-attack-lunge-left !important;\n}\n.team-battle .fighter-art-button:has(.impact-attack) .fighter-portrait,\n.team-battle .fighter-art-button:has(.impact-attack) .fighter-portrait-wrapper {\n  animation:none !important;\n  transform:none !important;\n}\n.team-battle .fighter-art-button:has(.impact-evaded) {\n  animation:team-card-evade-dodge .52s cubic-bezier(.2,.75,.25,1) both !important;\n}\n.team-battle .fighter-art-button:has(.impact-evaded) .fighter-portrait,\n.team-battle .fighter-art-button:has(.impact-evaded) .fighter-portrait-wrapper {\n  animation:none !important;\n  transform:none !important;\n}\n@keyframes team-card-attack-lunge {\n  0%,100% { transform:translateX(0) scale(1); }\n  45% { transform:translateX(36px) scale(1.035); }\n}\n@keyframes team-card-attack-lunge-left {\n  0%,100% { transform:translateX(0) scale(1); }\n  45% { transform:translateX(-36px) scale(1.035); }\n}\n"],["STYLE",{},"/* Isolated horizontal layout refinements for local co-op.\n   Kept separate from the main team battle stylesheet to avoid broad overrides. */\n.team-battle:is(.is-local-coop, .is-local-pvp) .battle-bottom {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  align-items: stretch;\n  gap: 14px;\n  width: 100%;\n}\n.team-battle:is(.is-local-coop, .is-local-pvp) .battle-bottom > .combat-log {\n  display: none !important;\n}\n.team-battle:is(.is-local-coop, .is-local-pvp) .battle-bottom .player-attack-panel {\n  width: 100%;\n  min-width: 0;\n  margin: 0;\n  align-self: stretch;\n}\n.team-battle:is(.is-local-coop, .is-local-pvp) .battlefield {\n  position: relative;\n  isolation: isolate;\n}\n.team-battle:is(.is-local-coop, .is-local-pvp) .local-coop-incoming {\n  position: absolute;\n  z-index: 35;\n  top: 50%;\n  width: min(310px, 28%);\n  max-height: min(78%, 540px);\n  overflow-y: auto;\n  transform: translateY(-50%);\n  margin: 0;\n  box-shadow: 0 16px 42px #000b, 0 0 20px #ff315955;\n}\n.team-battle:is(.is-local-coop, .is-local-pvp) .local-coop-incoming.is-first {\n  left: 12px;\n  right: auto;\n}\n.team-battle:is(.is-local-coop, .is-local-pvp) .local-coop-incoming.is-second {\n  right: 12px;\n  left: auto;\n}\n.team-battle:is(.is-local-coop, .is-local-pvp) .player-attack-popup.is-opponent-side {\n  position: absolute;\n  z-index: 34;\n  top: 50%;\n  right: 12px;\n  left: auto;\n  width: min(310px, 28%);\n  transform: translateY(-50%);\n  margin: 0;\n}\n.team-battle:is(.is-local-coop, .is-local-pvp) .battle-center {\n  pointer-events: none;\n}\n@media (max-width: 900px) {\n  .team-battle:is(.is-local-coop, .is-local-pvp) .local-coop-incoming,\n  .team-battle:is(.is-local-coop, .is-local-pvp) .player-attack-popup.is-opponent-side {\n    width: min(260px, 42%);\n  }\n}\n@media (max-width: 650px) {\n  .team-battle:is(.is-local-coop, .is-local-pvp) .battle-bottom {\n    grid-template-columns: minmax(0, 1fr);\n  }\n  .team-battle:is(.is-local-coop, .is-local-pvp) .local-coop-incoming,\n  .team-battle:is(.is-local-coop, .is-local-pvp) .player-attack-popup.is-opponent-side {\n    position: relative;\n    inset: auto;\n    width: min(100%, 360px);\n    max-height: none;\n    transform: none;\n    margin: 10px auto;\n  }\n}\n\n/* ==========================================================\n   LOCAL MATCH — HORIZONTAL ARCADE LAYOUT\n   This stylesheet is intentionally scoped to local co-op so\n   the existing solo TeamBattle presentation stays untouched.\n========================================================== */\n\n.team-battle:is(.is-local-coop, .is-local-pvp) {\n  width: 100%;\n  min-height: 100vh;\n  height: 100vh;\n  padding: 10px 18px 14px;\n  display: grid;\n  grid-template-rows: 42px minmax(280px, 1fr) minmax(210px, 30vh);\n  gap: 9px;\n  overflow: hidden;\n  background:\n    radial-gradient(ellipse at 50% 42%, rgba(165, 245, 27, .09), transparent 58%),\n    linear-gradient(180deg, #0b1710 0%, #0a1711 58%, #080d16 100%);\n}\n\n.team-battle:is(.is-local-coop, .is-local-pvp) .battle-header {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);\n  align-items: center;\n  gap: 12px;\n  min-height: 0;\n  padding: 0 4px;\n}\n\n.team-battle:is(.is-local-coop, .is-local-pvp) .battle-header h1 {\n  white-space: nowrap;\n  font-size: clamp(17px, 1.7vw, 25px);\n  letter-spacing: 2px;\n}\n\n.team-battle:is(.is-local-coop, .is-local-pvp) .battlefield {\n  min-height: 0;\n  height: 100%;\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) minmax(42px, .12fr) minmax(0, 1fr);\n  align-items: stretch;\n  gap: clamp(8px, 1.3vw, 20px);\n  padding: clamp(12px, 1.5vw, 22px);\n  border: 1px solid rgba(19, 213, 255, .55);\n  border-radius: 13px;\n  background:\n    radial-gradient(ellipse at center, rgba(28, 62, 39, .42), transparent 68%),\n    linear-gradient(145deg, #102017, #0b1710);\n  box-shadow: inset 0 0 26px rgba(19, 213, 255, .035), 0 8px 24px #0005;\n}\n\n.team-battle:is(.is-local-coop, .is-local-pvp) .battle-team {\n  min-width: 0;\n  min-height: 0;\n  gap: 8px;\n  justify-content: center;\n}\n\n.team-battle:is(.is-local-coop, .is-local-pvp) .team-heading {\n  min-height: 22px;\n  margin: 0;\n  font-size: 10px;\n  letter-spacing: 2px;\n}\n\n.team-battle:is(.is-local-coop, .is-local-pvp) .fighter-grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  align-items: center;\n  justify-items: center;\n  gap: clamp(8px, 1.2vw, 18px);\n  min-height: 0;\n  flex: 1;\n}\n\n.team-battle:is(.is-local-coop, .is-local-pvp) .fighter-unit {\n  width: min(100%, 310px);\n  max-width: 310px;\n  min-height: 0;\n  gap: 8px;\n}\n\n.team-battle:is(.is-local-coop, .is-local-pvp) .fighter-hud {\n  padding: 8px 10px;\n  gap: 5px;\n}\n\n.team-battle:is(.is-local-coop, .is-local-pvp) .fighter-portrait-stage {\n  min-height: 0;\n  height: clamp(150px, 27vh, 300px);\n}\n\n.team-battle:is(.is-local-coop, .is-local-pvp) .battle-center {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  min-width: 0;\n  padding: 4px;\n  text-align: center;\n}\n\n.team-battle:is(.is-local-coop, .is-local-pvp) .battle-center p {\n  max-width: 120px;\n  color: #f7e9b5;\n  font: 800 clamp(9px, .8vw, 12px)/1.35 Oxanium, sans-serif;\n  text-shadow: 0 2px 8px #000;\n}\n\n.team-battle:is(.is-local-coop, .is-local-pvp) .battle-bottom {\n  min-height: 0;\n  height: 100%;\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  align-items: stretch;\n  gap: 10px;\n  overflow: hidden;\n}\n\n.team-battle:is(.is-local-coop, .is-local-pvp) .battle-bottom > .combat-log {\n  display: none !important;\n}\n\n.team-battle:is(.is-local-coop, .is-local-pvp) .battle-bottom .player-attack-panel {\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n  min-height: 0;\n  width: 100%;\n  margin: 0;\n  padding: 8px;\n  border: 1px solid rgba(165, 245, 27, .3);\n  border-radius: 11px;\n  background: linear-gradient(160deg, rgba(28, 48, 29, .98), rgba(10, 20, 13, .98));\n  box-shadow: 0 8px 22px #0005;\n}\n\n.team-battle:is(.is-local-coop, .is-local-pvp) .battle-bottom .attack-panel-header {\n  flex: 0 0 auto;\n  min-height: 28px;\n  padding: 4px 8px;\n  border-bottom: 2px solid #a5f51b;\n  text-align: center;\n}\n\n.team-battle:is(.is-local-coop, .is-local-pvp) .team-attack-grid {\n  min-height: 0;\n  grid-auto-columns: clamp(92px, 8vw, 126px);\n  grid-auto-rows: minmax(0, 1fr);\n  grid-template-rows: minmax(0, 1fr);\n  overflow-x: auto;\n  overflow-y: hidden;\n  align-content: stretch;\n  padding: 8px 2px 4px;\n}\n\n.team-battle:is(.is-local-coop, .is-local-pvp) .team-attack-wrapper,\n.team-battle:is(.is-local-coop, .is-local-pvp) .team-attack-card {\n  min-height: 0;\n  height: 100%;\n}\n\n.team-battle:is(.is-local-coop, .is-local-pvp) .team-attack-card {\n  padding: 6px;\n  gap: 4px;\n}\n\n.team-battle:is(.is-local-coop, .is-local-pvp) .team-attack-card .team-attack-image,\n.team-battle:is(.is-local-coop, .is-local-pvp) .team-attack-card .team-attack-image-placeholder {\n  flex: 0 0 clamp(52px, 8vh, 76px);\n  height: clamp(52px, 8vh, 76px);\n}\n\n.team-battle:is(.is-local-coop, .is-local-pvp) .local-coop-incoming {\n  z-index: 35;\n  top: 50%;\n  width: min(300px, 29%);\n  max-height: 84%;\n  overflow-y: auto;\n  transform: translateY(-50%);\n  border-color: rgba(255, 63, 97, .8);\n}\n\n.team-battle:is(.is-local-coop, .is-local-pvp) .local-coop-incoming.is-first {\n  left: 10px;\n  right: auto;\n}\n\n.team-battle:is(.is-local-coop, .is-local-pvp) .local-coop-incoming.is-second {\n  right: 10px;\n  left: auto;\n}\n\n.team-battle:is(.is-local-coop, .is-local-pvp) .player-attack-popup.is-opponent-side {\n  z-index: 34;\n  top: 50%;\n  right: 10px;\n  left: auto;\n  width: min(300px, 29%);\n  transform: translateY(-50%);\n}\n\n@media (max-width: 900px) {\n  .team-battle:is(.is-local-coop, .is-local-pvp) {\n    padding: 8px;\n    grid-template-rows: 38px minmax(260px, 1fr) minmax(190px, 30vh);\n  }\n  .team-battle:is(.is-local-coop, .is-local-pvp) .battlefield { gap: 6px; padding: 9px; }\n  .team-battle:is(.is-local-coop, .is-local-pvp) .fighter-portrait-stage { height: clamp(115px, 22vh, 210px); }\n  .team-battle:is(.is-local-coop, .is-local-pvp) .local-coop-incoming,\n  .team-battle:is(.is-local-coop, .is-local-pvp) .player-attack-popup.is-opponent-side { width: min(250px, 34%); }\n}\n\n@media (max-width: 650px) {\n  .team-battle:is(.is-local-coop, .is-local-pvp) {\n    height: auto;\n    min-height: 100vh;\n    overflow: visible;\n    display: flex;\n    flex-direction: column;\n  }\n  .team-battle:is(.is-local-coop, .is-local-pvp) .battlefield {\n    min-height: 650px;\n    grid-template-columns: minmax(0, 1fr) 26px minmax(0, 1fr);\n  }\n  .team-battle:is(.is-local-coop, .is-local-pvp) .fighter-grid { grid-template-columns: minmax(0, 1fr); }\n  .team-battle:is(.is-local-coop, .is-local-pvp) .fighter-portrait-stage { height: clamp(135px, 22vh, 190px); }\n  .team-battle:is(.is-local-coop, .is-local-pvp) .battle-bottom {\n    height: auto;\n    grid-template-columns: minmax(0, 1fr);\n    overflow: visible;\n  }\n  .team-battle:is(.is-local-coop, .is-local-pvp) .battle-bottom .player-attack-panel { min-height: 190px; }\n  .team-battle:is(.is-local-coop, .is-local-pvp) .team-attack-grid {\n    grid-auto-columns: 105px;\n    grid-auto-rows: 190px;\n    grid-template-rows: 190px;\n    overflow-y: hidden;\n  }\n  .team-battle:is(.is-local-coop, .is-local-pvp) .team-attack-wrapper,\n  .team-battle:is(.is-local-coop, .is-local-pvp) .team-attack-card { height: 190px; min-height: 190px; }\n  .team-battle:is(.is-local-coop, .is-local-pvp) .local-coop-incoming,\n  .team-battle:is(.is-local-coop, .is-local-pvp) .player-attack-popup.is-opponent-side {\n    position: relative;\n    inset: auto;\n    width: min(100%, 340px);\n    max-height: none;\n    transform: none;\n    margin: 8px auto;\n  }\n}\n\n"],["STYLE",{},"/* Styles scoped exclusively to the Local Battle route. */\n.local-pvp-screen {\n  position:relative;\n  --lp-cyan:#13d5ff; --lp-red:#ff3159; --lp-gold:#ffc857;\n  min-height:100vh; width:100%; padding:clamp(10px,2vw,24px); box-sizing:border-box;\n  color:#f5f7fb; background:radial-gradient(ellipse at 50% 42%,#243447 0%,#101722 48%,#080d14 100%);\n  overflow-x:hidden; font-family:\"Arial Black\",\"Trebuchet MS\",sans-serif;\n}\n.local-pvp-screen * { box-sizing:border-box; }\n.local-pvp-header,.local-pvp-match-header {\n  max-width:1600px; margin:0 auto 18px; display:flex; justify-content:space-between; align-items:center; gap:16px;\n  padding:12px 18px; border:1px solid #526477; border-radius:14px;\n  background:linear-gradient(110deg,#121c29,#263547 50%,#121c29); box-shadow:0 10px 30px #0008;\n}\n.local-pvp-header > div,.local-pvp-match-header > div { display:grid; gap:3px; text-align:center; }\n.local-pvp-header strong,.local-pvp-match-header strong { color:var(--lp-gold); font-size:1.2rem; letter-spacing:2px; }\n.local-pvp-header span,.local-pvp-match-header span { color:#b9c7d5; font-size:.7rem; letter-spacing:2px; }\n.local-pvp-header button,.local-pvp-pause-trigger { padding:9px 14px; border:1px solid #718399; border-radius:8px; color:white; background:#202d3c; font-weight:900; cursor:pointer; }\n.local-pvp-active-clock,.local-pvp-header > div:last-child { color:var(--lp-cyan); font-size:1.4rem; }\n.local-pvp-split-screen {\n  max-width:1700px; margin:auto; display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:clamp(12px,2vw,28px);\n  align-items:start;\n}\n.local-pvp-player-screen {\n  position:relative; min-width:0; padding:14px; border:1px solid #526477; border-radius:15px;\n  background:linear-gradient(155deg,#1a2838ed,#0d1520f2); box-shadow:0 14px 32px #0007;\n}\n.local-pvp-player-one { border-top:4px solid var(--lp-cyan); }\n.local-pvp-player-two { border-top:4px solid var(--lp-red); }\n.local-pvp-player-heading { display:flex; align-items:center; gap:10px; margin-bottom:12px; }\n.local-pvp-player-heading > span { font-size:1rem; font-weight:1000; }\n.local-pvp-player-one .local-pvp-player-heading > span { color:var(--lp-cyan); }\n.local-pvp-player-two .local-pvp-player-heading > span { color:var(--lp-red); }\n.local-pvp-player-heading strong { color:#b6c5d3; font-size:.68rem; }\n.local-pvp-player-heading b { margin-left:auto; color:var(--lp-gold); font-size:1.1rem; }\n.local-pvp-finish-rect { padding:8px 10px; border:1px solid #718399; border-radius:7px; color:white; background:#26384b; font-size:.62rem; font-weight:900; cursor:pointer; }\n.local-pvp-screen-fighters { display:grid; grid-template-columns:minmax(0,1fr); }\n.local-pvp-screen-fighters .local-pvp-fighter-status:first-child { display:none; }\n.local-pvp-screen-fighters .local-pvp-fighter-status { width:100%; }\n.local-pvp-screen-fighters .battle-status-panel { display:grid; grid-template-columns:minmax(130px,40%) minmax(0,1fr); gap:14px; align-items:center; }\n.local-pvp-screen-fighters #characterPortraitWrapper,.local-pvp-screen-fighters #opponentPortraitWrapper { position:relative; min-height:210px; display:flex; align-items:center; justify-content:center; background:#080e16; border-radius:10px; overflow:hidden; }\n.local-pvp-screen-fighters #characterImage,.local-pvp-screen-fighters #opponentImage { max-width:100%; max-height:260px; object-fit:contain; }\n.local-pvp-fighter-info { min-width:0; }\n.local-pvp-fighter-info h2 { color:white; font-size:1.25rem; }\n.local-pvp-fighter-info p { color:var(--lp-gold); font-size:.65rem; letter-spacing:1.5px; }\n.local-pvp-fighter-statbars,.local-pvp-fighter-compact { display:grid; gap:6px; }\n.local-pvp-fighter-compact { margin-top:8px; }\n.local-pvp-existing-attacks { margin-top:12px; }\n.local-pvp-existing-attacks #attackSection { margin:0 !important; }\n.local-pvp-existing-attacks #attack { border:1px solid #52677d; border-radius:10px; color:white; background:#101a26; }\n.local-pvp-existing-attacks #attackHeader { color:white; background:#26394d; }\n.local-pvp-existing-attacks #attackList { display:grid !important; grid-template-columns:repeat(2,minmax(0,1fr)); overflow:visible !important; }\n.local-pvp-existing-attacks .attack-card-wrapper { min-width:0; }\n.local-pvp-existing-attacks .attack-card { width:100%; min-width:0 !important; height:100%; color:white; background:#1d2c3d; border:1px solid #5a7189; }\n.local-pvp-existing-attacks .attack-image { height:85px; object-fit:contain; }\n.local-pvp-incoming { position:relative !important; inset:auto !important; width:min(100%,520px); margin:16px auto 0; padding:12px; border:1px solid var(--lp-gold); border-radius:12px; color:white; background:#101925f5; box-shadow:0 12px 30px #000c; }\n.local-pvp-incoming-player-one { border-left:5px solid var(--lp-cyan); right:2%; left:auto; margin:0; }\n.local-pvp-incoming-player-two { border-right:5px solid var(--lp-red); left:2%; right:auto; margin:0; }\n.local-pvp-1v1 > .local-pvp-incoming { position:absolute !important; top:30%; width:min(38%,520px); z-index:8; }\n.local-pvp-incoming #aiAttackCard { display:grid; gap:8px; }\n.local-pvp-incoming #aiAttackHeader { display:flex; justify-content:space-between; color:var(--lp-gold); font-size:.75rem; }\n.local-pvp-incoming #aiAttackInfo { display:grid; grid-template-columns:1fr auto; align-items:center; gap:8px; }\n.local-pvp-incoming .incoming-attack-image img { max-height:90px; object-fit:contain; }\n.local-pvp-incoming #defensiveActions { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:7px; }\n.local-pvp-incoming #defensiveActions button { min-height:45px; border:1px solid #7b8da1; border-radius:7px; color:white; background:#26394d; font-size:.65rem; font-weight:900; }\n.local-pvp-incoming #defensiveActions button:last-child { background:#652638; border-color:#a73a50; }\n.local-pvp-matchup { max-width:1600px; margin:0 auto 16px; display:grid; grid-template-columns:minmax(0,1fr) 70px minmax(0,1fr); align-items:center; gap:14px; }\n.local-pvp-side { min-width:0; padding:12px; border:1px solid #526477; border-radius:14px; background:linear-gradient(155deg,#1a2838,#0d1520); }\n.local-pvp-side h2 { margin:0 0 10px; font-size:1rem; }\n.local-pvp-player1 h2 { color:var(--lp-cyan); }\n.local-pvp-player2 h2 { color:var(--lp-red); }\n.local-pvp-vs { display:grid; place-items:center; width:60px; height:60px; border:2px solid var(--lp-gold); border-radius:50%; color:var(--lp-gold); font-size:1.4rem; }\n.local-pvp-fighter { display:grid; grid-template-columns:minmax(90px,35%) minmax(0,1fr); gap:10px; margin:8px 0; padding:8px; border:1px solid #586d82; border-radius:9px; background:#172536; }\n.local-pvp-fighter img { width:100%; height:120px; object-fit:contain; }\n.local-pvp-fighter-info { display:grid; align-content:center; gap:5px; }\n.local-pvp-fighter-info strong { font-size:.85rem; }\n.local-pvp-fighter-info span { font:700 .62rem Arial,sans-serif; }\n.local-pvp-meter { height:8px; overflow:hidden; border-radius:12px; background:#080d14; }\n.local-pvp-meter i { display:block; height:100%; background:linear-gradient(90deg,#c51f39,#ff526d); }\n.local-pvp-meter.mana i { background:linear-gradient(90deg,#087ab8,#25d7ff); }\n.local-pvp-targets { max-width:1100px; margin:12px auto; display:flex; justify-content:center; flex-wrap:wrap; gap:10px; }\n.local-pvp-targets label { display:grid; gap:4px; color:#d6e0ea; font-size:.65rem; }\n.local-pvp-targets select { min-width:150px; padding:7px; border:1px solid #64798e; border-radius:6px; color:white; background:#172536; }\n.local-pvp-defense { position:absolute; z-index:8; top:27%; width:min(34%,460px); margin:0; padding:14px; border:1px solid var(--lp-gold); border-radius:12px; color:white; background:#101925f5; box-shadow:0 12px 30px #000c; text-align:center; }\n.local-pvp-defense-player1 { right:2%; left:auto; border-left:5px solid var(--lp-cyan); }\n.local-pvp-defense-player2 { left:2%; right:auto; border-right:5px solid var(--lp-red); }\n.local-pvp-defense h2 { margin:5px; }\n.local-pvp-defense-timer { color:var(--lp-gold); font-size:1.5rem; }\n.local-pvp-defense > div:last-child { display:flex; justify-content:center; flex-wrap:wrap; gap:8px; }\n.local-pvp-defense button { padding:9px 12px; border:1px solid #718399; border-radius:7px; color:white; background:#26394d; font-weight:900; }\n.local-pvp-attacks { max-width:900px; margin:14px auto; display:grid; grid-template-columns:minmax(0,1fr); gap:14px; }\n.local-pvp-player1-panels,.local-pvp-player2-panels { min-width:0; width:100%; }\n.local-pvp-screen .player-attack-panel { padding:10px; border:1px solid #52677d; border-radius:10px; background:#101a26; }\n.local-pvp-screen .attack-panel-header { display:flex; justify-content:space-between; }\n.local-pvp-screen .team-attack-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px; }\n.local-pvp-screen .team-attack-card { width:100%; min-width:0; padding:7px; border:1px solid #566b80; border-radius:8px; color:white; background:#1d2c3d; }\n.local-pvp-screen .team-attack-image { width:100%; height:75px; object-fit:contain; }\n.local-pvp-screen .team-attack-card:disabled { opacity:.4; }\n.local-pvp-screen .finish-turn-button { width:100%; margin-top:8px; padding:8px; border:1px solid #718399; border-radius:7px; color:white; background:#26384b; }\n.local-pvp-log { display:none; }\n.local-pvp-round-intro { position:fixed; z-index:20; inset:0; display:grid; place-content:center; gap:8px; color:white; background:#050a12ef; text-align:center; font-size:clamp(2rem,6vw,4rem); font-weight:1000; letter-spacing:5px; animation:lp-intro 1.5s ease both; pointer-events:none; }\n.local-pvp-round-intro span { color:var(--lp-gold); font-size:1rem; letter-spacing:3px; }\n.local-pvp-pause-overlay,.local-pvp-result { position:fixed; z-index:30; inset:0; display:grid; place-items:center; padding:20px; background:#050912ef; }\n.local-pvp-pause-panel { width:min(420px,100%); display:grid; gap:12px; padding:28px; border:1px solid #71859b; border-radius:16px; background:linear-gradient(145deg,#26394d,#0d1520); text-align:center; }\n.local-pvp-pause-panel button,.local-pvp-result button { padding:12px; border:1px solid #72879d; border-radius:7px; color:white; background:#26394d; font-weight:900; }\n.local-pvp-result { align-content:center; gap:14px; }\n.local-pvp-result p { color:var(--lp-gold); font-size:clamp(2rem,6vw,4rem); text-align:center; }\n@keyframes lp-intro { 0%{opacity:0} 12%,82%{opacity:1} 100%{opacity:0} }\n@media(max-width:950px) {\n .local-pvp-split-screen { grid-template-columns:1fr; }\n .local-pvp-matchup { grid-template-columns:minmax(0,1fr) 45px minmax(0,1fr); }\n .local-pvp-attacks { grid-template-columns:1fr; }\n}\n@media(max-width:600px) {\n .local-pvp-screen { padding:7px; }\n .local-pvp-header,.local-pvp-match-header { padding:8px; gap:6px; }\n .local-pvp-header strong,.local-pvp-match-header strong { font-size:.9rem; }\n .local-pvp-header span,.local-pvp-match-header span { font-size:.52rem; letter-spacing:1px; }\n .local-pvp-player-screen { padding:8px; }\n .local-pvp-screen-fighters .battle-status-panel { grid-template-columns:1fr; }\n .local-pvp-screen-fighters #characterPortraitWrapper,.local-pvp-screen-fighters #opponentPortraitWrapper { min-height:150px; }\n .local-pvp-screen-fighters #characterImage,.local-pvp-screen-fighters #opponentImage { max-height:180px; }\n .local-pvp-matchup { grid-template-columns:1fr; }\n .local-pvp-1v1 > .local-pvp-incoming { position:relative !important; top:auto; left:auto; right:auto; width:100%; margin:12px auto; }\n .local-pvp-defense { position:relative; top:auto; left:auto; right:auto; width:100%; margin:12px auto; }\n .local-pvp-vs { margin:auto; width:44px; height:44px; }\n .local-pvp-fighter { grid-template-columns:1fr; }\n .local-pvp-fighter img { height:105px; }\n .local-pvp-incoming #defensiveActions { grid-template-columns:1fr; }\n}\n\n.local-pvp-queue-counter { display:flex; align-items:center; gap:7px; padding:7px 10px; border:1px dashed #74879a; border-radius:8px; background:#111b27; }\n.local-pvp-queue-counter strong { color:var(--lp-gold); font-size:1.2rem; }\n.local-pvp-queue-counter span { color:#c5d2df; font-size:.58rem; letter-spacing:1px; }\n.local-pvp-defense-player1 { left:2%; right:auto; border-left:5px solid var(--lp-cyan); }\n.local-pvp-defense-player2 { right:2%; left:auto; border-right:5px solid var(--lp-red); }\n\n.local-pvp-fighter { position:relative; }\n.local-pvp-fighter-defense { position:absolute; z-index:10; top:0; width:min(270px,90vw); padding:10px; border:1px solid var(--lp-gold); border-radius:9px; color:white; background:#101925f7; box-shadow:0 12px 28px #000c; }\n.local-pvp-player1 .local-pvp-fighter-defense { left:calc(100% + 10px); }\n.local-pvp-player2 .local-pvp-fighter-defense { right:calc(100% + 10px); }\n.local-pvp-fighter-defense > strong { display:block; color:var(--lp-gold); font-size:.65rem; }\n.local-pvp-fighter-defense h4 { margin:7px 0; font-size:.85rem; }\n.local-pvp-fighter-defense p { margin:5px 0; font:700 .62rem Arial,sans-serif; }\n.local-pvp-fighter-defense > div { display:grid; gap:5px; }\n.local-pvp-fighter-defense button { padding:7px 5px; border:1px solid #718399; border-radius:6px; color:white; background:#26394d; font-size:.62rem; font-weight:900; }\n.local-pvp-fighter-defense button:disabled { opacity:.4; }\n@media(max-width:600px) {\n .local-pvp-fighter-defense { position:relative; top:auto; left:auto !important; right:auto !important; width:100%; margin-top:8px; }\n}\n\n.local-pvp-player-screen { position:relative; }\n.local-pvp-one-on-one-defense { position:absolute; z-index:9; top:58%; width:min(82%,360px); padding:12px; border:1px solid var(--lp-gold); border-radius:10px; color:white; background:#101925f7; box-shadow:0 12px 30px #000c; }\n.local-pvp-player-one .local-pvp-one-on-one-defense { right:10px; border-right:5px solid var(--lp-cyan); }\n.local-pvp-player-two .local-pvp-one-on-one-defense { left:10px; border-left:5px solid var(--lp-red); }\n.local-pvp-one-on-one-defense > strong { display:block; color:var(--lp-gold); font-size:.68rem; }\n.local-pvp-one-on-one-defense h4 { margin:8px 0; font-size:.9rem; }\n.local-pvp-one-on-one-defense p { font:700 .65rem Arial,sans-serif; }\n.local-pvp-one-on-one-defense > div { display:grid; gap:6px; }\n.local-pvp-one-on-one-defense button { padding:8px; border:1px solid #718399; border-radius:6px; color:white; background:#26394d; font-size:.65rem; font-weight:900; }\n.local-pvp-one-on-one-defense button:disabled { opacity:.4; }\n@media(max-width:600px) {\n .local-pvp-one-on-one-defense { position:relative; top:auto; left:auto !important; right:auto !important; width:100%; margin-top:10px; }\n}\n\n.local-pvp-defense-attack-image { display:block; width:100%; max-height:86px; object-fit:contain; margin:5px auto; border-radius:6px; background:#080e16; }\n"],["STYLE",{},"@import url(\"https://fonts.googleapis.com/css2?family=Oxanium:wght@400;500;600;700;800&family=Rajdhani:wght@400;500;600;700&display=swap\");\n/* ================================\n   HOMESCREEN - ARCADE FIGHTING GAME\n================================ */\n.home-screen {\n  --arcade-red: #ff3159;\n  --arcade-cyan: #13d5ff;\n  --arcade-dark: #080d1c;\n\n  position: relative;\n  isolation: isolate;\n  display: flex;\n  flex-direction: column;\n  min-height: 100vh;\n  overflow: hidden;\n  padding: 24px clamp(20px, 5vw, 72px);\n  box-sizing: border-box;\n  background:\n    radial-gradient(\n      ellipse at 50% 42%,\n      rgba(30, 47, 85, 0.65),\n      transparent 65%\n    ),\n    var(--arcade-dark);\n  color: #fff;\n  font-family: Arial, Helvetica, sans-serif;\n}\n.home-screen *,\n.home-screen *::before,\n.home-screen *::after {\n  box-sizing: border-box;\n}\n.arcade-background {\n  position: absolute;\n  inset: 0;\n  z-index: -1;\n  pointer-events: none;\n  opacity: 0.3;\n  background-image:\n    linear-gradient(rgba(19, 213, 255, 0.07) 1px, transparent 1px),\n    linear-gradient(90deg, rgba(19, 213, 255, 0.07) 1px, transparent 1px);\n  background-size: 48px 48px;\n  mask-image: linear-gradient(\n    to bottom,\n    transparent,\n    black 25%,\n    black 80%,\n    transparent\n  );\n  animation: arcade-grid-drift 18s linear infinite;\n}\n/* HEADER */\n.home-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  width: 100%;\n  max-width: 1400px;\n  margin: 0 auto;\n}\n.game-logo {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n.logo-mark {\n  display: grid;\n  place-items: center;\n  width: 48px;\n  height: 48px;\n  background: var(--arcade-red);\n  color: #fff;\n  font-size: 22px;\n  font-weight: 1000;\n  font-style: italic;\n  transform: skew(-8deg);\n  box-shadow: 4px 4px 0 #79172c;\n  animation: logo-impact 0.65s cubic-bezier(0.16, 1, 0.3, 1) both;\n}\n.logo-name {\n  font-size: clamp(13px, 2vw, 19px);\n  font-weight: 900;\n  letter-spacing: 2px;\n  animation: logo-name-enter 0.65s ease-out 0.12s both;\n}\n.home-header-right {\n  display: flex;\n  align-items: center;\n  justify-content: flex-end;\n  flex-wrap: wrap;\n  gap: 12px;\n}\n.header-tag {\n  padding: 9px 13px;\n  border: 1px solid rgba(19, 213, 255, 0.6);\n  color: var(--arcade-cyan);\n  font-size: 11px;\n  font-weight: 800;\n  letter-spacing: 2px;\n}\n.currency-display {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 10px 14px;\n  border: 1px solid rgba(54, 230, 160, 0.55);\n  background: rgba(54, 230, 160, 0.08);\n  color: #36e6a0;\n  font-size: 14px;\n  font-weight: 900;\n  font-variant-numeric: tabular-nums;\n  box-shadow: 0 0 14px rgba(54, 230, 160, 0.08);\n  animation: currency-arrive 0.6s ease-out 0.25s both;\n}\n.currency-icon {\n  font-size: 19px;\n}\n.currency-label {\n  font-size: 9px;\n  letter-spacing: 1.5px;\n}\n/* MAIN CONTENT */\n.home-content {\n  display: flex;\n  flex: 1;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  width: 100%;\n  max-width: 650px;\n  margin: 0 auto;\n  padding: 48px 0;\n  text-align: center;\n  animation: home-screen-enter 0.55s cubic-bezier(0.16, 1, 0.3, 1) both;\n}\n.home-eyebrow {\n  margin: 0 0 18px;\n  color: var(--arcade-cyan);\n  font-size: 11px;\n  font-weight: 900;\n  letter-spacing: 5px;\n  animation: home-text-enter 0.45s ease-out 0.1s both;\n}\n.home-title {\n  display: flex;\n  flex-direction: column;\n  gap: 0;\n  margin: 0;\n  font-size: clamp(48px, 10vw, 88px);\n  font-weight: 1000;\n  font-style: italic;\n  line-height: 0.87;\n  letter-spacing: -4px;\n  text-shadow: 5px 5px 0 rgba(0, 0, 0, 0.45);\n  animation: home-title-impact 0.7s cubic-bezier(0.16, 1, 0.3, 1) 0.08s both;\n}\n.title-accent {\n  color: var(--arcade-red);\n  -webkit-text-stroke: 1px #ff8ca2;\n  text-shadow:\n    0 0 20px rgba(255, 49, 89, 0.4),\n    5px 5px 0 #75162c;\n}\n.home-subtitle {\n  margin: 25px 0 30px;\n  color: #bdc9df;\n  font-size: 14px;\n  letter-spacing: 1px;\n  animation: home-text-enter 0.5s ease-out 0.2s both;\n}\n.menu-title {\n  margin: 0 0 24px;\n  font-size: clamp(30px, 6vw, 46px);\n  font-weight: 1000;\n  font-style: italic;\n  letter-spacing: -1px;\n  text-shadow: 3px 3px 0 rgba(255, 49, 89, 0.35);\n}\n.menu-description {\n  max-width: 420px;\n  margin: 0 0 28px;\n  color: #bdc9df;\n  font-size: 14px;\n  line-height: 1.6;\n}\n/* MENU BUTTONS */\n.home-menu-buttons {\n  display: flex;\n  flex-direction: column;\n  gap: 13px;\n  width: 100%;\n  max-width: 390px;\n}\n.home-menu-buttons > .arcade-button {\n  animation: home-button-enter 0.45s cubic-bezier(0.16, 1, 0.3, 1) backwards;\n}\n.home-menu-buttons > .arcade-button:nth-child(1) {\n  animation-delay: 0.18s;\n}\n.home-menu-buttons > .arcade-button:nth-child(2) {\n  animation-delay: 0.27s;\n}\n.home-menu-buttons > .arcade-button:nth-child(3) {\n  animation-delay: 0.36s;\n}\n.home-menu-buttons > .arcade-button:nth-child(4) {\n  animation-delay: 0.45s;\n}\n.home-menu-buttons > .arcade-button:nth-child(5) {\n  animation-delay: 0.63s;\n}\n.arcade-button {\n  position: relative;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  width: 100%;\n  min-height: 57px;\n  padding: 17px 22px;\n  border: 1px solid #38435b;\n  border-left: 5px solid var(--arcade-cyan);\n  background: rgba(15, 23, 43, 0.94);\n  color: #f3f6ff;\n  font-size: 13px;\n  font-weight: 900;\n  letter-spacing: 1.5px;\n  text-align: left;\n  cursor: pointer;\n  transition:\n    transform 0.18s ease,\n    background 0.18s ease,\n    border-color 0.18s ease,\n    box-shadow 0.18s ease;\n}\n.arcade-button > span {\n  flex-shrink: 0;\n  color: var(--arcade-cyan);\n  font-size: 10px;\n}\n.arcade-button:hover:not(:disabled) {\n  transform: translateX(5px);\n  border-color: var(--arcade-cyan);\n  background: #152640;\n  box-shadow: 0 0 18px rgba(19, 213, 255, 0.17);\n}\n.primary-button {\n  border-color: var(--arcade-red);\n  border-left-width: 5px;\n  background: var(--arcade-red);\n  color: white;\n  box-shadow: 4px 4px 0 #79172c;\n}\n.primary-button > span {\n  color: white;\n}\n.primary-button:hover:not(:disabled) {\n  border-color: #ff9aad;\n  background: #ff496b;\n  box-shadow:\n    0 0 22px rgba(255, 49, 89, 0.38),\n    4px 4px 0 #79172c;\n}\n.arcade-button:disabled {\n  border-color: #303747;\n  background: #111725;\n  color: #687287;\n  cursor: not-allowed;\n  opacity: 0.65;\n}\n.arcade-button:disabled > span {\n  color: #687287;\n}\n.continue-button {\n  max-width: 390px;\n  margin-top: 24px;\n}\n/* 1v1 / 2v2 SELECTION */\n.choice-grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 15px;\n  width: 100%;\n  max-width: 390px;\n}\n.choice-button {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 12px;\n  min-height: 140px;\n  padding: 18px 10px;\n  border: 2px solid #303c54;\n  background: rgba(15, 23, 43, 0.95);\n  color: white;\n  cursor: pointer;\n  transition: 0.2s ease;\n}\n.choice-button strong {\n  font-size: 43px;\n  font-style: italic;\n  font-weight: 1000;\n}\n.choice-button > span {\n  color: #aebbd2;\n  font-size: 10px;\n  font-weight: 800;\n  letter-spacing: 1.5px;\n}\n.choice-button:hover {\n  border-color: var(--arcade-cyan);\n  transform: translateY(-3px);\n}\n.choice-button.selected {\n  border-color: var(--arcade-red);\n  background: rgba(255, 49, 89, 0.12);\n  box-shadow:\n    inset 0 0 22px rgba(255, 49, 89, 0.09),\n    0 0 15px rgba(255, 49, 89, 0.2);\n  animation: selected-option-pulse 1.8s ease-in-out infinite;\n}\n.choice-button.selected strong {\n  color: var(--arcade-red);\n}\n/* DIFFICULTY */\n.difficulty-list {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n  width: 100%;\n  max-width: 390px;\n}\n.difficulty-button {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  min-height: 54px;\n  padding: 15px 19px;\n  border: 1px solid #303c54;\n  background: rgba(15, 23, 43, 0.95);\n  color: #dce5f6;\n  font-size: 12px;\n  font-weight: 900;\n  letter-spacing: 2px;\n  cursor: pointer;\n  transition: 0.2s ease;\n}\n.difficulty-button:hover {\n  border-color: var(--arcade-cyan);\n}\n.difficulty-button.selected {\n  border-color: var(--arcade-cyan);\n  background: rgba(19, 213, 255, 0.09);\n  color: white;\n  box-shadow: 0 0 14px rgba(19, 213, 255, 0.13);\n}\n.difficulty-check {\n  color: var(--arcade-cyan);\n  font-size: 18px;\n}\n/* TEAM CONTROL CARDS */\n.team-control-grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 14px;\n  width: min(100%, 560px);\n  margin: 24px auto 32px;\n}\n.team-control-card {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  align-items: stretch;\n  gap: 12px;\n  width: 100%;\n  min-width: 0;\n  min-height: 160px;\n  padding: 16px;\n  color: #eef5ff;\n  text-align: left;\n  background: linear-gradient(145deg, #111d31, #0b1425);\n  border: 1px solid #34445d;\n  border-radius: 7px;\n  cursor: pointer;\n  transition:\n    border-color 160ms ease,\n    box-shadow 160ms ease,\n    transform 160ms ease;\n}\n.team-control-card:hover:not(:disabled) {\n  transform: translateY(-2px);\n  border-color: #27dfe8;\n}\n.team-control-card.selected {\n  border: 2px solid #20e7ed;\n  box-shadow: 0 0 12px rgba(32, 231, 237, 0.35);\n}\n.team-control-card:focus-visible {\n  outline: 2px solid #fff;\n  outline-offset: 3px;\n}\n.team-control-card:disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n}\n.team-control-title {\n  min-height: 2.5em;\n  font-size: 0.85rem;\n  font-weight: 800;\n  letter-spacing: 0.04em;\n  line-height: 1.3;\n}\n.team-control-matchup {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 12px;\n  min-height: 42px;\n}\n.matchup-side {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 6px;\n}\n.matchup-rectangle {\n  display: grid;\n  place-items: center;\n  width: 34px;\n  height: 38px;\n  border: 1px solid;\n  border-radius: 4px;\n}\n.matchup-rectangle i {\n  font-size: 1.1rem;\n}\n.matchup-rectangle.player {\n  border-color: #168fe0;\n  background: rgba(22, 143, 224, 0.18);\n  color: #54baff;\n}\n.matchup-rectangle.cpu {\n  border-color: #e83f59;\n  background: rgba(232, 63, 89, 0.18);\n  color: #ff657b;\n}\n.team-control-matchup > b {\n  color: #dce8f5;\n  font-size: 0.75rem;\n  letter-spacing: 0.08em;\n}\n.team-control-description {\n  color: #aab8ca;\n  font-size: 0.78rem;\n  line-height: 1.4;\n}\n/* BACK BUTTON */\n.back-button {\n  position: static;\n  margin: 27px auto 0;\n  padding: 10px 16px;\n  border: none;\n  background: transparent;\n  color: #9caac2;\n  font-size: 11px;\n  font-weight: 900;\n  letter-spacing: 2px;\n  cursor: pointer;\n  transition: color 0.2s ease;\n}\n.back-button:hover {\n  color: white;\n  text-shadow: 0 0 12px rgba(255, 255, 255, 0.5);\n}\n/* FOOTER */\n.home-footer {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  width: 100%;\n  max-width: 1400px;\n  margin: 0 auto;\n  padding-top: 20px;\n  border-top: 1px solid rgba(126, 151, 190, 0.18);\n  color: #738099;\n  font-size: 9px;\n  font-weight: 800;\n  letter-spacing: 1.5px;\n}\n/* FOCUS */\n.arcade-button:focus-visible,\n.choice-button:focus-visible,\n.difficulty-button:focus-visible,\n.back-button:focus-visible {\n  outline: 3px solid #fff;\n  outline-offset: 4px;\n}\n/* ANIMATIONS */\n@keyframes arcade-grid-drift {\n  from {\n    background-position: 0 0, 0 0;\n  }\n\n  to {\n    background-position: 48px 48px, 48px 48px;\n  }\n}\n@keyframes logo-impact {\n  0% {\n    opacity: 0;\n    transform: skew(-8deg) scale(0.65) rotate(-8deg);\n  }\n\n  70% {\n    transform: skew(-8deg) scale(1.12) rotate(2deg);\n  }\n\n  100% {\n    opacity: 1;\n    transform: skew(-8deg) scale(1) rotate(0);\n  }\n}\n@keyframes logo-name-enter {\n  from {\n    opacity: 0;\n    transform: translateX(-12px);\n  }\n\n  to {\n    opacity: 1;\n    transform: translateX(0);\n  }\n}\n@keyframes home-screen-enter {\n  from {\n    opacity: 0;\n    transform: translateY(15px);\n  }\n\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n@keyframes home-text-enter {\n  from {\n    opacity: 0;\n    transform: translateY(10px);\n  }\n\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n@keyframes home-title-impact {\n  0% {\n    opacity: 0;\n    transform: translateY(24px) scale(0.94);\n  }\n\n  75% {\n    opacity: 1;\n    transform: translateY(-3px) scale(1.015);\n  }\n\n  100% {\n    opacity: 1;\n    transform: translateY(0) scale(1);\n  }\n}\n@keyframes home-button-enter {\n  from {\n    opacity: 0;\n    transform: translateX(-22px);\n  }\n\n  to {\n    opacity: 1;\n    transform: translateX(0);\n  }\n}\n@keyframes selected-option-pulse {\n  0%,\n  100% {\n    box-shadow:\n      inset 0 0 22px rgba(255, 49, 89, 0.09),\n      0 0 10px rgba(255, 49, 89, 0.15);\n  }\n\n  50% {\n    box-shadow:\n      inset 0 0 25px rgba(255, 49, 89, 0.16),\n      0 0 19px rgba(255, 49, 89, 0.3);\n  }\n}\n@keyframes currency-arrive {\n  from {\n    opacity: 0;\n    transform: translateY(-8px);\n  }\n\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n/* RESPONSIVE */\n@media (max-width: 650px) {\n  .team-control-grid {\n    grid-template-columns: 1fr;\n    width: min(100%, 390px);\n  }\n}\n@media (max-width: 480px) {\n  .home-screen {\n    padding: 18px;\n  }\n\n  .logo-mark {\n    width: 40px;\n    height: 40px;\n    font-size: 18px;\n  }\n\n  .logo-name {\n    font-size: 11px;\n    letter-spacing: 1px;\n  }\n\n  .header-tag {\n    padding: 8px;\n    font-size: 9px;\n    letter-spacing: 1px;\n  }\n\n  .home-title {\n    letter-spacing: -2px;\n  }\n\n  .home-header-right {\n    gap: 7px;\n  }\n\n  .currency-display {\n    gap: 5px;\n    padding: 8px;\n    font-size: 12px;\n  }\n\n  .currency-label {\n    font-size: 8px;\n  }\n\n  .home-footer {\n    align-items: flex-start;\n    flex-direction: column;\n    font-size: 8px;\n  }\n}\n@media (prefers-reduced-motion: reduce) {\n  .arcade-background,\n  .logo-mark,\n  .logo-name,\n  .home-content,\n  .home-eyebrow,\n  .home-title,\n  .home-subtitle,\n  .home-menu-buttons > .arcade-button,\n  .currency-display,\n  .choice-button.selected {\n    animation: none;\n  }\n\n  .arcade-button,\n  .choice-button,\n  .difficulty-button,\n  .back-button,\n  .team-control-card {\n    transition: none;\n  }\n}\n.keybind-player-grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 1rem;\n  width: min(100%, 900px);\n  max-height: 55vh;\n  overflow-y: auto;\n  margin: 1rem auto;\n}\n.keybind-player {\n  padding: 1rem;\n  border: 1px solid rgba(255, 255, 255, 0.2);\n  border-radius: 8px;\n}\n.keybind-player h3 {\n  margin-bottom: 0.75rem;\n}\n.keybind-row {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 1rem;\n  padding: 0.35rem 0;\n}\n.keybind-button {\n  min-width: 5rem;\n  padding: 0.4rem 0.75rem;\n  color: inherit;\n  background: rgba(255, 255, 255, 0.1);\n  border: 1px solid currentColor;\n  border-radius: 4px;\n  cursor: pointer;\n}\n.keybind-message {\n  min-height: 1.5em;\n  text-align: center;\n}\n.settings-actions {\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  gap: 1rem;\n}\n@media (max-width: 700px) {\n  .keybind-player-grid {\n    grid-template-columns: 1fr;\n    max-height: 60vh;\n  }\n}\n/* FIRST-TIME STARTER SELECTION */\n.starter-modal-overlay {\n  position: fixed;\n  inset: 0;\n  z-index: 1000;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 20px;\n  background: rgba(0, 0, 0, 0.85);\n  backdrop-filter: blur(8px);\n}\n.starter-modal {\n  width: min(100%, 600px);\n  padding: 32px 24px;\n  text-align: center;\n  background: #15151d;\n  border: 2px solid #13d5ff;\n  border-radius: 14px;\n  box-shadow: 0 0 30px rgba(19, 213, 255, 0.2);\n}\n.starter-modal .menu-description {\n  margin-bottom: 25px;\n}\n.starter-choice-grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 14px;\n  margin-bottom: 24px;\n}\n.starter-choice {\n  min-height: 135px;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 12px;\n  padding: 18px 10px;\n  color: white;\n  background: #242430;\n  border: 2px solid #484854;\n  border-radius: 10px;\n  cursor: pointer;\n  transition: 0.2s ease;\n}\n.starter-choice:hover {\n  border-color: #13d5ff;\n  transform: translateY(-3px);\n}\n.starter-choice.selected {\n  border-color: #13d5ff;\n  background: rgba(19, 213, 255, 0.12);\n  box-shadow: 0 0 18px rgba(19, 213, 255, 0.2);\n}\n.starter-choice-name {\n  font-size: 1.4rem;\n  font-weight: 900;\n  letter-spacing: 1px;\n}\n.starter-choice-status {\n  color: #13d5ff;\n  font-size: 0.75rem;\n  font-weight: bold;\n}\n.starter-selected-check {\n  color: #13d5ff;\n  font-size: 0.8rem;\n  font-weight: bold;\n}\n.starter-confirm-button:disabled {\n  opacity: 0.4;\n  cursor: not-allowed;\n  transform: none;\n}\n.starter-modal-note {\n  margin-top: 18px;\n  color: #aaa;\n  font-size: 0.75rem;\n}\n/* LOCKED 2V2 OPTION */\n.choice-button:disabled {\n  opacity: 0.4;\n  cursor: not-allowed;\n  filter: grayscale(0.8);\n  transform: none;\n}\n.choice-button:disabled:hover {\n  transform: none;\n  border-color: inherit;\n}\n@media (max-width: 480px) {\n  .starter-modal {\n    padding: 24px 16px;\n  }\n\n  .starter-choice-grid {\n    gap: 8px;\n  }\n\n  .starter-choice-name {\n    font-size: 1.1rem;\n  }\n}\n.starter-choice-image {\n  width: 90px;\n  height: 110px;\n  object-fit: contain;\n  object-position: center;\n  border-radius: 6px;\n}\n/* ==========================================\n   WILD CARDS — CINEMATIC HOMEPAGE REDESIGN\n========================================== */\n.home-screen {\n  --wc-lime: #a5f51b;\n  --wc-gold: #f6d84a;\n  --wc-ink: #10141c;\n\n  min-height: 100vh;\n  padding: 22px clamp(18px, 4vw, 64px) 18px;\n  background:\n    linear-gradient(\n      180deg,\n      rgba(13, 17, 29, 0.12) 0%,\n      rgba(13, 17, 29, 0.18) 38%,\n      rgba(9, 13, 22, 0.86) 100%\n    ),\n    radial-gradient(\n      ellipse at 50% 25%,\n      rgba(246, 216, 74, 0.24),\n      transparent 48%\n    ),\n    linear-gradient(\n      180deg,\n      #e8a65d 0%,\n      #a75d53 35%,\n      #27334b 70%,\n      #10141c 100%\n    );\n}\n/* Atmospheric environment */\n.arcade-background {\n  position: absolute;\n  inset: 0;\n  z-index: -1;\n  overflow: hidden;\n  opacity: 1;\n  background:\n    radial-gradient(\n      ellipse at 50% 35%,\n      rgba(255, 221, 137, 0.28),\n      transparent 35%\n    ),\n    linear-gradient(\n      180deg,\n      transparent 42%,\n      rgba(12, 18, 30, 0.3) 60%,\n      #10141c 100%\n    );\n  animation: none;\n}\n/* Distant mountain silhouettes */\n.arcade-background::before {\n  content: \"\";\n  position: absolute;\n  inset: 20% -5% 12%;\n  background:\n    linear-gradient(\n      145deg,\n      transparent 0 38%,\n      rgba(48, 53, 76, 0.9) 38.2% 60%,\n      transparent 60.2%\n    ),\n    linear-gradient(\n      35deg,\n      transparent 0 35%,\n      rgba(31, 39, 61, 0.95) 35.2% 62%,\n      transparent 62.2%\n    );\n  clip-path: polygon(\n    0 75%, 12% 42%, 22% 62%, 35% 18%,\n    48% 65%, 63% 30%, 77% 67%, 89% 37%,\n    100% 68%, 100% 100%, 0 100%\n  );\n  opacity: 0.8;\n}\n/* Distant city and tournament lighting */\n.arcade-background::after {\n  content: \"\";\n  position: absolute;\n  inset: 48% 0 0;\n  background:\n    radial-gradient(\n      ellipse at 50% 20%,\n      rgba(246, 216, 74, 0.3),\n      transparent 40%\n    ),\n    repeating-linear-gradient(\n      90deg,\n      transparent 0 35px,\n      rgba(246, 216, 74, 0.18) 36px 38px,\n      transparent 39px 65px\n    );\n  opacity: 0.55;\n  mask-image: linear-gradient(\n    to bottom,\n    transparent,\n    black 20%,\n    black 75%,\n    transparent\n  );\n}\n/* Header */\n.home-header {\n  position: relative;\n  z-index: 2;\n  max-width: 1500px;\n}\n.game-logo {\n  display: none;\n}\n.home-header-spacer {\n  flex: 1;\n}\n/* Main hero */\n.home-content {\n  position: relative;\n  z-index: 1;\n  max-width: 1120px;\n  padding: clamp(20px, 4vh, 45px) 0 28px;\n}\n.home-hero {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  width: 100%;\n}\n.home-hero-brand {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  width: 100%;\n  margin-bottom: clamp(24px, 4vh, 42px);\n  text-align: center;\n}\n.home-hero-brand .home-eyebrow {\n  margin-bottom: 6px;\n  color: var(--wc-gold);\n  font-size: 10px;\n  letter-spacing: 5px;\n  text-shadow: 0 2px 12px rgba(0, 0, 0, 0.7);\n}\n.wild-cards-logo {\n  display: block;\n  width: min(590px, 78vw);\n  max-height: 230px;\n  object-fit: contain;\n  filter:\n    drop-shadow(0 12px 12px rgba(0, 0, 0, 0.45))\n    drop-shadow(0 0 28px rgba(165, 245, 27, 0.12));\n  animation: wc-logo-arrive 0.9s cubic-bezier(0.16, 1, 0.3, 1) both;\n}\n.home-hero-brand .home-subtitle {\n  margin: 8px 0 15px;\n  color: #fff3d2;\n  font-size: 11px;\n  font-weight: 900;\n  letter-spacing: 2.4px;\n  text-shadow: 0 2px 8px rgba(0, 0, 0, 0.8);\n}\n.hero-divider {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 14px;\n  width: min(310px, 70%);\n  color: var(--wc-gold);\n  font-size: 9px;\n  letter-spacing: 3px;\n}\n.hero-divider span {\n  flex: 1;\n  height: 1px;\n  background: linear-gradient(\n    90deg,\n    transparent,\n    rgba(246, 216, 74, 0.8)\n  );\n}\n.hero-divider span:last-child {\n  transform: rotate(180deg);\n}\n/* Mode cards */\n.home-mode-grid {\n  display: grid;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  gap: 13px;\n  width: 100%;\n}\n.mode-card {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n  min-height: 225px;\n  padding: 0;\n  overflow: hidden;\n  border: 1px solid rgba(255, 255, 255, 0.22);\n  background: rgba(13, 19, 31, 0.88);\n  color: white;\n  text-align: left;\n  cursor: pointer;\n  isolation: isolate;\n  transition:\n    transform 220ms ease,\n    border-color 220ms ease,\n    box-shadow 220ms ease;\n}\n.mode-card::before {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  z-index: -1;\n  opacity: 0.8;\n  transition: opacity 220ms ease, transform 350ms ease;\n}\n.mode-card--quick::before {\n  background:\n    radial-gradient(\n      circle at 50% 25%,\n      rgba(165, 245, 27, 0.4),\n      transparent 50%\n    ),\n    linear-gradient(145deg, #58633b, #17251f 75%);\n}\n.mode-card--story::before {\n  background:\n    radial-gradient(\n      circle at 50% 25%,\n      rgba(246, 216, 74, 0.35),\n      transparent 52%\n    ),\n    linear-gradient(145deg, #765443, #252333 75%);\n}\n.mode-card--simulator::before {\n  background:\n    radial-gradient(\n      circle at 50% 25%,\n      rgba(40, 216, 255, 0.3),\n      transparent 52%\n    ),\n    linear-gradient(145deg, #365b69, #18232f 75%);\n}\n.mode-card--festival::before {\n  background:\n    radial-gradient(\n      circle at 50% 25%,\n      rgba(255, 49, 89, 0.32),\n      transparent 52%\n    ),\n    linear-gradient(145deg, #75404a, #251c2b 75%);\n}\n.mode-card:hover {\n  z-index: 2;\n  transform: translateY(-7px);\n  border-color: var(--wc-lime);\n  box-shadow: 0 12px 35px rgba(0, 0, 0, 0.4);\n}\n.mode-card:hover::before {\n  opacity: 1;\n  transform: scale(1.08);\n}\n.mode-card-art {\n  position: relative;\n  display: grid;\n  flex: 1;\n  min-height: 125px;\n  place-items: center;\n  overflow: hidden;\n}\n.mode-card-art::before,\n.mode-card-art::after {\n  content: \"\";\n  position: absolute;\n  width: 130px;\n  height: 130px;\n  border: 1px solid rgba(255, 255, 255, 0.18);\n  transform: rotate(45deg);\n}\n.mode-card-art::after {\n  width: 95px;\n  height: 95px;\n  border-color: rgba(255, 255, 255, 0.28);\n}\n.mode-art-symbol {\n  position: relative;\n  z-index: 1;\n  color: rgba(255, 255, 255, 0.92);\n  font-size: clamp(40px, 5vw, 64px);\n  font-weight: 1000;\n  font-style: italic;\n  text-shadow: 0 5px 18px rgba(0, 0, 0, 0.5);\n  transition: transform 250ms ease;\n}\n.mode-card:hover .mode-art-symbol {\n  transform: scale(1.16) rotate(-5deg);\n}\n.mode-card-info {\n  display: flex;\n  flex-direction: column;\n  gap: 7px;\n  padding: 15px;\n  background: linear-gradient(\n    180deg,\n    rgba(9, 13, 22, 0.65),\n    rgba(9, 13, 22, 0.98)\n  );\n}\n.mode-card-number {\n  color: var(--wc-lime);\n  font-size: 8px;\n  font-weight: 900;\n  letter-spacing: 2px;\n}\n.mode-card-info strong {\n  font-size: clamp(13px, 1.35vw, 17px);\n  font-style: italic;\n  font-weight: 1000;\n  letter-spacing: 0.5px;\n}\n.mode-card-info > span:last-child {\n  min-height: 2.6em;\n  color: #b9c2d0;\n  font-size: 10px;\n  line-height: 1.4;\n}\n.mode-card-arrow {\n  position: absolute;\n  top: 12px;\n  right: 14px;\n  color: white;\n  font-size: 20px;\n  opacity: 0.7;\n  transition: transform 180ms ease;\n}\n.mode-card:hover .mode-card-arrow {\n  transform: translate(3px, -3px);\n  color: var(--wc-lime);\n}\n/* Utility navigation */\n.home-utility-nav {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-wrap: wrap;\n  gap: 15px;\n  margin-top: 25px;\n}\n.home-utility-nav button {\n  padding: 7px 3px;\n  border: 0;\n  background: transparent;\n  color: #d1d5dc;\n  font-size: 9px;\n  font-weight: 900;\n  letter-spacing: 1.5px;\n  cursor: pointer;\n  transition: color 160ms ease;\n}\n.home-utility-nav button:hover {\n  color: var(--wc-lime);\n}\n.home-utility-nav > span {\n  width: 3px;\n  height: 3px;\n  border-radius: 50%;\n  background: var(--wc-gold);\n  opacity: 0.75;\n}\n/* Footer */\n.home-footer {\n  position: relative;\n  z-index: 1;\n  border-top-color: rgba(246, 216, 74, 0.18);\n  color: rgba(225, 225, 225, 0.6);\n}\n/* Entrance animation */\n@keyframes wc-logo-arrive {\n  from {\n    opacity: 0;\n    transform: translateY(18px) scale(0.94);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0) scale(1);\n  }\n}\n/* Responsive layout */\n@media (max-width: 900px) {\n  .home-mode-grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .mode-card {\n    min-height: 205px;\n  }\n\n  .wild-cards-logo {\n    max-height: 190px;\n  }\n}\n@media (max-width: 520px) {\n  .home-screen {\n    padding: 14px 14px 16px;\n  }\n\n  .home-content {\n    padding: 28px 0 20px;\n  }\n\n  .home-mode-grid {\n    gap: 9px;\n  }\n\n  .mode-card {\n    min-height: 175px;\n  }\n\n  .mode-card-art {\n    min-height: 90px;\n  }\n\n  .mode-card-info {\n    padding: 11px;\n  }\n\n  .mode-card-info strong {\n    font-size: 12px;\n  }\n\n  .mode-card-info > span:last-child {\n    font-size: 9px;\n  }\n\n  .home-utility-nav {\n    gap: 9px;\n  }\n\n  .home-utility-nav button {\n    font-size: 8px;\n  }\n\n  .home-utility-nav > span {\n    display: none;\n  }\n\n  .wild-cards-logo {\n    width: min(440px, 90vw);\n  }\n\n  .home-hero-brand .home-eyebrow {\n    font-size: 8px;\n    letter-spacing: 3px;\n  }\n\n  .home-hero-brand .home-subtitle {\n    max-width: 310px;\n    font-size: 9px;\n    line-height: 1.6;\n  }\n}\n@media (prefers-reduced-motion: reduce) {\n  .wild-cards-logo,\n  .mode-card,\n  .mode-card::before,\n  .mode-art-symbol {\n    animation: none;\n    transition: none;\n  }\n}\n/* ==========================================\n   WILD CARDS — MAIN MENU NAVIGATION\n========================================== */\n.home-hero--main {\n  width: 100%;\n  max-width: 850px;\n  margin: auto;\n  padding: 10px 0 20px;\n}\n.home-hero--main .home-hero-brand {\n  margin-bottom: 24px;\n}\n.main-menu-nav {\n  display: flex;\n  flex-direction: column;\n  gap: 9px;\n  width: min(100%, 460px);\n  margin: 0 auto;\n}\n.main-menu-button {\n  position: relative;\n  display: grid;\n  grid-template-columns: 34px 42px 1fr 24px;\n  align-items: center;\n  gap: 12px;\n  min-height: 61px;\n  padding: 9px 17px;\n  overflow: hidden;\n\n  border: 1px solid rgba(246, 216, 74, 0.25);\n  border-left: 3px solid rgba(165, 245, 27, 0.65);\n\n  background:\n    linear-gradient(\n      100deg,\n      rgba(28, 35, 43, 0.97),\n      rgba(13, 19, 29, 0.94)\n    );\n\n  color: #fff;\n  text-align: left;\n  cursor: pointer;\n\n  clip-path: polygon(\n    0 0,\n    calc(100% - 14px) 0,\n    100% 14px,\n    100% 100%,\n    14px 100%,\n    0 calc(100% - 14px)\n  );\n\n  transition:\n    transform 180ms ease,\n    border-color 180ms ease,\n    background 180ms ease,\n    box-shadow 180ms ease;\n}\n.main-menu-button::before {\n  content: \"\";\n  position: absolute;\n  top: 0;\n  bottom: 0;\n  left: -100%;\n  width: 65%;\n  transform: skewX(-22deg);\n  background: linear-gradient(\n    90deg,\n    transparent,\n    rgba(165, 245, 27, 0.12),\n    transparent\n  );\n  transition: left 350ms ease;\n}\n.main-menu-button:hover {\n  z-index: 2;\n  transform: translateX(6px);\n  border-color: rgba(165, 245, 27, 0.8);\n  border-left-color: #a5f51b;\n  background: linear-gradient(\n    100deg,\n    rgba(54, 67, 40, 0.98),\n    rgba(17, 26, 29, 0.98)\n  );\n  box-shadow: 0 5px 20px rgba(0, 0, 0, 0.3);\n}\n.main-menu-button:hover::before {\n  left: 140%;\n}\n.main-menu-button:focus-visible {\n  outline: 2px solid #f6d84a;\n  outline-offset: 3px;\n}\n.main-menu-index {\n  color: rgba(246, 216, 74, 0.65);\n  font-size: 10px;\n  font-weight: 900;\n  letter-spacing: 1px;\n}\n.main-menu-icon {\n  display: grid;\n  place-items: center;\n  width: 36px;\n  height: 36px;\n  border: 1px solid rgba(246, 216, 74, 0.3);\n  background: rgba(246, 216, 74, 0.07);\n  color: #f6d84a;\n  font-size: 18px;\n  font-weight: 900;\n  transform: skew(-5deg);\n}\n.main-menu-label {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n.main-menu-label strong {\n  color: #f5f3e9;\n  font-size: 13px;\n  font-weight: 1000;\n  font-style: italic;\n  letter-spacing: 1.3px;\n}\n.main-menu-label small {\n  color: #929baa;\n  font-size: 8px;\n  font-weight: 800;\n  letter-spacing: 1.6px;\n}\n.main-menu-arrow {\n  color: #a5f51b;\n  font-size: 12px;\n  opacity: 0.65;\n  transition: transform 180ms ease, opacity 180ms ease;\n}\n.main-menu-button:hover .main-menu-arrow {\n  transform: translateX(4px);\n  opacity: 1;\n}\n/* Main PLAY button */\n.main-menu-button--primary {\n  min-height: 69px;\n  border-color: rgba(165, 245, 27, 0.65);\n  border-left: 5px solid #a5f51b;\n  background:\n    linear-gradient(\n      100deg,\n      rgba(83, 102, 42, 0.96),\n      rgba(22, 36, 28, 0.98) 65%,\n      rgba(13, 20, 27, 0.98)\n    );\n  box-shadow:\n    inset 0 0 22px rgba(165, 245, 27, 0.08),\n    0 5px 18px rgba(0, 0, 0, 0.2);\n}\n.main-menu-button--primary .main-menu-label strong {\n  color: #c8ff65;\n  font-size: 16px;\n  letter-spacing: 2px;\n}\n.main-menu-button--primary .main-menu-icon {\n  border-color: rgba(165, 245, 27, 0.65);\n  background: rgba(165, 245, 27, 0.13);\n  color: #c8ff65;\n}\n.main-menu-button--primary .main-menu-index {\n  color: #c8ff65;\n}\n/* Responsive */\n@media (max-width: 600px) {\n  .main-menu-nav {\n    width: min(100%, 420px);\n    gap: 8px;\n  }\n\n  .main-menu-button {\n    min-height: 57px;\n    padding: 8px 11px;\n    grid-template-columns: 25px 36px 1fr 18px;\n    gap: 8px;\n  }\n\n  .main-menu-label strong {\n    font-size: 11px;\n  }\n\n  .main-menu-label small {\n    font-size: 7px;\n  }\n\n  .main-menu-index {\n    font-size: 9px;\n  }\n\n  .main-menu-icon {\n    width: 32px;\n    height: 32px;\n  }\n}\n/* ==========================================\n   SINGLE PLAYER — MODE SELECTION\n========================================== */\n.single-player-screen {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  width: 100%;\n  max-width: 1120px;\n  gap: 18px;\n}\n.single-player-heading {\n  text-align: center;\n}\n.single-player-heading .home-eyebrow {\n  margin-bottom: 10px;\n}\n.single-player-screen .home-mode-grid {\n  width: 100%;\n}\n.single-player-screen .back-button {\n  margin-top: 10px;\n}\n/* ==========================================\n   WILD CARDS — SHARED BUTTON THEME\n========================================== */\n.arcade-button {\n  min-height: 57px;\n  padding: 15px 21px;\n  border: 1px solid rgba(246, 216, 74, 0.35);\n  border-left: 4px solid #a5f51b;\n  border-radius: 0;\n  background: linear-gradient(\n    100deg,\n    rgba(31, 39, 44, 0.98),\n    rgba(13, 19, 29, 0.98)\n  );\n  color: #f5f3e9;\n  font-weight: 900;\n  letter-spacing: 1.5px;\n  clip-path: polygon(\n    0 0,\n    calc(100% - 12px) 0,\n    100% 12px,\n    100% 100%,\n    12px 100%,\n    0 calc(100% - 12px)\n  );\n  box-shadow: none;\n}\n.arcade-button > span {\n  color: #a5f51b;\n}\n.arcade-button:hover:not(:disabled) {\n  transform: translateX(5px);\n  border-color: #a5f51b;\n  background: linear-gradient(\n    100deg,\n    rgba(60, 76, 39, 0.98),\n    rgba(18, 29, 30, 0.98)\n  );\n  box-shadow: 0 5px 18px rgba(0, 0, 0, 0.3);\n}\n.primary-button,\n.primary-button:hover:not(:disabled) {\n  border-color: #a5f51b;\n  border-left: 5px solid #c5ff52;\n  background: linear-gradient(\n    100deg,\n    #53652e,\n    #263b2b 75%,\n    #17251f\n  );\n  color: #eaffc9;\n  box-shadow:\n    inset 0 0 18px rgba(165, 245, 27, 0.1),\n    0 4px 14px rgba(0, 0, 0, 0.25);\n}\n.primary-button > span {\n  color: #d5ff85;\n}\n.back-button {\n  position: relative;\n  padding: 10px 17px;\n  border: 1px solid rgba(246, 216, 74, 0.3);\n  border-radius: 0;\n  background: rgba(15, 21, 30, 0.8);\n  color: #d4d0bd;\n  font-size: 10px;\n  font-weight: 900;\n  letter-spacing: 2px;\n  cursor: pointer;\n  transition: 180ms ease;\n  clip-path: polygon(\n    0 0,\n    calc(100% - 9px) 0,\n    100% 9px,\n    100% 100%,\n    9px 100%,\n    0 calc(100% - 9px)\n  );\n}\n.back-button:hover {\n  border-color: #f6d84a;\n  color: #f6d84a;\n  background: rgba(246, 216, 74, 0.08);\n  transform: translateX(-3px);\n}\n@media (prefers-reduced-motion: reduce) {\n  .main-menu-button,\n  .main-menu-button::before,\n  .main-menu-arrow {\n    transition: none;\n  }\n}\n/* ==============================================\n   WILD CARDS — CONSOLE MENU LAYOUT SYSTEM\n   Main menu + all selection screens\n============================================== */\n.home-screen {\n  --wc-lime: #a5f51b;\n  --wc-gold: #f6d84a;\n  --wc-dark: #10141c;\n  --wc-panel: rgba(12, 18, 27, 0.92);\n  --wc-muted: #aab3c0;\n}\n/* Give the screens more horizontal room */\n.home-content {\n  width: 100%;\n  max-width: 1500px;\n  min-height: 0;\n  padding: 28px 0 36px;\n  align-items: stretch;\n  justify-content: center;\n  text-align: left;\n}\n/* Main menu: logo above, controls below */\n.home-hero--main {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  justify-content: center;\n  width: 100%;\n  max-width: 1500px;\n  min-height: 65vh;\n  margin: auto;\n  padding: 25px 0;\n}\n.home-hero--main .home-hero-brand {\n  align-items: flex-start;\n  width: min(520px, 100%);\n  margin: 0 0 auto;\n  text-align: left;\n}\n.home-hero--main .wild-cards-logo {\n  width: min(460px, 75vw);\n  max-height: 190px;\n  object-position: left center;\n}\n.home-hero--main .home-eyebrow {\n  margin-left: 8px;\n}\n.home-hero--main .home-subtitle {\n  margin-left: 8px;\n  text-align: left;\n}\n.home-hero--main .hero-divider {\n  margin-left: 8px;\n}\n/* Menu buttons occupy the lower-left area */\n.main-menu-nav {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 10px;\n  width: min(690px, 100%);\n  margin: 35px 0 0;\n}\n.main-menu-button {\n  min-height: 66px;\n  padding: 10px 14px;\n  background:\n    linear-gradient(\n      110deg,\n      rgba(29, 37, 42, 0.96),\n      rgba(11, 17, 26, 0.94)\n    );\n  border-color: rgba(246, 216, 74, 0.2);\n  border-left: 3px solid rgba(165, 245, 27, 0.65);\n}\n.main-menu-button--primary {\n  grid-column: span 2;\n  min-height: 75px;\n}\n.main-menu-button:not(.main-menu-button--primary) {\n  grid-template-columns: 25px 34px 1fr 15px;\n  gap: 8px;\n  min-height: 59px;\n}\n.main-menu-button:not(.main-menu-button--primary) .main-menu-icon {\n  width: 30px;\n  height: 30px;\n  font-size: 15px;\n}\n.main-menu-button:not(.main-menu-button--primary)\n.main-menu-label strong {\n  font-size: 11px;\n}\n.main-menu-button:not(.main-menu-button--primary)\n.main-menu-label small {\n  font-size: 7px;\n  letter-spacing: 1px;\n}\n/* More depth in the menu panels */\n.main-menu-button::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  background: linear-gradient(\n    120deg,\n    transparent 20%,\n    rgba(255, 255, 255, 0.025) 50%,\n    transparent 80%\n  );\n}\n.main-menu-button:hover {\n  transform: translateX(5px);\n}\n/* ==============================================\n   SHARED SUBMENU STAGE\n============================================== */\n.home-content:has(.home-menu-buttons),\n.home-content:has(.single-player-screen),\n.home-content:has(.choice-grid),\n.home-content:has(.difficulty-list),\n.home-content:has(.team-control-grid) {\n  align-items: flex-start;\n  justify-content: center;\n  text-align: left;\n}\n/* Play / game mode selection */\n.home-content:has(.home-menu-buttons) {\n  padding-left: clamp(5px, 5vw, 80px);\n}\n.home-content:has(.home-menu-buttons) > * {\n  max-width: 520px;\n}\n.home-menu-buttons {\n  max-width: 460px;\n  gap: 12px;\n}\n/* Single-player cards */\n.single-player-screen {\n  align-items: flex-start;\n  width: 100%;\n  max-width: 1100px;\n  margin: auto 0;\n}\n.single-player-heading {\n  margin-bottom: 12px;\n  text-align: left;\n}\n.single-player-heading .home-eyebrow {\n  margin-bottom: 8px;\n}\n.single-player-screen .home-mode-grid {\n  max-width: 1050px;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n}\n.single-player-screen .mode-card {\n  min-height: 230px;\n}\n/* Consistent screen headings */\n.menu-title {\n  margin-bottom: 10px;\n  color: #fff9e9;\n  font-size: clamp(32px, 5vw, 49px);\n  letter-spacing: -1.5px;\n  text-shadow:\n    3px 3px 0 rgba(0, 0, 0, 0.45),\n    0 0 20px rgba(246, 216, 74, 0.12);\n}\n.home-eyebrow {\n  color: var(--wc-gold);\n  font-size: 10px;\n  letter-spacing: 4px;\n}\n.menu-description {\n  max-width: 490px;\n  margin: 0 0 27px;\n  color: #d1d4d8;\n  font-size: 13px;\n  line-height: 1.7;\n}\n/* ==============================================\n   1V1 / 2V2 — MATCH FORMAT SELECTION\n============================================== */\n.home-content:has(.choice-grid) {\n  padding-left: clamp(5px, 5vw, 80px);\n}\n.home-content:has(.choice-grid) > .home-eyebrow,\n.home-content:has(.choice-grid) > .menu-title,\n.home-content:has(.choice-grid) > .menu-description {\n  width: min(100%, 570px);\n}\n.choice-grid {\n  width: min(100%, 570px);\n  max-width: 570px;\n  gap: 15px;\n}\n.choice-button {\n  position: relative;\n  min-height: 190px;\n  overflow: hidden;\n  gap: 14px;\n  border: 1px solid rgba(246, 216, 74, 0.28);\n  border-bottom: 4px solid rgba(165, 245, 27, 0.45);\n  background:\n    linear-gradient(\n      145deg,\n      rgba(44, 55, 43, 0.94),\n      rgba(12, 19, 26, 0.97)\n    );\n  clip-path: polygon(\n    0 0,\n    calc(100% - 18px) 0,\n    100% 18px,\n    100% 100%,\n    18px 100%,\n    0 calc(100% - 18px)\n  );\n}\n.choice-button:nth-child(2) {\n  background:\n    linear-gradient(\n      145deg,\n      rgba(64, 54, 39, 0.94),\n      rgba(12, 19, 26, 0.97)\n    );\n}\n.choice-button strong {\n  color: #fff4d0;\n  font-size: clamp(45px, 6vw, 65px);\n  text-shadow: 0 5px 15px rgba(0, 0, 0, 0.5);\n}\n.choice-button > span {\n  color: #c9c9bd;\n  font-size: 10px;\n  letter-spacing: 2px;\n}\n.choice-button:hover:not(:disabled) {\n  border-color: var(--wc-gold);\n  border-bottom-color: var(--wc-lime);\n  transform: translateY(-5px);\n  box-shadow: 0 12px 28px rgba(0, 0, 0, 0.3);\n}\n.choice-button.selected {\n  border-color: var(--wc-lime);\n  border-bottom-color: var(--wc-lime);\n  background:\n    linear-gradient(\n      145deg,\n      rgba(79, 99, 42, 0.95),\n      rgba(14, 25, 24, 0.98)\n    );\n  box-shadow:\n    inset 0 0 30px rgba(165, 245, 27, 0.1),\n    0 0 20px rgba(165, 245, 27, 0.15);\n  animation: none;\n}\n.choice-button.selected strong {\n  color: #d7ff91;\n}\n.choice-button:disabled {\n  filter: grayscale(0.8);\n}\n/* Continue action */\n.continue-button {\n  width: min(100%, 570px);\n  max-width: 570px;\n  margin-top: 22px;\n}\n/* ==============================================\n   DIFFICULTY — THREE DISTINCT LEVELS\n============================================== */\n.home-content:has(.difficulty-list) {\n  padding-left: clamp(5px, 5vw, 80px);\n}\n.difficulty-list {\n  width: min(100%, 570px);\n  max-width: 570px;\n  gap: 12px;\n}\n.difficulty-button {\n  position: relative;\n  min-height: 75px;\n  padding: 18px 23px;\n  border: 1px solid rgba(246, 216, 74, 0.22);\n  border-left: 4px solid rgba(246, 216, 74, 0.35);\n  background:\n    linear-gradient(\n      100deg,\n      rgba(31, 39, 43, 0.97),\n      rgba(12, 18, 27, 0.97)\n    );\n  color: #e9e6d9;\n  font-size: 14px;\n  letter-spacing: 3px;\n  clip-path: polygon(\n    0 0,\n    calc(100% - 13px) 0,\n    100% 13px,\n    100% 100%,\n    0 100%\n  );\n}\n.difficulty-button:hover {\n  border-color: var(--wc-gold);\n  border-left-color: var(--wc-lime);\n  background: rgba(47, 57, 39, 0.97);\n}\n.difficulty-button.selected {\n  border-color: var(--wc-lime);\n  border-left-color: var(--wc-lime);\n  background:\n    linear-gradient(\n      100deg,\n      rgba(66, 86, 37, 0.97),\n      rgba(17, 29, 25, 0.98)\n    );\n  color: #eaffc9;\n  box-shadow: inset 0 0 20px rgba(165, 245, 27, 0.09);\n}\n.difficulty-check {\n  color: var(--wc-lime);\n}\n/* ==============================================\n   TEAM CONTROL — MATCHUP OPTIONS\n============================================== */\n.home-content:has(.team-control-grid) {\n  padding-left: clamp(5px, 5vw, 80px);\n}\n.team-control-grid {\n  width: min(100%, 760px);\n  max-width: 760px;\n  gap: 13px;\n  margin: 20px 0 25px;\n}\n.team-control-card {\n  min-height: 170px;\n  padding: 18px;\n  border: 1px solid rgba(246, 216, 74, 0.24);\n  border-bottom: 3px solid rgba(165, 245, 27, 0.35);\n  border-radius: 0;\n  background:\n    linear-gradient(\n      145deg,\n      rgba(34, 43, 44, 0.97),\n      rgba(12, 18, 27, 0.98)\n    );\n  clip-path: polygon(\n    0 0,\n    calc(100% - 14px) 0,\n    100% 14px,\n    100% 100%,\n    14px 100%,\n    0 calc(100% - 14px)\n  );\n}\n.team-control-card:hover:not(:disabled) {\n  transform: translateY(-4px);\n  border-color: var(--wc-gold);\n  border-bottom-color: var(--wc-lime);\n}\n.team-control-card.selected {\n  border: 1px solid var(--wc-lime);\n  border-bottom: 3px solid var(--wc-lime);\n  box-shadow: 0 0 20px rgba(165, 245, 27, 0.15);\n}\n/* Keep player and CPU distinction,\n   but tone down the old neon colors */\n.matchup-rectangle.player {\n  border-color: #a5f51b;\n  background: rgba(165, 245, 27, 0.12);\n  color: #caff7c;\n}\n.matchup-rectangle.cpu {\n  border-color: #f6d84a;\n  background: rgba(246, 216, 74, 0.1);\n  color: #ffe98b;\n}\n/* ==============================================\n   SHARED BUTTONS\n============================================== */\n.arcade-button {\n  min-height: 58px;\n  border: 1px solid rgba(246, 216, 74, 0.3);\n  border-left: 4px solid var(--wc-lime);\n  border-radius: 0;\n  background:\n    linear-gradient(\n      100deg,\n      rgba(34, 43, 42, 0.98),\n      rgba(12, 18, 27, 0.98)\n    );\n  color: #f7f2df;\n  clip-path: polygon(\n    0 0,\n    calc(100% - 13px) 0,\n    100% 13px,\n    100% 100%,\n    13px 100%,\n    0 calc(100% - 13px)\n  );\n  box-shadow: none;\n}\n.arcade-button > span {\n  color: var(--wc-lime);\n}\n.arcade-button:hover:not(:disabled) {\n  transform: translateX(5px);\n  border-color: var(--wc-lime);\n  background:\n    linear-gradient(\n      100deg,\n      rgba(65, 82, 39, 0.98),\n      rgba(17, 28, 27, 0.98)\n    );\n  box-shadow: 0 6px 18px rgba(0, 0, 0, 0.3);\n}\n.primary-button,\n.primary-button:hover:not(:disabled) {\n  border-color: var(--wc-lime);\n  border-left-color: #d6ff8b;\n  background:\n    linear-gradient(\n      100deg,\n      #566b31,\n      #2b422c 75%,\n      #17251f\n    );\n  color: #f0ffd9;\n  box-shadow:\n    inset 0 0 20px rgba(165, 245, 27, 0.1),\n    0 4px 16px rgba(0, 0, 0, 0.25);\n}\n.primary-button > span {\n  color: #e5ffb5;\n}\n.back-button {\n  margin: 24px 0 0;\n  padding: 11px 17px;\n  border: 1px solid rgba(246, 216, 74, 0.28);\n  border-radius: 0;\n  background: rgba(12, 18, 27, 0.8);\n  color: #d9d2bd;\n  clip-path: polygon(\n    0 0,\n    calc(100% - 9px) 0,\n    100% 9px,\n    100% 100%,\n    9px 100%,\n    0 calc(100% - 9px)\n  );\n}\n.back-button:hover {\n  border-color: var(--wc-gold);\n  color: var(--wc-gold);\n  text-shadow: none;\n}\n/* ==============================================\n   RESPONSIVE CONSOLE LAYOUT\n============================================== */\n@media (max-width: 900px) {\n  .home-content {\n    padding-top: 30px;\n    padding-bottom: 30px;\n  }\n\n  .single-player-screen .home-mode-grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .home-hero--main {\n    min-height: 60vh;\n  }\n}\n@media (max-width: 600px) {\n  .home-content:has(.home-menu-buttons),\n  .home-content:has(.choice-grid),\n  .home-content:has(.difficulty-list),\n  .home-content:has(.team-control-grid) {\n    padding-left: 0;\n  }\n\n  .home-hero--main {\n    min-height: auto;\n    padding: 30px 0;\n  }\n\n  .home-hero--main .home-hero-brand {\n    margin-bottom: 28px;\n  }\n\n  .main-menu-nav {\n    grid-template-columns: 1fr;\n    width: 100%;\n    margin-top: 15px;\n  }\n\n  .main-menu-button--primary {\n    grid-column: span 1;\n  }\n\n  .choice-button {\n    min-height: 145px;\n  }\n\n  .choice-button strong {\n    font-size: 42px;\n  }\n\n  .team-control-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .single-player-screen .home-mode-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .home-hero--main .wild-cards-logo {\n    width: min(380px, 90vw);\n  }\n}\n@media (prefers-reduced-motion: reduce) {\n  .choice-button,\n  .difficulty-button,\n  .team-control-card,\n  .arcade-button,\n  .main-menu-button {\n    animation: none;\n    transition: none;\n  }\n}\n/* ==========================================\n   MAIN MENU — FINAL NAVIGATION ARRANGEMENT\n========================================== */\n.main-menu-nav {\n  display: flex !important;\n  flex-direction: column;\n  align-items: stretch;\n  gap: 10px;\n  width: min(100%, 430px);\n  margin: 30px 0 0;\n}\n.main-menu-button {\n  display: grid;\n  grid-template-columns: 42px 1fr 24px;\n  min-height: 63px;\n  width: 100%;\n}\n.main-menu-button--primary {\n  min-height: 76px;\n}\n.main-menu-index {\n  display: none;\n}\n@media (max-width: 600px) {\n  .main-menu-nav {\n    width: 100%;\n    margin-top: 20px;\n  }\n}\n/* ==========================================\n   WILD CARDS — MENU BUTTON TEXT ALIGNMENT FIX\n========================================== */\n/* Main menu button layout */\n.main-menu-button {\n  display: grid;\n  grid-template-columns: 44px minmax(0, 1fr) 24px;\n  align-items: center;\n  column-gap: 15px;\n\n  min-height: 76px;\n  padding: 13px 20px;\n  text-align: left;\n}\n/* Icon */\n.main-menu-icon {\n  width: 40px;\n  height: 40px;\n  flex-shrink: 0;\n}\n/* Text container */\n.main-menu-label {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  justify-content: center;\n  gap: 7px;\n\n  min-width: 0;\n  width: 100%;\n  line-height: normal;\n}\n/* Main button title */\n.main-menu-label strong {\n  display: block;\n  width: 100%;\n  margin: 0;\n\n  font-size: 14px;\n  line-height: 1.25;\n  font-weight: 1000;\n  letter-spacing: 1.4px;\n  white-space: normal;\n}\n/* Button description */\n.main-menu-label small {\n  display: block;\n  width: 100%;\n  margin: 0;\n\n  font-size: 9px;\n  line-height: 1.5;\n  font-weight: 700;\n  letter-spacing: 1.1px;\n  color: #aab3c0;\n  white-space: normal;\n}\n/* Arrow */\n.main-menu-arrow {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  font-size: 17px;\n}\n/* Primary Play button */\n.main-menu-button--primary {\n  min-height: 84px;\n  padding: 15px 20px;\n}\n.main-menu-button--primary .main-menu-label {\n  gap: 8px;\n}\n.main-menu-button--primary .main-menu-label strong {\n  font-size: 17px;\n  letter-spacing: 2px;\n}\n.main-menu-button--primary .main-menu-label small {\n  font-size: 9px;\n}\n/* Other menu buttons */\n.main-menu-button:not(.main-menu-button--primary) {\n  min-height: 72px;\n  grid-template-columns: 44px minmax(0, 1fr) 24px;\n  gap: 15px;\n}\n.main-menu-button:not(.main-menu-button--primary)\n.main-menu-label strong {\n  font-size: 13px;\n}\n.main-menu-button:not(.main-menu-button--primary)\n.main-menu-label small {\n  font-size: 9px;\n}\n/* Responsive */\n@media (max-width: 600px) {\n  .main-menu-button {\n    grid-template-columns: 36px minmax(0, 1fr) 20px;\n    min-height: 68px;\n    padding: 11px 13px;\n    column-gap: 11px;\n  }\n\n  .main-menu-icon {\n    width: 34px;\n    height: 34px;\n    font-size: 15px;\n  }\n\n  .main-menu-label {\n    gap: 5px;\n  }\n\n  .main-menu-label strong {\n    font-size: 12px;\n  }\n\n  .main-menu-label small {\n    font-size: 8px;\n    line-height: 1.4;\n    letter-spacing: 0.7px;\n  }\n\n  .main-menu-button--primary {\n    min-height: 75px;\n  }\n}\n/* ==========================================\n   WILD CARDS — GAMER / ANIME TYPOGRAPHY\n========================================== */\n/* Main interface font */\n.home-screen {\n  font-family: \"Rajdhani\", sans-serif;\n  font-weight: 600;\n}\n/* Main menu and screen headings */\n.home-screen .menu-title,\n.home-screen .home-eyebrow,\n.home-screen .single-player-heading,\n.home-screen .team-control-title,\n.home-screen .starter-modal h2 {\n  font-family: \"Oxanium\", sans-serif;\n  font-weight: 800;\n}\n/* Menu button labels */\n.home-screen .main-menu-label strong,\n.home-screen .arcade-button,\n.home-screen .difficulty-button,\n.home-screen .back-button,\n.home-screen .continue-button {\n  font-family: \"Oxanium\", sans-serif;\n  font-weight: 700;\n}\n/* Main PLAY button */\n.home-screen .main-menu-button--primary .main-menu-label strong {\n  font-weight: 800;\n  letter-spacing: 2.5px;\n}\n/* Supporting menu descriptions */\n.home-screen .menu-description,\n.home-screen .home-subtitle,\n.home-screen .main-menu-label small,\n.home-screen .team-control-description,\n.home-screen .home-footer,\n.home-screen .starter-modal-note {\n  font-family: \"Rajdhani\", sans-serif;\n  font-weight: 600;\n  letter-spacing: 0.5px;\n}\n/* Small interface labels */\n.home-screen .main-menu-index,\n.home-screen .home-utility-nav button,\n.home-screen .header-tag,\n.home-screen .currency-label,\n.home-screen .choice-button > span,\n.home-screen .difficulty-button {\n  letter-spacing: 1.5px;\n}\n/* Match format numbers */\n.home-screen .choice-button strong {\n  font-family: \"Oxanium\", sans-serif;\n  font-weight: 800;\n}\n/* Team selection headings */\n.home-screen .team-control-matchup > b {\n  font-family: \"Oxanium\", sans-serif;\n  font-weight: 700;\n}\n/* Starter character selection */\n.home-screen .starter-choice-name,\n.home-screen .starter-choice-status,\n.home-screen .starter-selected-check {\n  font-family: \"Oxanium\", sans-serif;\n  font-weight: 700;\n}\n/* Currency display */\n.home-screen .currency-display {\n  font-family: \"Oxanium\", sans-serif;\n  font-weight: 700;\n}\n/* ================================\n   SETTINGS — AUDIO CONTROLS\n================================ */\n.audio-settings-section {\n  width: min(100%, 920px);\n  margin: 34px auto 24px;\n  padding: 24px clamp(16px, 3vw, 30px);\n  border: 1px solid rgba(255, 211, 89, 0.22);\n  border-radius: 14px;\n  background: rgba(7, 18, 30, 0.58);\n  text-align: left;\n}\n.audio-settings-section .home-eyebrow,\n.audio-settings-section .menu-title,\n.audio-settings-section .menu-description {\n  text-align: left;\n}\n.audio-setting-row,\n.audio-mute-row {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 22px;\n  padding: 15px 0;\n  border-top: 1px solid rgba(255, 255, 255, 0.09);\n  color: #f4f5f7;\n}\n.audio-setting-copy,\n.audio-mute-row > span {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n.audio-setting-copy strong,\n.audio-mute-row strong {\n  color: #ffe08a;\n  font-size: 0.9rem;\n  letter-spacing: 0.04em;\n}\n.audio-setting-copy small,\n.audio-mute-row small {\n  color: #aab8c8;\n  font-size: 0.75rem;\n}\n.audio-setting-control {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  width: min(48%, 300px);\n}\n.audio-setting-control input {\n  flex: 1;\n  min-width: 100px;\n  accent-color: #ffd45c;\n  cursor: pointer;\n}\n.audio-setting-control output {\n  min-width: 42px;\n  color: #ffe08a;\n  font-size: 0.8rem;\n  font-variant-numeric: tabular-nums;\n  text-align: right;\n}\n.audio-mute-row input {\n  width: 20px;\n  height: 20px;\n  accent-color: #ffd45c;\n  cursor: pointer;\n}\n@media (max-width: 600px) {\n  .audio-settings-section {\n    padding: 18px 14px;\n  }\n\n  .audio-setting-row {\n    align-items: flex-start;\n    flex-direction: column;\n    gap: 10px;\n  }\n\n  .audio-setting-control {\n    width: 100%;\n  }\n}\n/* ==========================================================\n   BEAT-SYNCED LOGO ANIMATIONS\n   Change wc-beat-animation--bounce on the logo element to:\n   --shake | --pulse | --tilt | --pop\n   The beat duration is supplied by the active music track BPM.\n========================================================== */\n.wc-rhythm-active .wc-beat-animation--bounce {\n  animation: wc-logo-bounce var(--wc-beat-duration, 0.5s) ease-in-out infinite;\n}\n.wc-rhythm-active .wc-beat-animation--shake {\n  animation: wc-logo-shake var(--wc-beat-duration, 0.5s) steps(1, end) infinite;\n}\n.wc-rhythm-active .wc-beat-animation--pulse {\n  animation: wc-logo-pulse var(--wc-beat-duration, 0.5s) ease-in-out infinite;\n}\n.wc-rhythm-active .wc-beat-animation--tilt {\n  animation: wc-logo-tilt var(--wc-beat-duration, 0.5s) ease-in-out infinite;\n}\n.wc-rhythm-active .wc-beat-animation--pop {\n  animation: wc-logo-pop var(--wc-beat-duration, 0.5s) cubic-bezier(.2,.8,.2,1) infinite;\n}\n@keyframes wc-logo-bounce {\n  0%, 100% { transform: translateY(0) scale(1); }\n  16% { transform: translateY(-8px) scale(1.035); }\n  32% { transform: translateY(0) scale(1); }\n}\n@keyframes wc-logo-shake {\n  0%, 100% { transform: translateX(0) rotate(0); }\n  12% { transform: translateX(-3px) rotate(-1deg); }\n  24% { transform: translateX(3px) rotate(1deg); }\n  36% { transform: translateX(-2px) rotate(-.5deg); }\n  48% { transform: translateX(0) rotate(0); }\n}\n@keyframes wc-logo-pulse {\n  0%, 100% { transform: scale(1); filter: brightness(1); }\n  18% { transform: scale(1.055); filter: brightness(1.2); }\n  36% { transform: scale(1); filter: brightness(1); }\n}\n@keyframes wc-logo-tilt {\n  0%, 100% { transform: rotate(0) translateY(0); }\n  18% { transform: rotate(-3deg) translateY(-2px); }\n  36% { transform: rotate(3deg) translateY(0); }\n  54% { transform: rotate(0); }\n}\n@keyframes wc-logo-pop {\n  0%, 100% { transform: scale(1); }\n  14% { transform: scale(1.12); }\n  28% { transform: scale(.98); }\n  42% { transform: scale(1); }\n}\n@media (prefers-reduced-motion: reduce) {\n  .wc-rhythm-active [class*=\"wc-beat-animation--\"] { animation: none !important; }\n}\n/* Keep keyboard focus visible while navigating menus with arrows or WASD. */\n.home-screen button:focus-visible {\n  outline: 3px solid var(--arcade-cyan);\n  outline-offset: 5px;\n  box-shadow:\n    0 0 0 2px rgba(8, 13, 28, 0.95),\n    0 0 22px rgba(19, 213, 255, 0.5);\n  filter: brightness(1.16);\n  position: relative;\n  z-index: 5;\n}\n.home-screen .main-menu-button:focus-visible {\n  border-color: var(--arcade-cyan);\n  transform: translateX(5px);\n  background-color: rgba(19, 213, 255, 0.12);\n}\n.home-screen .arcade-button:focus-visible,\n.home-screen .mode-card:focus-visible,\n.home-screen .choice-button:focus-visible,\n.home-screen .difficulty-button:focus-visible,\n.home-screen .team-control-card:focus-visible {\n  border-color: var(--arcade-cyan);\n}\n.home-screen button:disabled:focus-visible {\n  outline-color: rgba(19, 213, 255, 0.35);\n  filter: none;\n}\n/* WILD CARDS — FOUR-FIGHTER STARTER DRAFT */\n.starter-modal-expanded { width:min(100%,900px); max-height:92vh; overflow:auto; border:1px solid #d9bd62; border-radius:22px 5px; background:linear-gradient(125deg,#1a3048,#101c2d 52%,#080f1b); box-shadow:0 22px 70px #000c,0 0 34px #d5bd5e30,inset 0 1px 0 #fff2; }\n.starter-modal-expanded .menu-title { color:#f5d56a; text-shadow:0 3px 0 #795a1e,0 0 18px #f5d56a55; }\n.starter-choice-grid-four { grid-template-columns:repeat(4,minmax(0,1fr)); gap:12px; }\n.starter-choice-expanded { min-width:0; min-height:260px; justify-content:flex-start; padding:12px 9px; gap:8px; background:linear-gradient(155deg,#25435d,#101c2d 80%); border:1px solid #5c86a4; border-bottom:3px solid #091522; border-radius:10px 3px; box-shadow:inset 0 1px 0 #ffffff25,0 3px 0 #050b12; }\n.starter-choice-expanded:hover { border-color:#13d5ff; box-shadow:0 0 18px #13d5ff55; }\n.starter-choice-expanded.selected { border-color:#fff0a1; background:linear-gradient(155deg,#66572f,#182c3e); box-shadow:0 0 20px #f5d56a55; }\n.starter-choice-expanded .starter-choice-name { min-height:2.2em; display:flex; align-items:center; justify-content:center; color:#f5d56a; font:900 clamp(.75rem,1.2vw,1rem) Oxanium,sans-serif; text-align:center; }\n.starter-choice-expanded .starter-choice-status { min-height:2.4em; color:#a9c3da; font:800 .62rem Oxanium,sans-serif; letter-spacing:.6px; text-align:center; }\n.starter-choice-expanded .starter-choice-image { width:100%; height:clamp(110px,17vh,165px); object-fit:contain; }\n.starter-choice-vitals { display:grid; grid-template-columns:1fr 1fr; gap:6px; width:100%; }\n.starter-choice-vitals>span { display:flex; justify-content:space-between; align-items:center; padding:5px 7px; border:1px solid #ffffff24; border-radius:5px; background:#071321aa; }\n.starter-choice-vitals b { color:#a9c3da; font:900 .68rem Oxanium,sans-serif; }\n.starter-choice-vitals strong { color:#fff; font:900 .8rem Oxanium,sans-serif; }\n.starter-expanded-details { display:flex; align-items:center; justify-content:space-between; gap:18px; margin:0 0 18px; padding:14px 16px; text-align:left; border:1px solid #d5bd5e66; border-radius:9px; background:#071321bb; }\n.starter-expanded-details>div:first-child>span { color:#13d5ff; font:800 .65rem Oxanium,sans-serif; letter-spacing:2px; }\n.starter-expanded-details h3 { margin:4px 0; color:#f5d56a; font:900 1.1rem Oxanium,sans-serif; }\n.starter-expanded-details p { margin:0; color:#a9bad0; font:700 .8rem Rajdhani,sans-serif; }\n.starter-detail-stats { display:grid; grid-template-columns:repeat(2,minmax(105px,1fr)); gap:7px; }\n.starter-detail-stats span { display:flex; justify-content:space-between; gap:10px; color:#a9bad0; font:800 .66rem Oxanium,sans-serif; }\n.starter-detail-stats b { color:#fff; }\n.starter-modal-expanded .starter-confirm-button { min-width:min(100%,300px); margin:12px auto 0; }\n.starter-warning-overlay { position:fixed; inset:0; z-index:1100; display:grid; place-items:center; padding:18px; background:#020711d9; backdrop-filter:blur(10px); }\n.starter-warning-modal { width:min(480px,100%); padding:28px; text-align:center; color:#f4f8ff; border:1px solid #e4bf5b; border-radius:18px 4px; background:linear-gradient(145deg,#1a3048,#080f1b); box-shadow:0 22px 70px #000e,0 0 32px #e4bf5b33; }\n.starter-warning-icon { display:block; color:#ffd76b; font-size:42px; filter:drop-shadow(0 0 12px #e4bf5b88); }\n.starter-warning-modal h2 { margin:5px 0 12px; color:#f5d56a; font:900 2rem Oxanium,sans-serif; }\n.starter-warning-modal p { color:#c5d2e2; font:600 1rem Rajdhani,sans-serif; }\n.starter-warning-modal p strong { color:#fff0a1; }\n.starter-warning-modal .starter-warning-emphasis { color:#ff9eaa; font-weight:900; }\n.starter-warning-actions { display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-top:20px; }\n.starter-warning-actions button { min-height:48px; padding:10px; border:1px solid #5c86a4; border-bottom:3px solid #091522; border-radius:8px 3px; color:#f4f8ff; background:linear-gradient(180deg,#25435d,#14283d); font:900 .8rem Oxanium,sans-serif; cursor:pointer; }\n.starter-warning-actions .starter-warning-confirm { color:#111827; border-color:#fff0a1; background:linear-gradient(180deg,#fff0a1,#e5b938); }\n@media(max-width:700px){.starter-modal-expanded{padding:20px 14px}.starter-choice-grid-four{grid-template-columns:repeat(2,minmax(0,1fr))}.starter-choice-expanded{min-height:225px}.starter-expanded-details{align-items:flex-start;flex-direction:column}.starter-detail-stats{width:100%}}\n@media(max-width:380px){.starter-choice-grid-four{grid-template-columns:1fr 1fr}.starter-choice-expanded .starter-choice-image{height:100px}.starter-warning-actions{grid-template-columns:1fr}}\n/* STARTER DRAFT — ATTRIBUTE BARS + REFINED CARD PRESENTATION */\n.starter-modal-overlay { padding: clamp(12px, 3vh, 28px); }\n.starter-modal-expanded {\n  width: min(100%, 1040px);\n  max-height: min(94vh, 900px);\n  padding: clamp(20px, 3vw, 34px);\n  border: 1px solid #f2d778;\n  box-shadow: 0 28px 90px #000e, 0 0 0 1px #ffffff0a, 0 0 42px #e5bf4b35, inset 0 1px 0 #fff3;\n  position: relative;\n}\n.starter-modal-expanded::before {\n  content: \"\";\n  position: absolute;\n  inset: 8px;\n  border: 1px solid #ffffff12;\n  border-radius: 16px 3px;\n  pointer-events: none;\n}\n.starter-modal-expanded > * { position: relative; }\n.starter-modal-expanded .home-eyebrow { color: #63ddff; text-shadow: 0 0 12px #13d5ff66; }\n.starter-modal-expanded .menu-description { max-width: 680px; margin: 8px auto 22px; color: #bdcce0; }\n.starter-choice-grid-four { gap: 14px; }\n.starter-choice-expanded {\n  position: relative;\n  min-height: 275px;\n  padding: 14px 11px 12px;\n  overflow: hidden;\n  transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease, background 180ms ease;\n}\n.starter-choice-expanded::after {\n  content: \"\";\n  position: absolute;\n  inset: auto -20% -55% -20%;\n  height: 65%;\n  background: radial-gradient(ellipse, #13d5ff24, transparent 70%);\n  opacity: 0;\n  transition: opacity 180ms ease;\n  pointer-events: none;\n}\n.starter-choice-expanded:hover { transform: translateY(-4px); }\n.starter-choice-expanded.selected {\n  transform: translateY(-3px);\n  border-color: #ffe58a;\n  box-shadow: 0 0 0 1px #ffe58a66, 0 0 24px #f5d56a66, inset 0 0 24px #f5d56a12;\n}\n.starter-choice-expanded.selected::after { opacity: 1; }\n.starter-choice-expanded .starter-choice-image { filter: drop-shadow(0 8px 12px #0009); transition: transform 220ms ease; }\n.starter-choice-expanded:hover .starter-choice-image { transform: scale(1.045); }\n.starter-choice-vitals > span:first-child { border-color: #ff647c55; }\n.starter-choice-vitals > span:last-child { border-color: #35d9ff55; }\n.starter-choice-vitals > span:first-child b { color: #ff8797; }\n.starter-choice-vitals > span:last-child b { color: #65e5ff; }\n.starter-selected-check {\n  position: absolute;\n  top: 9px;\n  right: 8px;\n  z-index: 2;\n  padding: 4px 7px;\n  border: 1px solid #ffe58a;\n  border-radius: 4px;\n  color: #ffe58a;\n  background: #111b2bea;\n  font: 900 .58rem Oxanium,sans-serif;\n  letter-spacing: .6px;\n}\n.starter-expanded-details {\n  align-items: stretch;\n  margin-top: 16px;\n  padding: 16px 18px;\n  border-color: #e4bf5b66;\n  background: linear-gradient(110deg,#0a1728ee,#12263aee);\n  box-shadow: inset 0 1px 0 #ffffff10, 0 8px 22px #0005;\n}\n.starter-expanded-details > div:first-child { min-width: 170px; align-self: center; }\n.starter-detail-stats {\n  flex: 1;\n  display: grid;\n  grid-template-columns: repeat(2,minmax(0,1fr));\n  gap: 12px 18px;\n}\n.starter-stat-bar { min-width: 0; display: grid; gap: 6px; }\n.starter-stat-heading { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; color: #a9c3da; font: 900 .66rem Oxanium,sans-serif; letter-spacing: .7px; }\n.starter-stat-heading strong { color: #f6f8ff; font-size: .76rem; font-variant-numeric: tabular-nums; }\n.starter-stat-heading small { color: #8396ae; font-size: .58rem; }\n.starter-stat-track { display: block; height: 9px; overflow: hidden; border: 1px solid #ffffff20; border-radius: 20px; background: #030914; box-shadow: inset 0 2px 4px #000b; }\n.starter-stat-fill { display: block; height: 100%; border-radius: inherit; background: linear-gradient(90deg,#1a8db5,#43e1ff); box-shadow: 0 0 10px #13d5ff88; transition: width 320ms ease; }\n.starter-stat-defense .starter-stat-fill { background: linear-gradient(90deg,#7b6935,#f5d56a); box-shadow: 0 0 10px #f5d56a77; }\n.starter-stat-agility .starter-stat-fill { background: linear-gradient(90deg,#168b64,#5af0b0); box-shadow: 0 0 10px #5af0b077; }\n.starter-stat-regen .starter-stat-fill { background: linear-gradient(90deg,#2868bb,#68aaff); box-shadow: 0 0 10px #68aaff77; }\n.starter-stat-slots .starter-stat-fill { background: linear-gradient(90deg,#a04bba,#e18cff); box-shadow: 0 0 10px #e18cff77; }\n.starter-modal-expanded .starter-confirm-button { min-height: 48px; margin-top: 16px; }\n.starter-modal-note { color: #8fa2ba; font: 700 .72rem Rajdhani,sans-serif; letter-spacing: .3px; }\n@media(max-width:700px) {\n  .starter-expanded-details { gap: 12px; }\n  .starter-detail-stats { width: 100%; grid-template-columns: 1fr 1fr; }\n}\n@media(max-width:480px) {\n  .starter-choice-grid-four { gap: 8px; }\n  .starter-choice-expanded { min-height: 225px; padding: 10px 7px; }\n  .starter-choice-expanded .starter-choice-image { height: 100px; }\n  .starter-detail-stats { gap: 10px; }\n}\n/* ==========================================================\n   SETTINGS SCREEN — INTERNAL SCROLL REGION + VISUAL EFFECTS\n   Keep the footer in the viewport while settings scroll above it.\n   ========================================================== */\n.home-screen--settings {\n  height: 100vh;\n  height: 100dvh;\n  min-height: 0;\n  overflow: hidden;\n}\n.home-screen--settings .home-header,\n.home-screen--settings .home-footer {\n  flex: 0 0 auto;\n}\n.home-screen--settings .home-content--settings > * {\n  flex-shrink: 0;\n}\n.home-screen--settings .home-content--settings {\n  flex: 1 1 0;\n  min-height: 0;\n  max-height: none;\n  width: 100%;\n  margin: 0 auto;\n  padding: clamp(14px, 2vh, 24px) 12px 30px;\n  justify-content: flex-start;\n  align-items: stretch;\n  overflow-x: hidden;\n  overflow-y: auto;\n  overscroll-behavior: contain;\n  scrollbar-width: thin;\n  scrollbar-color: #d5bd5e #101a28;\n  scroll-padding-block: 18px;\n}\n.home-screen--settings .home-content--settings::-webkit-scrollbar {\n  width: 9px;\n}\n.home-screen--settings .home-content--settings::-webkit-scrollbar-track {\n  border-radius: 12px;\n  background: #101a28;\n}\n.home-screen--settings .home-content--settings::-webkit-scrollbar-thumb {\n  border: 2px solid #101a28;\n  border-radius: 12px;\n  background: linear-gradient(180deg, #ffe98b, #b58a28);\n}\n.home-screen--settings .keybind-player-grid {\n  max-height: none;\n  overflow: visible;\n  flex: 0 0 auto;\n}\n.home-screen--settings .settings-actions {\n  flex: 0 0 auto;\n  padding: 16px 0 4px;\n}\n.visual-settings-section {\n  width: min(100%, 920px);\n  margin: 26px auto 20px;\n  padding: 24px clamp(16px, 3vw, 30px);\n  border: 1px solid rgba(19, 213, 255, .25);\n  border-radius: 14px;\n  background: linear-gradient(145deg, rgba(8, 26, 42, .94), rgba(7, 15, 27, .94));\n  box-shadow: inset 0 1px 0 #ffffff0c, 0 12px 28px #0005;\n  text-align: left;\n}\n.visual-settings-section .home-eyebrow,\n.visual-settings-section .menu-title,\n.visual-settings-section .menu-description {\n  text-align: left;\n}\n.visual-settings-section .home-eyebrow {\n  color: #13d5ff;\n  margin-bottom: 8px;\n}\n.visual-settings-section .menu-title {\n  margin-bottom: 8px;\n  color: #f4f8ff;\n  font-size: clamp(1.35rem, 3vw, 1.8rem);\n}\n.visual-settings-section .menu-description {\n  margin: 0 0 18px;\n  color: #aab8c8;\n}\n.quality-setting-block {\n  display: grid;\n  gap: 12px;\n  padding: 16px;\n  border: 1px solid #13d5ff35;\n  border-radius: 10px;\n  background: #071321;\n}\n.quality-setting-heading strong {\n  display: block;\n  color: #eaf8ff;\n  font: 900 .86rem Oxanium, sans-serif;\n  letter-spacing: 1.2px;\n}\n.quality-setting-heading small {\n  display: block;\n  margin-top: 4px;\n  color: #54e5ff;\n  font: 800 .76rem Oxanium, sans-serif;\n}\n.quality-setting-options {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 9px;\n}\n.quality-setting-button {\n  display: grid;\n  align-content: center;\n  gap: 5px;\n  min-width: 0;\n  min-height: 68px;\n  padding: 10px 8px;\n  border: 1px solid #35536b;\n  border-bottom: 3px solid #07101a;\n  border-radius: 8px;\n  color: #eaf4ff;\n  background: linear-gradient(180deg, #1b3046, #102033);\n  cursor: pointer;\n  text-align: center;\n  transition: border-color .16s ease, filter .16s ease, transform .16s ease;\n}\n.quality-setting-button strong {\n  font: 900 .84rem Oxanium, sans-serif;\n  letter-spacing: 1px;\n}\n.quality-setting-button small {\n  color: #9eb0c7;\n  font: 700 .72rem Rajdhani, sans-serif;\n  line-height: 1.2;\n}\n.quality-setting-button:hover {\n  border-color: #13d5ff;\n  filter: brightness(1.12);\n  transform: translateY(-1px);\n}\n.quality-setting-button.is-selected {\n  color: #06131e;\n  border-color: #73edff;\n  background: linear-gradient(180deg, #9af1ff, #24cce9);\n  box-shadow: 0 0 14px #13d5ff55;\n}\n.quality-setting-button.is-selected small {\n  color: #123748;\n}\n.quality-setting-note {\n  margin: 0;\n  color: #8fa6bd;\n  font: 600 .78rem/1.45 Rajdhani, sans-serif;\n}\n.visual-setting-toggle {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 18px;\n  margin-top: 12px;\n  padding: 16px 4px 4px;\n  border-top: 1px solid #ffffff20;\n  color: #f4f5f7;\n}\n.visual-setting-toggle > span {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n.visual-setting-toggle strong {\n  color: #ffe08a;\n  font: 800 .9rem Oxanium, sans-serif;\n  letter-spacing: .04em;\n}\n.visual-setting-toggle small {\n  color: #aab8c8;\n  font: 600 .78rem Rajdhani, sans-serif;\n}\n.visual-setting-toggle input {\n  flex: 0 0 auto;\n  width: 21px;\n  height: 21px;\n  accent-color: #13d5ff;\n  cursor: pointer;\n}\n@media (max-width: 700px) {\n  .home-screen--settings {\n    padding-top: 14px;\n    padding-bottom: 12px;\n  }\n  .home-screen--settings .home-content--settings {\n    padding: 12px 2px 24px;\n  }\n  .home-screen--settings .keybind-player-grid {\n    grid-template-columns: 1fr;\n  }\n  .visual-settings-section {\n    padding: 18px 14px;\n  }\n}\n@media (max-width: 520px) {\n  .quality-setting-options {\n    grid-template-columns: 1fr;\n  }\n  .quality-setting-button {\n    min-height: 52px;\n  }\n  .visual-setting-toggle {\n    align-items: flex-start;\n  }\n}\n"],["STYLE",{},"\n@import url(\"https://fonts.googleapis.com/css2?family=Oxanium:wght@400;500;600;700;800&family=Rajdhani:wght@400;500;600;700&display=swap\");\n\n/* ==========================================\n   WILD CARDS — CHARACTER MARKETPLACE\n========================================== */\n\n.shop-screen {\n  --shop-gold: #ffe45c;\n  --shop-lime: #c8ff52;\n  --shop-ivory: #fff4c2;\n  --shop-sage: #c5c9b7;\n\n  position: relative;\n  isolation: isolate;\n  min-height: 100vh;\n  padding: 28px clamp(16px, 4vw, 54px) 36px;\n  overflow: hidden;\n  color: var(--shop-ivory);\n  font-family: \"Rajdhani\", sans-serif;\n  background:\n    radial-gradient(ellipse at 50% -15%, rgba(255, 228, 92, 0.13), transparent 48%),\n    radial-gradient(ellipse at 100% 55%, rgba(165, 245, 27, 0.08), transparent 38%),\n    linear-gradient(145deg, #18221b, #10141c 65%, #090e15);\n}\n\n.shop-screen *,\n.shop-screen *::before,\n.shop-screen *::after {\n  box-sizing: border-box;\n}\n\n.shop-screen::before {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  z-index: -1;\n  pointer-events: none;\n  opacity: 0.16;\n  background-image:\n    linear-gradient(rgba(255, 228, 92, 0.055) 1px, transparent 1px),\n    linear-gradient(90deg, rgba(255, 228, 92, 0.055) 1px, transparent 1px);\n  background-size: 38px 38px;\n  mask-image: linear-gradient(to bottom, black, transparent 85%);\n}\n\n/* HEADER */\n\n.shop-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  flex-wrap: wrap;\n  gap: 16px;\n  max-width: 1450px;\n  margin: 0 auto 48px;\n}\n\n.shop-back-button {\n  position: relative;\n  padding: 12px 18px;\n  color: var(--shop-ivory);\n  background: rgba(17, 25, 27, 0.92);\n  border: 1px solid rgba(255, 228, 92, 0.35);\n  border-left: 4px solid var(--shop-lime);\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 10px;\n  font-weight: 800;\n  letter-spacing: 1.2px;\n  cursor: pointer;\n  transition: 180ms ease;\n}\n\n.shop-back-button:hover {\n  color: var(--shop-gold);\n  border-color: var(--shop-gold);\n  background: rgba(255, 228, 92, 0.07);\n  transform: translateY(-2px);\n}\n\n/* CURRENCY BALANCE */\n\n.shop-balance {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 12px 18px;\n  color: var(--shop-gold);\n  background: linear-gradient(\n    135deg,\n    rgba(255, 228, 92, 0.14),\n    rgba(255, 228, 92, 0.035)\n  );\n  border: 1px solid rgba(255, 228, 92, 0.48);\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 12px;\n  font-weight: 800;\n  letter-spacing: 1px;\n  box-shadow: inset 0 0 16px rgba(255, 228, 92, 0.04);\n}\n\n.shop-balance span {\n  color: var(--shop-gold);\n  font-size: 23px;\n  text-shadow: 0 0 12px rgba(255, 228, 92, 0.4);\n}\n\n/* STORE TITLE */\n\n.shop-heading {\n  position: relative;\n  max-width: 900px;\n  margin: 0 auto 42px;\n  text-align: center;\n}\n\n.shop-heading > p {\n  display: inline-block;\n  margin: 0;\n  padding: 8px 14px;\n  color: var(--shop-lime);\n  background: rgba(200, 255, 82, 0.08);\n  border: 1px solid rgba(200, 255, 82, 0.3);\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 10px;\n  font-weight: 800;\n  letter-spacing: 3px;\n}\n\n.shop-heading h1 {\n  margin: 17px 0 12px;\n  color: var(--shop-gold);\n  font-family: \"Oxanium\", sans-serif;\n  font-size: clamp(36px, 5.5vw, 66px);\n  font-weight: 800;\n  font-style: italic;\n  line-height: 0.98;\n  letter-spacing: -1px;\n  text-transform: uppercase;\n  text-shadow:\n    0 0 20px rgba(255, 228, 92, 0.2),\n    4px 4px 0 rgba(0, 0, 0, 0.4);\n}\n\n.shop-heading > span {\n  display: block;\n  color: var(--shop-sage);\n  font-size: 15px;\n  font-weight: 600;\n  line-height: 1.7;\n}\n\n/* PURCHASE FEEDBACK */\n\n.shop-message {\n  max-width: 700px;\n  margin: 0 auto 28px;\n  padding: 14px 18px;\n  color: var(--shop-lime);\n  background: rgba(200, 255, 82, 0.08);\n  border: 1px solid rgba(200, 255, 82, 0.35);\n  border-left: 3px solid var(--shop-lime);\n  font-size: 14px;\n  font-weight: 700;\n  text-align: center;\n  animation: shop-message-in 0.25s ease-out;\n}\n\n@keyframes shop-message-in {\n  from {\n    opacity: 0;\n    transform: translateY(-6px);\n  }\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n/* CHARACTER GRID */\n\n.shop-grid {\n  display: grid;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  gap: 24px;\n  width: 100%;\n  max-width: 1450px;\n  margin: 0 auto;\n}\n\n/* FIGHTER CARDS */\n\n.shop-card {\n  position: relative;\n  min-width: 0;\n  overflow: hidden;\n  background: linear-gradient(160deg, #283329 0%, #151e1d 62%, #0d1517 100%);\n  border: 1px solid rgba(255, 228, 92, 0.2);\n  border-bottom: 3px solid rgba(200, 255, 82, 0.35);\n  box-shadow:\n    0 10px 25px rgba(0, 0, 0, 0.2),\n    inset 0 1px 0 rgba(255, 255, 255, 0.025);\n  transition:\n    transform 0.25s ease,\n    border-color 0.25s ease,\n    box-shadow 0.25s ease;\n}\n\n.shop-card::before {\n  content: \"\";\n  position: absolute;\n  top: 0;\n  left: 0;\n  z-index: 2;\n  width: 100%;\n  height: 3px;\n  background: var(--shop-gold);\n  opacity: 0;\n  transition: opacity 0.25s ease;\n}\n\n.shop-card:hover {\n  transform: translateY(-7px);\n  border-color: var(--shop-gold);\n  box-shadow:\n    0 15px 32px rgba(0, 0, 0, 0.38),\n    0 0 22px rgba(255, 228, 92, 0.09);\n}\n\n.shop-card:hover::before {\n  opacity: 1;\n}\n\n.shop-card-unlocked {\n  border-color: rgba(200, 255, 82, 0.48);\n  border-bottom-color: var(--shop-lime);\n}\n\n.shop-card-unlocked::before {\n  background: var(--shop-lime);\n  opacity: 0.8;\n}\n\n.shop-card-unlocked:hover {\n  border-color: var(--shop-lime);\n  box-shadow:\n    0 15px 32px rgba(0, 0, 0, 0.38),\n    0 0 20px rgba(200, 255, 82, 0.1);\n}\n\n/* CHARACTER ART */\n\n.shop-portrait {\n  position: relative;\n  height: clamp(225px, 25vw, 310px);\n  overflow: hidden;\n  background:\n    radial-gradient(ellipse at 50% 40%, rgba(165, 245, 27, 0.12), transparent 68%),\n    #111b18;\n  border-bottom: 1px solid rgba(255, 228, 92, 0.16);\n}\n\n.shop-portrait::after {\n  content: \"\";\n  position: absolute;\n  inset: 35% 0 0;\n  pointer-events: none;\n  background: linear-gradient(\n    to bottom,\n    transparent,\n    rgba(8, 13, 18, 0.18) 45%,\n    rgba(8, 13, 18, 0.62)\n  );\n}\n\n.shop-portrait img {\n  display: block;\n  width: 100%;\n  height: 100%;\n  object-fit: contain;\n  object-position: center bottom;\n  padding: 8px 5px 0;\n  transition: transform 0.4s ease;\n}\n\n.shop-card:hover .shop-portrait img {\n  transform: scale(1.055);\n}\n\n/* CENTERED LOCK EMBLEM */\n\n.shop-lock {\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  z-index: 4;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 5px;\n  color: var(--shop-gold);\n  pointer-events: none;\n  transform: translate(-50%, -50%);\n}\n\n/* SVG PADLOCK */\n\n.shop-lock-icon {\n  display: block;\n  width: 58px;\n  height: 65px;\n  overflow: visible;\n  filter:\n    drop-shadow(0 0 4px rgba(255, 228, 92, 0.85))\n    drop-shadow(0 0 13px rgba(255, 228, 92, 0.35));\n  transition: transform 0.25s ease;\n}\n\n/* LOCKED RIBBON */\n\n.shop-lock-ribbon {\n  display: block;\n  padding: 5px 17px;\n  color: #24200c;\n  background: linear-gradient(110deg, #d6a900, #ffe45c 55%, #e9bd27);\n  border: 1px solid #fff0a0;\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 11px;\n  font-weight: 900;\n  line-height: 1.2;\n  letter-spacing: 2px;\n  text-align: center;\n  box-shadow:\n    0 0 12px rgba(255, 228, 92, 0.3),\n    inset 0 1px 0 rgba(255, 255, 255, 0.25);\n  transform: rotate(-10deg);\n}\n\n.shop-card:hover .shop-lock-icon {\n  transform: scale(1.08);\n}\n\n.shop-card:hover .shop-lock-ribbon {\n  box-shadow:\n    0 0 18px rgba(255, 228, 92, 0.45),\n    inset 0 1px 0 rgba(255, 255, 255, 0.25);\n}\n\n/* CARD DETAILS */\n\n.shop-card-info {\n  position: relative;\n  padding: 18px 17px 17px;\n}\n\n.shop-card-info h2 {\n  overflow: hidden;\n  margin: 0 0 10px;\n  color: var(--shop-ivory);\n  font-family: \"Oxanium\", sans-serif;\n  font-size: clamp(16px, 1.4vw, 20px);\n  font-weight: 800;\n  line-height: 1.25;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.shop-card-info p {\n  display: flex;\n  align-items: center;\n  min-height: 18px;\n  margin: 0 0 17px;\n  color: var(--shop-gold);\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 12px;\n  font-weight: 800;\n  letter-spacing: 1px;\n}\n\n.shop-card-unlocked .shop-card-info p {\n  color: var(--shop-lime);\n}\n\n/* PURCHASE BUTTON */\n\n.shop-purchase-button {\n  width: 100%;\n  min-height: 46px;\n  padding: 12px 9px;\n  color: #24200c;\n  background: linear-gradient(110deg, #e9c83b, var(--shop-gold));\n  border: 1px solid #fff0a0;\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 10px;\n  font-weight: 900;\n  letter-spacing: 1px;\n  cursor: pointer;\n  transition:\n    background 0.2s ease,\n    box-shadow 0.2s ease,\n    transform 0.2s ease;\n}\n\n.shop-purchase-button:hover:not(:disabled) {\n  background: linear-gradient(110deg, #fff0a0, #fff8cf);\n  box-shadow: 0 0 20px rgba(255, 228, 92, 0.24);\n  transform: translateY(-1px);\n}\n\n.shop-purchase-button:active:not(:disabled) {\n  transform: translateY(1px);\n}\n\n.shop-purchase-button:disabled {\n  color: var(--shop-lime);\n  background: rgba(200, 255, 82, 0.08);\n  border: 1px solid rgba(200, 255, 82, 0.3);\n  cursor: default;\n}\n\n/* RETURN BUTTON */\n\n.shop-footer {\n  display: flex;\n  justify-content: center;\n  margin: 46px 0 10px;\n  padding-top: 26px;\n  border-top: 1px solid rgba(255, 228, 92, 0.16);\n}\n\n.shop-footer .shop-back-button {\n  min-width: 235px;\n  padding: 15px 22px;\n}\n\n/* TABLETS */\n\n@media (max-width: 1050px) {\n  .shop-grid {\n    grid-template-columns: repeat(3, minmax(0, 1fr));\n    gap: 19px;\n  }\n\n  .shop-portrait {\n    height: clamp(215px, 29vw, 275px);\n  }\n\n  .shop-card-info {\n    padding: 15px 13px;\n  }\n}\n\n/* MOBILE */\n\n@media (max-width: 720px) {\n  .shop-screen {\n    padding: 20px 16px 28px;\n  }\n\n  .shop-header {\n    margin-bottom: 38px;\n  }\n\n  .shop-heading {\n    margin-bottom: 30px;\n  }\n\n  .shop-grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n    gap: 14px;\n  }\n\n  .shop-portrait {\n    height: clamp(190px, 48vw, 270px);\n  }\n\n  .shop-card-info h2 {\n    font-size: 16px;\n  }\n\n  .shop-purchase-button {\n    min-height: 42px;\n    font-size: 9px;\n  }\n}\n\n/* SMALL PHONES */\n\n@media (max-width: 380px) {\n  .shop-screen {\n    padding-right: 11px;\n    padding-left: 11px;\n  }\n\n  .shop-grid {\n    gap: 10px;\n  }\n\n  .shop-portrait {\n    height: 180px;\n  }\n\n  .shop-card-info {\n    padding: 13px 10px;\n  }\n\n  .shop-card-info h2 {\n    font-size: 14px;\n  }\n\n  .shop-card-info p {\n    font-size: 10px;\n    letter-spacing: 0.3px;\n  }\n\n  .shop-purchase-button {\n    padding-right: 4px;\n    padding-left: 4px;\n    font-size: 9px;\n  }\n\n  .shop-balance {\n    padding: 10px 12px;\n  }\n}\n\n/* ACCESSIBILITY */\n\n@media (prefers-reduced-motion: reduce) {\n  .shop-card,\n  .shop-portrait img,\n  .shop-back-button,\n  .shop-purchase-button {\n    transition: none;\n  }\n\n  .shop-message {\n    animation: none;\n  }\n}\n"],["STYLE",{},"@import url(\"https://fonts.googleapis.com/css2?family=Oxanium:wght@400;500;600;700;800&family=Rajdhani:wght@400;500;600;700&display=swap\");\n\n.bot-simulator {\n  min-height: 100vh;\n  padding: 32px;\n  color: #f4f7fb;\n  background:\n    radial-gradient(ellipse at top, #18313f 0%, transparent 55%),\n    #101319;\n}\n\n.simulator-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 20px;\n  margin-bottom: 36px;\n}\n\n.simulator-header button {\n  padding: 10px 16px;\n  border: 1px solid #4a6474;\n  border-radius: 6px;\n  color: #fff;\n  background: #202832;\n  cursor: pointer;\n}\n\n.simulator-header div {\n  text-align: right;\n}\n\n.simulator-header p {\n  margin: 0;\n  color: #13d5ff;\n  font-size: 0.8rem;\n  letter-spacing: 3px;\n}\n\n.simulator-header h1 {\n  margin: 4px 0 0;\n  font-weight: 900;\n  letter-spacing: 2px;\n}\n\n.simulator-setup,\n.simulation-results {\n  max-width: 1050px;\n  margin: 0 auto 28px;\n  padding: 26px;\n  border: 1px solid #35434e;\n  border-radius: 12px;\n  background: rgb(23 29 37 / 94%);\n  box-shadow: 0 12px 32px rgb(0 0 0 / 22%);\n}\n\n.simulator-setup h2,\n.simulation-results h2 {\n  margin-top: 0;\n  font-weight: 800;\n}\n\n.simulator-setup > p {\n  color: #aebac5;\n}\n\n.simulator-bots {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);\n  align-items: center;\n  gap: 22px;\n  margin-top: 28px;\n}\n\n.simulator-bot {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n  min-width: 0;\n  padding: 20px;\n  border: 1px solid #3c4b58;\n  border-radius: 8px;\n  background: #121820;\n}\n\n.simulator-bot h3 {\n  margin: 0 0 10px;\n  color: #13d5ff;\n  font-weight: 800;\n}\n\n.simulator-bot:last-child h3 {\n  color: #ff526d;\n}\n\n.simulator-bot label,\n.simulation-count label {\n  font-size: 0.9rem;\n  font-weight: 700;\n}\n\n.simulator-bot select,\n.simulation-count input {\n  width: 100%;\n  min-width: 0;\n  padding: 11px;\n  border: 1px solid #455360;\n  border-radius: 5px;\n  color: #fff;\n  background: #252e38;\n}\n\n.simulator-versus {\n  color: #ff526d;\n  font-size: 1.6rem;\n  font-weight: 900;\n  font-style: italic;\n}\n\n.simulation-count {\n  max-width: 320px;\n  display: grid;\n  gap: 10px;\n  margin-top: 24px;\n}\n\n.run-simulation-button {\n  display: block;\n  width: 100%;\n  margin-top: 26px;\n  padding: 16px;\n  border: 0;\n  border-radius: 6px;\n  color: #08151a;\n  background: #13d5ff;\n  font-weight: 900;\n  letter-spacing: 1px;\n  cursor: pointer;\n}\n\n.run-simulation-button:hover:not(:disabled) {\n  background: #73e7ff;\n}\n\n.run-simulation-button:disabled {\n  opacity: 0.55;\n  cursor: not-allowed;\n}\n\n.simulation-stat-grid {\n  display: grid;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  gap: 14px;\n  margin: 22px 0;\n}\n\n.simulation-stat-grid > div {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  padding: 18px;\n  border: 1px solid #35434e;\n  border-radius: 8px;\n  background: #121820;\n}\n\n.simulation-stat-grid span {\n  color: #aebac5;\n  font-size: 0.8rem;\n  font-weight: 700;\n}\n\n.simulation-stat-grid strong {\n  font-size: 1.8rem;\n}\n\n.last-simulation {\n  margin-top: 28px;\n}\n\n.last-simulation h3 {\n  margin-top: 22px;\n  font-size: 1rem;\n  font-weight: 800;\n}\n\n.simulation-log {\n  max-height: 360px;\n  overflow-y: auto;\n  padding: 14px;\n  border: 1px solid #35434e;\n  border-radius: 6px;\n  background: #0d1117;\n}\n\n.simulation-log p {\n  margin: 0;\n  padding: 9px 0;\n  border-bottom: 1px solid #29313a;\n  color: #c8d2dc;\n  font-size: 0.9rem;\n}\n\n.simulation-log p:last-child {\n  border-bottom: 0;\n}\n\n@media (max-width: 700px) {\n  .bot-simulator {\n    padding: 16px;\n  }\n\n  .simulator-header {\n    align-items: flex-start;\n  }\n\n  .simulator-header h1 {\n    font-size: 1.35rem;\n  }\n\n  .simulator-bots {\n    grid-template-columns: 1fr;\n  }\n\n  .simulator-versus {\n    text-align: center;\n  }\n\n  .simulation-stat-grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .simulator-setup,\n  .simulation-results {\n    padding: 18px;\n  }\n}\n\n/* Simulation mode selector */\n\n.simulator-mode-buttons {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 12px;\n  margin: 24px 0;\n}\n\n.simulator-mode-buttons button {\n  flex: 1;\n  min-width: 160px;\n  padding: 13px 18px;\n  border: 1px solid #455360;\n  border-radius: 6px;\n  color: #d7e0e8;\n  background: #202832;\n  font-weight: 800;\n  letter-spacing: 1px;\n  cursor: pointer;\n  transition: background 0.2s, border-color 0.2s;\n}\n\n.simulator-mode-buttons button:hover {\n  border-color: #13d5ff;\n}\n\n.simulator-mode-buttons button.active {\n  color: #08151a;\n  background: #13d5ff;\n  border-color: #13d5ff;\n}\n\n.all-matchups-info {\n  margin-top: 24px;\n}\n\n.all-matchups-info > h3 {\n  color: #13d5ff;\n  font-weight: 800;\n}\n\n.all-matchups-info > p {\n  color: #aebac5;\n  line-height: 1.6;\n}\n\n.all-matchups-info strong {\n  color: #fff;\n}\n\n.simulation-warning {\n  margin-top: 16px;\n  color: #aebac5;\n  font-size: 0.9rem;\n  line-height: 1.6;\n}\n\n/* Leaderboard */\n\n.matchup-table-wrapper {\n  width: 100%;\n  margin-top: 24px;\n  overflow-x: auto;\n  border: 1px solid #35434e;\n  border-radius: 8px;\n}\n\n.matchup-table {\n  width: 100%;\n  border-collapse: collapse;\n  text-align: left;\n  white-space: nowrap;\n}\n\n.matchup-table th,\n.matchup-table td {\n  padding: 14px 16px;\n  border-bottom: 1px solid #293540;\n}\n\n.matchup-table th {\n  color: #13d5ff;\n  background: #121820;\n  font-size: 0.8rem;\n  letter-spacing: 0.5px;\n}\n\n.matchup-table td {\n  color: #e0e7ee;\n  background: #171d25;\n}\n\n.matchup-table tbody tr:hover td {\n  background: #222d38;\n}\n\n.matchup-table tbody tr:last-child td {\n  border-bottom: none;\n}\n\n.matchup-table td:nth-child(3) {\n  color: #62e6a7;\n  font-weight: 800;\n}\n\n@media (max-width: 700px) {\n  .simulator-mode-buttons {\n    flex-direction: column;\n  }\n\n  .simulator-mode-buttons button {\n    width: 100%;\n  }\n\n  .matchup-table th,\n  .matchup-table td {\n    padding: 11px 12px;\n  }\n}\n\n.combat-log-health span {\n  padding: 4px 8px;\n  border-radius: 4px;\n  background: rgba(255, 255, 255, 0.06);\n}\n\n/* ABOVE CODE IS DEPRECATED */\n\n/* Starting-order comparison */\n\n.starting-order-comparison {\n  margin-top: 28px;\n}\n\n.starting-order-comparison > h3 {\n  margin-bottom: 10px;\n}\n\n.starting-order-grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 16px;\n  margin-top: 16px;\n}\n\n.starting-order-card {\n  min-width: 0;\n  padding: 18px;\n  border: 1px solid rgba(19, 213, 255, 0.35);\n  border-radius: 8px;\n  background: rgba(19, 213, 255, 0.05);\n}\n\n.starting-order-card h4 {\n  margin-top: 0;\n  margin-bottom: 16px;\n}\n\n.starting-order-card p {\n  margin: 8px 0;\n}\n\n.starting-order-card hr {\n  margin: 16px 0;\n  border: 0;\n  border-top: 1px solid rgba(255, 255, 255, 0.15);\n}\n\n@media (max-width: 700px) {\n  .starting-order-grid {\n    grid-template-columns: 1fr;\n  }\n}\n\n.combat-log-entry {\n  padding: 12px;\n  margin-bottom: 10px;\n  border-radius: 6px;\n}\n\n.combat-log-health {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 10px;\n  margin-top: 10px;\n  font-size: 0.9rem;\n  font-weight: 600;\n}\n\n.combat-log-health > span {\n  display: flex;\n  flex-direction: column;\n  gap: 5px;\n  padding: 8px 12px;\n  border-radius: 5px;\n  background: rgba(255, 255, 255, 0.06);\n}\n\n.health-number {\n  font-size: 1rem;\n  font-weight: 700;\n}\n\n/* Overall fighter ranking */\n\n.matchup-table .overall-score-cell {\n  color: #13d5ff;\n  font-size: 1rem;\n  font-weight: 900;\n}\n\n.matchup-table .top-ranked-fighter td {\n  background: rgba(19, 213, 255, 0.09);\n}\n\n.matchup-table .top-ranked-fighter td:first-child {\n  color: #ffd166;\n  font-size: 1.1rem;\n  font-weight: 900;\n}\n\n.matchup-table .top-ranked-fighter td:nth-child(2) {\n  color: #ffffff;\n  font-weight: 900;\n}\n\n.mana-number {\n  color: #13d5ff;\n  font-size: 0.85rem;\n  margin-left: 8px;\n}\n\n.simulation-progress-header strong {\n  color: #13d5ff;\n}\n\n.simulation-progress {\n  width: 100%;\n  margin-top: 20px;\n  padding: 16px;\n  border: 1px solid rgba(19, 213, 255, 0.3);\n  border-radius: 10px;\n  background: rgba(0, 0, 0, 0.65);\n}\n\n.simulation-progress-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 10px;\n  color: #13d5ff;\n  font-size: 0.85rem;\n  font-weight: bold;\n}\n\n.simulation-progress-track {\n  width: 100%;\n  height: 13px;\n  overflow: hidden;\n  border-radius: 20px;\n  background: #252525;\n  border: 1px solid rgba(255, 255, 255, 0.12);\n}\n\n.simulation-progress-fill {\n  height: 100%;\n  border-radius: inherit;\n  background: linear-gradient(90deg, #087da8, #13d5ff);\n  box-shadow: 0 0 12px rgba(19, 213, 255, 0.55);\n  transition: width 0.2s ease;\n  width: 0%;\n}\n\n.simulation-progress p {\n  margin: 10px 0 0;\n  color: #aaa;\n  font-size: 0.85rem;\n  text-align: center;\n}\n\n/* =========================================\n   ALL MATCHUPS - FIGHTER SELECTION\n========================================= */\n\n.analysis-fighter-selector {\n  margin-top: 28px;\n  padding: 20px;\n  border: 1px solid rgba(19, 213, 255, 0.3);\n  border-radius: 10px;\n  background: rgba(10, 18, 25, 0.8);\n}\n\n.analysis-fighter-selector-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-start;\n  flex-wrap: wrap;\n  gap: 16px;\n}\n\n.analysis-fighter-selector-header h3 {\n  margin: 0 0 8px;\n  color: #13d5ff;\n  font-weight: 900;\n}\n\n.analysis-fighter-selector-header p {\n  margin: 0;\n  color: #aebac5;\n  line-height: 1.5;\n}\n\n.analysis-selection-actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 8px;\n}\n\n.analysis-selection-actions button {\n  padding: 9px 13px;\n  border: 1px solid #13d5ff;\n  border-radius: 5px;\n  color: #13d5ff;\n  background: #121820;\n  font-size: 0.75rem;\n  font-weight: 800;\n  cursor: pointer;\n}\n\n.analysis-selection-actions button:hover:not(:disabled) {\n  color: #08151a;\n  background: #13d5ff;\n}\n\n.analysis-selection-actions button:disabled {\n  opacity: 0.5;\n  cursor: not-allowed;\n}\n\n.analysis-selection-count {\n  margin: 20px 0 12px;\n  color: #aebac5;\n}\n\n.analysis-selection-count strong {\n  color: #13d5ff;\n}\n\n.analysis-fighter-list {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 9px;\n}\n\n.analysis-fighter-option {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  min-width: 0;\n  padding: 11px;\n  border: 1px solid #35434e;\n  border-radius: 6px;\n  background: #171d25;\n  cursor: pointer;\n  transition: border-color 0.2s, background 0.2s;\n}\n\n.analysis-fighter-option:hover {\n  border-color: #13d5ff;\n  background: #202c36;\n}\n\n.analysis-fighter-option input {\n  width: 17px;\n  height: 17px;\n  accent-color: #13d5ff;\n  cursor: pointer;\n}\n\n.analysis-fighter-option span {\n  overflow: hidden;\n  color: #e0e7ee;\n  font-size: 0.9rem;\n  font-weight: 700;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.analysis-selection-warning {\n  margin: 16px 0 0;\n  color: #ff526d;\n  font-weight: 700;\n}\n\n/* =========================================\n   INDIVIDUAL FIGHTER MATCHUP RANKINGS\n========================================= */\n\n.fighter-matchup-rankings {\n  margin-top: 36px;\n}\n\n.fighter-matchup-rankings > h3 {\n  margin-bottom: 8px;\n  color: #13d5ff;\n  font-weight: 900;\n}\n\n.fighter-matchup-rankings > p {\n  color: #aebac5;\n  line-height: 1.5;\n}\n\n.fighter-matchup-grid {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 16px;\n  margin-top: 20px;\n}\n\n.fighter-matchup-card {\n  min-width: 0;\n  padding: 18px;\n  border: 1px solid #35434e;\n  border-radius: 9px;\n  background: #121820;\n}\n\n.fighter-matchup-card > h4 {\n  margin: 0 0 18px;\n  padding-bottom: 12px;\n  border-bottom: 1px solid #35434e;\n  color: #fff;\n  font-size: 1.1rem;\n  font-weight: 900;\n}\n\n.fighter-matchup-columns {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 14px;\n}\n\n.fighter-matchup-columns > div {\n  min-width: 0;\n}\n\n.fighter-matchup-columns h5 {\n  min-height: 34px;\n  margin: 0 0 12px;\n  font-size: 0.75rem;\n  font-weight: 900;\n  line-height: 1.4;\n}\n\n.difficult-opponents-heading {\n  color: #ff526d;\n}\n\n.favorable-opponents-heading {\n  color: #62e6a7;\n}\n\n.fighter-matchup-list {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.fighter-matchup-list li {\n  display: flex;\n  align-items: flex-start;\n  gap: 8px;\n  min-width: 0;\n  padding: 9px;\n  border-radius: 5px;\n  background: #202832;\n}\n\n.matchup-rank {\n  flex-shrink: 0;\n  color: #13d5ff;\n  font-weight: 900;\n}\n\n.fighter-matchup-list li > div {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n  min-width: 0;\n}\n\n.fighter-matchup-list li strong {\n  overflow-wrap: anywhere;\n  color: #fff;\n  font-size: 0.85rem;\n}\n\n.fighter-matchup-list li small {\n  color: #aebac5;\n  font-size: 0.72rem;\n}\n\n.fighter-matchup-empty {\n  color: #84919d;\n  font-size: 0.8rem;\n  line-height: 1.5;\n}\n\n@media (max-width: 850px) {\n  .analysis-fighter-list {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .fighter-matchup-grid {\n    grid-template-columns: 1fr;\n  }\n}\n\n@media (max-width: 550px) {\n  .analysis-fighter-list {\n    grid-template-columns: 1fr;\n  }\n\n  .fighter-matchup-columns {\n    grid-template-columns: 1fr;\n  }\n\n  .analysis-fighter-selector-header {\n    flex-direction: column;\n  }\n}\n\n/* ==========================================\n   WILD CARDS — COMBAT RESEARCH LABORATORY\n========================================== */\n\n.bot-simulator {\n  --lab-blue: #168cff;\n  --lab-cyan: #27dfff;\n  --lab-dark: #050d1b;\n  --lab-panel: rgba(9, 25, 47, 0.94);\n  --lab-border: rgba(39, 160, 255, 0.35);\n\n  font-family: \"Rajdhani\", sans-serif;\n  background:\n    radial-gradient(\n      ellipse at 50% 0%,\n      rgba(0, 119, 255, 0.24),\n      transparent 55%\n    ),\n    radial-gradient(\n      ellipse at 0% 50%,\n      rgba(0, 190, 255, 0.08),\n      transparent 40%\n    ),\n    linear-gradient(145deg, #07172d, #030914 75%);\n}\n\n/* Laboratory atmosphere */\n\n.bot-simulator::before {\n  content: \"\";\n  position: fixed;\n  inset: 0;\n  z-index: 0;\n  pointer-events: none;\n  opacity: 0.15;\n  background-image:\n    linear-gradient(rgba(39, 223, 255, 0.12) 1px, transparent 1px),\n    linear-gradient(90deg, rgba(39, 223, 255, 0.12) 1px, transparent 1px);\n  background-size: 42px 42px;\n  mask-image: linear-gradient(to bottom, black, transparent 90%);\n}\n\n.bot-simulator > * {\n  position: relative;\n  z-index: 1;\n}\n\n/* Header */\n\n.simulator-header {\n  max-width: 1450px;\n  margin: 0 auto 38px;\n  padding-bottom: 20px;\n  border-bottom: 1px solid var(--lab-border);\n}\n\n.simulator-header h1 {\n  font-family: \"Oxanium\", sans-serif;\n  font-weight: 800;\n  letter-spacing: 2.5px;\n  text-shadow: 0 0 18px rgba(39, 223, 255, 0.25);\n}\n\n.simulator-header p {\n  color: var(--lab-cyan);\n  font-family: \"Oxanium\", sans-serif;\n  font-weight: 700;\n}\n\n.simulator-header button {\n  border-color: var(--lab-border);\n  border-radius: 2px;\n  background: #0c2039;\n  font-family: \"Oxanium\", sans-serif;\n  font-weight: 700;\n}\n\n.simulator-header button:hover {\n  border-color: var(--lab-cyan);\n  color: var(--lab-cyan);\n  box-shadow: 0 0 16px rgba(39, 223, 255, 0.15);\n}\n\n/* Main research panels */\n\n.simulator-setup,\n.simulation-results {\n  position: relative;\n  border: 1px solid var(--lab-border);\n  border-radius: 4px;\n  background:\n    linear-gradient(\n      145deg,\n      rgba(13, 37, 66, 0.96),\n      rgba(5, 16, 32, 0.98)\n    );\n  box-shadow:\n    0 15px 40px rgba(0, 0, 0, 0.35),\n    inset 0 1px 0 rgba(39, 223, 255, 0.06);\n}\n\n.simulator-setup h2,\n.simulation-results h2 {\n  font-family: \"Oxanium\", sans-serif;\n  font-weight: 800;\n  letter-spacing: 1.5px;\n}\n\n.simulator-setup > p {\n  color: #a9c6e2;\n}\n\n/* Fighter experiment panels */\n\n.simulator-bot {\n  border: 1px solid rgba(39, 160, 255, 0.3);\n  border-radius: 3px;\n  background: linear-gradient(145deg, #102947, #071629);\n}\n\n.simulator-bot h3 {\n  color: #39caff;\n  font-family: \"Oxanium\", sans-serif;\n  letter-spacing: 1px;\n}\n\n.simulator-bot:last-child h3 {\n  color: #ff526d;\n}\n\n.simulator-bot select,\n.simulation-count input {\n  border-color: rgba(39, 160, 255, 0.4);\n  border-radius: 2px;\n  background: #071a30;\n  font-family: \"Rajdhani\", sans-serif;\n  font-weight: 700;\n}\n\n.simulator-bot select:focus,\n.simulation-count input:focus {\n  outline: 1px solid var(--lab-cyan);\n  border-color: var(--lab-cyan);\n  box-shadow: 0 0 12px rgba(39, 223, 255, 0.15);\n}\n\n/* VS indicator */\n\n.simulator-versus {\n  color: var(--lab-cyan);\n  font-family: \"Oxanium\", sans-serif;\n  text-shadow: 0 0 15px rgba(39, 223, 255, 0.5);\n}\n\n/* Simulation mode selector */\n\n.simulator-mode-buttons button {\n  border-color: var(--lab-border);\n  border-radius: 2px;\n  background: #0b2039;\n  font-family: \"Oxanium\", sans-serif;\n  font-weight: 700;\n}\n\n.simulator-mode-buttons button.active {\n  color: #03111e;\n  background: var(--lab-cyan);\n  border-color: var(--lab-cyan);\n  box-shadow: 0 0 18px rgba(39, 223, 255, 0.25);\n}\n\n/* Run experiment */\n\n.run-simulation-button {\n  border: 1px solid var(--lab-cyan);\n  border-radius: 2px;\n  color: #03111e;\n  background: linear-gradient(100deg, #168cff, #27dfff);\n  font-family: \"Oxanium\", sans-serif;\n  font-weight: 800;\n  letter-spacing: 2px;\n  box-shadow: 0 0 20px rgba(39, 223, 255, 0.13);\n}\n\n.run-simulation-button:hover:not(:disabled) {\n  background: linear-gradient(100deg, #42b5ff, #8cefff);\n  box-shadow: 0 0 25px rgba(39, 223, 255, 0.3);\n}\n\n/* Research statistics */\n\n.simulation-stat-grid > div {\n  border: 1px solid var(--lab-border);\n  border-radius: 3px;\n  background: rgba(5, 19, 36, 0.95);\n}\n\n.simulation-stat-grid span {\n  color: #8eb5d9;\n  font-family: \"Oxanium\", sans-serif;\n  letter-spacing: 0.5px;\n}\n\n.simulation-stat-grid strong {\n  color: var(--lab-cyan);\n  font-family: \"Oxanium\", sans-serif;\n  font-weight: 800;\n}\n\n/* Progress indicator */\n\n.simulation-progress {\n  border-color: var(--lab-border);\n  border-radius: 3px;\n  background: rgba(3, 14, 29, 0.96);\n}\n\n.simulation-progress-header {\n  color: var(--lab-cyan);\n  font-family: \"Oxanium\", sans-serif;\n}\n\n.simulation-progress-header strong {\n  color: #fff;\n}\n\n.simulation-progress-track {\n  border: 1px solid rgba(39, 223, 255, 0.25);\n  border-radius: 2px;\n  background: #071426;\n}\n\n.simulation-progress-fill {\n  border-radius: 1px;\n  background: linear-gradient(90deg, #0875e5, #27dfff);\n  box-shadow: 0 0 15px rgba(39, 223, 255, 0.5);\n}\n\n/* Results tables */\n\n.matchup-table-wrapper {\n  border-color: var(--lab-border);\n  border-radius: 3px;\n}\n\n.matchup-table th {\n  color: var(--lab-cyan);\n  background: #0b2542;\n  font-family: \"Oxanium\", sans-serif;\n}\n\n.matchup-table td {\n  background: #091a30;\n}\n\n.matchup-table tbody tr:hover td {\n  background: #102c4b;\n}\n\n.matchup-table .overall-score-cell {\n  color: var(--lab-cyan);\n}\n\n/* Combat logs */\n\n.simulation-log {\n  border-color: var(--lab-border);\n  border-radius: 3px;\n  background: #030d1a;\n}\n\n.simulation-log p {\n  border-bottom-color: rgba(39, 160, 255, 0.16);\n}\n\n/* Analysis sections */\n\n.analysis-fighter-selector,\n.fighter-matchup-card,\n.starting-order-card {\n  border-color: var(--lab-border);\n  border-radius: 3px;\n  background: var(--lab-panel);\n}\n\n.analysis-fighter-selector-header h3,\n.fighter-matchup-rankings > h3 {\n  color: var(--lab-cyan);\n  font-family: \"Oxanium\", sans-serif;\n}\n\n.analysis-fighter-option {\n  border-color: rgba(39, 160, 255, 0.22);\n  border-radius: 3px;\n  background: #0b1c31;\n}\n\n.analysis-fighter-option:hover {\n  border-color: var(--lab-cyan);\n  background: #102c4b;\n}\n\n.analysis-fighter-option input {\n  accent-color: var(--lab-cyan);\n}\n\n/* Responsive safety */\n\n@media (max-width: 700px) {\n  .simulator-header {\n    gap: 12px;\n  }\n}\n\n/* ==========================================\n   LOADOUT LAB — SLOT-AWARE ATTACK OPTIMIZER\n========================================== */\n\n.loadout-lab {\n  margin-top: 22px;\n}\n\n.loadout-lab-intro {\n  margin-bottom: 22px;\n  padding: 18px;\n  border: 1px solid rgba(39, 223, 255, 0.28);\n  background: rgba(5, 19, 36, 0.75);\n}\n\n.loadout-lab-intro h3,\n.loadout-results h3,\n.loadout-results h4 {\n  margin: 0 0 10px;\n  color: var(--lab-cyan, #27dfff);\n  font-family: \"Oxanium\", sans-serif;\n  font-weight: 800;\n}\n\n.loadout-lab-intro p,\n.loadout-slot-note {\n  margin: 0;\n  color: #a9c6e2;\n  line-height: 1.55;\n}\n\n.loadout-lab-controls {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 16px;\n}\n\n.loadout-lab-panel {\n  min-width: 0;\n  padding: 17px;\n  border: 1px solid rgba(39, 160, 255, 0.3);\n  background: linear-gradient(145deg, #102947, #071629);\n}\n\n.loadout-lab-panel > label,\n.loadout-panel-heading label {\n  display: block;\n  margin-bottom: 11px;\n  color: #39caff;\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 0.85rem;\n  font-weight: 800;\n}\n\n.loadout-lab-panel select,\n.loadout-test-settings input {\n  width: 100%;\n  min-width: 0;\n  padding: 11px;\n  border: 1px solid rgba(39, 160, 255, 0.4);\n  border-radius: 2px;\n  color: #fff;\n  background: #071a30;\n}\n\n.loadout-slot-note {\n  margin-top: 10px;\n  font-size: 0.88rem;\n}\n\n.loadout-panel-heading {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 10px;\n}\n\n.loadout-panel-heading span {\n  color: #27dfff;\n  font-size: 0.82rem;\n  font-weight: 800;\n}\n\n.loadout-choice-list {\n  display: grid;\n  gap: 7px;\n  max-height: 290px;\n  margin-top: 12px;\n  overflow-y: auto;\n}\n\n.loadout-choice {\n  display: flex;\n  align-items: center;\n  gap: 9px;\n  min-width: 0;\n  padding: 9px 10px;\n  border: 1px solid rgba(39, 160, 255, 0.18);\n  background: rgba(3, 14, 29, 0.72);\n  cursor: pointer;\n}\n\n.loadout-choice:hover {\n  border-color: #27dfff;\n}\n\n.loadout-choice input {\n  flex: 0 0 auto;\n  width: 16px;\n  height: 16px;\n  accent-color: #27dfff;\n}\n\n.loadout-choice span {\n  overflow-wrap: anywhere;\n  color: #e0eaf5;\n  font-size: 0.88rem;\n  font-weight: 700;\n}\n\n.loadout-warning {\n  margin: 12px 0 0;\n  color: #ff8294;\n  font-weight: 800;\n}\n\n.loadout-test-settings {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 220px));\n  gap: 16px;\n  margin-top: 20px;\n}\n\n.loadout-test-settings label {\n  display: grid;\n  gap: 8px;\n  color: #b9d5ef;\n  font-weight: 700;\n}\n\n.loadout-results {\n  margin-top: 28px;\n  padding: 20px;\n  border: 1px solid rgba(39, 223, 255, 0.35);\n  background: rgba(3, 14, 29, 0.82);\n}\n\n.loadout-best-score {\n  color: #e9f5ff;\n  font-size: 1.05rem;\n}\n\n.loadout-best-score strong {\n  color: #62e6a7;\n  font-size: 1.35rem;\n}\n\n.loadout-saved-note {\n  color: #62e6a7;\n}\n\n.loadout-best-attacks {\n  display: grid;\n  grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));\n  gap: 9px;\n  margin: 18px 0 24px;\n}\n\n.loadout-best-attacks > div {\n  display: flex;\n  flex-direction: column;\n  gap: 7px;\n  padding: 12px;\n  border: 1px solid rgba(39, 223, 255, 0.24);\n  background: #0b2039;\n}\n\n.loadout-best-attacks span {\n  color: #27dfff;\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 0.72rem;\n  font-weight: 800;\n}\n\n.loadout-best-attacks strong {\n  color: #fff;\n}\n\n.loadout-results h4 {\n  margin-top: 24px;\n}\n\n.loadout-candidate-results {\n  display: grid;\n  gap: 8px;\n}\n\n.loadout-candidate-results > div {\n  display: grid;\n  gap: 5px;\n  padding: 12px;\n  border: 1px solid rgba(39, 160, 255, 0.2);\n  background: #0b1c31;\n}\n\n.loadout-candidate-results > div strong {\n  color: #27dfff;\n}\n\n.loadout-candidate-results > div span {\n  color: #c1d4e8;\n  line-height: 1.4;\n}\n\n.loadout-candidate-results > .loadout-candidate-best {\n  border-color: rgba(98, 230, 167, 0.55);\n  background: rgba(30, 95, 75, 0.18);\n}\n\n@media (max-width: 950px) {\n  .loadout-lab-controls {\n    grid-template-columns: 1fr 1fr;\n  }\n\n  .loadout-lab-panel:first-child {\n    grid-column: 1 / -1;\n  }\n}\n\n@media (max-width: 650px) {\n  .loadout-lab-controls,\n  .loadout-test-settings {\n    grid-template-columns: 1fr;\n  }\n\n  .loadout-lab-panel:first-child {\n    grid-column: auto;\n  }\n}\n\n.matchup-table .ranked-loadout-cell {\n  min-width: 240px;\n  max-width: 420px;\n  color: #b9d5ef;\n  font-size: 0.82rem;\n  line-height: 1.55;\n  white-space: normal;\n}\n\n.ranked-loadout-cell > div + div {\n  margin-top: 7px;\n  padding-top: 7px;\n  border-top: 1px solid rgba(39, 160, 255, 0.16);\n}\n\n.ranked-loadout-cell strong {\n  color: #27dfff;\n}\n\n.optimized-loadout-summary {\n  margin: 22px 0;\n  padding: 18px;\n  border: 1px solid rgba(39, 223, 255, 0.28);\n  background: rgba(5, 19, 36, 0.72);\n}\n\n.optimized-loadout-summary h3 {\n  margin: 0 0 12px;\n  color: #27dfff;\n  font-family: \"Oxanium\", sans-serif;\n  font-weight: 800;\n}\n\n.optimized-loadout-row {\n  display: grid;\n  grid-template-columns: minmax(130px, 0.35fr) minmax(0, 1fr);\n  gap: 12px;\n  padding: 10px 0;\n  border-top: 1px solid rgba(39, 160, 255, 0.16);\n}\n\n.optimized-loadout-row strong {\n  color: #fff;\n}\n\n.optimized-loadout-row span {\n  color: #b9d5ef;\n  line-height: 1.45;\n}\n\n@media (max-width: 650px) {\n  .optimized-loadout-row {\n    grid-template-columns: 1fr;\n    gap: 5px;\n  }\n}\n"],["STYLE",{},"@import url(\"https://fonts.googleapis.com/css2?family=Oxanium:wght@400;500;600;700;800&family=Rajdhani:wght@400;500;600;700&display=swap\");\n.watch-page {\n  min-height: 100vh;\n  padding: 28px;\n  color: #f4f6ff;\n  background:\n    radial-gradient(ellipse at 50% 35%, #24213c 0%, transparent 55%),\n    #10111b;\n}\n.watch-header {\n  position: relative;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  margin-bottom: 30px;\n  text-align: center;\n}\n.watch-header h1 {\n  margin: 5px 0;\n  font-size: clamp(2rem, 5vw, 3.5rem);\n  font-weight: 900;\n  letter-spacing: 0.1em;\n}\n.watch-header p {\n  color: #a9adc2;\n}\n.watch-eyebrow {\n  color: #13d5ff !important;\n  font-size: 0.75rem;\n  font-weight: 800;\n  letter-spacing: 0.2em;\n}\n.watch-back-button {\n  position: absolute;\n  left: 0;\n  top: 0;\n  padding: 10px 14px;\n  border: 1px solid #44465b;\n  border-radius: 8px;\n  color: white;\n  background: #1b1c2b;\n  cursor: pointer;\n}\n.watch-setup,\n.watch-arena,\n.watch-playback,\n.watch-combat-log {\n  max-width: 1100px;\n  margin: 0 auto 22px;\n  padding: 22px;\n  border: 1px solid #34364d;\n  border-radius: 16px;\n  background: #181a28;\n  box-shadow: 0 12px 35px #0003;\n}\n.watch-setup h2,\n.watch-combat-log h2 {\n  margin-top: 0;\n}\n.watch-setup-grid {\n  display: grid;\n  grid-template-columns: 1fr auto 1fr;\n  gap: 20px;\n  align-items: center;\n}\n.watch-setup-side {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n}\n.watch-setup-side label {\n  color: #b7bad0;\n  font-size: 0.9rem;\n}\n.watch-setup-side select {\n  width: 100%;\n  padding: 12px;\n  border: 1px solid #44465b;\n  border-radius: 8px;\n  color: white;\n  background: #10111b;\n}\n.watch-vs {\n  color: #ffcf5c;\n  font-size: 1.5rem;\n  font-weight: 900;\n  font-style: italic;\n}\n.watch-primary-button,\n.watch-secondary-button,\n.watch-speed-button {\n  padding: 11px 16px;\n  border: 1px solid transparent;\n  border-radius: 8px;\n  color: white;\n  font-weight: 800;\n  cursor: pointer;\n  transition: transform 0.15s, filter 0.15s;\n}\n.watch-primary-button {\n  background: linear-gradient(135deg, #087ea4, #13d5ff);\n  color: #07121a;\n}\n.watch-secondary-button,\n.watch-speed-button {\n  border-color: #44465b;\n  background: #252739;\n}\n.watch-primary-button:disabled {\n  opacity: 0.45;\n  cursor: not-allowed;\n}\n.watch-primary-button:not(:disabled):hover,\n.watch-secondary-button:hover,\n.watch-speed-button:hover {\n  filter: brightness(1.15);\n  transform: translateY(-1px);\n}\n.watch-setup > .watch-primary-button {\n  display: block;\n  width: 100%;\n  margin-top: 22px;\n}\n.watch-error {\n  color: #ff8198;\n}\n.watch-arena {\n  position: relative;\n  overflow: hidden;\n  min-height: 420px;\n  background:\n    radial-gradient(ellipse at 50% 100%, #41405c 0%, transparent 55%),\n    linear-gradient(180deg, #202338, #11131f 70%);\n}\n.watch-arena::before {\n  position: absolute;\n  right: 0;\n  bottom: 0;\n  left: 0;\n  height: 25%;\n  background: repeating-linear-gradient(\n    100deg,\n    transparent 0 55px,\n    #8e91b012 56px 58px\n  );\n  border-top: 1px solid #777b9a40;\n  content: \"\";\n  pointer-events: none;\n}\n.watch-round {\n  position: relative;\n  z-index: 1;\n  width: fit-content;\n  margin: 0 auto 18px;\n  padding: 7px 18px;\n  border: 1px solid #696b84;\n  border-radius: 20px;\n  color: #ffcf5c;\n  background: #11131fdc;\n  font-size: 0.8rem;\n  font-weight: 900;\n  letter-spacing: 0.12em;\n}\n.watch-arena-fighters {\n  position: relative;\n  z-index: 1;\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) minmax(120px, 0.8fr) minmax(0, 1fr);\n  align-items: center;\n  gap: 18px;\n}\n.watch-fighter {\n  min-width: 0;\n  text-align: center;\n}\n.watch-fighter-right .watch-fighter-image img {\n  transform: scaleX(-1);\n  animation-name: watch-idle-right;\n}\n.watch-fighter-glow {\n  position: absolute;\n  bottom: 8px;\n  width: 65%;\n  height: 40%;\n  border-radius: 50%;\n  opacity: 0.2;\n  filter: blur(30px);\n}\n.watch-fighter h2 {\n  overflow-wrap: anywhere;\n  font-size: clamp(1rem, 2vw, 1.5rem);\n  font-weight: 900;\n}\n.watch-meter {\n  margin: 12px 0;\n  text-align: left;\n}\n.watch-meter-label {\n  display: flex;\n  justify-content: space-between;\n  gap: 8px;\n  margin-bottom: 5px;\n  color: #c3c6d8;\n  font-size: 0.75rem;\n  font-weight: 700;\n}\n.watch-meter-track {\n  height: 10px;\n  overflow: hidden;\n  border: 1px solid #ffffff15;\n  border-radius: 8px;\n  background: #090a12;\n}\n.watch-meter-fill {\n  height: 100%;\n  border-radius: inherit;\n  transition: width 0.45s ease;\n  box-shadow: 0 0 10px currentColor;\n}\n.watch-fighter-stats {\n  display: flex;\n  justify-content: center;\n  flex-wrap: wrap;\n  gap: 12px;\n  color: #9fa3bb;\n  font-size: 0.75rem;\n  font-weight: 800;\n}\n.watch-arena-center {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 12px;\n  text-align: center;\n}\n.watch-vs-large {\n  color: #ffcf5c;\n  font-size: clamp(2rem, 5vw, 4rem);\n  font-weight: 1000;\n  font-style: italic;\n  text-shadow: 0 0 20px #ffcf5c55;\n}\n.watch-action-banner {\n  width: 100%;\n  padding: 12px 8px;\n  border: 1px solid #545773;\n  border-radius: 8px;\n  background: #10111beF;\n  font-size: 0.85rem;\n  font-weight: 900;\n  overflow-wrap: anywhere;\n  animation: watch-announce 0.3s ease-out;\n}\n.watch-action-defend {\n  border-color: #ffcf5c;\n}\n.watch-action-evade {\n  border-color: #13d5ff;\n}\n.watch-action-take\\ damage {\n  border-color: #ff3159;\n}\n.watch-action-result {\n  color: #ffcf5c;\n  font-size: 0.75rem;\n  font-weight: 900;\n}\n.watch-playback {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  flex-wrap: wrap;\n  gap: 16px;\n}\n.watch-playback-buttons,\n.watch-speed-controls {\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 8px;\n}\n.watch-speed-controls > span {\n  margin-right: 5px;\n  color: #b7bad0;\n  font-size: 0.85rem;\n}\n.watch-speed-button.active {\n  border-color: #13d5ff;\n  color: #13d5ff;\n  background: #13d5ff18;\n}\n.watch-log-list {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  max-height: 260px;\n  overflow-y: auto;\n  padding-right: 5px;\n}\n.watch-log-entry {\n  display: grid;\n  grid-template-columns: 36px 1fr;\n  gap: 10px;\n  padding: 10px;\n  border-radius: 7px;\n  background: #222436;\n  color: #d8daea;\n  font-size: 0.85rem;\n  line-height: 1.5;\n}\n.watch-log-entry strong {\n  color: white;\n}\n.watch-log-round {\n  color: #13d5ff;\n  font-weight: 900;\n}\n@keyframes watch-idle {\n  0%, 100% { transform: translateY(0); }\n  50% { transform: translateY(-6px); }\n}\n@keyframes watch-idle-right {\n  0%, 100% { transform: scaleX(-1) translateY(0); }\n  50% { transform: scaleX(-1) translateY(-6px); }\n}\n@keyframes watch-announce {\n  from { opacity: 0; transform: scale(0.94); }\n  to { opacity: 1; transform: scale(1); }\n}\n@media (max-width: 700px) {\n  .watch-page {\n    padding: 14px;\n  }\n\n  .watch-header {\n    padding-top: 48px;\n  }\n\n  .watch-setup,\n  .watch-arena,\n  .watch-playback,\n  .watch-combat-log {\n    padding: 14px;\n  }\n\n  .watch-setup-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .watch-vs {\n    text-align: center;\n  }\n\n  .watch-arena-fighters {\n    grid-template-columns: minmax(0, 1fr) minmax(80px, 0.65fr) minmax(0, 1fr);\n    gap: 8px;\n  }\n\n  .watch-fighter-image {\n    height: 140px;\n  }\n\n  .watch-fighter-image img {\n    width: 130px;\n  }\n\n  .watch-action-banner {\n    padding: 8px 4px;\n    font-size: 0.7rem;\n  }\n\n  .watch-meter-label {\n    font-size: 0.65rem;\n  }\n\n  .watch-meter-track {\n    height: 8px;\n  }\n\n  .watch-playback {\n    align-items: flex-start;\n    flex-direction: column;\n  }\n}\n/* =========================================\n   WATCH MODE — STUNNED PORTRAIT EFFECT\n========================================= */\n.watch-fighter-image {\n  position: relative;\n  display: flex;\n  align-items: end;\n  justify-content: center;\n  height: 190px;\n  margin-bottom: 8px;\n  width: 125px;\n  flex: 0 0 125px;\n  overflow: hidden;\n  isolation: isolate;\n  margin-inline: auto;\n}\n.watch-fighter-image.fighter-stunned {\n  animation: watch-stun-shake 0.35s infinite;\n}\n/* Keep the image within the exact portrait dimensions */\n.watch-fighter-image img {\n  position: relative;\n  z-index: 1;\n  max-width: 100%;\n  width: 125px;\n  height: 190px;\n  object-fit: cover;\n  object-position: bottom;\n  filter: drop-shadow(0 8px 12px #0008);\n  animation: watch-idle 2.8s ease-in-out infinite;\n  display: block;\n}\n.watch-fighter-image.fighter-stunned img {\n  filter:\n    drop-shadow(0 0 4px #13d5ff)\n    drop-shadow(0 0 9px rgba(19, 213, 255, 0.8));\n\n  animation: watch-stun-glow 1s ease-in-out infinite alternate;\n}\n/* Light stays strictly inside the portrait */\n.watch-fighter-image.fighter-stunned::after {\n  content: \"\";\n  position: absolute;\n  z-index: 2;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n  pointer-events: none;\n\n  background: linear-gradient(\n    110deg,\n    transparent 25%,\n    rgba(19, 213, 255, 0.12) 40%,\n    rgba(255, 255, 255, 0.9) 50%,\n    rgba(19, 213, 255, 0.4) 58%,\n    transparent 75%\n  );\n\n  background-size: 250% 100%;\n  animation: watch-stun-lightning 1.7s linear infinite;\n}\n@keyframes watch-stun-shake {\n  0%, 100% { transform: translateX(0); }\n  25% { transform: translateX(-2px); }\n  75% { transform: translateX(2px); }\n}\n@keyframes watch-stun-glow {\n  from {\n    filter:\n      drop-shadow(0 0 3px #13d5ff)\n      drop-shadow(0 0 6px rgba(19, 213, 255, 0.4));\n  }\n\n  to {\n    filter:\n      drop-shadow(0 0 6px #13d5ff)\n      drop-shadow(0 0 12px rgba(19, 213, 255, 0.9));\n  }\n}\n@keyframes watch-stun-lightning {\n  from { background-position: 100% 0; }\n  to { background-position: -150% 0; }\n}\n@media (prefers-reduced-motion: reduce) {\n  .watch-fighter-image.fighter-stunned,\n  .watch-fighter-image.fighter-stunned img,\n  .watch-fighter-image.fighter-stunned::after {\n    animation: none !important;\n  }\n}\n/* ==========================================\n   WILD CARDS — WATCH MODE\n   COMBAT RESEARCH LABORATORY\n========================================== */\n.watch-page {\n  --watch-blue: #168cff;\n  --watch-cyan: #27dfff;\n  --watch-dark: #050d1b;\n  --watch-panel: rgba(9, 25, 47, 0.94);\n  --watch-border: rgba(39, 160, 255, 0.35);\n\n  position: relative;\n  isolation: isolate;\n  overflow: hidden;\n  font-family: \"Rajdhani\", sans-serif;\n  color: #edf7ff;\n\n  background:\n    radial-gradient(\n      ellipse at 50% 0%,\n      rgba(0, 119, 255, 0.25),\n      transparent 55%\n    ),\n    radial-gradient(\n      ellipse at 0% 55%,\n      rgba(0, 190, 255, 0.08),\n      transparent 40%\n    ),\n    linear-gradient(145deg, #07172d, #030914 75%);\n}\n.watch-page::before {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  z-index: -1;\n  pointer-events: none;\n  opacity: 0.13;\n\n  background-image:\n    linear-gradient(rgba(39, 160, 255, 0.13) 1px, transparent 1px),\n    linear-gradient(90deg, rgba(39, 160, 255, 0.13) 1px, transparent 1px);\n\n  background-size: 42px 42px;\n}\n.watch-page > * {\n  position: relative;\n  z-index: 1;\n}\n/* HEADER */\n.watch-header {\n  margin-bottom: 34px;\n}\n.watch-header h1 {\n  font-family: \"Oxanium\", sans-serif;\n  font-weight: 800;\n  letter-spacing: 0.12em;\n  text-transform: uppercase;\n  color: #f4fbff;\n  text-shadow:\n    0 0 12px rgba(22, 140, 255, 0.35),\n    0 0 30px rgba(39, 223, 255, 0.12);\n}\n.watch-header p {\n  color: #9bb9d4;\n  font-size: 1.1rem;\n}\n.watch-eyebrow {\n  color: var(--watch-cyan) !important;\n  font-family: \"Oxanium\", sans-serif;\n  letter-spacing: 0.24em;\n  text-shadow: 0 0 12px rgba(39, 223, 255, 0.4);\n}\n.watch-back-button {\n  border: 1px solid var(--watch-border);\n  border-radius: 8px;\n  color: #dff5ff;\n  background: rgba(8, 28, 52, 0.9);\n  font-family: \"Oxanium\", sans-serif;\n  font-weight: 700;\n  transition: 0.2s ease;\n}\n.watch-back-button:hover {\n  border-color: var(--watch-cyan);\n  color: white;\n  background: rgba(22, 140, 255, 0.2);\n  box-shadow: 0 0 18px rgba(39, 223, 255, 0.15);\n}\n/* LAB PANELS */\n.watch-setup,\n.watch-arena,\n.watch-playback,\n.watch-combat-log {\n  border: 1px solid var(--watch-border);\n  border-radius: 14px;\n  background:\n    linear-gradient(\n      145deg,\n      rgba(13, 37, 66, 0.96),\n      rgba(5, 16, 31, 0.97)\n    );\n  box-shadow:\n    0 14px 35px rgba(0, 0, 0, 0.35),\n    inset 0 1px 0 rgba(39, 223, 255, 0.06);\n}\n.watch-setup h2,\n.watch-combat-log h2 {\n  color: #eaf8ff;\n  font-family: \"Oxanium\", sans-serif;\n  font-weight: 800;\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n}\n/* FIGHTER CONFIGURATION */\n.watch-setup-side label {\n  color: #9fc5e4;\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 0.82rem;\n  font-weight: 700;\n  letter-spacing: 0.06em;\n  text-transform: uppercase;\n}\n.watch-setup-side select {\n  border: 1px solid rgba(39, 160, 255, 0.3);\n  border-radius: 7px;\n  color: #eaf8ff;\n  background: #07172b;\n  font-family: \"Rajdhani\", sans-serif;\n  font-size: 1rem;\n  font-weight: 600;\n  outline: none;\n  transition: 0.2s ease;\n}\n.watch-setup-side select:focus {\n  border-color: var(--watch-cyan);\n  box-shadow: 0 0 0 2px rgba(39, 223, 255, 0.12);\n}\n.watch-vs {\n  color: var(--watch-cyan);\n  font-family: \"Oxanium\", sans-serif;\n  text-shadow: 0 0 15px rgba(39, 223, 255, 0.45);\n}\n/* BUTTONS */\n.watch-primary-button,\n.watch-secondary-button,\n.watch-speed-button {\n  border-radius: 7px;\n  font-family: \"Oxanium\", sans-serif;\n  font-weight: 700;\n  letter-spacing: 0.04em;\n  transition: 0.2s ease;\n}\n.watch-primary-button {\n  border: 1px solid rgba(39, 223, 255, 0.65);\n  color: #03101d;\n  background: linear-gradient(110deg, #087bdf, #27dfff);\n  box-shadow: 0 0 18px rgba(22, 140, 255, 0.2);\n}\n.watch-primary-button:not(:disabled):hover {\n  filter: brightness(1.15);\n  box-shadow: 0 0 24px rgba(39, 223, 255, 0.35);\n}\n.watch-primary-button:disabled {\n  opacity: 0.35;\n  filter: grayscale(0.5);\n}\n.watch-secondary-button,\n.watch-speed-button {\n  border: 1px solid rgba(39, 160, 255, 0.3);\n  color: #c8e7ff;\n  background: rgba(13, 39, 68, 0.9);\n}\n.watch-secondary-button:hover,\n.watch-speed-button:hover {\n  border-color: var(--watch-cyan);\n  color: white;\n  background: rgba(22, 140, 255, 0.2);\n}\n.watch-speed-button.active {\n  border-color: var(--watch-cyan);\n  color: var(--watch-cyan);\n  background: rgba(39, 223, 255, 0.12);\n  box-shadow: inset 0 0 12px rgba(39, 223, 255, 0.08);\n}\n.watch-error {\n  color: #ff6683;\n  font-weight: 700;\n}\n/* BATTLE ARENA */\n.watch-arena {\n  min-height: 420px;\n  border-color: rgba(39, 160, 255, 0.42);\n\n  background:\n    radial-gradient(\n      ellipse at 50% 100%,\n      rgba(0, 115, 220, 0.28),\n      transparent 55%\n    ),\n    radial-gradient(\n      ellipse at 50% 0%,\n      rgba(39, 223, 255, 0.08),\n      transparent 60%\n    ),\n    linear-gradient(180deg, #0b2039, #050d1b 78%);\n}\n.watch-arena::before {\n  border-top-color: rgba(39, 160, 255, 0.25);\n  background: repeating-linear-gradient(\n    100deg,\n    transparent 0 55px,\n    rgba(39, 160, 255, 0.045) 56px 58px\n  );\n}\n.watch-round {\n  border: 1px solid rgba(39, 223, 255, 0.45);\n  color: var(--watch-cyan);\n  background: rgba(3, 15, 29, 0.92);\n  font-family: \"Oxanium\", sans-serif;\n  box-shadow: 0 0 15px rgba(39, 223, 255, 0.12);\n}\n/* FIGHTERS */\n.watch-fighter h2 {\n  color: #f1f9ff;\n  font-family: \"Oxanium\", sans-serif;\n  font-weight: 800;\n  letter-spacing: 0.04em;\n  text-shadow: 0 2px 12px rgba(0, 0, 0, 0.7);\n}\n.watch-fighter-stats {\n  color: #9bbbd6;\n  font-family: \"Rajdhani\", sans-serif;\n  font-size: 0.85rem;\n  font-weight: 700;\n}\n/* HEALTH / RESOURCE METERS */\n.watch-meter-label {\n  color: #b7d3e9;\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 0.7rem;\n  letter-spacing: 0.04em;\n}\n.watch-meter-track {\n  border: 1px solid rgba(255, 255, 255, 0.12);\n  background: #020812;\n  box-shadow: inset 0 2px 5px #0009;\n}\n.watch-meter-fill {\n  box-shadow:\n    0 0 8px currentColor,\n    0 0 15px currentColor;\n}\n/* CENTER BATTLE DISPLAY */\n.watch-vs-large {\n  color: var(--watch-cyan);\n  font-family: \"Oxanium\", sans-serif;\n  text-shadow:\n    0 0 12px rgba(39, 223, 255, 0.65),\n    0 0 30px rgba(22, 140, 255, 0.35);\n}\n.watch-action-banner {\n  border: 1px solid rgba(39, 160, 255, 0.4);\n  color: #e8f7ff;\n  background: rgba(3, 15, 29, 0.95);\n  font-family: \"Oxanium\", sans-serif;\n  letter-spacing: 0.03em;\n  box-shadow: 0 5px 18px rgba(0, 0, 0, 0.25);\n}\n.watch-action-defend {\n  border-color: #f6d84a;\n  box-shadow: 0 0 12px rgba(246, 216, 74, 0.12);\n}\n.watch-action-evade {\n  border-color: var(--watch-cyan);\n  box-shadow: 0 0 12px rgba(39, 223, 255, 0.12);\n}\n.watch-action-take\\ damage {\n  border-color: #ff3159;\n  box-shadow: 0 0 12px rgba(255, 49, 89, 0.12);\n}\n.watch-action-result {\n  color: #f6d84a;\n  font-family: \"Oxanium\", sans-serif;\n}\n/* PLAYBACK CONTROLS */\n.watch-playback {\n  border-color: rgba(39, 160, 255, 0.3);\n}\n.watch-speed-controls > span {\n  color: #9fc5e4;\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 0.78rem;\n  font-weight: 700;\n  letter-spacing: 0.05em;\n  text-transform: uppercase;\n}\n/* COMBAT LOG */\n.watch-log-list {\n  scrollbar-color: #168cff #07172b;\n  scrollbar-width: thin;\n}\n.watch-log-entry {\n  border: 1px solid rgba(39, 160, 255, 0.12);\n  color: #c8dced;\n  background: rgba(7, 24, 44, 0.88);\n  font-family: \"Rajdhani\", sans-serif;\n  font-size: 0.95rem;\n  transition: border-color 0.2s ease;\n}\n.watch-log-entry:hover {\n  border-color: rgba(39, 223, 255, 0.3);\n}\n.watch-log-entry strong {\n  color: #f1faff;\n  font-family: \"Oxanium\", sans-serif;\n}\n.watch-log-round {\n  color: var(--watch-cyan);\n  font-family: \"Oxanium\", sans-serif;\n}\n/* KEEP THE EXISTING 125 x 190 PORTRAIT DIMENSIONS */\n.watch-fighter-image {\n  width: 125px;\n  height: 190px;\n  flex: 0 0 125px;\n  overflow: hidden;\n  isolation: isolate;\n}\n.watch-fighter-image img {\n  width: 125px;\n  height: 190px;\n  max-width: 100%;\n  object-fit: cover;\n}\n/* Preserve the existing stun lighting and shake animations. */\n/* RESPONSIVE */\n@media (max-width: 700px) {\n  .watch-header h1 {\n    letter-spacing: 0.07em;\n  }\n\n  .watch-setup,\n  .watch-arena,\n  .watch-playback,\n  .watch-combat-log {\n    border-radius: 10px;\n  }\n\n  .watch-arena-fighters {\n    gap: 8px;\n  }\n\n  .watch-fighter-image {\n    width: 125px;\n    height: 190px;\n  }\n\n  .watch-fighter-image img {\n    width: 125px;\n    height: 190px;\n  }\n}\n@media (prefers-reduced-motion: reduce) {\n  .watch-page *,\n  .watch-page *::before,\n  .watch-page *::after {\n    scroll-behavior: auto;\n  }\n}\n"],["STYLE",{},"/* Tournament bot matches use the same battle shell and fighter HUD as Battle.jsx. */\n.wc-cpu-watch,\n.wc-cpu-watch * {\n  box-sizing: border-box;\n}\n\n.wc-cpu-watch {\n  position: fixed;\n  z-index: 1000;\n  inset: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 7px;\n  overflow: hidden;\n  padding: 10px clamp(10px, 2vw, 24px);\n  color: #f1f5ff;\n  background:\n    radial-gradient(ellipse at 50% 18%, rgba(27, 71, 54, .55), transparent 58%),\n    linear-gradient(180deg, #07120f 0%, #08130f 55%, #050a10 100%);\n  font-family: Rajdhani, Arial, sans-serif;\n}\n\n.wc-cpu-tournament-header {\n  flex: 0 0 48px;\n  display: grid;\n  grid-template-columns: auto minmax(180px, 1fr) auto minmax(0, auto);\n  align-items: center;\n  gap: clamp(8px, 1.6vw, 20px);\n  min-width: 0;\n  padding: 0 2px 7px;\n  border-bottom: 1px solid #a5ff193b;\n}\n\n.wc-cpu-brand {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n  min-width: 0;\n}\n\n.wc-cpu-brand span {\n  color: #f4f2d9;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: .82rem;\n  font-weight: 1000;\n  letter-spacing: .16em;\n  white-space: nowrap;\n  text-shadow: 0 0 12px #a5ff1930;\n}\n\n.wc-cpu-brand strong {\n  color: #a5ff19;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: .52rem;\n  font-weight: 900;\n  letter-spacing: .16em;\n}\n\n.wc-cpu-player-persistent {\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  min-width: 0;\n  max-width: 330px;\n  padding: 4px 9px;\n  border: 1px solid rgba(32, 217, 255, .38);\n  border-radius: 7px;\n  background: linear-gradient(100deg, rgba(7, 54, 62, .46), rgba(16, 17, 15, .95));\n  box-shadow: inset 3px 0 #20d9ff, 0 0 16px rgba(19, 213, 255, .06);\n}\n\n.wc-cpu-player-persistent img {\n  flex: 0 0 auto;\n  width: 29px;\n  height: 34px;\n  object-fit: cover;\n  object-position: center top;\n  border-radius: 3px;\n  background: #151d1d;\n}\n\n.wc-cpu-player-persistent div {\n  display: flex;\n  flex: 1;\n  min-width: 0;\n  flex-direction: column;\n  gap: 2px;\n}\n\n.wc-cpu-player-persistent small {\n  color: #71d7e8;\n  font-size: .46rem;\n  font-weight: 950;\n  letter-spacing: .12em;\n}\n\n.wc-cpu-player-persistent strong {\n  overflow: hidden;\n  color: #f0eee4;\n  font-size: .75rem;\n  font-weight: 900;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.wc-cpu-player-persistent > span {\n  color: #a9bdaf;\n  font-size: .45rem;\n  font-weight: 900;\n  letter-spacing: .06em;\n  text-align: right;\n}\n\n.wc-cpu-match-meta {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n  text-align: center;\n}\n\n.wc-cpu-match-meta small {\n  color: #a5ff19;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: .52rem;\n  font-weight: 900;\n  letter-spacing: .13em;\n  text-transform: uppercase;\n}\n\n.wc-cpu-match-meta strong {\n  color: #f4f2d9;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: .78rem;\n  font-weight: 1000;\n  letter-spacing: .12em;\n}\n\n.wc-cpu-header-actions {\n  display: flex;\n  align-items: center;\n  justify-content: flex-end;\n  gap: 5px;\n  min-width: 0;\n}\n\n.wc-cpu-tool-button,\n.wc-cpu-exit-button,\n.wc-cpu-speed button {\n  min-height: 31px;\n  padding: 5px 9px;\n  border: 1px solid #536b7a;\n  border-radius: 6px;\n  color: #e8f4ff;\n  background: linear-gradient(145deg, #1a2c3c, #101a27);\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: .52rem;\n  font-weight: 950;\n  letter-spacing: .07em;\n  cursor: pointer;\n  transition: transform .15s ease, filter .15s ease, border-color .15s ease;\n}\n\n.wc-cpu-tool-button:hover:not(:disabled),\n.wc-cpu-exit-button:hover,\n.wc-cpu-speed button:hover {\n  filter: brightness(1.18);\n  transform: translateY(-1px);\n  border-color: #20d9ff;\n}\n\n.wc-cpu-tool-button:disabled {\n  opacity: .45;\n  cursor: not-allowed;\n}\n\n.wc-cpu-tool-button:first-child {\n  border-color: #a5ff1970;\n  color: #eaffbc;\n}\n\n.wc-cpu-exit-button {\n  border-color: #695b3b;\n  color: #e9d8ac;\n  background: #201d16;\n}\n\n.wc-cpu-speed {\n  display: flex;\n  align-items: center;\n  gap: 3px;\n}\n\n.wc-cpu-speed button {\n  min-width: 31px;\n  min-height: 29px;\n  padding-inline: 5px;\n  color: #a9bdcf;\n  background: #101b28;\n}\n\n.wc-cpu-speed button.active {\n  border-color: #a5ff19;\n  color: #12190d;\n  background: linear-gradient(145deg, #d7ff7b, #82ca20);\n  box-shadow: 0 0 12px #a5ff1935;\n}\n\n/* Use the exact Battle.jsx grid/areas, with the tournament controls kept above it. */\n.wc-cpu-game-container {\n  flex: 1 1 auto;\n  min-height: 0;\n  height: auto !important;\n  padding: 0 !important;\n  overflow: hidden;\n  background: transparent !important;\n}\n\n.wc-cpu-watch #battleLayout.wc-cpu-battle-layout {\n  height: 100%;\n  min-height: 0;\n  grid-template-columns: minmax(190px, .27fr) minmax(0, .73fr);\n  grid-template-rows: 35px minmax(190px, 1fr) minmax(132px, 22vh);\n  grid-template-areas:\n    \"header header\"\n    \"arena arena\"\n    \"log attacks\";\n  gap: 8px;\n  max-width: 1780px;\n}\n\n.wc-cpu-battle-header {\n  min-width: 0;\n}\n\n.wc-cpu-battle-header .solo-team-label {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 1px;\n  min-width: 0;\n  min-height: 32px;\n  padding: 3px 8px;\n  overflow: hidden;\n}\n\n.wc-cpu-battle-header .solo-team-label small {\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: 7px;\n  font-weight: 900;\n  letter-spacing: .13em;\n  opacity: .78;\n}\n\n.wc-cpu-battle-header .wc-cpu-side-name {\n  display: block;\n  max-width: 100%;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.wc-cpu-battle-header h1 {\n  font-size: clamp(14px, 1.4vw, 21px);\n}\n\n.wc-cpu-watch #battleLayout > #battleArena.wc-cpu-battle-arena {\n  min-height: 0;\n  height: 100%;\n  padding: 10px clamp(16px, 5vw, 90px) 8px;\n  overflow: hidden;\n  border-color: #287a5b;\n  background:\n    radial-gradient(ellipse at 50% 75%, rgba(39, 103, 67, .3), transparent 58%),\n    linear-gradient(145deg, #102117, #0c1a12 70%, #0c1912);\n  box-shadow: inset 0 0 28px #0007, 0 0 18px #12d98c12;\n}\n\n.wc-cpu-arena-grid {\n  position: absolute;\n  z-index: -1;\n  inset: 0;\n  opacity: .25;\n  pointer-events: none;\n  background:\n    radial-gradient(ellipse at 50% 100%, #a5ff1920, transparent 46%),\n    repeating-linear-gradient(0deg, transparent 0 44px, #d8e9ff0a 45px 46px);\n}\n\n.wc-cpu-watch #battleLayout > #battleArena > #opponentSection,\n.wc-cpu-watch #battleLayout > #battleArena > #characterSection {\n  max-width: 460px;\n  gap: clamp(6px, 1vh, 12px);\n}\n\n.wc-cpu-watch #battleLayout #opponent {\n  --fighter-accent: #ff526b;\n}\n\n.wc-cpu-watch #battleLayout #character {\n  --fighter-accent: #20d9ff;\n}\n\n.wc-cpu-watch #battleLayout .solo-fighter-art {\n  cursor: default;\n}\n\n.wc-cpu-watch #battleLayout .solo-fighter-art img {\n  pointer-events: none;\n}\n\n.wc-cpu-watch #battleLayout .wc-cpu-is-attacking .solo-fighter-art img {\n  animation: wcCpuBattleLunge .34s cubic-bezier(.2, .8, .2, 1);\n}\n\n.wc-cpu-watch #battleLayout #opponentSection.wc-cpu-is-attacking .solo-fighter-art img {\n  --wc-cpu-lunge: 15px;\n}\n\n.wc-cpu-watch #battleLayout #characterSection.wc-cpu-is-attacking .solo-fighter-art img {\n  --wc-cpu-lunge: -15px;\n}\n\n.wc-cpu-watch #battleLayout .wc-cpu-is-knocked-out .solo-fighter-art img {\n  filter: grayscale(1) brightness(.65) drop-shadow(0 0 8px #ff526b55);\n  opacity: .55;\n}\n\n.wc-cpu-live-action {\n  position: absolute;\n  z-index: 12;\n  top: 10px;\n  left: 50%;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 2px;\n  width: min(330px, 36%);\n  min-height: 44px;\n  padding: 6px 10px;\n  transform: translateX(-50%);\n  border: 1px solid #a5ff1945;\n  border-radius: 7px;\n  color: #edf5e9;\n  background: linear-gradient(145deg, rgba(15, 32, 24, .94), rgba(8, 14, 18, .94));\n  box-shadow: 0 5px 16px #0008, 0 0 14px #a5ff1910;\n  text-align: center;\n  pointer-events: none;\n}\n\n.wc-cpu-live-action > span {\n  color: #a5ff19;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: 7px;\n  font-weight: 950;\n  letter-spacing: .18em;\n}\n\n.wc-cpu-live-action strong {\n  max-width: 100%;\n  overflow: hidden;\n  color: #f7f5e7;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: clamp(8px, .9vw, 11px);\n  font-weight: 900;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.wc-cpu-live-action small {\n  color: #ffacb8;\n  font-size: 8px;\n  font-weight: 900;\n  letter-spacing: .08em;\n}\n\n.wc-cpu-fighter-loading {\n  display: grid;\n  place-items: center;\n  color: #a5ff19;\n  font-family: Oxanium, Arial, sans-serif;\n}\n\n/* The bottom half matches Battle.jsx: combat history at left, attack cards at right. */\n.wc-cpu-watch #battleLayout > #combatLog.wc-cpu-combat-log {\n  grid-area: log;\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n  min-height: 0;\n  width: 100%;\n  margin: 0;\n  overflow: hidden;\n  border: 1px solid #344b3d;\n  border-radius: 10px;\n  background: linear-gradient(145deg, #14251b, #0a1510);\n  box-shadow: 0 5px 18px #0006;\n}\n\n.wc-cpu-watch #battleLayout #combatLogHeader {\n  flex: 0 0 auto;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 6px;\n  padding: 7px 9px;\n  border-bottom: 1px solid #a5ff1945;\n}\n\n.wc-cpu-watch #battleLayout #combatLogHeader h4 {\n  margin: 0;\n  color: #eaf2db;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: 9px;\n  font-weight: 900;\n  letter-spacing: .08em;\n}\n\n.wc-cpu-watch #battleLayout #combatLogHeader span {\n  color: #a5ff19;\n  font-size: 8px;\n  font-weight: 900;\n}\n\n.wc-cpu-watch #battleLayout #combatLogEntries {\n  flex: 1 1 auto;\n  min-height: 0;\n  padding: 4px 9px;\n  overflow-y: auto;\n  scrollbar-color: #50694d #101a13;\n  scrollbar-width: thin;\n}\n\n.wc-cpu-watch #battleLayout .combat-log-entry {\n  gap: 2px;\n  padding: 4px 1px;\n}\n\n.wc-cpu-watch #battleLayout .combat-log-time {\n  color: #a5ff19;\n  font-size: 7px;\n}\n\n.wc-cpu-watch #battleLayout .combat-log-text {\n  color: #d2dfd4;\n  font-size: 8px;\n  line-height: 1.2;\n}\n\n.wc-cpu-watch #battleLayout .combat-log-text strong {\n  color: #f3f6e8;\n}\n\n.wc-cpu-watch #battleLayout .combat-log-entry.hit .combat-log-text {\n  color: #ff9aa8;\n}\n\n.wc-cpu-watch #battleLayout #battleAttackPanel.wc-cpu-attack-panel {\n  grid-area: attacks;\n  min-width: 0;\n  min-height: 0;\n  margin: 0;\n  overflow: hidden;\n  border: 1px solid #647d3b80;\n  border-radius: 10px;\n  background: linear-gradient(145deg, #17271b, #0d1710);\n}\n\n.wc-cpu-watch #battleLayout #battleAttackPanel #attackHeader {\n  padding: 6px 10px;\n  border-bottom-color: #a5ff19;\n  font-size: 9px;\n}\n\n.wc-cpu-watch #battleLayout #battleAttackPanel #attackBody {\n  padding: 5px 7px 2px;\n}\n\n.wc-cpu-watch #battleLayout #battleAttackPanel #attackList {\n  gap: 7px;\n  padding: 2px 2px 5px;\n}\n\n.wc-cpu-watch #battleLayout #battleAttackPanel .attack-card-wrapper {\n  flex-basis: 118px;\n  width: 118px;\n  min-width: 118px;\n}\n\n.wc-cpu-watch #battleLayout #battleAttackPanel .attack-card {\n  gap: 3px;\n  padding: 5px !important;\n  cursor: default;\n}\n\n.wc-cpu-watch #battleLayout #battleAttackPanel .attack-image,\n.wc-cpu-watch #battleLayout #battleAttackPanel .wc-cpu-attack-image-placeholder {\n  width: 100%;\n  height: clamp(36px, 6vh, 55px);\n  min-height: 36px;\n  max-height: 55px;\n  border: 1px solid #536b91;\n  border-radius: 5px;\n  object-fit: cover;\n}\n\n.wc-cpu-attack-image-placeholder {\n  display: grid;\n  place-items: center;\n  color: #a5ff19;\n  background: linear-gradient(145deg, #263a27, #101a14);\n  font-size: 19px;\n}\n\n.wc-cpu-watch #battleLayout #battleAttackPanel .attack-card h5 {\n  min-height: 22px;\n  max-height: 22px;\n  margin: 0;\n  font-size: 8px;\n  line-height: 1.15;\n}\n\n.wc-cpu-watch #battleLayout #battleAttackPanel .attack-stats {\n  gap: 2px;\n}\n\n.wc-cpu-watch #battleLayout #battleAttackPanel .attack-stats span,\n.wc-cpu-watch #battleLayout #battleAttackPanel .attack-cost span {\n  font-size: 7px;\n}\n\n.wc-cpu-watch #battleLayout #battleAttackPanel .attack-damage,\n.wc-cpu-watch #battleLayout #battleAttackPanel .attack-speed {\n  padding: 3px 2px;\n}\n\n.wc-cpu-panel-footer {\n  display: flex;\n  justify-content: space-between;\n  gap: 8px;\n  padding: 4px 9px 6px;\n  color: #a5ff19;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: 7px;\n  font-weight: 900;\n  letter-spacing: .1em;\n}\n\n.wc-cpu-empty-moves {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 4px;\n  width: 100%;\n  min-width: 180px;\n  color: #eaf2db;\n  text-align: center;\n}\n\n.wc-cpu-empty-moves strong {\n  color: #a5ff19;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: 10px;\n}\n\n.wc-cpu-empty-moves span {\n  color: #a8b9ae;\n  font-size: 9px;\n}\n\n/* K.O. choices are presented in the center like a true match-end popup. */\n.wc-cpu-ko-backdrop {\n  position: fixed;\n  z-index: 11000;\n  inset: 0;\n  display: grid;\n  place-items: center;\n  overflow-y: auto;\n  padding: 18px;\n  background: rgba(2, 7, 12, .78);\n  backdrop-filter: blur(7px);\n  animation: wcCpuKoFadeIn .28s ease-out both;\n}\n\n.wc-cpu-ko-dialog {\n  position: relative;\n  width: min(670px, 100%);\n  max-height: min(92vh, 760px);\n  overflow-y: auto;\n  padding: clamp(18px, 3vw, 30px);\n  border: 1px solid #a5ff19a8;\n  border-radius: 15px 5px;\n  color: #f5f8ff;\n  background:\n    radial-gradient(ellipse at 50% 0%, #37602755, transparent 58%),\n    linear-gradient(145deg, #1a2b20, #0a111a 72%);\n  box-shadow: 0 22px 80px #000e, 0 0 0 4px #a5ff1917, 0 0 30px #a5ff1930;\n  text-align: center;\n  animation: wcCpuKoImpact .42s cubic-bezier(.16, 1, .3, 1) both;\n}\n\n.wc-cpu-ko-eyebrow {\n  margin: 0 0 7px;\n  color: #a5ff19;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: .65rem;\n  font-weight: 950;\n  letter-spacing: .2em;\n}\n\n.wc-cpu-ko-dialog > h2 {\n  margin: 0;\n  color: #fff;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: clamp(2.5rem, 8vw, 4.8rem);\n  font-weight: 1000;\n  font-style: italic;\n  line-height: .98;\n  text-shadow: 0 0 18px #ff315988, 3px 3px 0 #541624;\n}\n\n.wc-cpu-ko-subtitle {\n  margin: 9px 0 18px;\n  color: #d4e2d5;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: .76rem;\n  font-weight: 900;\n  letter-spacing: .09em;\n}\n\n.wc-cpu-ko-matchup {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);\n  align-items: center;\n  gap: 12px;\n  max-width: 470px;\n  margin: 0 auto 18px;\n}\n\n.wc-cpu-ko-fighter {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 5px;\n  min-width: 0;\n  padding: 9px;\n  border: 1px solid #ffffff22;\n  border-radius: 9px;\n  background: #07110caa;\n}\n\n.wc-cpu-ko-fighter > span {\n  color: #b7c5bc;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: 8px;\n  font-weight: 950;\n  letter-spacing: .13em;\n}\n\n.wc-cpu-ko-fighter img {\n  width: auto;\n  height: clamp(92px, 18vh, 145px);\n  max-width: 100%;\n  object-fit: contain;\n}\n\n.wc-cpu-ko-fighter strong {\n  max-width: 100%;\n  overflow: hidden;\n  color: #f4f7ed;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: .76rem;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.wc-cpu-ko-fighter small {\n  color: #a5ff19;\n  font-size: .58rem;\n  font-weight: 900;\n}\n\n.wc-cpu-ko-fighter.is-winner {\n  border-color: #a5ff1970;\n  box-shadow: inset 0 0 15px #a5ff1912, 0 0 14px #a5ff1910;\n}\n\n.wc-cpu-ko-fighter.is-defeated {\n  border-color: #ff526b60;\n  filter: saturate(.6);\n}\n\n.wc-cpu-ko-fighter.is-defeated img {\n  filter: grayscale(.65);\n  opacity: .76;\n}\n\n.wc-cpu-ko-fighter.is-defeated small {\n  color: #ff9aa8;\n}\n\n.wc-cpu-ko-vs {\n  color: #f3d85a;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: 1.1rem;\n  font-weight: 1000;\n}\n\n.wc-cpu-ko-options {\n  padding-top: 14px;\n  border-top: 1px solid #ffffff1c;\n}\n\n.wc-cpu-ko-options > p {\n  margin: 0 0 10px;\n  color: #b3c2b2;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: .62rem;\n  font-weight: 900;\n  letter-spacing: .15em;\n}\n\n.wc-cpu-ko-options button {\n  min-height: 40px;\n  border: 1px solid #627d4d;\n  border-radius: 6px;\n  padding: 8px 12px;\n  color: #e8f1e8;\n  background: linear-gradient(145deg, #1b3325, #0f1b17);\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: .62rem;\n  font-weight: 950;\n  letter-spacing: .08em;\n  cursor: pointer;\n  transition: transform .15s ease, filter .15s ease;\n}\n\n.wc-cpu-ko-options button:hover {\n  filter: brightness(1.2);\n  transform: translateY(-1px);\n}\n\n.wc-cpu-ko-options .wc-cpu-ko-continue {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 12px;\n  width: min(100%, 350px);\n  min-height: 48px;\n  margin: 0 auto;\n  border-color: #e5f7a1;\n  color: #14200c;\n  background: linear-gradient(110deg, #e8ff9d, #9dde39);\n  box-shadow: 0 0 16px #a5ff193b;\n  font-size: .76rem;\n}\n\n.wc-cpu-ko-continue span {\n  font-size: 1rem;\n}\n\n.wc-cpu-ko-secondary {\n  display: flex;\n  justify-content: center;\n  flex-wrap: wrap;\n  gap: 8px;\n  margin-top: 9px;\n}\n\n.wc-cpu-ko-secondary button {\n  min-height: 34px;\n  font-size: .53rem;\n}\n\n@keyframes wcCpuBattleLunge {\n  0%, 100% { transform: translateX(0) scale(1); }\n  42% { transform: translateX(var(--wc-cpu-lunge, 12px)) scale(1.035); }\n}\n\n@keyframes wcCpuKoFadeIn {\n  from { opacity: 0; }\n  to { opacity: 1; }\n}\n\n@keyframes wcCpuKoImpact {\n  0% { opacity: 0; transform: translateY(20px) scale(.92); }\n  70% { opacity: 1; transform: translateY(-2px) scale(1.01); }\n  100% { opacity: 1; transform: translateY(0) scale(1); }\n}\n\n@media (max-width: 1120px) and (min-width: 701px) {\n  .wc-cpu-tournament-header {\n    grid-template-columns: auto minmax(130px, 1fr) auto;\n  }\n\n  .wc-cpu-match-meta {\n    display: none;\n  }\n\n  .wc-cpu-header-actions {\n    grid-column: 3;\n  }\n\n  .wc-cpu-watch #battleLayout.wc-cpu-battle-layout {\n    grid-template-rows: 34px minmax(180px, 1fr) minmax(125px, 21vh);\n  }\n\n  .wc-cpu-watch #battleLayout > #battleArena.wc-cpu-battle-arena {\n    padding-inline: clamp(8px, 2vw, 24px);\n    gap: 10px;\n  }\n\n  .wc-cpu-live-action {\n    width: min(250px, 32%);\n  }\n}\n\n@media (max-width: 700px) {\n  .wc-cpu-watch {\n    min-height: 100%;\n    overflow-y: auto;\n    padding: 8px;\n  }\n\n  .wc-cpu-tournament-header {\n    flex: 0 0 auto;\n    grid-template-columns: minmax(0, 1fr) auto;\n    gap: 7px;\n  }\n\n  .wc-cpu-brand {\n    grid-column: 1;\n    grid-row: 1;\n  }\n\n  .wc-cpu-player-persistent {\n    grid-column: 1;\n    grid-row: 2;\n    max-width: none;\n  }\n\n  .wc-cpu-match-meta {\n    display: none;\n  }\n\n  .wc-cpu-header-actions {\n    grid-column: 2;\n    grid-row: 1 / span 2;\n    flex-wrap: wrap;\n    justify-content: flex-end;\n    max-width: 210px;\n  }\n\n  .wc-cpu-tool-button,\n  .wc-cpu-exit-button {\n    min-height: 27px;\n    padding: 4px 6px;\n    font-size: 7px;\n  }\n\n  .wc-cpu-speed button {\n    min-width: 25px;\n    min-height: 25px;\n    font-size: 7px;\n  }\n\n  .wc-cpu-game-container {\n    flex: 1 0 auto;\n    min-height: 640px;\n    overflow: visible;\n  }\n\n  .wc-cpu-watch #battleLayout.wc-cpu-battle-layout {\n    height: auto;\n    min-height: 640px;\n    grid-template-columns: minmax(0, 1fr);\n    grid-template-rows: 34px minmax(340px, 46vh) 125px 175px;\n    grid-template-areas:\n      \"header\"\n      \"arena\"\n      \"log\"\n      \"attacks\";\n    gap: 7px;\n  }\n\n  .wc-cpu-battle-header {\n    gap: 4px;\n  }\n\n  .wc-cpu-battle-header h1 {\n    font-size: 11px;\n    letter-spacing: .5px;\n  }\n\n  .wc-cpu-battle-header h1 span {\n    display: block;\n    margin: 1px 0 0;\n    font-size: 7px;\n  }\n\n  .wc-cpu-battle-header .solo-team-label {\n    padding-inline: 4px;\n  }\n\n  .wc-cpu-battle-header .wc-cpu-side-name {\n    font-size: 8px;\n  }\n\n  .wc-cpu-battle-header .solo-team-label small {\n    font-size: 6px;\n  }\n\n  .wc-cpu-watch #battleLayout > #battleArena.wc-cpu-battle-arena {\n    gap: 8px;\n    padding: 8px 6px;\n  }\n\n  .wc-cpu-watch #battleLayout > #battleArena > #opponentSection,\n  .wc-cpu-watch #battleLayout > #battleArena > #characterSection {\n    gap: 6px;\n  }\n\n  .wc-cpu-watch #battleLayout .solo-fighter-hud {\n    gap: 4px;\n    padding: 6px;\n  }\n\n  .wc-cpu-watch #battleLayout .solo-fighter-name-row h2 {\n    font-size: 10px;\n  }\n\n  .wc-cpu-watch #battleLayout .solo-resource-row {\n    grid-template-columns: 17px minmax(0, 1fr) auto;\n    gap: 4px;\n  }\n\n  .wc-cpu-watch #battleLayout .solo-resource-row b {\n    min-width: 38px;\n    font-size: 7px;\n  }\n\n  .wc-cpu-watch #battleLayout .solo-segment-group {\n    grid-template-columns: 1fr;\n    gap: 3px;\n  }\n\n  .wc-cpu-watch #battleLayout .solo-fighter-art {\n    min-height: 100px;\n  }\n\n  .wc-cpu-watch #battleLayout .solo-fighter-art img {\n    max-width: 100%;\n  }\n\n  .wc-cpu-live-action {\n    top: 5px;\n    width: min(170px, 34%);\n    min-height: 38px;\n    padding: 4px;\n  }\n\n  .wc-cpu-live-action > span {\n    font-size: 6px;\n  }\n\n  .wc-cpu-live-action strong {\n    font-size: 7px;\n  }\n\n  .wc-cpu-live-action small {\n    font-size: 6px;\n  }\n\n  .wc-cpu-watch #battleLayout #combatLogHeader {\n    padding: 5px 7px;\n  }\n\n  .wc-cpu-watch #battleLayout #combatLogEntries {\n    padding: 3px 7px;\n  }\n\n  .wc-cpu-watch #battleLayout #battleAttackPanel .attack-card-wrapper {\n    flex-basis: 105px;\n    width: 105px;\n    min-width: 105px;\n  }\n\n  .wc-cpu-ko-backdrop {\n    align-items: center;\n    padding: 10px;\n  }\n\n  .wc-cpu-ko-dialog {\n    padding: 16px 12px;\n  }\n\n  .wc-cpu-ko-subtitle {\n    font-size: .62rem;\n  }\n\n  .wc-cpu-ko-matchup {\n    gap: 6px;\n  }\n\n  .wc-cpu-ko-fighter {\n    padding: 6px 4px;\n  }\n\n  .wc-cpu-ko-fighter img {\n    height: 100px;\n  }\n\n  .wc-cpu-ko-fighter strong {\n    font-size: .62rem;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .wc-cpu-watch *,\n  .wc-cpu-watch *::before,\n  .wc-cpu-watch *::after {\n    animation-duration: .01ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: .01ms !important;\n  }\n}\n\n/* Keep the simulation round obvious even when the tournament phase is shown above it. */\n.wc-cpu-battle-header h1 {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 2px;\n  line-height: 1.02;\n}\n\n.wc-cpu-battle-header h1 .wc-cpu-battle-round-counter {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  min-height: 16px;\n  margin-top: 2px;\n  padding: 3px 9px;\n  border: 1px solid rgba(165, 255, 25, .48);\n  border-radius: 3px;\n  color: #d9ff91;\n  background: linear-gradient(90deg, rgba(56, 91, 20, .38), rgba(13, 25, 12, .88));\n  box-shadow: 0 0 13px rgba(165, 255, 25, .12), inset 0 1px rgba(255, 255, 255, .08);\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: clamp(7px, .65vw, 9px);\n  font-weight: 1000;\n  letter-spacing: .17em;\n  line-height: 1;\n  white-space: nowrap;\n  font-variant-numeric: tabular-nums;\n  animation: wcCpuRoundCounterUpdate .3s ease both;\n}\n\n@keyframes wcCpuRoundCounterUpdate {\n  from { opacity: .45; transform: translateY(-3px) scale(.96); }\n  to { opacity: 1; transform: translateY(0) scale(1); }\n}\n\n@media (max-width: 700px) {\n  .wc-cpu-battle-header h1 {\n    gap: 1px;\n    font-size: 10px;\n  }\n\n  .wc-cpu-battle-header h1 .wc-cpu-battle-round-counter {\n    min-height: 13px;\n    margin-top: 1px;\n    padding: 2px 5px;\n    font-size: 6px;\n    letter-spacing: .1em;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .wc-cpu-battle-header h1 .wc-cpu-battle-round-counter {\n    animation: none !important;\n  }\n}\n\n\n/* Watch Mode intentionally keeps only the current-match skip control. */\n.wc-cpu-skip-only {\n  justify-content: flex-end;\n}\n.wc-cpu-skip-button {\n  min-width: 112px;\n  min-height: 34px;\n  border-color: #d9f48b;\n  color: #18210d;\n  background: linear-gradient(135deg, #e7ff9c, #91ce35);\n  box-shadow: 0 0 15px rgba(165, 255, 25, .2);\n  font-weight: 950;\n  letter-spacing: .1em;\n}\n.wc-cpu-skip-button span {\n  margin-left: 6px;\n  font-size: .8rem;\n}\n"],["STYLE",{},"/* WILD CARDS — TOURNAMENT EXPERIENCE */\n.wc-tournament,\n.wc-tournament * {\n  box-sizing: border-box;\n}\n\n.wc-tournament {\n  --wc-gold: #e9c66f;\n  --wc-gold-bright: #ffe6a0;\n  --wc-gold-deep: #8e672c;\n  --wc-cream: #f5ecd6;\n  --wc-muted: #aaa18e;\n  --wc-panel: rgba(18, 17, 15, .94);\n  position: relative;\n  isolation: isolate;\n  width: 100%;\n  height: 100dvh;\n  min-height: 620px;\n  padding: 16px clamp(16px, 3vw, 42px) 18px;\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n  overflow: hidden;\n  color: var(--wc-cream);\n  background:\n    radial-gradient(ellipse at 50% -18%, rgba(202, 151, 60, .34), transparent 48%),\n    radial-gradient(ellipse at 12% 48%, rgba(100, 72, 29, .12), transparent 35%),\n    radial-gradient(ellipse at 88% 62%, rgba(100, 72, 29, .10), transparent 35%),\n    linear-gradient(145deg, #171512 0%, #090909 54%, #15110b 100%);\n  font-family: inherit;\n}\n\n.wc-tournament::before,\n.wc-tournament::after {\n  position: absolute;\n  z-index: -1;\n  content: \"\";\n  pointer-events: none;\n}\n\n.wc-tournament::before {\n  inset: 0;\n  opacity: .22;\n  background-image:\n    linear-gradient(rgba(238, 201, 121, .045) 1px, transparent 1px),\n    linear-gradient(90deg, rgba(238, 201, 121, .045) 1px, transparent 1px);\n  background-size: 42px 42px;\n  mask-image: linear-gradient(to bottom, black, transparent 76%);\n}\n\n.wc-tournament::after {\n  top: -25%;\n  left: 50%;\n  width: min(70vw, 900px);\n  height: 55%;\n  transform: translateX(-50%);\n  background: radial-gradient(ellipse, rgba(255, 220, 139, .12), transparent 68%);\n  filter: blur(14px);\n}\n\n.wc-tournament button {\n  font: inherit;\n}\n\n.wc-tourney-header {\n  position: relative;\n  z-index: 1;\n  flex: 0 0 42px;\n  display: grid;\n  grid-template-columns: 1fr auto 1fr;\n  align-items: center;\n  gap: 14px;\n  min-width: 0;\n  border-bottom: 1px solid rgba(226, 190, 111, .3);\n  padding-bottom: 10px;\n}\n\n.wc-tourney-header-title {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 2px;\n  white-space: nowrap;\n  letter-spacing: .22em;\n  color: var(--wc-gold);\n  font-size: .62rem;\n}\n\n.wc-tourney-header-title strong {\n  color: #f6ebd3;\n  font-size: .72rem;\n  letter-spacing: .25em;\n}\n\n.wc-tourney-exit,\n.wc-tourney-reveal-button {\n  min-height: 32px;\n  border: 1px solid rgba(226, 190, 111, .48);\n  border-radius: 3px;\n  padding: 0 14px;\n  color: #f0d99d;\n  background: linear-gradient(180deg, rgba(45, 38, 25, .95), rgba(20, 18, 14, .95));\n  font-size: .65rem !important;\n  font-weight: 850;\n  letter-spacing: .13em;\n  cursor: pointer;\n  transition: border-color .18s ease, background .18s ease, transform .18s ease, box-shadow .18s ease;\n}\n\n.wc-tourney-exit {\n  justify-self: start;\n}\n\n.wc-tourney-exit:hover,\n.wc-tourney-reveal-button:hover:not(:disabled) {\n  border-color: var(--wc-gold-bright);\n  background: linear-gradient(180deg, #514126, #211b10);\n  box-shadow: 0 0 18px rgba(230, 190, 104, .18);\n  transform: translateY(-1px);\n}\n\n.wc-tourney-header-right {\n  display: flex;\n  justify-content: flex-end;\n  align-items: center;\n  gap: 12px;\n  min-width: 0;\n  color: #c9b88e;\n  font-size: .62rem;\n  font-weight: 800;\n  letter-spacing: .14em;\n}\n\n.wc-tourney-reveal-button {\n  color: #1b1509;\n  border-color: #ffdfa0;\n  background: linear-gradient(135deg, #fff0bc, #c59645 75%, #9c702f);\n  box-shadow: 0 4px 18px rgba(207, 158, 68, .2);\n}\n\n.wc-tourney-live-state {\n  color: #d8bd7c;\n  white-space: nowrap;\n}\n\n.wc-tourney-bracket-title {\n  flex: 0 0 auto;\n  min-height: 58px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n}\n\n.wc-tourney-bracket-title h1,\n.wc-tourney-setup-title h1,\n.wc-tourney-results-title h1 {\n  margin: 2px 0 0;\n  color: var(--wc-gold-bright);\n  font-size: clamp(1.35rem, 2.4vw, 2.15rem);\n  font-weight: 950;\n  letter-spacing: .13em;\n  line-height: 1;\n  text-shadow: 0 3px 22px rgba(216, 168, 76, .32);\n}\n\n.wc-tourney-kicker {\n  margin: 0;\n  color: #b99552;\n  font-size: .56rem;\n  font-weight: 850;\n  letter-spacing: .24em;\n}\n\n.wc-tourney-player-strip {\n  min-width: 240px;\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  padding: 5px 12px 5px 6px;\n  border: 1px solid rgba(19, 213, 255, .42);\n  border-radius: 4px;\n  background: linear-gradient(100deg, rgba(13, 55, 62, .42), rgba(16, 18, 17, .92));\n  box-shadow: inset 3px 0 #13d5ff, 0 0 18px rgba(19, 213, 255, .07);\n}\n\n.wc-tourney-player-strip img {\n  width: 42px;\n  height: 46px;\n  object-fit: cover;\n  object-position: center top;\n  border-radius: 2px;\n  background: #202629;\n}\n\n.wc-tourney-player-strip div {\n  display: flex;\n  flex: 1;\n  min-width: 0;\n  flex-direction: column;\n  gap: 3px;\n}\n\n.wc-tourney-player-strip small {\n  color: #7ddced;\n  font-size: .5rem;\n  font-weight: 900;\n  letter-spacing: .16em;\n}\n\n.wc-tourney-player-strip strong {\n  overflow: hidden;\n  color: #f4f5eb;\n  font-size: .9rem;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.wc-tourney-player-strip > span {\n  color: #d4c29b;\n  font-size: .52rem;\n  font-weight: 850;\n  letter-spacing: .1em;\n  white-space: nowrap;\n}\n\n.wc-tourney-rounds {\n  position: relative;\n  z-index: 1;\n  flex: 1 1 auto;\n  min-height: 0;\n  width: min(100%, 1040px);\n  margin: 0 auto;\n  display: flex;\n  flex-direction: column;\n  gap: 7px;\n  overflow: hidden;\n}\n\n.wc-tourney-round {\n  min-height: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.wc-tourney-round-title {\n  flex: 0 0 17px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 12px;\n  border-bottom: 1px solid rgba(219, 179, 96, .23);\n  color: #a88b52;\n}\n\n.wc-tourney-round-title span,\n.wc-tourney-round-title small {\n  color: #8f805e;\n  font-size: .49rem;\n  font-weight: 850;\n  letter-spacing: .16em;\n}\n\n.wc-tourney-round-title h2 {\n  margin: 0;\n  color: #e8d29f;\n  font-size: .68rem;\n  font-weight: 950;\n  letter-spacing: .2em;\n}\n\n.wc-tourney-round-matches {\n  flex: 1 1 auto;\n  min-height: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n}\n\n.wc-tourney-match {\n  position: relative;\n  flex: 1 1 0;\n  min-height: 0;\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  gap: 3px;\n  padding: 4px 10px;\n  border: 1px solid rgba(166, 132, 69, .36);\n  border-radius: 4px;\n  background:\n    linear-gradient(100deg, rgba(40, 34, 24, .96), rgba(16, 16, 15, .98) 48%, rgba(36, 29, 19, .96));\n  box-shadow: 0 4px 13px rgba(0, 0, 0, .27), inset 0 1px rgba(255, 239, 194, .035);\n}\n\n.wc-tourney-match.is-player-match {\n  border-color: rgba(19, 213, 255, .72);\n  box-shadow: inset 3px 0 #13d5ff, 0 0 18px rgba(19, 213, 255, .1);\n}\n\n.wc-tourney-match-heading {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  color: #867858;\n  font-size: .47rem;\n  font-weight: 900;\n  letter-spacing: .16em;\n}\n\n.wc-tourney-matchup {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) 34px minmax(0, 1fr);\n  align-items: center;\n  gap: 7px;\n  min-height: 0;\n}\n\n.wc-tourney-versus {\n  color: #d6b66e;\n  font-size: .62rem;\n  font-weight: 950;\n  text-align: center;\n  letter-spacing: .1em;\n}\n\n.wc-tourney-fighter {\n  min-width: 0;\n  height: 34px;\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  padding: 2px 7px;\n  border: 1px solid rgba(154, 139, 107, .18);\n  border-radius: 3px;\n  background: rgba(8, 9, 9, .62);\n}\n\n.wc-tourney-fighter.player-entry {\n  border-color: rgba(19, 213, 255, .46);\n}\n\n.wc-tourney-fighter.match-winner {\n  border-color: rgba(242, 204, 117, .75);\n  background: rgba(89, 67, 27, .25);\n}\n\n.wc-tourney-fighter.eliminated {\n  opacity: .35;\n  filter: grayscale(1);\n}\n\n.wc-tourney-portrait {\n  flex: 0 0 29px;\n  width: 29px;\n  height: 29px;\n  display: grid;\n  place-items: center;\n  overflow: hidden;\n  border-radius: 2px;\n  color: #dfc27b;\n  background: linear-gradient(145deg, #40351f, #181511);\n  font-size: 1.12rem;\n  font-weight: 900;\n}\n\n.wc-tourney-portrait img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  object-position: center top;\n}\n\n.wc-tourney-fighter-name {\n  flex: 1;\n  min-width: 0;\n  overflow: hidden;\n  color: #e9e0cb;\n  font-size: .68rem;\n  font-weight: 850;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.wc-tourney-fighter small {\n  color: #e9ce8c;\n  font-size: .46rem;\n  font-weight: 950;\n  letter-spacing: .08em;\n}\n\n.wc-tourney-fighter.player-entry small {\n  color: #69d9ef;\n}\n\n.wc-tourney-fight-button {\n  align-self: center;\n  min-height: 21px;\n  border: 1px solid #f0d18c;\n  border-radius: 2px;\n  padding: 2px 13px;\n  color: #211809;\n  background: linear-gradient(90deg, #fbe8ad, #c18e3e);\n  font-size: .54rem !important;\n  font-weight: 950;\n  letter-spacing: .14em;\n  cursor: pointer;\n  transition: filter .18s ease, box-shadow .18s ease, transform .18s ease;\n}\n\n.wc-tourney-fight-button span {\n  margin-left: 6px;\n}\n\n.wc-tourney-fight-button:hover {\n  filter: brightness(1.13);\n  box-shadow: 0 0 15px rgba(235, 192, 103, .26);\n  transform: translateY(-1px);\n}\n\n.wc-tourney-winner-line {\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  gap: 7px;\n  color: #917848;\n  font-size: .49rem;\n  font-weight: 900;\n  letter-spacing: .15em;\n}\n\n.wc-tourney-winner-line strong {\n  color: #f0d48e;\n  font-size: .58rem;\n}\n\n.wc-tourney-spectator-bar {\n  position: relative;\n  z-index: 2;\n  flex: 0 0 50px;\n  width: min(100%, 1040px);\n  display: flex;\n  align-items: center;\n  gap: 8px;\n  margin: 0 auto;\n  border: 1px solid rgba(205, 163, 82, .48);\n  border-radius: 4px;\n  padding: 6px 10px;\n  background: rgba(18, 16, 12, .98);\n  box-shadow: 0 -8px 28px rgba(0, 0, 0, .3);\n}\n\n.wc-tourney-spectator-bar div {\n  flex: 1;\n  min-width: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 3px;\n}\n\n.wc-tourney-spectator-bar strong {\n  color: #f2d58f;\n  font-size: .6rem;\n  letter-spacing: .14em;\n}\n\n.wc-tourney-spectator-bar span {\n  color: #a99e88;\n  font-size: .58rem;\n}\n\n.wc-tourney-spectator-bar button {\n  min-height: 30px;\n  border: 1px solid #d5b36b;\n  border-radius: 3px;\n  padding: 0 10px;\n  color: #1b150b;\n  background: linear-gradient(135deg, #f4dfa4, #b17f32);\n  font-size: .53rem;\n  font-weight: 950;\n  letter-spacing: .08em;\n  cursor: pointer;\n}\n\n.wc-tourney-spectator-bar .wc-tourney-skip-button,\n.wc-tourney-spectator-bar .wc-tourney-restart-button {\n  color: #dec995;\n  border-color: rgba(212, 177, 107, .4);\n  background: rgba(37, 31, 21, .9);\n}\n\n.wc-tourney-spectator-bar button:disabled {\n  opacity: .55;\n  cursor: wait;\n}\n\n/* SETUP */\n.wc-tournament-setup {\n  gap: 8px;\n  padding-top: 13px;\n  padding-bottom: 12px;\n}\n\n.wc-tourney-setup-tag {\n  justify-self: end;\n  color: #b9a16f;\n  font-size: .62rem;\n  font-weight: 850;\n  letter-spacing: .15em;\n}\n\n.wc-tourney-setup-title {\n  flex: 0 0 auto;\n  padding-top: 5px;\n  text-align: center;\n}\n\n.wc-tourney-setup-title h1 {\n  margin: 7px 0 5px;\n  font-size: clamp(1.55rem, 3vw, 2.45rem);\n}\n\n.wc-tourney-setup-title > p:last-child {\n  margin: 0;\n  color: #aaa18e;\n  font-size: .76rem;\n}\n\n.wc-tourney-size-picker {\n  flex: 0 0 auto;\n  width: min(100%, 760px);\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  margin: 4px auto 0;\n}\n\n.wc-tourney-section-label {\n  color: #b79654;\n  font-size: .56rem;\n  font-weight: 950;\n  letter-spacing: .18em;\n}\n\n.wc-tourney-size-picker > div {\n  display: flex;\n  gap: 9px;\n}\n\n.wc-tourney-size-picker button {\n  min-width: 126px;\n  height: 59px;\n  display: grid;\n  grid-template-columns: 42px 1fr;\n  grid-template-rows: 1fr 1fr;\n  align-content: center;\n  align-items: center;\n  column-gap: 8px;\n  border: 1px solid rgba(187, 151, 83, .37);\n  border-radius: 4px;\n  padding: 6px 12px;\n  color: #e8d9b7;\n  background: linear-gradient(145deg, rgba(39, 33, 22, .96), rgba(16, 15, 13, .98));\n  text-align: left;\n  cursor: pointer;\n  transition: border-color .18s ease, box-shadow .18s ease, transform .18s ease;\n}\n\n.wc-tourney-size-picker button.active {\n  border-color: #f2d58c;\n  box-shadow: inset 0 0 0 1px rgba(242, 213, 140, .18), 0 0 20px rgba(224, 180, 88, .13);\n  background: linear-gradient(145deg, #4a3920, #1b1710);\n}\n\n.wc-tourney-size-picker button:hover {\n  transform: translateY(-1px);\n}\n\n.wc-tourney-size-picker button strong {\n  grid-row: 1 / 3;\n  color: #f5d98e;\n  font-size: 1.75rem;\n  line-height: 1;\n}\n\n.wc-tourney-size-picker button span {\n  align-self: end;\n  font-size: .58rem;\n  font-weight: 950;\n  letter-spacing: .1em;\n}\n\n.wc-tourney-size-picker button small {\n  align-self: start;\n  color: #a99b7c;\n  font-size: .49rem;\n  letter-spacing: .12em;\n}\n\n.wc-tourney-character-picker {\n  flex: 0 0 auto;\n  width: min(100%, 1040px);\n  margin: 0 auto;\n}\n\n.wc-tourney-section-heading {\n  display: flex;\n  align-items: end;\n  justify-content: space-between;\n  gap: 14px;\n  margin-bottom: 8px;\n}\n\n.wc-tourney-section-heading h2 {\n  margin: 3px 0 0;\n  color: #f0e3c9;\n  font-size: .9rem;\n  font-weight: 950;\n  letter-spacing: .14em;\n}\n\n.wc-tourney-section-heading > span {\n  color: #91836a;\n  font-size: .54rem;\n  font-weight: 850;\n  letter-spacing: .12em;\n}\n\n.wc-tourney-roster-track {\n  display: flex;\n  gap: 10px;\n  overflow-x: auto;\n  overflow-y: hidden;\n  padding: 2px 2px 10px;\n  scroll-snap-type: x mandatory;\n  scrollbar-width: thin;\n  scrollbar-color: #9a753b rgba(255, 255, 255, .06);\n}\n\n.wc-tourney-roster-card {\n  position: relative;\n  flex: 0 0 126px;\n  min-width: 0;\n  display: flex;\n  flex-direction: column;\n  align-items: stretch;\n  gap: 5px;\n  border: 1px solid rgba(160, 137, 94, .34);\n  border-radius: 4px;\n  padding: 6px;\n  color: #e9dfca;\n  background: linear-gradient(180deg, rgba(34, 30, 23, .98), rgba(14, 14, 13, .98));\n  text-align: left;\n  cursor: pointer;\n  scroll-snap-align: start;\n  transition: border-color .18s ease, transform .18s ease, box-shadow .18s ease;\n}\n\n.wc-tourney-roster-card:hover {\n  transform: translateY(-2px);\n  border-color: rgba(226, 194, 126, .8);\n}\n\n.wc-tourney-roster-card.selected {\n  border-color: #f1d48c;\n  box-shadow: inset 0 0 0 1px rgba(241, 212, 140, .24), 0 0 17px rgba(238, 194, 102, .2);\n  background: linear-gradient(180deg, rgba(78, 58, 28, .96), rgba(22, 18, 12, .98));\n}\n\n.wc-tourney-roster-image {\n  position: relative;\n  display: block;\n  width: 100%;\n  height: 110px;\n  overflow: hidden;\n  border-radius: 2px;\n  background:\n    radial-gradient(ellipse at 50% 20%, rgba(217, 179, 103, .18), transparent 60%),\n    #10100f;\n}\n\n.wc-tourney-roster-image img {\n  width: 100%;\n  height: 100%;\n  object-fit: contain;\n  object-position: center bottom;\n}\n\n.wc-tourney-roster-image i {\n  position: absolute;\n  top: 5px;\n  right: 5px;\n  width: 19px;\n  height: 19px;\n  display: grid;\n  place-items: center;\n  border-radius: 50%;\n  color: #171107;\n  background: #f5d98e;\n  font-size: .72rem;\n  font-style: normal;\n  font-weight: 950;\n}\n\n.wc-tourney-roster-card strong {\n  overflow: hidden;\n  font-size: .69rem;\n  font-weight: 900;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.wc-tourney-roster-card small {\n  color: #9a8b6b;\n  font-size: .47rem;\n  font-weight: 900;\n  letter-spacing: .14em;\n}\n\n.wc-tourney-roster-card.selected small {\n  color: #f3d995;\n}\n\n.wc-tourney-no-fighters {\n  padding: 24px;\n  border: 1px dashed rgba(196, 164, 101, .4);\n  color: #c8b88f;\n  text-align: center;\n}\n\n.wc-tourney-prize-section {\n  flex: 1 1 auto;\n  min-height: 0;\n  width: min(100%, 760px);\n  margin: 0 auto;\n  display: flex;\n  flex-direction: column;\n  justify-content: flex-end;\n}\n\n.wc-tourney-prize-section .wc-tourney-section-heading {\n  margin-bottom: 2px;\n}\n\n.wc-podium {\n  width: min(100%, 700px);\n  margin: 7px auto 0;\n  display: grid;\n  grid-template-columns: 1fr 1.12fr 1fr;\n  align-items: end;\n  gap: 9px;\n}\n\n.wc-podium-place {\n  min-width: 0;\n  height: 122px;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: flex-start;\n  gap: 4px;\n  overflow: hidden;\n  border: 1px solid rgba(170, 145, 95, .43);\n  border-bottom: 4px solid #8b8b91;\n  border-radius: 4px 4px 0 0;\n  padding: 8px 6px 6px;\n  background: linear-gradient(180deg, rgba(54, 53, 51, .76), rgba(18, 18, 17, .98));\n  text-align: center;\n}\n\n.wc-podium-place.place-1 {\n  height: 154px;\n  border-color: #f0d48c;\n  border-bottom: 5px solid #d9af54;\n  background: linear-gradient(180deg, rgba(106, 78, 32, .72), rgba(25, 20, 12, .98));\n  box-shadow: 0 0 28px rgba(223, 177, 83, .17);\n}\n\n.wc-podium-place.place-3 {\n  height: 108px;\n  border-bottom-color: #a8784c;\n  background: linear-gradient(180deg, rgba(79, 52, 34, .56), rgba(21, 16, 13, .98));\n}\n\n.wc-podium-rank {\n  color: #d7d5d0;\n  font-size: 1.35rem;\n  font-weight: 950;\n  line-height: 1;\n}\n\n.wc-podium-place.place-1 .wc-podium-rank {\n  color: #ffe7a7;\n  font-size: 1.65rem;\n  text-shadow: 0 0 16px rgba(249, 217, 144, .48);\n}\n\n.wc-podium-place.place-3 .wc-podium-rank {\n  color: #c99a70;\n}\n\n.wc-podium-place img {\n  width: min(100%, 88px);\n  height: 61px;\n  object-fit: contain;\n  object-position: center bottom;\n  filter: drop-shadow(0 4px 5px rgba(0, 0, 0, .6));\n}\n\n.wc-podium-empty {\n  height: 16px;\n  color: #b89b61;\n  font-size: .8rem;\n  font-weight: 900;\n}\n\n.wc-podium-place > strong {\n  width: 100%;\n  overflow: hidden;\n  color: #f2e8d2;\n  font-size: .68rem;\n  font-weight: 950;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.wc-podium-place > span {\n  color: #bbaa84;\n  font-size: .48rem;\n  font-weight: 950;\n  letter-spacing: .13em;\n}\n\n.wc-podium-place.place-1 > span {\n  color: #ffdf91;\n}\n\n.wc-podium-prize {\n  display: flex;\n  align-items: baseline;\n  justify-content: center;\n  gap: 4px;\n  color: #f6d991;\n  font-size: .75rem;\n  font-weight: 950;\n}\n\n.wc-podium-prize small {\n  color: #a99978;\n  font-size: .43rem;\n  letter-spacing: .1em;\n}\n\n.wc-tourney-setup-footer {\n  flex: 0 0 47px;\n  width: min(100%, 760px);\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  margin: 0 auto;\n  border-top: 1px solid rgba(219, 179, 96, .23);\n  padding-top: 8px;\n}\n\n.wc-tourney-setup-footer > div {\n  min-width: 0;\n  display: flex;\n  flex-direction: column;\n  gap: 3px;\n}\n\n.wc-tourney-setup-footer > div strong {\n  overflow: hidden;\n  color: #f4e4c0;\n  font-size: .76rem;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.wc-tourney-setup-footer > div span {\n  color: #9d8e6d;\n  font-size: .48rem;\n  font-weight: 900;\n  letter-spacing: .14em;\n}\n\n.wc-tourney-primary-action {\n  min-height: 38px;\n  border: 1px solid #ffe3a1;\n  border-radius: 3px;\n  padding: 0 22px;\n  color: #201707;\n  background: linear-gradient(110deg, #fff0bd 0%, #e7bf6d 45%, #a97932 100%);\n  box-shadow: 0 5px 20px rgba(203, 155, 66, .2), inset 0 1px rgba(255, 255, 255, .4);\n  font-size: .65rem;\n  font-weight: 1000;\n  letter-spacing: .16em;\n  cursor: pointer;\n  transition: filter .18s ease, transform .18s ease, box-shadow .18s ease;\n}\n\n.wc-tourney-primary-action:hover:not(:disabled) {\n  filter: brightness(1.12);\n  transform: translateY(-2px);\n  box-shadow: 0 8px 24px rgba(203, 155, 66, .3), inset 0 1px rgba(255, 255, 255, .45);\n}\n\n.wc-tourney-primary-action:disabled {\n  opacity: .45;\n  cursor: not-allowed;\n}\n\n.wc-tourney-primary-action span {\n  margin-left: 10px;\n}\n\n/* RESULTS — SECOND PLACE LEFT, CHAMPION CENTER, THIRD PLACE RIGHT */\n.wc-tournament-results {\n  align-items: center;\n  justify-content: flex-start;\n  gap: 10px;\n  padding-top: 18px;\n}\n\n.wc-tourney-results-header {\n  width: 100%;\n  flex: 0 0 38px;\n  display: flex;\n  justify-content: space-between;\n  color: #c6a96d;\n  font-size: .58rem;\n  font-weight: 850;\n  letter-spacing: .18em;\n}\n\n.wc-tourney-results-title {\n  flex: 0 0 auto;\n  text-align: center;\n}\n\n.wc-tourney-results-title h1 {\n  margin-top: 6px;\n  font-size: clamp(2rem, 4vw, 3.2rem);\n}\n\n.wc-tourney-results-title > p:last-child {\n  margin: 7px 0 0;\n  color: #b8ac95;\n  font-size: .72rem;\n}\n\n.wc-tournament-results .wc-podium {\n  flex: 0 0 auto;\n  width: min(100%, 760px);\n  align-items: end;\n  gap: 12px;\n  margin: 10px auto 2px;\n}\n\n.wc-tournament-results .wc-podium-place {\n  height: clamp(170px, 27vh, 245px);\n  gap: 7px;\n  padding: 12px 10px 9px;\n  border-bottom-width: 6px;\n}\n\n.wc-tournament-results .wc-podium-place.place-1 {\n  height: clamp(220px, 34vh, 300px);\n}\n\n.wc-tournament-results .wc-podium-place.place-3 {\n  height: clamp(155px, 24vh, 220px);\n}\n\n.wc-tournament-results .wc-podium-rank {\n  font-size: 1.9rem;\n}\n\n.wc-tournament-results .wc-podium-place.place-1 .wc-podium-rank {\n  font-size: 2.3rem;\n}\n\n.wc-tournament-results .wc-podium-place img {\n  width: min(100%, 150px);\n  height: clamp(90px, 14vh, 125px);\n}\n\n.wc-tournament-results .wc-podium-place > strong {\n  font-size: clamp(.75rem, 1.25vw, 1rem);\n}\n\n.wc-tournament-results .wc-podium-place > span {\n  font-size: .56rem;\n}\n\n.wc-tourney-reward-receipt {\n  flex: 0 0 auto;\n  width: min(100%, 620px);\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 28px;\n  border: 1px solid rgba(221, 184, 105, .45);\n  border-radius: 4px;\n  padding: 13px 20px;\n  background: linear-gradient(110deg, rgba(32, 27, 18, .98), rgba(16, 15, 13, .98));\n  box-shadow: 0 8px 25px rgba(0, 0, 0, .26);\n}\n\n.wc-tourney-reward-receipt div {\n  display: flex;\n  flex-direction: column;\n  gap: 5px;\n}\n\n.wc-tourney-reward-receipt div span {\n  color: #a6926a;\n  font-size: .5rem;\n  font-weight: 900;\n  letter-spacing: .15em;\n}\n\n.wc-tourney-reward-receipt div strong {\n  color: #f3d895;\n  font-size: 1.05rem;\n  font-weight: 950;\n}\n\n.wc-tourney-reward-receipt div strong small {\n  font-size: .54rem;\n  letter-spacing: .1em;\n}\n\n.wc-tourney-reward-receipt p {\n  max-width: 210px;\n  margin: 0;\n  color: #bcb09a;\n  font-size: .63rem;\n  line-height: 1.4;\n}\n\n.wc-tournament-results .wc-tourney-primary-action {\n  flex: 0 0 auto;\n  min-width: 240px;\n  margin-top: 2px;\n}\n\n.wc-tourney-new-run {\n  flex: 0 0 auto;\n  border: 1px solid rgba(208, 174, 107, .5);\n  border-radius: 3px;\n  padding: 8px 18px;\n  color: #e2cca0;\n  background: rgba(39, 32, 20, .7);\n  font-size: .56rem !important;\n  font-weight: 900;\n  letter-spacing: .15em;\n  cursor: pointer;\n  transition: border-color .18s ease, background .18s ease;\n}\n\n.wc-tourney-new-run:hover {\n  border-color: #f1d28c;\n  background: rgba(79, 59, 26, .72);\n}\n\n.wc-tourney-new-run span {\n  margin-left: 8px;\n}\n\n/* RESPONSIVE SAFETY */\n@media (max-height: 760px) and (min-width: 701px) {\n  .wc-tournament {\n    min-height: 0;\n    padding-top: 10px;\n    padding-bottom: 10px;\n    gap: 6px;\n  }\n\n  .wc-tourney-header {\n    flex-basis: 36px;\n    padding-bottom: 6px;\n  }\n\n  .wc-tourney-bracket-title {\n    min-height: 48px;\n  }\n\n  .wc-tourney-player-strip {\n    min-width: 210px;\n  }\n\n  .wc-tourney-player-strip img {\n    width: 34px;\n    height: 38px;\n  }\n\n  .wc-tourney-match {\n    padding-top: 2px;\n    padding-bottom: 2px;\n  }\n\n  .wc-tourney-fighter {\n    height: 29px;\n  }\n\n  .wc-tourney-portrait {\n    width: 25px;\n    height: 25px;\n    flex-basis: 25px;\n  }\n\n  .wc-tourney-fight-button {\n    min-height: 18px;\n    padding-top: 1px;\n    padding-bottom: 1px;\n  }\n\n  .wc-tourney-setup-title h1 {\n    font-size: 1.8rem;\n  }\n\n  .wc-tourney-roster-image {\n    height: 88px;\n  }\n\n  .wc-tourney-roster-card {\n    flex-basis: 112px;\n  }\n\n  .wc-podium-place {\n    height: 106px;\n  }\n\n  .wc-podium-place.place-1 {\n    height: 132px;\n  }\n\n  .wc-podium-place.place-3 {\n    height: 96px;\n  }\n}\n\n@media (max-width: 700px) {\n  .wc-tournament {\n    min-height: 0;\n    padding: 10px 11px 12px;\n  }\n\n  .wc-tourney-header {\n    grid-template-columns: 1fr auto;\n    flex-basis: 44px;\n  }\n\n  .wc-tourney-header-title {\n    align-items: flex-end;\n    font-size: .52rem;\n  }\n\n  .wc-tourney-header-title strong {\n    font-size: .58rem;\n  }\n\n  .wc-tourney-header-right {\n    grid-column: 1 / -1;\n    justify-content: space-between;\n  }\n\n  .wc-tourney-bracket-title {\n    align-items: flex-start;\n    flex-direction: column;\n    gap: 7px;\n  }\n\n  .wc-tourney-player-strip {\n    width: 100%;\n    min-width: 0;\n  }\n\n  .wc-tourney-rounds {\n    overflow-y: auto;\n    padding-right: 3px;\n  }\n\n  .wc-tourney-round {\n    flex: 0 0 auto !important;\n    min-height: 0;\n  }\n\n  .wc-tourney-round-matches {\n    flex: 0 0 auto;\n  }\n\n  .wc-tourney-match {\n    min-height: 64px;\n    flex: 0 0 auto;\n  }\n\n  .wc-tourney-fighter-name {\n    font-size: .59rem;\n  }\n\n  .wc-tourney-spectator-bar {\n    flex-wrap: wrap;\n    flex-basis: auto;\n  }\n\n  .wc-tourney-spectator-bar div {\n    flex-basis: 100%;\n  }\n\n  .wc-tourney-spectator-bar button {\n    flex: 1;\n  }\n\n  .wc-tourney-setup {\n    overflow-y: auto;\n  }\n\n  .wc-tourney-size-picker {\n    align-items: flex-start;\n    flex-direction: column;\n  }\n\n  .wc-tourney-size-picker > div {\n    width: 100%;\n  }\n\n  .wc-tourney-size-picker button {\n    flex: 1;\n  }\n\n  .wc-tourney-setup-title > p:last-child {\n    font-size: .66rem;\n  }\n\n  .wc-tourney-roster-card {\n    flex-basis: 112px;\n  }\n\n  .wc-tourney-roster-image {\n    height: 94px;\n  }\n\n  .wc-tourney-prize-section {\n    flex: 0 0 auto;\n  }\n\n  .wc-podium {\n    gap: 5px;\n  }\n\n  .wc-podium-place {\n    padding-right: 3px;\n    padding-left: 3px;\n  }\n\n  .wc-podium-prize {\n    gap: 2px;\n    font-size: .63rem;\n  }\n\n  .wc-tourney-setup-footer {\n    position: sticky;\n    bottom: 0;\n    background: rgba(10, 10, 9, .97);\n  }\n\n  .wc-tournament-results .wc-podium {\n    gap: 5px;\n  }\n\n  .wc-tournament-results .wc-podium-place {\n    padding: 8px 4px;\n  }\n\n  .wc-tourney-reward-receipt {\n    gap: 12px;\n    padding: 10px;\n  }\n\n  .wc-tourney-reward-receipt div strong {\n    font-size: .88rem;\n  }\n}\n\n/* Vertical connector spine keeps the match list reading as one bracket. */\n.wc-tourney-round-matches {\n  position: relative;\n  padding-left: 17px;\n}\n.wc-tourney-round-matches::before {\n  position: absolute;\n  content: \"\";\n  top: 7px;\n  bottom: 7px;\n  left: 5px;\n  width: 1px;\n  background: linear-gradient(to bottom, transparent, rgba(222, 183, 103, .68) 12%, rgba(222, 183, 103, .48) 88%, transparent);\n}\n.wc-tourney-match::before {\n  position: absolute;\n  content: \"\";\n  top: 50%;\n  left: -13px;\n  width: 12px;\n  height: 1px;\n  background: rgba(222, 183, 103, .55);\n}\n.wc-podium-bonus {\n  margin-top: -2px;\n  color: #d4b66f;\n  font-size: .43rem;\n  font-style: normal;\n  font-weight: 950;\n  letter-spacing: .1em;\n}\n.wc-tournament-results .wc-tourney-round-matches {\n  padding-left: 0;\n}\n@media (max-width: 700px) {\n  .wc-tourney-round-matches {\n    padding-left: 14px;\n  }\n  .wc-tourney-match::before {\n    left: -10px;\n    width: 9px;\n  }\n}\n\n.wc-tourney-result-player {\n  flex: 0 0 auto;\n  align-self: center;\n  width: min(100%, 320px);\n  min-width: 0;\n  border-color: rgba(19, 213, 255, .46);\n}\n.wc-tourney-result-player > span {\n  color: #d4c29b;\n  font-size: .56rem;\n  font-weight: 950;\n  letter-spacing: .1em;\n}\n@media (max-height: 680px) and (min-width: 701px) {\n  .wc-tourney-bracket .wc-tourney-rounds {\n    overflow-y: auto;\n    padding-right: 4px;\n  }\n  .wc-tourney-bracket .wc-tourney-round {\n    flex: 0 0 auto !important;\n  }\n  .wc-tourney-bracket .wc-tourney-round-matches {\n    flex: 0 0 auto;\n  }\n  .wc-tourney-bracket .wc-tourney-match {\n    min-height: 62px;\n  }\n}\n\n/* Bracket draw, elimination and championship presentation polish */\n.wc-tourney-reveal-status {\n  flex: 0 0 34px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 10px;\n  border: 1px solid rgba(226,190,111,.38);\n  border-radius: 3px;\n  color: #f4d993;\n  background: linear-gradient(90deg,rgba(56,42,19,.35),rgba(17,15,11,.85),rgba(56,42,19,.35));\n  font-size: .58rem;\n  font-weight: 950;\n  letter-spacing: .18em;\n  animation: wcRevealBanner .4s ease both;\n}\n.wc-tourney-reveal-spinner {\n  width: 13px;\n  height: 13px;\n  border: 2px solid rgba(244,217,147,.2);\n  border-top-color: #ffe6a0;\n  border-radius: 50%;\n  animation: wcRevealSpin .65s linear infinite;\n}\n.wc-tourney-fighter.is-revealing .wc-tourney-portrait {\n  border: 1px solid rgba(255,225,151,.9);\n  box-shadow: 0 0 13px rgba(231,190,103,.35);\n  animation: wcRevealFlicker .35s ease-in-out infinite alternate;\n}\n.wc-tourney-fighter.is-revealing .wc-tourney-portrait img {\n  animation: wcRevealPortrait .35s ease-in-out infinite alternate;\n  filter: brightness(1.16) saturate(1.2);\n}\n.wc-tourney-fighter.is-revealing .wc-tourney-fighter-name {\n  color: #ffe5a0;\n  animation: wcNameFlicker .22s steps(2,end) infinite;\n}\n.wc-tourney-rounds .wc-tourney-match {\n  animation: wcBracketDrop .42s cubic-bezier(.2,.8,.2,1) both;\n}\n.wc-tourney-rounds .wc-tourney-round:nth-child(2) .wc-tourney-match {\n  animation-delay: .08s;\n}\n.wc-tourney-rounds .wc-tourney-round:nth-child(3) .wc-tourney-match {\n  animation-delay: .16s;\n}\n.wc-tourney-elimination-panel {\n  position: relative;\n  z-index: 3;\n  flex: 0 0 auto;\n  width: min(100%,1040px);\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  margin: 0 auto;\n  border: 1px solid rgba(222,119,115,.48);\n  border-radius: 4px;\n  padding: 9px 12px;\n  background: linear-gradient(100deg,rgba(63,26,22,.96),rgba(22,16,13,.98) 52%,rgba(37,25,16,.98));\n  box-shadow: 0 0 22px rgba(171,64,56,.12),0 -8px 28px rgba(0,0,0,.3);\n  animation: wcEliminationEnter .45s ease both;\n}\n.wc-tourney-elimination-mark {\n  flex: 0 0 43px;\n  width: 43px;\n  height: 43px;\n  display: grid;\n  place-items: center;\n  border: 1px solid #c66b62;\n  border-radius: 50%;\n  color: #ffb0a4;\n  font-size: .83rem;\n  font-weight: 1000;\n  box-shadow: 0 0 14px rgba(220,91,82,.2);\n}\n.wc-tourney-elimination-panel>div:nth-child(2) {\n  flex: 1;\n  min-width: 120px;\n  display: flex;\n  flex-direction: column;\n  gap: 3px;\n}\n.wc-tourney-elimination-panel>div:nth-child(2) strong {\n  color: #f1b2a6;\n  font-size: .62rem;\n  font-weight: 1000;\n  letter-spacing: .14em;\n}\n.wc-tourney-elimination-panel>div:nth-child(2) span {\n  color: #c7a99d;\n  font-size: .56rem;\n}\n.wc-tourney-elimination-panel button {\n  min-height: 31px;\n  border: 1px solid rgba(223,187,117,.48);\n  border-radius: 3px;\n  padding: 0 11px;\n  color: #ebd9b7;\n  background: rgba(30,25,18,.9);\n  font-size: .52rem;\n  font-weight: 950;\n  letter-spacing: .08em;\n  cursor: pointer;\n  transition: background .18s ease,border-color .18s ease,transform .18s ease;\n}\n.wc-tourney-elimination-panel button:hover {\n  border-color: #ffe2a0;\n  background: rgba(91,66,30,.7);\n  transform: translateY(-1px);\n}\n.wc-tourney-elimination-panel .wc-tourney-watch-button {\n  border-color: #f4d48e;\n  color: #211707;\n  background: linear-gradient(110deg,#fff0bc,#b27f34);\n}\n.wc-tourney-elimination-panel .wc-tourney-restart-button {\n  border-color: rgba(220,132,118,.48);\n  color: #e7b4a9;\n}\n.wc-tourney-confetti {\n  position: absolute;\n  z-index: -1;\n  inset: 0;\n  overflow: hidden;\n  pointer-events: none;\n}\n.wc-tourney-confetti i {\n  position: absolute;\n  top: -8%;\n  width: 7px;\n  height: 13px;\n  border-radius: 1px;\n  background: linear-gradient(180deg,#fff0ba,#bd8b3c);\n  opacity: 0;\n  animation: wcChampConfetti 3.7s linear infinite;\n}\n.wc-tourney-confetti i:nth-child(3n) {\n  width: 5px;\n  height: 9px;\n  background: linear-gradient(180deg,#f8f1dc,#b7b5b1);\n}\n.wc-tourney-confetti i:nth-child(4n) {\n  width: 6px;\n  height: 11px;\n  background: linear-gradient(180deg,#f2bd78,#9f603e);\n}\n.wc-tourney-crown-light {\n  position: absolute;\n  z-index: -1;\n  top: -20%;\n  left: 50%;\n  width: min(80vw,900px);\n  height: 70%;\n  transform: translateX(-50%);\n  background: radial-gradient(ellipse,rgba(235,194,105,.2),rgba(198,148,67,.055) 40%,transparent 70%);\n  filter: blur(12px);\n  animation: wcCrownPulse 3.5s ease-in-out infinite alternate;\n}\n.wc-tournament-results .wc-podium-place {\n  transform-origin: center bottom;\n  animation: wcPodiumRise .68s cubic-bezier(.15,.85,.25,1.2) both;\n}\n.wc-tournament-results .wc-podium-place:nth-child(1) { animation-delay: .24s; }\n.wc-tournament-results .wc-podium-place:nth-child(2) { animation-delay: .48s; }\n.wc-tournament-results .wc-podium-place:nth-child(3) { animation-delay: .72s; }\n.wc-tournament-results .wc-podium-place.place-1 {\n  box-shadow: 0 0 35px rgba(239,197,105,.23),inset 0 1px rgba(255,246,211,.2);\n}\n.wc-tourney-results-title {\n  animation: wcResultsTitle .6s ease both;\n}\n.wc-tourney-result-player {\n  animation: wcResultsTitle .6s .15s ease both;\n}\n.wc-tourney-reward-receipt {\n  animation: wcResultsTitle .55s .8s ease both;\n}\n.wc-tournament-results .wc-tourney-primary-action {\n  animation: wcResultsTitle .45s 1s ease both;\n}\n.wc-tournament.is-restarting {\n  animation: wcTournamentExit .48s ease both;\n}\n.wc-tourney-primary-action:focus-visible,\n.wc-tourney-fight-button:focus-visible,\n.wc-tourney-reveal-button:focus-visible,\n.wc-tourney-elimination-panel button:focus-visible,\n.wc-tourney-exit:focus-visible,\n.wc-tourney-new-run:focus-visible {\n  outline: 2px solid #ffe6a0;\n  outline-offset: 3px;\n}\n@keyframes wcRevealSpin { to { transform: rotate(360deg); } }\n@keyframes wcRevealBanner { from { opacity:0; transform:translateY(-5px); } to { opacity:1; transform:translateY(0); } }\n@keyframes wcRevealFlicker { from { filter:brightness(.8); } to { filter:brightness(1.45); } }\n@keyframes wcRevealPortrait { from { transform:scale(.94); opacity:.65; } to { transform:scale(1.04); opacity:1; } }\n@keyframes wcNameFlicker { 50% { opacity:.5; } }\n@keyframes wcBracketDrop { from { opacity:0; transform:translateY(-9px); } to { opacity:1; transform:translateY(0); } }\n@keyframes wcEliminationEnter { from { opacity:0; transform:translateY(14px); } to { opacity:1; transform:translateY(0); } }\n@keyframes wcChampConfetti { 0% { opacity:0; transform:translate3d(0,-10vh,0) rotate(0); } 10% { opacity:.92; } 88% { opacity:.9; } 100% { opacity:0; transform:translate3d(35px,110vh,0) rotate(760deg); } }\n@keyframes wcCrownPulse { from { opacity:.55; transform:translateX(-50%) scale(.94); } to { opacity:1; transform:translateX(-50%) scale(1.08); } }\n@keyframes wcPodiumRise { from { opacity:0; transform:translateY(34px) scale(.94); } to { opacity:1; transform:translateY(0) scale(1); } }\n@keyframes wcResultsTitle { from { opacity:0; transform:translateY(12px); } to { opacity:1; transform:translateY(0); } }\n@keyframes wcTournamentExit { to { opacity:0; transform:scale(.985); filter:blur(4px); } }\n\n@media (max-width: 760px) {\n  .wc-tourney-elimination-panel {\n    flex-wrap: wrap;\n  }\n  .wc-tourney-elimination-panel>div:nth-child(2) {\n    flex: 1 1 calc(100% - 64px);\n  }\n  .wc-tourney-elimination-panel button {\n    flex: 1 1 30%;\n  }\n  .wc-tourney-reveal-status {\n    flex-basis: 30px;\n    font-size: .48rem;\n  }\n  .wc-tournament-results {\n    overflow-y: auto;\n  }\n}\n@media (prefers-reduced-motion: reduce) {\n  .wc-tournament *,\n  .wc-tournament *::before,\n  .wc-tournament *::after {\n    animation-duration: .01ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: .01ms !important;\n  }\n}\n/* Anonymous contender silhouette used before the CPU reveal. */\n.wc-tourney-portrait.is-mystery {\n  position: relative;\n  isolation: isolate;\n  overflow: hidden;\n  display: grid;\n  place-items: center;\n  color: #f4d894;\n  background:\n    radial-gradient(ellipse at 50% 35%, rgba(211, 174, 103, .2), transparent 56%),\n    linear-gradient(145deg, #29251c, #11100e);\n}\n.wc-tourney-portrait.is-mystery::before {\n  position: absolute;\n  z-index: 0;\n  top: 15%;\n  left: 50%;\n  width: 34%;\n  aspect-ratio: 1;\n  border: 1px solid rgba(221, 190, 128, .5);\n  border-radius: 50%;\n  content: \"\";\n  transform: translateX(-50%);\n  background: linear-gradient(145deg, #a18a60, #443923 78%);\n  box-shadow: 0 0 18px rgba(197, 160, 93, .22);\n}\n.wc-tourney-portrait.is-mystery::after {\n  position: absolute;\n  z-index: 0;\n  left: 50%;\n  bottom: -9%;\n  width: 76%;\n  height: 59%;\n  border: 1px solid rgba(221, 190, 128, .38);\n  border-bottom: 0;\n  border-radius: 48% 48% 8% 8%;\n  content: \"\";\n  transform: translateX(-50%);\n  background: linear-gradient(145deg, #756447, #30291d 78%);\n}\n.wc-tourney-portrait.is-mystery span {\n  position: relative;\n  z-index: 2;\n  display: grid;\n  place-items: center;\n  width: 27px;\n  height: 27px;\n  border: 1px solid rgba(244, 216, 148, .7);\n  border-radius: 50%;\n  color: #fff0c2;\n  background: rgba(13, 13, 10, .82);\n  box-shadow: 0 2px 10px #000b, 0 0 12px #d5ad5a44;\n  font-size: .9rem;\n  font-weight: 1000;\n  text-shadow: 0 1px 5px #000;\n}\n\n.wc-tourney-primary-action.is-loading::after,\n.wc-tourney-reveal-button:disabled::after {\n  display: inline-block;\n  width: 10px;\n  height: 10px;\n  margin-left: 10px;\n  border: 2px solid rgba(31,23,10,.25);\n  border-top-color: #281d0a;\n  border-radius: 50%;\n  content: \"\";\n  vertical-align: -1px;\n  animation: wcRevealSpin .65s linear infinite;\n}\n.wc-tourney-reveal-button:disabled::after {\n  border-color: rgba(255,236,190,.2);\n  border-top-color: #ffe6a0;\n}\n\n@media (max-height: 700px) and (min-width: 701px) {\n  .wc-tournament-results {\n    min-height: 0;\n    overflow-y: auto;\n    justify-content: flex-start;\n    padding-top: 10px;\n    padding-bottom: 12px;\n    gap: 7px;\n  }\n  .wc-tournament-results .wc-podium {\n    margin-top: 4px;\n  }\n  .wc-tournament-results .wc-podium-place {\n    height: 158px;\n    gap: 4px;\n    padding-top: 7px;\n  }\n  .wc-tournament-results .wc-podium-place.place-1 {\n    height: 190px;\n  }\n  .wc-tournament-results .wc-podium-place.place-3 {\n    height: 144px;\n  }\n  .wc-tournament-results .wc-podium-place img {\n    height: 76px;\n  }\n  .wc-tourney-reward-receipt {\n    padding-top: 8px;\n    padding-bottom: 8px;\n  }\n}\n\n\n/* Fighter entries are display cards, not pseudo-buttons. */\n.wc-tourney-matchup {\n  align-items: stretch;\n  gap: 8px;\n}\n.wc-tourney-fighter {\n  position: relative;\n  min-width: 0;\n  height: 58px;\n  min-height: 58px;\n  display: flex;\n  align-items: center;\n  gap: 7px;\n  padding: 4px 7px 4px 4px;\n  border: 1px solid rgba(173, 148, 100, .34);\n  border-radius: 5px;\n  background:\n    linear-gradient(135deg, rgba(61, 52, 37, .78), rgba(18, 18, 16, .97) 56%),\n    #12110f;\n  box-shadow:\n    inset 0 1px rgba(255, 246, 219, .06),\n    0 4px 10px rgba(0, 0, 0, .22);\n  cursor: default;\n  transition: border-color .2s ease, background .2s ease, opacity .2s ease;\n}\n.wc-tourney-fighter::after {\n  position: absolute;\n  top: 5px;\n  right: 5px;\n  width: 4px;\n  height: 4px;\n  border-radius: 50%;\n  content: \"\";\n  background: rgba(222, 190, 121, .42);\n}\n.wc-tourney-fighter.player-entry {\n  border-color: rgba(19, 213, 255, .55);\n  background:\n    linear-gradient(115deg, rgba(11, 64, 72, .54), rgba(14, 17, 17, .98) 65%);\n  box-shadow: inset 2px 0 #13d5ff, 0 4px 12px rgba(0, 0, 0, .24);\n}\n.wc-tourney-fighter.match-winner {\n  border-color: rgba(247, 211, 127, .85);\n  background:\n    linear-gradient(115deg, rgba(91, 68, 29, .62), rgba(21, 18, 13, .98) 68%);\n  box-shadow: inset 2px 0 #e9c66f, 0 0 15px rgba(229, 189, 103, .1);\n}\n.wc-tourney-fighter.eliminated {\n  opacity: .46;\n  filter: grayscale(1);\n}\n.wc-tourney-portrait {\n  flex: 0 0 47px;\n  width: 47px;\n  height: 49px;\n  display: grid;\n  place-items: center;\n  overflow: hidden;\n  border: 1px solid rgba(224, 198, 143, .2);\n  border-radius: 3px;\n  color: #e8cd8e;\n  background:\n    radial-gradient(ellipse at 50% 20%, rgba(228, 192, 119, .18), transparent 72%),\n    linear-gradient(145deg, #302a20, #11100e);\n  font-size: 1rem;\n  font-weight: 950;\n}\n.wc-tourney-fighter.player-entry .wc-tourney-portrait {\n  border-color: rgba(19, 213, 255, .43);\n}\n.wc-tourney-fighter.match-winner .wc-tourney-portrait {\n  border-color: rgba(241, 210, 136, .75);\n}\n.wc-tourney-portrait img {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  object-position: center 16%;\n}\n.wc-tourney-fighter-name {\n  flex: 1;\n  min-width: 0;\n  overflow: hidden;\n  color: #f2e8d5;\n  font-size: .67rem;\n  font-weight: 950;\n  line-height: 1.05;\n  text-overflow: ellipsis;\n  white-space: normal;\n  overflow-wrap: anywhere;\n  text-shadow: 0 1px 5px #000;\n}\n.wc-tourney-fighter small {\n  flex: 0 0 auto;\n  max-width: 44px;\n  border: 1px solid rgba(222, 190, 121, .3);\n  border-radius: 2px;\n  padding: 3px 4px;\n  color: #e8cc8c;\n  background: rgba(0, 0, 0, .28);\n  font-size: .42rem;\n  font-weight: 1000;\n  letter-spacing: .08em;\n}\n.wc-tourney-fighter.player-entry small {\n  border-color: rgba(19, 213, 255, .42);\n  color: #74dff0;\n}\n.wc-tourney-fighter.match-winner small {\n  border-color: rgba(241, 210, 136, .58);\n  color: #ffe6a0;\n}\n.wc-tourney-versus {\n  align-self: center;\n  width: 26px;\n  min-width: 26px;\n  font-size: .55rem;\n  text-shadow: 0 0 12px rgba(214, 182, 110, .45);\n}\n.wc-tourney-match {\n  gap: 5px;\n  padding: 5px 9px;\n}\n.wc-tourney-match-heading {\n  font-size: .45rem;\n}\n.wc-tourney-fight-button {\n  min-height: 18px;\n  padding: 1px 11px;\n  font-size: .49rem !important;\n  letter-spacing: .12em;\n}\n\n/* Setup podium: reserve enough height for every prize line, including 3rd. */\n.wc-tournament-setup .wc-tourney-prize-section {\n  justify-content: center;\n  padding-top: 2px;\n}\n.wc-tournament-setup .wc-podium {\n  width: min(100%, 760px);\n  margin-top: 5px;\n  gap: 11px;\n}\n.wc-tournament-setup .wc-podium-place {\n  height: 178px;\n  min-height: 178px;\n  overflow: visible;\n  gap: 7px;\n  padding: 9px 7px 8px;\n}\n.wc-tournament-setup .wc-podium-place.place-1 {\n  height: 202px;\n  min-height: 202px;\n}\n.wc-tournament-setup .wc-podium-place.place-3 {\n  height: 166px;\n  min-height: 166px;\n}\n.wc-tournament-setup .wc-podium-place img {\n  height: 51px;\n  width: min(100%, 92px);\n}\n.wc-tournament-setup .wc-podium-place > strong {\n  font-size: .67rem;\n}\n.wc-tournament-setup .wc-podium-place > span {\n  font-size: .5rem;\n}\n.wc-tournament-setup .wc-podium-prize {\n  margin-top: 1px;\n  font-size: .82rem;\n  white-space: nowrap;\n}\n.wc-tournament-setup .wc-podium-prize small {\n  font-size: .46rem;\n}\n.wc-tournament-setup .wc-podium-bonus {\n  font-size: .46rem;\n  white-space: nowrap;\n}\n.wc-tourney-elimination-panel {\n  flex-wrap: wrap;\n}\n.wc-tourney-elimination-panel > div:nth-child(2) {\n  min-width: 180px;\n  flex: 1 1 250px;\n}\n.wc-tourney-elimination-panel button {\n  flex: 0 1 auto;\n}\n\n/* Compact displays keep the character portrait cards readable. */\n@media (max-width: 760px) {\n  .wc-tourney-fighter {\n    min-height: 55px;\n    height: 55px;\n    gap: 5px;\n    padding: 3px 5px 3px 3px;\n  }\n  .wc-tourney-portrait {\n    flex-basis: 43px;\n    width: 43px;\n    height: 47px;\n  }\n  .wc-tourney-fighter-name {\n    font-size: .59rem;\n  }\n  .wc-tourney-fighter small {\n    max-width: 37px;\n    padding: 2px 3px;\n    font-size: .38rem;\n  }\n  .wc-tourney-matchup {\n    gap: 4px;\n  }\n  .wc-tourney-versus {\n    width: 19px;\n    min-width: 19px;\n  }\n  .wc-tournament-setup .wc-podium-place {\n    height: 158px;\n    min-height: 158px;\n    padding: 7px 4px;\n    gap: 5px;\n  }\n  .wc-tournament-setup .wc-podium-place.place-1 {\n    height: 180px;\n    min-height: 180px;\n  }\n  .wc-tournament-setup .wc-podium-place.place-3 {\n    height: 150px;\n    min-height: 150px;\n  }\n  .wc-tournament-setup .wc-podium-place img {\n    height: 42px;\n  }\n  .wc-tournament-setup .wc-podium-prize {\n    gap: 2px;\n    font-size: .66rem;\n  }\n  .wc-tourney-elimination-panel button {\n    flex: 1 1 44%;\n  }\n}\n@media (max-height: 760px) and (min-width: 761px) {\n  .wc-tournament-setup .wc-podium-place {\n    height: 158px;\n    min-height: 158px;\n    gap: 5px;\n  }\n  .wc-tournament-setup .wc-podium-place.place-1 {\n    height: 180px;\n    min-height: 180px;\n  }\n  .wc-tournament-setup .wc-podium-place.place-3 {\n    height: 148px;\n    min-height: 148px;\n  }\n  .wc-tournament-setup .wc-podium-place img {\n    height: 40px;\n  }\n}\n\n\n/* =========================================================\n   ROUND-BY-ROUND CHAMPIONSHIP BRACKET\n   Large character cards, vertical match list, and clear advancement forks.\n   ========================================================= */\n.wc-tournament-bracket {\n  gap: 12px;\n}\n\n.wc-tourney-bracket-title {\n  width: min(100%, 1160px);\n  margin-inline: auto;\n}\n\n.wc-tourney-rounds.wc-tourney-current-round {\n  width: min(100%, 1160px);\n  flex: 1 1 auto;\n  min-height: 0;\n  overflow-y: auto;\n  overflow-x: hidden;\n  padding: 0 8px 16px;\n  scrollbar-color: #98763f #171511;\n  scrollbar-width: thin;\n}\n\n.wc-tourney-current-round-title {\n  position: sticky;\n  z-index: 4;\n  top: 0;\n  flex: 0 0 42px;\n  justify-content: center;\n  gap: 18px;\n  padding: 6px 12px;\n  border: 1px solid rgba(214, 174, 93, .26);\n  border-radius: 7px;\n  background: linear-gradient(100deg, rgba(22, 19, 13, .98), rgba(35, 28, 17, .98), rgba(22, 19, 13, .98));\n  box-shadow: 0 8px 18px #0008;\n}\n\n.wc-tourney-current-round-title h2 {\n  color: #f7d98b;\n  font-size: clamp(.95rem, 1.5vw, 1.3rem);\n  font-weight: 1000;\n  letter-spacing: .2em;\n}\n\n.wc-tourney-round-matches.wc-tourney-current-round-matches {\n  display: flex;\n  flex: 0 0 auto;\n  flex-direction: column;\n  gap: 16px;\n  padding: 12px 0 24px;\n}\n\n.wc-tourney-current-round .wc-tourney-match {\n  flex: 0 0 auto;\n  min-height: 0;\n  padding: 12px clamp(10px, 2vw, 22px) 14px;\n  border: 1px solid rgba(181, 148, 87, .42);\n  border-radius: 10px;\n  background:\n    radial-gradient(ellipse at 0% 50%, rgba(19, 213, 255, .06), transparent 38%),\n    linear-gradient(110deg, rgba(40, 34, 24, .97), rgba(13, 14, 13, .99) 52%, rgba(33, 25, 18, .97));\n  box-shadow: 0 12px 28px #0007, inset 0 1px #fff1;\n  animation: wcCurrentMatchEnter .5s cubic-bezier(.16, 1, .3, 1) both;\n}\n\n.wc-tourney-current-round .wc-tourney-match:nth-child(2) { animation-delay: .12s; }\n.wc-tourney-current-round .wc-tourney-match:nth-child(3) { animation-delay: .24s; }\n.wc-tourney-current-round .wc-tourney-match:nth-child(4) { animation-delay: .36s; }\n\n.wc-tourney-current-round .wc-tourney-match.is-player-match {\n  border-color: rgba(19, 213, 255, .8);\n  box-shadow: inset 4px 0 #13d5ff, 0 0 24px rgba(19, 213, 255, .12), 0 12px 28px #0007;\n}\n\n.wc-tourney-current-round .wc-tourney-match-heading {\n  min-height: 20px;\n  padding: 0 3px 7px;\n  border-bottom: 1px solid #ffffff12;\n  color: #c2a66c;\n  font-size: .62rem;\n  letter-spacing: .15em;\n}\n\n.wc-tourney-current-round .wc-tourney-match-heading span:last-child {\n  color: #a5a08f;\n}\n\n.wc-tourney-current-round .wc-tourney-matchup {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) 86px minmax(155px, .3fr);\n  align-items: stretch;\n  gap: clamp(8px, 1.8vw, 20px);\n  min-height: 0;\n  padding: 12px 0 4px;\n}\n\n.wc-tourney-fighter-stack {\n  display: flex;\n  flex-direction: column;\n  gap: 10px;\n  min-width: 0;\n}\n\n.wc-tourney-current-round .wc-tourney-fighter {\n  position: relative;\n  min-width: 0;\n  height: 156px;\n  min-height: 156px;\n  display: grid;\n  grid-template-columns: clamp(112px, 13vw, 158px) minmax(0, 1fr);\n  align-items: stretch;\n  gap: 14px;\n  padding: 7px;\n  overflow: hidden;\n  border: 1px solid rgba(176, 153, 110, .36);\n  border-radius: 7px;\n  background:\n    linear-gradient(100deg, rgba(33, 43, 36, .9), rgba(15, 18, 17, .98) 68%),\n    #101310;\n  box-shadow: inset 0 1px #ffffff12, 0 5px 15px #0006;\n  transition: border-color .2s ease, filter .2s ease, opacity .2s ease;\n}\n\n.wc-tourney-current-round .wc-tourney-fighter.player-entry {\n  border-color: #13d5ffad;\n  background: linear-gradient(100deg, rgba(8, 61, 72, .72), rgba(13, 19, 20, .98) 70%);\n  box-shadow: inset 3px 0 #13d5ff, 0 0 17px #13d5ff18;\n}\n\n.wc-tourney-current-round .wc-tourney-fighter.match-winner {\n  border-color: #e8c56e;\n  background: linear-gradient(100deg, rgba(83, 63, 27, .62), rgba(18, 18, 14, .98) 72%);\n  box-shadow: inset 3px 0 #f0cf7f, 0 0 18px #e6c66a1b;\n}\n\n.wc-tourney-current-round .wc-tourney-fighter.eliminated {\n  opacity: .42;\n  filter: grayscale(1);\n}\n\n.wc-tourney-current-round .wc-tourney-portrait {\n  position: relative;\n  width: 100%;\n  height: 100%;\n  min-width: 0;\n  flex: initial;\n  display: grid;\n  place-items: end center;\n  overflow: hidden;\n  border: 1px solid rgba(222, 188, 117, .3);\n  border-radius: 4px;\n  color: #e8cf93;\n  background:\n    radial-gradient(ellipse at 50% 90%, rgba(225, 188, 100, .19), transparent 65%),\n    linear-gradient(180deg, #20251f, #090d0b);\n  font-size: 3.4rem;\n}\n\n.wc-tourney-current-round .wc-tourney-portrait img {\n  display: block;\n  width: 100%;\n  height: 100%;\n  object-fit: contain;\n  object-position: center bottom;\n  filter: drop-shadow(0 7px 8px #000c);\n}\n\n.wc-tourney-current-round .wc-tourney-portrait.is-mystery {\n  background: radial-gradient(circle at 50% 45%, #70572a, #1b1811 72%);\n}\n\n.wc-tourney-fighter-meta {\n  min-width: 0;\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  justify-content: center;\n  gap: 8px;\n  padding: 8px 10px 8px 0;\n}\n\n.wc-tourney-fighter-seed {\n  color: #b29b6e;\n  font-size: .61rem;\n  font-weight: 950;\n  letter-spacing: .16em;\n}\n\n.wc-tourney-fighter-name {\n  display: block;\n  width: 100%;\n  overflow: hidden;\n  color: #fff3d2;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: clamp(1.05rem, 2vw, 1.65rem);\n  font-weight: 1000;\n  line-height: 1.1;\n  text-overflow: ellipsis;\n  white-space: normal;\n}\n\n.wc-tourney-fighter-tags {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 6px;\n}\n\n.wc-tourney-current-round .wc-tourney-fighter-tags small {\n  display: inline-flex;\n  align-items: center;\n  min-height: 22px;\n  padding: 4px 9px;\n  border: 1px solid #13d5ff75;\n  border-radius: 4px;\n  color: #8ceeff;\n  background: #13d5ff12;\n  font-size: .57rem;\n  font-weight: 1000;\n  letter-spacing: .12em;\n}\n\n.wc-tourney-current-round .wc-tourney-fighter.match-winner .wc-tourney-fighter-tags small {\n  border-color: #e9cb80;\n  color: #f5d98d;\n  background: #e9cb8017;\n}\n\n.wc-tourney-versus {\n  position: relative;\n  display: grid;\n  place-items: center;\n  min-height: 25px;\n  color: #d6b66e;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: .72rem;\n  font-weight: 1000;\n  letter-spacing: .18em;\n}\n\n.wc-tourney-versus::before,\n.wc-tourney-versus::after {\n  content: \"\";\n  flex: 1;\n  height: 1px;\n  background: linear-gradient(90deg, transparent, #c09b5a, transparent);\n}\n\n.wc-tourney-versus span {\n  padding: 0 13px;\n}\n\n.wc-tourney-bracket-fork {\n  position: relative;\n  min-width: 0;\n  min-height: 322px;\n}\n\n.wc-tourney-bracket-fork i {\n  position: absolute;\n  display: block;\n  background: linear-gradient(90deg, #8e713d, #ddbd75);\n  box-shadow: 0 0 7px #d5ae5d33;\n}\n\n.wc-tourney-bracket-fork .fork-upper {\n  top: 25%;\n  left: 0;\n  width: 35%;\n  height: 2px;\n}\n\n.wc-tourney-bracket-fork .fork-lower {\n  bottom: 25%;\n  left: 0;\n  width: 35%;\n  height: 2px;\n}\n\n.wc-tourney-bracket-fork .fork-stem {\n  top: 25%;\n  bottom: 25%;\n  left: 35%;\n  width: 2px;\n  background: linear-gradient(180deg, #ddbd75, #8e713d);\n}\n\n.wc-tourney-bracket-fork .fork-out {\n  top: calc(50% - 1px);\n  left: 35%;\n  right: 0;\n  height: 2px;\n}\n\n.wc-tourney-advance-slot {\n  min-width: 0;\n  min-height: 322px;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 9px;\n  padding: 9px;\n  border: 1px dashed rgba(201, 168, 100, .4);\n  border-radius: 7px;\n  background: linear-gradient(145deg, rgba(28, 25, 19, .9), rgba(9, 12, 10, .96));\n  text-align: center;\n}\n\n.wc-tourney-advance-slot > span {\n  color: #bba16b;\n  font-size: .6rem;\n  font-weight: 950;\n  letter-spacing: .12em;\n}\n\n.wc-tourney-advance-portrait {\n  width: min(100%, 130px);\n  height: 155px;\n  display: grid;\n  place-items: end center;\n  overflow: hidden;\n  border: 1px solid #d5b56f88;\n  border-radius: 5px;\n  background: radial-gradient(ellipse at 50% 85%, #d5b56f2a, transparent 65%), #13150f;\n}\n\n.wc-tourney-advance-portrait img {\n  width: 100%;\n  height: 100%;\n  object-fit: contain;\n  object-position: center bottom;\n}\n\n.wc-tourney-advance-slot > strong {\n  color: #f2d98e;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: .95rem;\n  font-weight: 1000;\n}\n\n.wc-tourney-advance-slot > small {\n  color: #a78a50;\n  font-size: .54rem;\n  font-weight: 900;\n  letter-spacing: .1em;\n}\n\n.wc-tourney-advance-pending {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  width: min(100%, 130px);\n  height: 155px;\n  border: 1px solid #a58a5640;\n  border-radius: 5px;\n  color: #d6b66e;\n  background: radial-gradient(circle, #6a542b55, #11120e 72%);\n}\n\n.wc-tourney-advance-pending span {\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: 3.1rem;\n  font-weight: 1000;\n}\n\n.wc-tourney-advance-pending strong {\n  color: #e1ca91;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: .8rem;\n}\n\n.wc-tourney-advance-pending small {\n  color: #9a8968;\n  font-size: .48rem;\n  font-weight: 900;\n  letter-spacing: .09em;\n}\n\n.wc-tourney-current-round .wc-tourney-fight-button {\n  min-height: 42px;\n  margin-top: 9px;\n  padding: 8px 20px;\n  border: 1px solid #a5f3ff;\n  border-radius: 5px;\n  color: #05141b;\n  background: linear-gradient(105deg, #83efff, #13b9e8);\n  box-shadow: 0 0 18px #13d5ff32;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: .76rem;\n  font-weight: 1000;\n  letter-spacing: .12em;\n}\n\n.wc-tourney-current-round .wc-tourney-fight-button:hover {\n  filter: brightness(1.12);\n  transform: translateY(-2px);\n}\n\n@keyframes wcCurrentMatchEnter {\n  from { opacity: 0; transform: translateY(22px) scale(.98); }\n  to { opacity: 1; transform: translateY(0) scale(1); }\n}\n\n/* Round-end presentation: eliminators -> next-round pairings -> ready prompt. */\n.wc-round-transition {\n  position: fixed;\n  z-index: 9500;\n  inset: 0;\n  display: grid;\n  place-items: center;\n  overflow-y: auto;\n  padding: 20px;\n  background:\n    radial-gradient(ellipse at 50% 10%, rgba(176, 127, 46, .28), transparent 54%),\n    rgba(3, 6, 8, .94);\n  backdrop-filter: blur(12px);\n  animation: wcRoundTransitionFade .35s ease both;\n}\n\n.wc-round-transition-panel {\n  width: min(1040px, 100%);\n  max-height: min(92vh, 940px);\n  overflow-y: auto;\n  padding: clamp(20px, 3vw, 38px);\n  border: 1px solid rgba(218, 183, 111, .72);\n  border-radius: 12px 4px;\n  color: #f4f0e5;\n  background:\n    radial-gradient(ellipse at 50% 0%, rgba(121, 87, 38, .35), transparent 52%),\n    linear-gradient(145deg, #1a1a14, #090d0c 65%, #11100b);\n  box-shadow: 0 30px 100px #000e, 0 0 0 5px #d0a85a16, 0 0 38px #d0a85a28;\n  text-align: center;\n  animation: wcRoundPanelEnter .5s cubic-bezier(.16, 1, .3, 1) both;\n}\n\n.wc-round-transition-kicker {\n  margin: 0 0 8px;\n  color: #e0be72;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: .68rem;\n  font-weight: 950;\n  letter-spacing: .2em;\n}\n\n.wc-round-transition-panel > h2,\n.wc-round-ready h2 {\n  margin: 0;\n  color: #ffe5a1;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: clamp(2rem, 6vw, 4.2rem);\n  font-weight: 1000;\n  letter-spacing: .09em;\n  text-shadow: 0 0 22px #c79b4e55, 3px 3px #5a3c17;\n}\n\n.wc-round-transition-caption {\n  margin: 8px 0 20px;\n  color: #b9b09e;\n  font-size: .75rem;\n  font-weight: 900;\n  letter-spacing: .16em;\n}\n\n.wc-round-eliminators {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n  width: min(690px, 100%);\n  margin: 0 auto 16px;\n}\n\n.wc-round-eliminator {\n  display: grid;\n  grid-template-columns: 38px 66px minmax(0, 1fr) auto;\n  align-items: center;\n  gap: 12px;\n  min-height: 76px;\n  padding: 5px 12px 5px 6px;\n  border: 1px solid #70434a88;\n  border-radius: 6px;\n  background: linear-gradient(100deg, #3a171d, #151310 78%);\n  text-align: left;\n  animation: wcEliminatorReveal .55s cubic-bezier(.16, 1, .3, 1) both;\n}\n\n.wc-round-eliminator-rank {\n  color: #c99e71;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: 1.05rem;\n  font-weight: 1000;\n  text-align: center;\n}\n\n.wc-round-eliminator img {\n  width: 62px;\n  height: 66px;\n  object-fit: contain;\n  object-position: center bottom;\n  filter: grayscale(.75) drop-shadow(0 3px 5px #0009);\n}\n\n.wc-round-eliminator strong {\n  overflow: hidden;\n  color: #f2dfd0;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: .95rem;\n  font-weight: 950;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.wc-round-eliminator small {\n  color: #ff8c9d;\n  font-size: .57rem;\n  font-weight: 1000;\n  letter-spacing: .14em;\n}\n\n.wc-round-transition-progress {\n  display: inline-block;\n  margin-top: 4px;\n  color: #a78e5c;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: .6rem;\n  font-weight: 900;\n  letter-spacing: .18em;\n  animation: wcRoundProgressPulse 1s ease-in-out infinite alternate;\n}\n\n.wc-round-standings {\n  display: flex;\n  flex-direction: column;\n  gap: 13px;\n  width: min(820px, 100%);\n  margin: 0 auto 16px;\n}\n\n.wc-round-standing-match {\n  position: relative;\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) 54px minmax(0, 1fr) 44px;\n  align-items: center;\n  gap: 10px;\n  min-height: 108px;\n  padding: 8px;\n  border: 1px solid #96783d88;\n  border-radius: 7px;\n  background: linear-gradient(105deg, #1e2920, #10150f 55%, #201a10);\n  animation: wcStandingReveal .55s cubic-bezier(.16, 1, .3, 1) both;\n}\n\n.wc-round-standing-fighter {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  min-width: 0;\n  text-align: left;\n}\n\n.wc-round-standing-fighter img {\n  flex: 0 0 auto;\n  width: 76px;\n  height: 88px;\n  object-fit: contain;\n  object-position: center bottom;\n  border: 1px solid #d7b86e55;\n  border-radius: 4px;\n  background: #0d120d;\n}\n\n.wc-round-standing-fighter strong {\n  overflow: hidden;\n  color: #f2e5bf;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: .88rem;\n  font-weight: 950;\n  text-overflow: ellipsis;\n}\n\n.wc-round-standing-match > span {\n  color: #e2c273;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: .9rem;\n  font-weight: 1000;\n}\n\n.wc-round-standing-fork {\n  position: relative;\n  height: 68px;\n}\n\n.wc-round-standing-fork i {\n  position: absolute;\n  left: 0;\n  width: 100%;\n  height: 2px;\n  background: #c9a85e;\n  box-shadow: 0 0 8px #c9a85e55;\n}\n\n.wc-round-standing-fork i:first-child { top: 10px; }\n.wc-round-standing-fork i:nth-child(2) { top: 56px; }\n.wc-round-standing-fork i:last-child {\n  top: 10px;\n  left: 50%;\n  width: 2px;\n  height: 48px;\n  background: linear-gradient(180deg, #c9a85e, #8d6c37);\n}\n\n.wc-round-ready {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 10px;\n  padding: clamp(18px, 4vw, 48px) 10px;\n  animation: wcRoundReadyEnter .8s cubic-bezier(.16, 1, .3, 1) both;\n}\n\n.wc-round-ready-emblem {\n  display: grid;\n  place-items: center;\n  width: 76px;\n  height: 76px;\n  border: 1px solid #e3c579;\n  border-radius: 50%;\n  color: #ffdf87;\n  background: radial-gradient(circle, #76602e, #18140c 72%);\n  box-shadow: 0 0 28px #d0a85a55, inset 0 0 16px #f9e0a333;\n  font-size: 2.8rem;\n}\n\n.wc-round-ready .wc-round-transition-caption {\n  margin: 0 0 8px;\n}\n\n.wc-round-ready button {\n  min-height: 52px;\n  padding: 12px 26px;\n  border: 1px solid #fff0ab;\n  border-radius: 6px 3px;\n  color: #151208;\n  background: linear-gradient(110deg, #fff0a1, #d9a83e);\n  box-shadow: 0 0 22px #e2bb5a44;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: .82rem;\n  font-weight: 1000;\n  letter-spacing: .14em;\n  cursor: pointer;\n  transition: transform .16s ease, filter .16s ease;\n}\n\n.wc-round-ready button:hover {\n  filter: brightness(1.1);\n  transform: translateY(-2px);\n}\n\n.wc-round-ready button span {\n  margin-left: 12px;\n  font-size: 1rem;\n}\n\n@keyframes wcRoundTransitionFade {\n  from { opacity: 0; }\n  to { opacity: 1; }\n}\n\n@keyframes wcRoundPanelEnter {\n  from { opacity: 0; transform: translateY(20px) scale(.97); }\n  to { opacity: 1; transform: translateY(0) scale(1); }\n}\n\n@keyframes wcEliminatorReveal {\n  from { opacity: 0; transform: translateX(-24px) scale(.97); }\n  to { opacity: 1; transform: translateX(0) scale(1); }\n}\n\n@keyframes wcStandingReveal {\n  from { opacity: 0; transform: translateY(18px) scale(.97); }\n  to { opacity: 1; transform: translateY(0) scale(1); }\n}\n\n@keyframes wcRoundReadyEnter {\n  0% { opacity: 0; transform: scale(.75); }\n  65% { opacity: 1; transform: scale(1.04); }\n  100% { opacity: 1; transform: scale(1); }\n}\n\n@keyframes wcRoundProgressPulse {\n  from { opacity: .55; }\n  to { opacity: 1; }\n}\n\n@media (max-width: 900px) {\n  .wc-tourney-current-round .wc-tourney-matchup {\n    grid-template-columns: minmax(0, 1fr) 58px minmax(125px, .3fr);\n    gap: 8px;\n  }\n\n  .wc-tourney-current-round .wc-tourney-fighter {\n    grid-template-columns: 112px minmax(0, 1fr);\n    height: 140px;\n    min-height: 140px;\n    gap: 10px;\n  }\n\n  .wc-tourney-bracket-fork,\n  .wc-tourney-advance-slot {\n    min-height: 290px;\n  }\n\n  .wc-tourney-advance-portrait,\n  .wc-tourney-advance-pending {\n    height: 128px;\n  }\n}\n\n@media (max-width: 640px) {\n  .wc-tourney-bracket-title {\n    align-items: flex-start;\n    flex-direction: column;\n    gap: 9px;\n  }\n\n  .wc-tourney-current-round-title {\n    position: static;\n    flex-wrap: wrap;\n    min-height: 54px;\n    gap: 5px 10px;\n  }\n\n  .wc-tourney-current-round .wc-tourney-matchup {\n    grid-template-columns: minmax(0, 1fr) 30px minmax(88px, .33fr);\n    gap: 5px;\n  }\n\n  .wc-tourney-current-round .wc-tourney-fighter {\n    grid-template-columns: 88px minmax(0, 1fr);\n    height: 118px;\n    min-height: 118px;\n    gap: 7px;\n    padding: 5px;\n  }\n\n  .wc-tourney-current-round .wc-tourney-portrait {\n    min-height: 106px;\n  }\n\n  .wc-tourney-fighter-meta {\n    gap: 5px;\n  }\n\n  .wc-tourney-fighter-seed {\n    font-size: .44rem;\n    letter-spacing: .08em;\n  }\n\n  .wc-tourney-fighter-name {\n    font-size: .9rem;\n  }\n\n  .wc-tourney-current-round .wc-tourney-fighter-tags small {\n    min-height: 18px;\n    padding: 3px 5px;\n    font-size: .45rem;\n  }\n\n  .wc-tourney-bracket-fork {\n    min-height: 244px;\n  }\n\n  .wc-tourney-advance-slot {\n    min-height: 244px;\n    gap: 5px;\n    padding: 5px 3px;\n  }\n\n  .wc-tourney-advance-slot > span {\n    font-size: .44rem;\n  }\n\n  .wc-tourney-advance-portrait,\n  .wc-tourney-advance-pending {\n    height: 100px;\n  }\n\n  .wc-tourney-advance-slot > strong {\n    font-size: .69rem;\n    overflow-wrap: anywhere;\n  }\n\n  .wc-tourney-advance-slot > small {\n    font-size: .4rem;\n  }\n\n  .wc-tourney-current-round .wc-tourney-fight-button {\n    width: 100%;\n    min-height: 38px;\n    font-size: .65rem;\n  }\n\n  .wc-round-transition {\n    padding: 9px;\n  }\n\n  .wc-round-transition-panel {\n    padding: 16px 11px;\n  }\n\n  .wc-round-eliminator {\n    grid-template-columns: 26px 54px minmax(0, 1fr) auto;\n    gap: 7px;\n    min-height: 65px;\n    padding-right: 7px;\n  }\n\n  .wc-round-eliminator img {\n    width: 52px;\n    height: 56px;\n  }\n\n  .wc-round-eliminator strong {\n    font-size: .76rem;\n  }\n\n  .wc-round-eliminator small {\n    font-size: .44rem;\n  }\n\n  .wc-round-standing-match {\n    grid-template-columns: minmax(0, 1fr) 26px minmax(0, 1fr);\n    gap: 5px;\n    padding: 6px;\n  }\n\n  .wc-round-standing-fighter {\n    flex-direction: column;\n    gap: 5px;\n    text-align: center;\n  }\n\n  .wc-round-standing-fighter img {\n    width: 65px;\n    height: 72px;\n  }\n\n  .wc-round-standing-fighter strong {\n    max-width: 100%;\n    font-size: .66rem;\n  }\n\n  .wc-round-standing-match > span {\n    font-size: .7rem;\n  }\n\n  .wc-round-standing-fork {\n    display: none;\n  }\n}\n\n@media (max-height: 760px) and (min-width: 641px) {\n  .wc-tourney-current-round .wc-tourney-fighter {\n    height: 132px;\n    min-height: 132px;\n  }\n\n  .wc-tourney-current-round .wc-tourney-matchup {\n    gap: 10px;\n  }\n\n  .wc-tourney-bracket-fork,\n  .wc-tourney-advance-slot {\n    min-height: 274px;\n  }\n\n  .wc-tourney-advance-portrait,\n  .wc-tourney-advance-pending {\n    height: 124px;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .wc-tourney-current-round .wc-tourney-match,\n  .wc-round-transition *,\n  .wc-round-transition *::before,\n  .wc-round-transition *::after {\n    animation-duration: .01ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: .01ms !important;\n  }\n}\n\n\n/* Animate the fork toward the advancing fighter once a result is confirmed. */\n.wc-tourney-current-round .wc-tourney-match.is-complete .wc-tourney-bracket-fork .fork-upper,\n.wc-tourney-current-round .wc-tourney-match.is-complete .wc-tourney-bracket-fork .fork-lower {\n  animation: wcBracketForkIn .45s ease-out both;\n}\n\n.wc-tourney-current-round .wc-tourney-match.is-complete .wc-tourney-bracket-fork .fork-stem {\n  animation: wcBracketStemIn .42s .18s ease-out both;\n}\n\n.wc-tourney-current-round .wc-tourney-match.is-complete .wc-tourney-bracket-fork .fork-out {\n  animation: wcBracketForkIn .42s .32s ease-out both;\n}\n\n.wc-tourney-current-round .wc-tourney-match.is-complete .wc-tourney-advance-slot.has-winner {\n  animation: wcAdvanceWinnerReveal .55s .34s cubic-bezier(.16, 1, .3, 1) both;\n}\n\n@keyframes wcBracketForkIn {\n  from { transform: scaleX(.05); opacity: .25; }\n  to { transform: scaleX(1); opacity: 1; }\n}\n\n@keyframes wcBracketStemIn {\n  from { transform: scaleY(.05); opacity: .25; }\n  to { transform: scaleY(1); opacity: 1; }\n}\n\n@keyframes wcAdvanceWinnerReveal {\n  from { opacity: .3; transform: translateX(-10px) scale(.96); }\n  to { opacity: 1; transform: translateX(0) scale(1); }\n}\n\n\n/* =========================================================\n   VERTICAL BRACKET TREE — side-by-side contender cards,\n   straight downward fork, then advancing winner.\n   ========================================================= */\n.wc-tourney-current-round .wc-tourney-matchup.wc-tourney-vertical-bracket {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 0;\n  padding: 13px 0 3px;\n}\n\n.wc-tourney-head-to-head {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) 46px minmax(0, 1fr);\n  align-items: stretch;\n  gap: clamp(6px, 1.4vw, 16px);\n  width: 100%;\n}\n\n.wc-tourney-current-round .wc-tourney-head-to-head .wc-tourney-fighter {\n  height: clamp(140px, 17vh, 184px);\n  min-height: 140px;\n  grid-template-columns: clamp(104px, 14vw, 172px) minmax(0, 1fr);\n  gap: 12px;\n  padding: 7px;\n}\n\n.wc-tourney-current-round .wc-tourney-head-to-head .wc-tourney-portrait {\n  min-height: 0;\n  height: 100%;\n  width: 100%;\n  place-items: end center;\n}\n\n.wc-tourney-current-round .wc-tourney-head-to-head .wc-tourney-portrait img {\n  width: 100%;\n  height: 100%;\n  object-fit: contain;\n  object-position: center bottom;\n}\n\n.wc-tourney-head-to-head .wc-tourney-versus {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  min-height: 0;\n  color: #d9ba73;\n  font-size: .7rem;\n  writing-mode: vertical-rl;\n}\n\n.wc-tourney-head-to-head .wc-tourney-versus::before,\n.wc-tourney-head-to-head .wc-tourney-versus::after {\n  content: \"\";\n  width: 1px;\n  height: 100%;\n  min-height: 24px;\n  background: linear-gradient(180deg, transparent, #c09b5a, transparent);\n}\n\n.wc-tourney-vertical-fork {\n  position: relative;\n  width: 100%;\n  height: 38px;\n  flex: 0 0 38px;\n  margin: 0 auto;\n}\n\n.wc-tourney-vertical-fork i {\n  position: absolute;\n  display: block;\n  background: linear-gradient(180deg, #e0c078, #8e713d);\n  box-shadow: 0 0 9px #d5ae5d45;\n}\n\n.wc-tourney-vertical-fork .fork-left,\n.wc-tourney-vertical-fork .fork-right {\n  top: 0;\n  width: 2px;\n  height: 48%;\n}\n\n.wc-tourney-vertical-fork .fork-left { left: 25%; }\n.wc-tourney-vertical-fork .fork-right { right: 25%; }\n\n.wc-tourney-vertical-fork .fork-join {\n  top: 46%;\n  left: 25%;\n  width: 50%;\n  height: 2px;\n  background: linear-gradient(90deg, #8e713d, #e0c078, #8e713d);\n}\n\n.wc-tourney-vertical-fork .fork-stem {\n  top: 46%;\n  bottom: 0;\n  left: calc(50% - 1px);\n  width: 2px;\n  background: linear-gradient(180deg, #e0c078, #8e713d);\n}\n\n.wc-tourney-current-round .wc-tourney-advance-slot {\n  display: grid;\n  grid-template-columns: auto 78px minmax(0, 1fr);\n  grid-template-rows: auto auto;\n  align-items: center;\n  justify-content: stretch;\n  gap: 3px 12px;\n  width: min(540px, 76%);\n  min-height: 92px;\n  padding: 8px 14px;\n  border: 1px solid rgba(201, 168, 100, .5);\n  border-radius: 7px;\n  background: linear-gradient(100deg, rgba(38, 31, 19, .95), rgba(11, 14, 11, .98));\n  box-shadow: 0 6px 16px #0006, inset 0 1px #fff1;\n}\n\n.wc-tourney-current-round .wc-tourney-advance-slot > span {\n  grid-column: 1 / -1;\n  color: #c1a56c;\n  font-size: .56rem;\n  font-weight: 950;\n  letter-spacing: .14em;\n  text-align: center;\n}\n\n.wc-tourney-current-round .wc-tourney-advance-portrait,\n.wc-tourney-current-round .wc-tourney-advance-pending {\n  grid-column: 2;\n  grid-row: 2;\n  width: 72px;\n  height: 67px;\n  border: 1px solid #d5b56f88;\n}\n\n.wc-tourney-current-round .wc-tourney-advance-slot > strong {\n  grid-column: 3;\n  grid-row: 2;\n  color: #f5d991;\n  font-size: clamp(.8rem, 1.2vw, 1.03rem);\n  text-align: left;\n}\n\n.wc-tourney-current-round .wc-tourney-advance-slot > small {\n  grid-column: 1;\n  grid-row: 2;\n  color: #b09255;\n  font-size: .48rem;\n  font-weight: 900;\n  letter-spacing: .07em;\n  text-align: right;\n}\n\n.wc-tourney-current-round .wc-tourney-advance-pending {\n  gap: 0;\n}\n\n.wc-tourney-current-round .wc-tourney-advance-pending span {\n  font-size: 1.65rem;\n  line-height: 1;\n}\n\n.wc-tourney-current-round .wc-tourney-advance-pending strong {\n  font-size: .48rem;\n}\n\n.wc-tourney-current-round .wc-tourney-advance-pending small {\n  display: none;\n}\n\n.wc-tourney-current-round .wc-tourney-match.is-complete .wc-tourney-vertical-fork .fork-left,\n.wc-tourney-current-round .wc-tourney-match.is-complete .wc-tourney-vertical-fork .fork-right {\n  animation: wcVerticalForkDown .45s ease-out both;\n}\n\n.wc-tourney-current-round .wc-tourney-match.is-complete .wc-tourney-vertical-fork .fork-join {\n  animation: wcVerticalForkAcross .4s .16s ease-out both;\n}\n\n.wc-tourney-current-round .wc-tourney-match.is-complete .wc-tourney-vertical-fork .fork-stem {\n  animation: wcVerticalForkDown .4s .3s ease-out both;\n  transform-origin: top;\n}\n\n@keyframes wcVerticalForkDown {\n  from { transform: scaleY(.05); opacity: .25; }\n  to { transform: scaleY(1); opacity: 1; }\n}\n\n@keyframes wcVerticalForkAcross {\n  from { transform: scaleX(.05); opacity: .25; }\n  to { transform: scaleX(1); opacity: 1; }\n}\n\n/* Dramatic, sequential eliminator reveal. The next fighter waits for the\n   previous fighter's K.O. stamp and portrait animation to complete. */\n.wc-round-eliminator {\n  position: relative;\n  grid-template-columns: 38px 76px minmax(0, 1fr) auto 56px;\n  min-height: 88px;\n  border-color: rgba(255, 72, 92, .58);\n  background:\n    radial-gradient(ellipse at 15% 50%, rgba(255, 38, 67, .2), transparent 45%),\n    linear-gradient(100deg, #45151e, #17110f 78%);\n  box-shadow: inset 4px 0 #f04459, 0 8px 22px #0008;\n  animation: wcEliminatorReveal 1.12s cubic-bezier(.12, .82, .22, 1) both;\n}\n\n.wc-round-eliminator::after {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  pointer-events: none;\n  background: linear-gradient(105deg, transparent 20%, rgba(255, 255, 255, .18) 48%, transparent 72%);\n  transform: translateX(-120%);\n  animation: wcEliminatorImpact 1.15s calc(var(--reveal-order, 0) * 1.12s + .2s) ease-out both;\n}\n\n.wc-round-eliminator img {\n  width: 72px;\n  height: 76px;\n  filter: grayscale(.85) contrast(1.25) drop-shadow(0 0 9px #ff314966);\n  animation: wcEliminatorPortrait 1s cubic-bezier(.16, 1, .3, 1) both;\n}\n\n.wc-round-eliminator strong {\n  color: #fff0eb;\n  font-size: 1rem;\n  text-shadow: 0 0 13px #ff315944;\n}\n\n.wc-round-eliminator small {\n  color: #ff8796;\n  font-size: .62rem;\n  letter-spacing: .18em;\n}\n\n.wc-round-eliminator-ko {\n  display: grid;\n  place-items: center;\n  width: 50px;\n  height: 50px;\n  border: 2px solid #ff7184;\n  border-radius: 50%;\n  color: #fff;\n  background: radial-gradient(circle, #a62237, #3d0d18 72%);\n  box-shadow: 0 0 18px #ff315977, inset 0 0 12px #fff2;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: .92rem;\n  font-weight: 1000;\n  transform: rotate(-12deg) scale(.55);\n  opacity: 0;\n  animation: wcKoStamp  .52s calc(var(--reveal-order, 0) * 1.12s + .5s) cubic-bezier(.16, 1, .3, 1) forwards;\n}\n\n@keyframes wcEliminatorReveal {\n  0% { opacity: 0; transform: translateX(-42px) scale(.92); filter: brightness(2.2); }\n  38% { opacity: 1; transform: translateX(7px) scale(1.015); filter: brightness(1.3); }\n  58% { transform: translateX(-3px) scale(1); filter: brightness(1); }\n  100% { opacity: 1; transform: translateX(0) scale(1); filter: brightness(.9); }\n}\n\n@keyframes wcEliminatorPortrait {\n  0% { opacity: 0; transform: translateY(-10px) scale(1.22); filter: grayscale(0) brightness(1.7); }\n  45% { opacity: 1; transform: translateY(0) scale(1); }\n  100% { opacity: .78; filter: grayscale(.85) contrast(1.25); }\n}\n\n@keyframes wcEliminatorImpact {\n  0% { transform: translateX(-120%); opacity: 0; }\n  30% { opacity: .8; }\n  100% { transform: translateX(120%); opacity: 0; }\n}\n\n@keyframes wcKoStamp {\n  0% { opacity: 0; transform: rotate(-18deg) scale(1.8); }\n  65% { opacity: 1; transform: rotate(-10deg) scale(.9); }\n  100% { opacity: 1; transform: rotate(-10deg) scale(1); }\n}\n\n/* Central start-tournament prompt overlays a live bracket preview. */\n.wc-tourney-start-backdrop {\n  position: fixed;\n  z-index: 9000;\n  inset: 0;\n  display: grid;\n  place-items: center;\n  overflow-y: auto;\n  padding: 18px;\n  background: rgba(3, 5, 7, .76);\n  backdrop-filter: blur(5px);\n  animation: wcRoundTransitionFade .3s ease both;\n}\n\n.wc-tourney-start-dialog {\n  width: min(900px, 100%);\n  max-height: min(92vh, 900px);\n  overflow-y: auto;\n  padding: clamp(20px, 3vw, 34px);\n  border: 1px solid #f0d68b;\n  border-radius: 13px 4px;\n  color: #f6efdd;\n  background:\n    radial-gradient(ellipse at 50% 0%, rgba(220, 173, 81, .26), transparent 53%),\n    linear-gradient(145deg, #242016, #0b0e0c 70%);\n  box-shadow: 0 26px 90px #000e, 0 0 0 5px #d1a84b22, 0 0 45px #dfba6844;\n  text-align: center;\n  animation: wcRoundPanelEnter .5s cubic-bezier(.16, 1, .3, 1) both;\n}\n\n.wc-tourney-start-kicker {\n  margin: 0 0 8px;\n  color: #f0d48c;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: .62rem;\n  font-weight: 1000;\n  letter-spacing: .2em;\n}\n\n.wc-tourney-start-dialog > h2 {\n  margin: 0;\n  color: #ffedbd;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: clamp(1.8rem, 5vw, 3.4rem);\n  font-weight: 1000;\n  letter-spacing: .08em;\n  text-shadow: 0 0 22px #dfb85d55;\n}\n\n.wc-tourney-start-copy {\n  margin: 8px 0 18px;\n  color: #d0c4a8;\n  font-size: .78rem;\n}\n\n.wc-tourney-start-preview-heading {\n  display: flex;\n  justify-content: space-between;\n  gap: 8px;\n  padding: 8px 11px;\n  border: 1px solid #b18a4c66;\n  border-bottom: 0;\n  border-radius: 6px 6px 0 0;\n  color: #e8d299;\n  background: #1d1b13;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: .6rem;\n  font-weight: 950;\n  letter-spacing: .12em;\n  text-align: left;\n}\n\n.wc-tourney-start-preview {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: 8px;\n  padding: 10px;\n  border: 1px solid #b18a4c66;\n  border-radius: 0 0 6px 6px;\n  background: rgba(5, 7, 7, .5);\n}\n\n.wc-tourney-start-match {\n  position: relative;\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) 28px minmax(0, 1fr) 16px;\n  align-items: center;\n  gap: 4px;\n  min-width: 0;\n  min-height: 108px;\n  padding: 18px 5px 5px;\n  border: 1px solid #ffffff18;\n  border-radius: 5px;\n  background: linear-gradient(110deg, #22251c, #10120e);\n}\n\n.wc-tourney-start-match-number {\n  position: absolute;\n  top: 5px;\n  left: 8px;\n  color: #bba16b;\n  font-size: .48rem;\n  font-weight: 950;\n  letter-spacing: .12em;\n}\n\n.wc-tourney-start-entrant {\n  min-width: 0;\n  display: grid;\n  grid-template-columns: 49px minmax(0, 1fr);\n  grid-template-rows: 1fr auto;\n  align-items: center;\n  gap: 2px 6px;\n  text-align: left;\n}\n\n.wc-tourney-start-portrait {\n  grid-row: 1 / span 2;\n  width: 49px;\n  height: 70px;\n  display: grid;\n  place-items: end center;\n  overflow: hidden;\n  border: 1px solid #c8a96255;\n  border-radius: 3px;\n  color: #d1b46f;\n  background: radial-gradient(ellipse at 50% 100%, #bd9b5225, transparent 65%), #12140f;\n  font-size: 2rem;\n  font-weight: 1000;\n}\n\n.wc-tourney-start-portrait img {\n  width: 100%;\n  height: 100%;\n  object-fit: contain;\n  object-position: center bottom;\n}\n\n.wc-tourney-start-entrant strong {\n  min-width: 0;\n  overflow: hidden;\n  color: #f0e4c6;\n  font-size: .58rem;\n  font-weight: 900;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.wc-tourney-start-entrant small {\n  color: #63dfff;\n  font-size: .44rem;\n  font-weight: 1000;\n  letter-spacing: .1em;\n}\n\n.wc-tourney-start-vs {\n  color: #e5c77d;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: .62rem;\n}\n\n.wc-tourney-start-advance {\n  display: grid;\n  place-items: center;\n  height: 68px;\n  border-left: 2px solid #b48e4c;\n  color: #f0d488;\n  font-size: 1.1rem;\n}\n\n.wc-tourney-start-footer {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 13px;\n  margin-top: 18px;\n}\n\n.wc-tourney-start-footer > span {\n  color: #c5ad78;\n  font-size: .59rem;\n  font-weight: 900;\n  letter-spacing: .16em;\n}\n\n.wc-tourney-start-footer button {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 12px;\n  width: min(420px, 100%);\n  min-height: 58px;\n  border: 1px solid #fff0ad;\n  border-radius: 7px 3px;\n  color: #1a1408;\n  background: linear-gradient(110deg, #fff3bd, #e5bd64 60%, #b98537);\n  box-shadow: 0 0 0 3px #e3bc6b23, 0 0 28px #efcb774f, 0 7px 20px #0009;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: .92rem;\n  font-weight: 1000;\n  letter-spacing: .15em;\n  cursor: pointer;\n  transition: transform .16s ease, filter .16s ease, box-shadow .16s ease;\n}\n\n.wc-tourney-start-footer button:hover:not(:disabled) {\n  filter: brightness(1.1);\n  transform: translateY(-2px) scale(1.015);\n  box-shadow: 0 0 0 4px #e3bc6b33, 0 0 38px #efcb7777, 0 10px 25px #000b;\n}\n\n.wc-tourney-start-footer button:disabled {\n  opacity: .75;\n  cursor: wait;\n}\n\n.wc-tourney-start-footer button > span {\n  font-size: 1.1rem;\n}\n\n.wc-tourney-start-spinner {\n  width: 16px;\n  height: 16px;\n  border: 2px solid #2a2519;\n  border-top-color: transparent;\n  border-radius: 50%;\n  animation: wcStartSpin .7s linear infinite;\n}\n\n@keyframes wcStartSpin { to { transform: rotate(360deg); } }\n\n/* Full standings: champion podium at left, every other rank in a right rail. */\n.wc-tourney-final-standings-layout {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) minmax(235px, 310px);\n  align-items: stretch;\n  gap: 18px;\n  width: min(100%, 1150px);\n  margin: 0 auto;\n}\n\n.wc-tourney-final-standings-layout .wc-podium {\n  min-width: 0;\n  align-self: center;\n}\n\n.wc-tourney-placement-list {\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n  padding: 12px;\n  border: 1px solid rgba(205, 168, 94, .42);\n  border-radius: 7px;\n  background: linear-gradient(155deg, #211d14, #0b0d0b 75%);\n  box-shadow: 0 10px 26px #0007, inset 0 1px #fff1;\n}\n\n.wc-tourney-placement-list > header {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n  padding: 0 3px 10px;\n  border-bottom: 1px solid #d1ac6544;\n  text-align: left;\n}\n\n.wc-tourney-placement-list > header span {\n  color: #c7a76a;\n  font-size: .54rem;\n  font-weight: 950;\n  letter-spacing: .18em;\n}\n\n.wc-tourney-placement-list > header strong {\n  color: #f4e1b2;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: .82rem;\n  letter-spacing: .08em;\n}\n\n.wc-tourney-placement-entries {\n  display: flex;\n  flex-direction: column;\n  gap: 7px;\n  padding-top: 9px;\n}\n\n.wc-tourney-placement-entry {\n  display: grid;\n  grid-template-columns: 39px 54px minmax(0, 1fr);\n  align-items: center;\n  gap: 8px;\n  min-height: 66px;\n  padding: 5px;\n  border: 1px solid #ffffff18;\n  border-radius: 4px;\n  background: linear-gradient(100deg, #2a2418, #10120e);\n}\n\n.wc-tourney-placement-rank {\n  color: #e3c77f;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: .78rem;\n  font-weight: 1000;\n  text-align: center;\n}\n\n.wc-tourney-placement-image {\n  width: 50px;\n  height: 56px;\n  display: grid;\n  place-items: end center;\n  overflow: hidden;\n  border: 1px solid #b89a5e55;\n  border-radius: 3px;\n  background: #11140f;\n}\n\n.wc-tourney-placement-image img {\n  width: 100%;\n  height: 100%;\n  object-fit: contain;\n  object-position: center bottom;\n}\n\n.wc-tourney-placement-name {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n  min-width: 0;\n  text-align: left;\n}\n\n.wc-tourney-placement-name strong {\n  overflow: hidden;\n  color: #eee2c5;\n  font-size: .72rem;\n  font-weight: 900;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.wc-tourney-placement-name small {\n  color: #9e8a60;\n  font-size: .47rem;\n  font-weight: 900;\n  letter-spacing: .12em;\n}\n\n@media (max-width: 760px) {\n  .wc-tourney-head-to-head {\n    grid-template-columns: minmax(0, 1fr) 30px minmax(0, 1fr);\n    gap: 5px;\n  }\n\n  .wc-tourney-current-round .wc-tourney-head-to-head .wc-tourney-fighter {\n    height: 122px;\n    min-height: 122px;\n    grid-template-columns: 82px minmax(0, 1fr);\n    gap: 6px;\n    padding: 5px;\n  }\n\n  .wc-tourney-current-round .wc-tourney-head-to-head .wc-tourney-fighter-name {\n    font-size: .77rem;\n  }\n\n  .wc-tourney-current-round .wc-tourney-head-to-head .wc-tourney-fighter-seed {\n    font-size: .38rem;\n    letter-spacing: .05em;\n  }\n\n  .wc-tourney-current-round .wc-tourney-advance-slot {\n    width: min(540px, 95%);\n  }\n\n  .wc-tourney-final-standings-layout {\n    grid-template-columns: minmax(0, 1fr);\n  }\n\n  .wc-tourney-final-standings-layout .wc-podium {\n    width: min(100%, 560px);\n    margin-inline: auto;\n  }\n\n  .wc-tourney-placement-entries {\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .wc-tourney-start-backdrop {\n    padding: 9px;\n  }\n\n  .wc-tourney-start-dialog {\n    padding: 16px 10px;\n  }\n\n  .wc-tourney-start-preview {\n    grid-template-columns: minmax(0, 1fr);\n  }\n\n  .wc-tourney-start-match {\n    min-height: 96px;\n  }\n\n  .wc-round-eliminator {\n    grid-template-columns: 28px 58px minmax(0, 1fr) auto 42px;\n    gap: 6px;\n    min-height: 70px;\n  }\n\n  .wc-round-eliminator img {\n    width: 55px;\n    height: 60px;\n  }\n\n  .wc-round-eliminator-ko {\n    width: 39px;\n    height: 39px;\n    font-size: .72rem;\n  }\n}\n\n\n/* The extended placement rail makes the final results page scroll instead of clipping. */\n.wc-tournament-results {\n  min-height: 0;\n  height: 100dvh;\n  overflow-x: hidden;\n  overflow-y: auto;\n  justify-content: flex-start;\n  padding-bottom: 26px;\n  scrollbar-color: #98763f #171511;\n  scrollbar-width: thin;\n}\n\n.wc-tourney-final-standings-layout {\n  flex: 0 0 auto;\n}\n\n.wc-tourney-placement-list {\n  align-self: stretch;\n}\n\n.wc-tourney-vertical-fork .fork-left,\n.wc-tourney-vertical-fork .fork-right {\n  transform-origin: top center;\n}\n\n@media (max-height: 860px) and (min-width: 761px) {\n  .wc-tournament-results {\n    gap: 7px;\n    padding-top: 10px;\n  }\n\n  .wc-tournament-results .wc-podium-place {\n    height: clamp(150px, 24vh, 205px);\n  }\n\n  .wc-tournament-results .wc-podium-place.place-1 {\n    height: clamp(185px, 29vh, 250px);\n  }\n\n  .wc-tournament-results .wc-podium-place.place-3 {\n    height: clamp(135px, 21vh, 180px);\n  }\n}\n\n\n.wc-tourney-start-footer .wc-tourney-start-cancel {\n  width: auto;\n  min-height: 32px;\n  padding: 5px 14px;\n  border: 1px solid #9d875c66;\n  color: #b8aa8d;\n  background: rgba(17, 17, 13, .7);\n  box-shadow: none;\n  font-size: .55rem;\n  letter-spacing: .12em;\n}\n\n.wc-tourney-start-footer .wc-tourney-start-cancel:hover:not(:disabled) {\n  border-color: #d8bd7c;\n  color: #f0dfb7;\n  background: rgba(49, 40, 23, .9);\n  box-shadow: none;\n}\n\n\n/* Current-round board: keep the view focused on the active stage and give\n   fighter artwork enough room to read clearly at a glance. */\n.wc-tourney-single-round {\n  width: min(100%, 1180px);\n  flex: 1 1 auto;\n  min-height: 0;\n  margin: 0 auto;\n  overflow-x: hidden;\n  overflow-y: auto;\n  padding: 2px 8px 12px;\n  scrollbar-color: #98763f #171511;\n  scrollbar-width: thin;\n}\n\n.wc-tourney-single-round > .wc-tourney-round {\n  min-height: 100%;\n  display: flex;\n  flex-direction: column;\n  gap: 12px;\n}\n\n.wc-tourney-single-round .wc-tourney-round-title {\n  flex: 0 0 48px;\n  min-height: 48px;\n  gap: clamp(8px, 2vw, 18px);\n  border: 1px solid rgba(214, 174, 93, .3);\n  border-radius: 6px;\n  background: linear-gradient(100deg, rgba(22, 19, 13, .98), rgba(35, 28, 17, .98), rgba(22, 19, 13, .98));\n  box-shadow: 0 7px 17px #0007;\n}\n\n.wc-tourney-single-round .wc-tourney-round-title h2 {\n  color: #f7d98b;\n  font-size: clamp(.88rem, 1.5vw, 1.2rem);\n  letter-spacing: .17em;\n}\n\n.wc-tourney-single-round .wc-tourney-round-matches {\n  display: grid;\n  flex: 1 0 auto;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  grid-auto-rows: minmax(150px, 1fr);\n  gap: 12px;\n  min-height: 0;\n  padding: 2px 0 8px;\n}\n\n.wc-tourney-single-round .wc-tourney-match {\n  min-width: 0;\n  min-height: 150px;\n  flex: initial;\n  justify-content: center;\n  gap: 7px;\n  padding: 10px 12px;\n  border-radius: 8px;\n  box-shadow: 0 9px 22px #0007, inset 0 1px #fff1;\n}\n\n.wc-tourney-single-round .wc-tourney-match-heading {\n  min-height: 17px;\n  font-size: .55rem;\n  letter-spacing: .1em;\n}\n\n.wc-tourney-single-round .wc-tourney-matchup {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr) 34px minmax(0, 1fr);\n  align-items: stretch;\n  gap: 7px;\n  min-height: 0;\n  padding: 3px 0;\n}\n\n.wc-tourney-single-round .wc-tourney-fighter {\n  height: 104px;\n  min-height: 104px;\n  display: grid;\n  grid-template-columns: minmax(70px, 34%) minmax(0, 1fr);\n  grid-template-rows: 1fr auto;\n  align-items: center;\n  gap: 3px 7px;\n  padding: 5px;\n  overflow: hidden;\n  border-radius: 6px;\n}\n\n.wc-tourney-single-round .wc-tourney-portrait {\n  grid-row: 1 / span 2;\n  width: 100%;\n  height: 92px;\n  min-width: 0;\n  flex: initial;\n  border-radius: 4px;\n  background:\n    radial-gradient(ellipse at 50% 20%, rgba(228, 192, 119, .2), transparent 72%),\n    linear-gradient(145deg, #302a20, #11100e);\n}\n\n.wc-tourney-single-round .wc-tourney-portrait img {\n  width: 100%;\n  height: 100%;\n  object-fit: contain;\n  object-position: center bottom;\n  padding: 1px;\n}\n\n.wc-tourney-single-round .wc-tourney-fighter-name {\n  align-self: end;\n  font-size: clamp(.62rem, .8vw, .78rem);\n  line-height: 1.12;\n}\n\n.wc-tourney-single-round .wc-tourney-fighter small {\n  justify-self: start;\n  max-width: 100%;\n  padding: 3px 5px;\n  font-size: .43rem;\n}\n\n.wc-tourney-single-round .wc-tourney-versus {\n  align-self: center;\n  width: 34px;\n  min-width: 34px;\n  font-size: .67rem;\n}\n\n.wc-tourney-single-round .wc-tourney-fight-button {\n  min-height: 27px;\n  padding: 4px 12px;\n  font-size: .56rem !important;\n}\n\n.wc-tourney-single-round .wc-tourney-winner-line {\n  padding-top: 4px;\n  font-size: .5rem;\n}\n\n@media (max-width: 900px) {\n  .wc-tourney-single-round .wc-tourney-round-matches {\n    grid-template-columns: minmax(0, 1fr);\n    grid-auto-rows: auto;\n  }\n}\n\n@media (max-width: 700px) {\n  .wc-tourney-single-round {\n    padding: 0 2px 8px;\n  }\n\n  .wc-tourney-single-round .wc-tourney-round-title {\n    flex-wrap: wrap;\n    flex: 0 0 auto;\n    min-height: 42px;\n    padding: 6px;\n    gap: 5px 9px;\n  }\n\n  .wc-tourney-single-round .wc-tourney-round-title span,\n  .wc-tourney-single-round .wc-tourney-round-title small {\n    font-size: .43rem;\n  }\n\n  .wc-tourney-single-round .wc-tourney-round-title h2 {\n    font-size: .75rem;\n  }\n\n  .wc-tourney-single-round .wc-tourney-match {\n    min-height: 130px;\n    padding: 8px 7px;\n  }\n\n  .wc-tourney-single-round .wc-tourney-matchup {\n    grid-template-columns: minmax(0, 1fr) 27px minmax(0, 1fr);\n    gap: 4px;\n  }\n\n  .wc-tourney-single-round .wc-tourney-fighter {\n    height: 90px;\n    min-height: 90px;\n    grid-template-columns: minmax(55px, 35%) minmax(0, 1fr);\n    gap: 3px 5px;\n    padding: 4px;\n  }\n\n  .wc-tourney-single-round .wc-tourney-portrait {\n    height: 80px;\n  }\n\n  .wc-tourney-single-round .wc-tourney-fighter-name {\n    font-size: .58rem;\n  }\n\n  .wc-tourney-single-round .wc-tourney-versus {\n    width: 27px;\n    min-width: 27px;\n    font-size: .54rem;\n  }\n}\n\n/* One-at-a-time placement reveals with a centered K.O. impact popup. */\n.wc-round-elimination-stage {\n  position: relative;\n  display: grid;\n  place-items: center;\n  width: min(760px, 100%);\n  min-height: 330px;\n  margin: 0 auto 14px;\n  overflow: hidden;\n  border: 1px solid rgba(255, 91, 109, .42);\n  border-radius: 10px;\n  background:\n    radial-gradient(ellipse at 50% 44%, rgba(204, 39, 57, .22), transparent 56%),\n    linear-gradient(145deg, #281117, #0d100e 72%);\n  box-shadow: inset 0 0 42px #0009, 0 12px 30px #0008;\n  animation: wcEliminatorReveal .55s cubic-bezier(.16, 1, .3, 1) both;\n}\n\n.wc-round-eliminator-spotlight {\n  position: relative;\n  z-index: 1;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 5px;\n  min-width: 0;\n  padding: 17px 20px 15px;\n  text-align: center;\n}\n\n.wc-round-eliminator-place {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  min-height: 30px;\n  padding: 5px 14px;\n  border: 1px solid #e6c778;\n  border-radius: 4px;\n  color: #ffe5a1;\n  background: linear-gradient(100deg, #4c3519, #211910);\n  box-shadow: 0 0 16px #e6c77827;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: .85rem;\n  font-weight: 1000;\n  letter-spacing: .16em;\n}\n\n.wc-round-eliminator-place.is-pending {\n  border-color: #ff7180;\n  color: #ffd0d5;\n  background: linear-gradient(100deg, #4b1c25, #211114);\n}\n\n.wc-round-eliminator-spotlight img {\n  width: 164px;\n  height: 178px;\n  object-fit: contain;\n  object-position: center bottom;\n  filter: drop-shadow(0 8px 14px #000c) drop-shadow(0 0 12px #f34a5b55);\n}\n\n.wc-round-eliminator-spotlight strong {\n  max-width: min(90vw, 560px);\n  overflow: hidden;\n  color: #fff2e8;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: clamp(1rem, 2vw, 1.4rem);\n  font-weight: 1000;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  text-shadow: 0 2px 10px #000;\n}\n\n.wc-round-eliminator-spotlight small {\n  color: #c7a8a0;\n  font-size: .57rem;\n  font-weight: 950;\n  letter-spacing: .15em;\n}\n\n.wc-round-ko-popup {\n  position: fixed;\n  z-index: 9600;\n  top: 50%;\n  left: 50%;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 0;\n  width: min(360px, 78%);\n  padding: 7px 14px 9px;\n  transform: translate(-50%, -50%) rotate(-8deg) scale(.35);\n  border: 3px solid #ffd0d5;\n  border-radius: 5px;\n  color: #fff;\n  background: linear-gradient(115deg, rgba(130, 15, 32, .97), rgba(34, 7, 13, .98));\n  box-shadow: 0 0 0 5px #e62c472c, 0 12px 35px #000d, 0 0 28px #ff2f4a88;\n  text-align: center;\n  animation: wcRoundKoPopup .92s cubic-bezier(.12, .82, .22, 1) both;\n  pointer-events: none;\n}\n\n.wc-round-ko-popup span {\n  color: #ffb8c0;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: .53rem;\n  font-weight: 1000;\n  letter-spacing: .2em;\n}\n\n.wc-round-ko-popup strong {\n  color: #fff;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: clamp(3.5rem, 10vw, 6.5rem);\n  font-weight: 1000;\n  font-style: italic;\n  line-height: .95;\n  letter-spacing: -.04em;\n  text-shadow: 4px 4px 0 #5a0e1a, 0 0 22px #ff526b;\n}\n\n.wc-round-ko-popup small {\n  color: #ffe0e3;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: .56rem;\n  font-weight: 1000;\n  letter-spacing: .14em;\n}\n\n@keyframes wcRoundKoPopup {\n  0% { opacity: 0; transform: translate(-50%, -50%) rotate(-14deg) scale(1.5); }\n  18% { opacity: 1; transform: translate(-50%, -50%) rotate(-8deg) scale(.92); }\n  30%, 78% { opacity: 1; transform: translate(-50%, -50%) rotate(-8deg) scale(1); }\n  100% { opacity: 0; transform: translate(-50%, -50%) rotate(-5deg) scale(.92); }\n}\n\n@media (max-width: 700px) {\n  .wc-round-elimination-stage {\n    min-height: 290px;\n  }\n\n  .wc-round-eliminator-spotlight img {\n    width: 132px;\n    height: 145px;\n  }\n\n  .wc-round-ko-popup {\n    width: 82%;\n  }\n}\n\n\n/* The player's contender identity is presented as a collectible character card. */\n.wc-tourney-bracket-title {\n  align-items: center;\n  min-height: 0;\n  gap: clamp(16px, 3vw, 34px);\n}\n\n.wc-tourney-player-card {\n  position: relative;\n  flex: 0 0 auto;\n  display: flex;\n  flex-direction: column;\n  width: clamp(190px, 19vw, 232px);\n  height: clamp(220px, 27vh, 268px);\n  overflow: hidden;\n  border: 2px solid rgba(19, 213, 255, .78);\n  border-radius: 13px 6px 13px 6px;\n  background:\n    radial-gradient(ellipse at 50% 12%, rgba(19, 213, 255, .2), transparent 62%),\n    linear-gradient(155deg, #142f35, #090f12 72%);\n  box-shadow:\n    0 0 0 4px rgba(19, 213, 255, .08),\n    0 13px 32px #0009,\n    inset 0 0 22px rgba(19, 213, 255, .08);\n}\n\n.wc-tourney-player-card::before,\n.wc-tourney-player-card::after {\n  position: absolute;\n  z-index: 2;\n  width: 19px;\n  height: 19px;\n  content: \"\";\n  pointer-events: none;\n}\n\n.wc-tourney-player-card::before {\n  top: 6px;\n  left: 6px;\n  border-top: 2px solid #8af0ff;\n  border-left: 2px solid #8af0ff;\n}\n\n.wc-tourney-player-card::after {\n  right: 6px;\n  bottom: 6px;\n  border-right: 2px solid #8af0ff;\n  border-bottom: 2px solid #8af0ff;\n}\n\n.wc-tourney-player-card-art {\n  position: relative;\n  flex: 1 1 auto;\n  min-height: 0;\n  display: grid;\n  place-items: end center;\n  overflow: hidden;\n  background:\n    radial-gradient(ellipse at 50% 20%, rgba(120, 235, 255, .24), transparent 58%),\n    linear-gradient(180deg, #193942, #0c171a 92%);\n}\n\n.wc-tourney-player-card-art::after {\n  position: absolute;\n  inset: 40% 0 0;\n  content: \"\";\n  pointer-events: none;\n  background: linear-gradient(180deg, transparent, rgba(3, 9, 11, .58));\n}\n\n.wc-tourney-player-card-art img {\n  width: 100%;\n  height: 100%;\n  padding: 8px 8px 0;\n  object-fit: contain;\n  object-position: center bottom;\n  filter: drop-shadow(0 7px 9px #000c);\n}\n\n.wc-tourney-player-card-art > span {\n  position: absolute;\n  z-index: 1;\n  top: 10px;\n  left: 50%;\n  width: max-content;\n  max-width: calc(100% - 34px);\n  padding: 4px 7px;\n  transform: translateX(-50%);\n  border: 1px solid rgba(105, 227, 246, .46);\n  border-radius: 3px;\n  color: #b8f6ff;\n  background: rgba(4, 18, 22, .78);\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: .45rem;\n  font-weight: 1000;\n  letter-spacing: .14em;\n  white-space: nowrap;\n}\n\n.wc-tourney-player-card-copy {\n  position: relative;\n  z-index: 1;\n  display: flex;\n  flex: 0 0 auto;\n  flex-direction: column;\n  gap: 3px;\n  min-width: 0;\n  padding: 9px 12px 11px;\n  border-top: 1px solid rgba(19, 213, 255, .4);\n  background: linear-gradient(100deg, rgba(6, 24, 29, .98), rgba(12, 18, 20, .98));\n}\n\n.wc-tourney-player-card-copy small {\n  color: #76e6f7;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: .58rem;\n  font-weight: 1000;\n  letter-spacing: .12em;\n}\n\n.wc-tourney-player-card-copy strong {\n  overflow: hidden;\n  color: #f4f6ed;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: .94rem;\n  font-weight: 1000;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.wc-tourney-player-card-copy > span {\n  color: #d6c899;\n  font-size: .47rem;\n  font-weight: 950;\n  letter-spacing: .15em;\n}\n\n@media (max-width: 700px) {\n  .wc-tourney-bracket-title {\n    align-items: flex-start;\n  }\n\n  .wc-tourney-player-card {\n    align-self: center;\n    width: min(100%, 310px);\n    height: 230px;\n  }\n}\n\n/* Ranked eliminations stay together as a list; the KO card is a single\n   viewport-centered announcement over the full board. */\n.wc-round-eliminators {\n  width: min(820px, 100%);\n  max-height: min(48vh, 470px);\n  overflow-y: auto;\n  padding: 3px 5px 8px;\n  scrollbar-color: #8d4950 #160f10;\n}\n\n.wc-round-eliminator {\n  grid-template-columns: 92px 72px minmax(0, 1fr) 100px 56px;\n  gap: 10px;\n  min-height: 78px;\n  padding: 6px 11px;\n  animation-delay: calc(var(--reveal-order, 0) * .12s);\n}\n\n.wc-round-eliminator.is-revealing {\n  border-color: #ff6577;\n  box-shadow: inset 4px 0 #ff3e58, 0 0 18px rgba(255, 57, 82, .3);\n  transform: translateX(3px);\n}\n\n.wc-round-eliminator-rank {\n  color: #ffe0a0;\n  font-size: .68rem;\n  letter-spacing: .06em;\n  white-space: nowrap;\n}\n\n.wc-round-eliminator img {\n  width: 68px;\n  height: 68px;\n  object-fit: contain;\n  object-position: center bottom;\n}\n\n.wc-round-eliminator-details {\n  display: flex;\n  flex-direction: column;\n  gap: 5px;\n  min-width: 0;\n  text-align: left;\n}\n\n.wc-round-eliminator-details strong {\n  overflow: hidden;\n  color: #fff0e4;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: .88rem;\n  font-weight: 1000;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.wc-round-eliminator-details small {\n  overflow: hidden;\n  color: #c59b8d;\n  font-size: .48rem;\n  font-weight: 950;\n  letter-spacing: .1em;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.wc-round-eliminator-status {\n  color: #ff9aa8;\n  font-size: .5rem;\n  font-weight: 1000;\n  letter-spacing: .12em;\n  text-align: center;\n}\n\n.wc-round-eliminator-status.is-pending {\n  color: #f4d48b;\n}\n\n.wc-round-eliminator-ko {\n  display: grid;\n  place-items: center;\n  min-height: 31px;\n  border: 1px solid #ff6577a8;\n  border-radius: 3px;\n  color: #fff0f0;\n  background: linear-gradient(110deg, #7c1828, #280b11);\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: .7rem;\n  font-weight: 1000;\n  font-style: italic;\n  letter-spacing: .1em;\n}\n\n.wc-round-ko-popup {\n  position: fixed;\n  z-index: 9600;\n  top: 50%;\n  left: 50%;\n  display: grid;\n  grid-template-columns: 116px minmax(0, 1fr);\n  align-items: center;\n  gap: 13px;\n  width: min(440px, calc(100vw - 30px));\n  min-height: 190px;\n  padding: 13px;\n  transform: translate(-50%, -50%) rotate(-3deg) scale(.35);\n  border: 3px solid #ffe1e4;\n  border-radius: 10px 4px 10px 4px;\n  color: #fff;\n  background:\n    radial-gradient(ellipse at 100% 0%, rgba(255, 92, 111, .25), transparent 55%),\n    linear-gradient(135deg, #671522, #160b0e 76%);\n  box-shadow:\n    0 0 0 5px rgba(239, 53, 78, .24),\n    0 20px 58px #000e,\n    inset 0 0 0 1px rgba(255, 255, 255, .12);\n  text-align: left;\n  animation: wcRoundKoPopup 1.12s cubic-bezier(.12, .82, .22, 1) both;\n  pointer-events: none;\n}\n\n.wc-round-ko-card-art {\n  display: grid;\n  place-items: end center;\n  height: 160px;\n  overflow: hidden;\n  border: 1px solid #ff9ca9;\n  border-radius: 5px;\n  background:\n    radial-gradient(ellipse at 50% 15%, #fa6c7c55, transparent 70%),\n    #16090c;\n}\n\n.wc-round-ko-card-art img {\n  width: 100%;\n  height: 100%;\n  object-fit: contain;\n  object-position: center bottom;\n  filter: drop-shadow(0 5px 8px #000c);\n}\n\n.wc-round-ko-card-copy {\n  display: flex;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 5px;\n  min-width: 0;\n}\n\n.wc-round-ko-card-copy span {\n  color: #ffc0c7;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: .52rem;\n  font-weight: 1000;\n  letter-spacing: .17em;\n}\n\n.wc-round-ko-card-copy strong {\n  color: #fff;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: clamp(3.7rem, 10vw, 5.8rem);\n  font-weight: 1000;\n  font-style: italic;\n  line-height: .88;\n  letter-spacing: -.04em;\n  text-shadow: 4px 4px 0 #500d19, 0 0 22px #ff526b;\n}\n\n.wc-round-ko-card-copy small {\n  max-width: 100%;\n  overflow: hidden;\n  color: #ffe0e3;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: .59rem;\n  font-weight: 1000;\n  letter-spacing: .08em;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n@keyframes wcRoundKoPopup {\n  0% { opacity: 0; transform: translate(-50%, -50%) rotate(-10deg) scale(1.25); }\n  18% { opacity: 1; transform: translate(-50%, -50%) rotate(-3deg) scale(.94); }\n  32%, 76% { opacity: 1; transform: translate(-50%, -50%) rotate(-3deg) scale(1); }\n  100% { opacity: 0; transform: translate(-50%, -50%) rotate(0deg) scale(.96); }\n}\n\n@media (max-width: 700px) {\n  .wc-round-eliminators {\n    max-height: 46vh;\n  }\n\n  .wc-round-eliminator {\n    grid-template-columns: 68px 52px minmax(0, 1fr) 58px;\n    gap: 6px;\n    min-height: 66px;\n    padding: 4px 5px;\n  }\n\n  .wc-round-eliminator img {\n    width: 50px;\n    height: 58px;\n  }\n\n  .wc-round-eliminator-details strong {\n    font-size: .68rem;\n  }\n\n  .wc-round-eliminator-details small {\n    font-size: .41rem;\n  }\n\n  .wc-round-eliminator-status {\n    display: none;\n  }\n\n  .wc-round-eliminator-ko {\n    min-height: 27px;\n    font-size: .58rem;\n  }\n\n  .wc-round-ko-popup {\n    grid-template-columns: 90px minmax(0, 1fr);\n    gap: 8px;\n    min-height: 154px;\n    padding: 9px;\n  }\n\n  .wc-round-ko-card-art {\n    height: 132px;\n  }\n\n  .wc-round-ko-card-copy span {\n    font-size: .43rem;\n  }\n}\n\n\n/* Championship bracket refresh: richer matchup cards and a clear winner fork. */\n.wc-tournament-bracket .wc-tourney-bracket-title {\n  position: relative;\n  width: min(1180px, 100%);\n  align-self: center;\n  padding: 13px 17px;\n  border: 1px solid rgba(218, 181, 103, .32);\n  border-radius: 12px;\n  background:\n    radial-gradient(ellipse at 12% 50%, rgba(226, 183, 91, .13), transparent 43%),\n    linear-gradient(110deg, rgba(33, 28, 20, .98), rgba(10, 12, 12, .98) 56%, rgba(19, 31, 32, .96));\n  box-shadow: 0 12px 30px #0007, inset 0 1px #fff1, inset 0 -1px rgba(228, 186, 95, .13);\n}\n\n.wc-tournament-bracket .wc-tourney-bracket-title > div:first-child {\n  display: flex;\n  flex-direction: column;\n  gap: 7px;\n  min-width: 0;\n  padding: 5px 8px;\n}\n\n.wc-tournament-bracket .wc-tourney-bracket-title h1 {\n  max-width: 680px;\n  font-size: clamp(1.3rem, 2.8vw, 2.4rem);\n  letter-spacing: .12em;\n}\n\n.wc-tournament-bracket .wc-tourney-bracket-title > div:first-child::after {\n  content: \"THE ROAD TO THE CROWN · EVERY WIN MOVES YOU FORWARD\";\n  color: #9f906d;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: .48rem;\n  font-weight: 900;\n  letter-spacing: .15em;\n}\n\n.wc-tournament-bracket .wc-tourney-player-card {\n  width: clamp(190px, 19vw, 226px);\n  height: clamp(205px, 23vh, 238px);\n  border-radius: 12px 5px 12px 5px;\n  box-shadow:\n    0 0 0 4px rgba(19, 213, 255, .07),\n    0 15px 28px #0009,\n    inset 0 0 22px rgba(19, 213, 255, .09);\n}\n\n.wc-tourney-single-round {\n  width: min(1180px, 100%);\n  padding: 4px 10px 16px;\n  overflow-x: hidden;\n  overflow-y: auto;\n  scrollbar-color: #a17c42 #15120d;\n}\n\n.wc-tourney-single-round .wc-tourney-round {\n  gap: 13px;\n}\n\n.wc-tourney-single-round .wc-tourney-round-title {\n  position: relative;\n  flex: 0 0 52px;\n  min-height: 52px;\n  border: 1px solid rgba(218, 181, 103, .4);\n  border-radius: 8px;\n  background:\n    linear-gradient(90deg, rgba(51, 39, 20, .95), rgba(19, 18, 15, .98) 46%, rgba(42, 32, 17, .95));\n  box-shadow: 0 7px 18px #0007, inset 0 1px #fff1;\n}\n\n.wc-tourney-single-round .wc-tourney-round-title span,\n.wc-tourney-single-round .wc-tourney-round-title small {\n  color: #c0a46b;\n  font-size: .54rem;\n}\n\n.wc-tourney-single-round .wc-tourney-round-title h2 {\n  color: #ffe3a1;\n  font-size: clamp(.9rem, 1.6vw, 1.22rem);\n  letter-spacing: .2em;\n  text-shadow: 0 0 18px rgba(235, 190, 103, .2);\n}\n\n.wc-tourney-single-round .wc-tourney-round-matches {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  grid-auto-rows: minmax(245px, auto);\n  align-items: stretch;\n  gap: 15px;\n  min-height: 0;\n  padding: 3px 0 10px;\n}\n\n.wc-tourney-single-round .wc-tourney-match {\n  min-height: 245px;\n  justify-content: flex-start;\n  gap: 9px;\n  padding: 12px 13px 11px;\n  border: 1px solid rgba(203, 165, 91, .38);\n  border-radius: 11px;\n  background:\n    radial-gradient(ellipse at 50% -15%, rgba(218, 177, 93, .12), transparent 56%),\n    linear-gradient(145deg, rgba(39, 34, 25, .98), rgba(11, 13, 13, .99) 56%, rgba(25, 30, 28, .98));\n  box-shadow: 0 12px 28px #0008, inset 0 1px #fff1, inset 0 -1px rgba(255, 220, 143, .08);\n  transition: border-color .2s ease, box-shadow .2s ease, transform .2s ease;\n}\n\n.wc-tourney-single-round .wc-tourney-match:hover {\n  border-color: rgba(230, 195, 117, .68);\n  box-shadow: 0 15px 31px #0009, 0 0 18px rgba(223, 181, 93, .08), inset 0 1px #fff1;\n  transform: translateY(-2px);\n}\n\n.wc-tourney-single-round .wc-tourney-match.is-player-match {\n  border-color: rgba(19, 213, 255, .72);\n  background:\n    radial-gradient(ellipse at 50% -15%, rgba(19, 213, 255, .16), transparent 58%),\n    linear-gradient(145deg, rgba(17, 46, 49, .98), rgba(10, 14, 15, .99) 60%, rgba(19, 29, 29, .98));\n  box-shadow: 0 12px 28px #0009, 0 0 22px rgba(19, 213, 255, .1), inset 3px 0 #13d5ff;\n}\n\n.wc-tourney-single-round .wc-tourney-match-heading {\n  min-height: 18px;\n  color: #b8a071;\n  font-size: .55rem;\n  letter-spacing: .13em;\n}\n\n.wc-tourney-single-round .wc-tourney-match-heading span:last-child {\n  padding: 3px 7px;\n  border: 1px solid rgba(216, 182, 110, .28);\n  border-radius: 3px;\n  color: #e2c783;\n  background: rgba(12, 12, 10, .58);\n  font-size: .45rem;\n}\n\n.wc-tourney-single-round .wc-tourney-matchup {\n  grid-template-columns: minmax(0, 1fr) 35px minmax(0, 1fr);\n  gap: 9px;\n  align-items: stretch;\n}\n\n.wc-tourney-single-round .wc-tourney-fighter {\n  height: 105px;\n  min-height: 105px;\n  grid-template-columns: minmax(70px, 36%) minmax(0, 1fr);\n  gap: 4px 8px;\n  padding: 6px;\n  border: 1px solid rgba(192, 171, 124, .24);\n  border-radius: 7px;\n  background: linear-gradient(145deg, rgba(9, 12, 12, .92), rgba(23, 22, 18, .92));\n  box-shadow: inset 0 1px #fff1, 0 5px 12px #0005;\n}\n\n.wc-tourney-single-round .wc-tourney-fighter.player-entry {\n  border-color: rgba(19, 213, 255, .55);\n  box-shadow: inset 3px 0 #13d5ff, 0 0 13px rgba(19, 213, 255, .08);\n}\n\n.wc-tourney-single-round .wc-tourney-fighter.match-winner {\n  border-color: rgba(255, 218, 125, .85);\n  background: linear-gradient(145deg, rgba(76, 58, 25, .58), rgba(22, 20, 14, .94));\n  box-shadow: inset 0 0 18px rgba(239, 194, 98, .11), 0 0 13px rgba(238, 194, 99, .12);\n}\n\n.wc-tourney-single-round .wc-tourney-portrait {\n  height: 91px;\n  border: 1px solid rgba(223, 188, 111, .2);\n  border-radius: 5px;\n}\n\n.wc-tourney-single-round .wc-tourney-portrait img {\n  object-fit: contain;\n  object-position: center bottom;\n}\n\n.wc-tourney-single-round .wc-tourney-fighter-name {\n  color: #fff2d8;\n  font-size: clamp(.62rem, .85vw, .8rem);\n  line-height: 1.15;\n  white-space: normal;\n}\n\n.wc-tourney-single-round .wc-tourney-fighter small {\n  justify-self: start;\n  padding: 3px 6px;\n  border-radius: 3px;\n  color: #f4d68f;\n  background: rgba(119, 88, 37, .2);\n  font-size: .44rem;\n}\n\n/* Two upper branches meet and feed a single advancing-winner card below. */\n.wc-tourney-advance-fork {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  width: 100%;\n  padding-top: 24px;\n}\n\n.wc-tourney-fork-lines {\n  position: absolute;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 25px;\n  pointer-events: none;\n}\n\n.wc-tourney-fork-lines i {\n  position: absolute;\n  display: block;\n  background: linear-gradient(180deg, #f1d28b, #9a7137);\n  box-shadow: 0 0 9px rgba(228, 183, 92, .32);\n}\n\n.wc-tourney-fork-lines .fork-branch {\n  top: 0;\n  width: 2px;\n  height: 10px;\n  transform-origin: top center;\n}\n\n.wc-tourney-fork-lines .fork-branch-left { left: 25%; }\n.wc-tourney-fork-lines .fork-branch-right { left: 75%; }\n\n.wc-tourney-fork-lines .fork-bridge {\n  top: 9px;\n  left: 25%;\n  width: 50%;\n  height: 2px;\n  transform-origin: center;\n}\n\n.wc-tourney-fork-lines .fork-stem {\n  top: 9px;\n  left: calc(50% - 1px);\n  width: 2px;\n  height: 15px;\n  transform-origin: top center;\n}\n\n.wc-tourney-advance-card {\n  position: relative;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 10px;\n  width: min(88%, 370px);\n  min-height: 57px;\n  padding: 7px 12px;\n  border: 1px dashed rgba(220, 183, 104, .4);\n  border-radius: 6px;\n  color: #b5a37d;\n  background: linear-gradient(100deg, rgba(17, 17, 14, .98), rgba(29, 25, 17, .98));\n  box-shadow: inset 0 1px #fff1, 0 5px 13px #0005;\n}\n\n.wc-tourney-advance-card-crown {\n  color: #e2c078;\n  font-size: 1.4rem;\n  text-shadow: 0 0 12px rgba(234, 190, 99, .25);\n}\n\n.wc-tourney-advance-card > div {\n  display: flex;\n  flex-direction: column;\n  gap: 2px;\n  min-width: 0;\n}\n\n.wc-tourney-advance-card > div small,\n.wc-tourney-advance-card-label {\n  color: #a28b5b;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: .44rem;\n  font-weight: 950;\n  letter-spacing: .14em;\n}\n\n.wc-tourney-advance-card > div strong {\n  color: #e8d7ad;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: .72rem;\n  font-weight: 1000;\n  letter-spacing: .1em;\n}\n\n.wc-tourney-advance-card.has-winner {\n  justify-content: flex-start;\n  border: 1px solid rgba(245, 205, 116, .75);\n  background:\n    radial-gradient(ellipse at 7% 50%, rgba(237, 194, 96, .16), transparent 48%),\n    linear-gradient(100deg, rgba(56, 43, 22, .98), rgba(17, 16, 13, .98));\n  box-shadow: 0 0 15px rgba(226, 176, 78, .13), inset 0 1px #fff2;\n  animation: wcTourneyWinnerCardEnter .65s cubic-bezier(.16, 1, .3, 1) both;\n}\n\n.wc-tourney-advance-card.has-winner img {\n  flex: 0 0 43px;\n  width: 43px;\n  height: 49px;\n  object-fit: contain;\n  object-position: center bottom;\n  filter: drop-shadow(0 3px 6px #000b);\n}\n\n.wc-tourney-advance-card.has-winner .wc-tourney-advance-card-label {\n  align-self: flex-start;\n  color: #f1d58f;\n}\n\n.wc-tourney-advance-card.has-winner > div strong {\n  color: #fff0bf;\n  font-size: .78rem;\n}\n\n.wc-tourney-advance-card.has-winner > div small {\n  color: #d2b36f;\n}\n\n@keyframes wcTourneyWinnerCardEnter {\n  from { opacity: .35; transform: translateY(-5px) scale(.97); }\n  to { opacity: 1; transform: translateY(0) scale(1); }\n}\n\n.wc-tourney-single-round .wc-tourney-fight-button {\n  min-height: 32px;\n  margin-top: 1px;\n  padding: 5px 18px;\n  border-radius: 4px;\n  font-size: .61rem !important;\n  box-shadow: 0 5px 14px rgba(217, 172, 84, .15);\n}\n\n.wc-tourney-single-round .wc-tourney-match.is-player-match .wc-tourney-fight-button {\n  border-color: #79eaff;\n  background: linear-gradient(90deg, #c9f8ff, #4bb9ce 65%, #287f91);\n  box-shadow: 0 0 16px rgba(19, 213, 255, .18), 0 5px 14px #0005;\n}\n\n.wc-tourney-single-round .wc-tourney-match.is-player-match .wc-tourney-fight-button:hover {\n  filter: brightness(1.12);\n  box-shadow: 0 0 24px rgba(19, 213, 255, .3);\n}\n\n@media (max-width: 900px) {\n  .wc-tourney-single-round .wc-tourney-round-matches {\n    grid-template-columns: minmax(0, 1fr);\n    grid-auto-rows: auto;\n  }\n}\n\n@media (max-width: 700px) {\n  .wc-tournament-bracket .wc-tourney-bracket-title {\n    align-items: stretch;\n    flex-direction: column;\n  }\n\n  .wc-tournament-bracket .wc-tourney-player-card {\n    align-self: flex-start;\n    width: min(100%, 320px);\n    height: 220px;\n  }\n\n  .wc-tourney-single-round {\n    padding: 3px 2px 12px;\n  }\n\n  .wc-tourney-single-round .wc-tourney-round-title {\n    flex-wrap: wrap;\n    gap: 4px 9px;\n    min-height: 47px;\n    flex-basis: 47px;\n  }\n\n  .wc-tourney-single-round .wc-tourney-match {\n    min-height: 0;\n    padding: 10px 8px;\n  }\n\n  .wc-tourney-single-round .wc-tourney-matchup {\n    grid-template-columns: minmax(0, 1fr) 27px minmax(0, 1fr);\n    gap: 4px;\n  }\n\n  .wc-tourney-single-round .wc-tourney-fighter {\n    height: 92px;\n    min-height: 92px;\n    grid-template-columns: minmax(52px, 35%) minmax(0, 1fr);\n    gap: 3px 5px;\n    padding: 4px;\n  }\n\n  .wc-tourney-single-round .wc-tourney-portrait {\n    height: 82px;\n  }\n\n  .wc-tourney-advance-card {\n    width: 94%;\n    min-height: 53px;\n    padding: 6px 8px;\n  }\n\n  .wc-tourney-advance-card.has-winner img {\n    width: 36px;\n    height: 42px;\n    flex-basis: 36px;\n  }\n\n  .wc-tourney-advance-card > div strong {\n    font-size: .64rem;\n  }\n\n  .wc-tourney-advance-card.has-winner > div strong {\n    font-size: .7rem;\n  }\n\n  .wc-tourney-single-round .wc-tourney-fight-button {\n    width: 100%;\n    min-height: 37px;\n  }\n}\n\n/* Give the placement board time to read: a measured row reveal, one buzzer\n   card per row, and a longer pause before the next bracket is offered. */\n.wc-round-eliminators {\n  gap: 10px;\n  width: min(860px, 100%);\n  max-height: min(54vh, 540px);\n  padding: 5px 7px 12px;\n}\n\n.wc-round-eliminator {\n  opacity: 0;\n  animation-duration: .92s;\n  animation-timing-function: cubic-bezier(.16, 1, .3, 1);\n}\n\n.wc-round-eliminator.is-revealing {\n  border-color: #ff8290;\n  box-shadow: inset 4px 0 #ff3e58, 0 0 22px rgba(255, 57, 82, .32);\n  transform: translateX(3px);\n}\n\n.wc-round-ko-popup {\n  animation-duration: 1.32s;\n  width: min(460px, calc(100vw - 30px));\n}\n\n.wc-round-transition-progress {\n  margin-top: 10px;\n  animation: wcRoundProgressPulse 1.4s ease-in-out infinite alternate;\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .wc-round-eliminator,\n  .wc-round-ko-popup,\n  .wc-tourney-advance-card.has-winner {\n    animation-duration: .01ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: .01ms !important;\n  }\n}\n\n\n/* The fork draws inward and downward when a match winner is confirmed. */\n.wc-tourney-advance-fork.is-complete .fork-branch {\n  animation: wcTourneyForkVertical .38s ease-out both;\n}\n\n.wc-tourney-advance-fork.is-complete .fork-bridge {\n  animation: wcTourneyForkHorizontal .38s .16s ease-out both;\n}\n\n.wc-tourney-advance-fork.is-complete .fork-stem {\n  animation: wcTourneyForkVertical .34s .3s ease-out both;\n}\n\n@keyframes wcTourneyForkVertical {\n  from { transform: scaleY(.05); opacity: .25; }\n  to { transform: scaleY(1); opacity: 1; }\n}\n\n@keyframes wcTourneyForkHorizontal {\n  from { transform: scaleX(.05); opacity: .25; }\n  to { transform: scaleX(1); opacity: 1; }\n}\n\n/* Elimination recap: reveal ranked rows in sequence; remove only the large K.O. overlay. */\n.wc-round-transition.phase-eliminators .wc-round-transition-panel {\n  width: min(980px, 100%);\n  max-height: min(94vh, 980px);\n  overflow-y: auto;\n  padding: clamp(18px, 2.6vw, 30px);\n}\n\n.wc-round-transition.phase-eliminators .wc-round-eliminators {\n  width: min(880px, 100%);\n  max-height: none;\n  overflow: visible;\n  gap: 8px;\n  padding: 4px 5px 10px;\n}\n\n.wc-round-transition.phase-eliminators .wc-round-eliminator {\n  grid-template-columns: 100px 68px minmax(0, 1fr) 116px 56px;\n  min-height: 72px;\n  gap: 12px;\n  padding: 5px 12px;\n  opacity: 0 !important;\n  border-color: rgba(218, 183, 111, .42);\n  background: linear-gradient(105deg, #29251a, #14130f 78%);\n  box-shadow: inset 3px 0 rgba(218, 183, 111, .72), 0 5px 14px #0007;\n  transform: none;\n  animation: none !important;\n}\n\n.wc-round-transition.phase-eliminators .wc-round-eliminator.is-visible {\n  opacity: 1 !important;\n  animation: wcEliminatorReveal .7s cubic-bezier(.16, 1, .3, 1) both !important;\n}\n\n.wc-round-transition.phase-eliminators .wc-round-eliminator::after {\n  display: none !important;\n  animation: none !important;\n}\n\n.wc-round-transition.phase-eliminators .wc-round-eliminator.is-revealing {\n  border-color: rgba(218, 183, 111, .42);\n  box-shadow: inset 3px 0 rgba(218, 183, 111, .72), 0 5px 14px #0007;\n  transform: none;\n}\n\n.wc-round-transition.phase-eliminators .wc-round-eliminator-rank {\n  color: #f4d58b;\n  font-size: .72rem;\n  letter-spacing: .04em;\n  white-space: nowrap;\n}\n\n.wc-round-transition.phase-eliminators .wc-round-eliminator img {\n  width: 62px;\n  height: 64px;\n  filter: drop-shadow(0 3px 6px #000b);\n}\n\n.wc-round-transition.phase-eliminators .wc-round-eliminator-details {\n  display: flex;\n  flex-direction: column;\n  gap: 4px;\n  min-width: 0;\n  text-align: left;\n}\n\n.wc-round-transition.phase-eliminators .wc-round-eliminator-details strong {\n  color: #fff1d7;\n  font-size: .9rem;\n  text-shadow: none;\n}\n\n.wc-round-transition.phase-eliminators .wc-round-eliminator-details small {\n  color: #b9a98b;\n  font-size: .52rem;\n  letter-spacing: .1em;\n}\n\n.wc-round-transition.phase-eliminators .wc-round-eliminator-status {\n  display: inline-flex !important;\n  justify-content: center;\n  color: #e6c778;\n  font-size: .58rem;\n  letter-spacing: .1em;\n}\n\n.wc-round-transition.phase-eliminators .wc-round-eliminator-status.is-pending {\n  color: #f4d48b;\n}\n\n.wc-round-eliminator-ko {\n  display: grid !important;\n}\n\n.wc-round-ko-popup {\n  display: none !important;\n}\n\n.wc-round-transition.phase-eliminators .wc-round-transition-progress {\n  margin-top: 8px;\n  color: #ddc17f;\n  animation: none;\n}\n\n@media (max-width: 700px) {\n  .wc-round-transition.phase-eliminators .wc-round-transition-panel {\n    max-height: 94vh;\n    padding: 15px 9px;\n  }\n\n  .wc-round-transition.phase-eliminators .wc-round-eliminators {\n    gap: 6px;\n    padding: 2px 1px 7px;\n  }\n\n  .wc-round-transition.phase-eliminators .wc-round-eliminator {\n    grid-template-columns: 58px 44px minmax(0, 1fr) 58px 34px;\n    min-height: 62px;\n    gap: 5px;\n    padding: 4px 5px;\n  }\n\n  .wc-round-transition.phase-eliminators .wc-round-eliminator-rank {\n    font-size: .56rem;\n    white-space: normal;\n  }\n\n  .wc-round-transition.phase-eliminators .wc-round-eliminator img {\n    width: 44px;\n    height: 54px;\n  }\n\n  .wc-round-transition.phase-eliminators .wc-round-eliminator-details strong {\n    font-size: .68rem;\n  }\n\n  .wc-round-transition.phase-eliminators .wc-round-eliminator-details small {\n    font-size: .39rem;\n    letter-spacing: .04em;\n  }\n\n  .wc-round-transition.phase-eliminators .wc-round-eliminator-status {\n    font-size: .42rem;\n    letter-spacing: .04em;\n  }\n\n  .wc-round-transition.phase-eliminators .wc-round-eliminator-ko {\n    min-height: 25px;\n    font-size: .54rem;\n  }\n}\n\n/* ================================================\n   GRAND FINALS: centered championship bracket + live standings rail\n   ================================================ */\n.wc-tournament-bracket .wc-tourney-finals-layout {\n  display: grid !important;\n  grid-template-columns: minmax(0, 1fr) minmax(260px, 318px);\n  align-items: stretch;\n  gap: clamp(14px, 2vw, 24px);\n  width: min(100%, 1460px);\n  max-width: 1460px;\n  margin-inline: auto;\n  padding: 4px clamp(8px, 1.5vw, 18px) 18px;\n  overflow-x: hidden;\n  overflow-y: auto;\n}\n\n.wc-tournament-bracket .wc-tourney-finals-round {\n  position: relative;\n  isolation: isolate;\n  display: flex;\n  flex-direction: column;\n  justify-content: flex-start;\n  align-items: stretch;\n  width: 100%;\n  min-width: 0;\n  min-height: 100%;\n  padding: 4px 0 12px;\n  overflow: visible;\n}\n\n.wc-tourney-finals-round::before {\n  content: \"\";\n  position: absolute;\n  z-index: -1;\n  inset: 10% 4% 8%;\n  pointer-events: none;\n  background:\n    radial-gradient(ellipse at 50% 34%, rgba(244, 196, 91, .2), transparent 52%),\n    radial-gradient(ellipse at 50% 78%, rgba(255, 160, 51, .08), transparent 54%);\n  filter: blur(15px);\n  animation: wcFinalsAura 3.2s ease-in-out infinite alternate;\n}\n\n.wc-tourney-finals-intro {\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 5px;\n  min-height: clamp(92px, 14vh, 138px);\n  margin: 0 auto 12px;\n  padding: 14px 22px;\n  text-align: center;\n  animation: wcFinalsTitleArrival .9s cubic-bezier(.16, 1, .3, 1) both;\n}\n\n.wc-tourney-finals-intro::before,\n.wc-tourney-finals-intro::after {\n  content: \"\";\n  position: absolute;\n  top: 50%;\n  width: clamp(36px, 9vw, 112px);\n  height: 1px;\n  background: linear-gradient(90deg, transparent, #f5d48a, transparent);\n  box-shadow: 0 0 12px rgba(245, 212, 138, .8);\n}\n\n.wc-tourney-finals-intro::before {\n  right: 100%;\n}\n\n.wc-tourney-finals-intro::after {\n  left: 100%;\n}\n\n.wc-tourney-finals-intro span {\n  color: #e5c47e;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: .65rem;\n  font-weight: 950;\n  letter-spacing: .32em;\n  text-shadow: 0 0 14px rgba(237, 190, 99, .5);\n}\n\n.wc-tourney-finals-intro strong {\n  color: #fff0c2;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: clamp(2.1rem, 4.2vw, 3.8rem);\n  font-weight: 1000;\n  line-height: .98;\n  letter-spacing: .16em;\n  text-shadow:\n    0 2px 0 #6c481c,\n    0 0 18px rgba(255, 206, 111, .54),\n    0 0 42px rgba(238, 156, 52, .27);\n  animation: wcFinalsTitleGlow 2.4s ease-in-out infinite alternate;\n}\n\n.wc-tourney-finals-intro small {\n  color: #bba77f;\n  font-size: .56rem;\n  font-weight: 900;\n  letter-spacing: .22em;\n}\n\n.wc-tournament-bracket .wc-tourney-finals-round .wc-tourney-round-title {\n  width: min(100%, 900px);\n  align-self: center;\n  flex: 0 0 48px;\n  min-height: 48px;\n  margin-bottom: 8px;\n  border-color: rgba(240, 197, 108, .58);\n  background:\n    linear-gradient(90deg, rgba(56, 37, 15, .97), rgba(24, 20, 14, .98) 50%, rgba(56, 37, 15, .97));\n  box-shadow: 0 0 22px rgba(235, 181, 83, .12), inset 0 1px #fff2;\n}\n\n.wc-tournament-bracket .wc-tourney-finals-round .wc-tourney-round-title h2 {\n  color: #ffe7ac;\n  text-shadow: 0 0 16px rgba(255, 205, 105, .46);\n}\n\n.wc-tournament-bracket .wc-tourney-finals-round .wc-tourney-round-matches {\n  display: grid;\n  grid-template-columns: minmax(0, 1fr);\n  grid-auto-rows: minmax(0, auto);\n  align-content: center;\n  justify-items: center;\n  flex: 1 0 auto;\n  min-height: 0;\n  padding: 10px 0 18px;\n}\n\n.wc-tournament-bracket .wc-tourney-finals-round .wc-tourney-match {\n  width: min(100%, 900px);\n  min-height: 350px;\n  padding: clamp(16px, 2vw, 24px);\n  border: 1px solid rgba(244, 202, 116, .78);\n  background:\n    radial-gradient(ellipse at 50% -12%, rgba(249, 194, 89, .23), transparent 58%),\n    linear-gradient(145deg, rgba(50, 38, 21, .99), rgba(14, 15, 14, .99) 55%, rgba(43, 29, 17, .99));\n  box-shadow:\n    0 18px 48px #000b,\n    0 0 0 1px rgba(255, 224, 157, .11),\n    0 0 34px rgba(235, 178, 75, .2),\n    inset 0 1px rgba(255, 244, 208, .2);\n  animation: wcFinalsMatchArrival .95s .18s cubic-bezier(.16, 1, .3, 1) both,\n    wcFinalsMatchPulse 3.4s 1.2s ease-in-out infinite;\n}\n\n.wc-tournament-bracket .wc-tourney-finals-round .wc-tourney-match:hover {\n  transform: none;\n}\n\n.wc-tournament-bracket .wc-tourney-finals-round .wc-tourney-match-heading {\n  min-height: 25px;\n  color: #efcf91;\n  font-size: .67rem;\n  letter-spacing: .18em;\n}\n\n.wc-tournament-bracket .wc-tourney-finals-round .wc-tourney-match-heading span:last-child {\n  border-color: rgba(244, 207, 139, .48);\n  color: #ffe6ae;\n  background: rgba(89, 56, 18, .28);\n}\n\n.wc-tournament-bracket .wc-tourney-finals-round .wc-tourney-matchup {\n  grid-template-columns: minmax(0, 1fr) 48px minmax(0, 1fr);\n  gap: clamp(10px, 1.8vw, 22px);\n  padding-top: 18px;\n}\n\n.wc-tournament-bracket .wc-tourney-finals-round .wc-tourney-fighter {\n  height: clamp(132px, 19vh, 190px);\n  min-height: 132px;\n  grid-template-columns: minmax(104px, 39%) minmax(0, 1fr);\n  gap: 8px 12px;\n  padding: 8px;\n  border-color: rgba(233, 208, 154, .43);\n  background: linear-gradient(145deg, rgba(13, 17, 15, .98), rgba(39, 32, 21, .96));\n}\n\n.wc-tournament-bracket .wc-tourney-finals-round .wc-tourney-fighter.match-winner {\n  border-color: #ffe6a4;\n  box-shadow: inset 0 0 20px rgba(248, 202, 107, .15), 0 0 24px rgba(246, 197, 95, .22);\n}\n\n.wc-tournament-bracket .wc-tourney-finals-round .wc-tourney-portrait {\n  height: 100%;\n  min-height: 112px;\n  border-color: rgba(240, 207, 139, .38);\n  background:\n    radial-gradient(ellipse at 50% 14%, rgba(255, 223, 155, .2), transparent 72%),\n    linear-gradient(180deg, #352b1c, #0e100e);\n}\n\n.wc-tournament-bracket .wc-tourney-finals-round .wc-tourney-fighter-name {\n  color: #fff0c8;\n  font-size: clamp(.75rem, 1vw, .95rem);\n  font-weight: 1000;\n}\n\n.wc-tournament-bracket .wc-tourney-finals-round .wc-tourney-versus {\n  color: #ffe3a1;\n  font-size: .95rem;\n  text-shadow: 0 0 14px rgba(250, 205, 113, .65);\n}\n\n.wc-tournament-bracket .wc-tourney-finals-round .wc-tourney-advance-fork {\n  margin-top: 8px;\n}\n\n.wc-tournament-bracket .wc-tourney-finals-round .wc-tourney-advance-card {\n  border-color: rgba(246, 208, 129, .72);\n  background: linear-gradient(105deg, rgba(78, 56, 22, .96), rgba(22, 20, 14, .98));\n  box-shadow: 0 0 22px rgba(238, 186, 83, .16), inset 0 1px #fff2;\n}\n\n.wc-tournament-bracket .wc-tourney-finals-round .wc-tourney-fight-button {\n  min-height: 44px;\n  margin-top: 8px;\n  font-size: .72rem !important;\n  letter-spacing: .18em;\n  animation: wcFinalsButtonPulse 2.2s ease-in-out infinite alternate;\n}\n\n/* Current placements stay visible beside the final matchup. */\n.wc-tourney-finals-standings {\n  position: relative;\n  align-self: stretch;\n  min-width: 0;\n  padding: 13px 11px 12px;\n  border: 1px solid rgba(218, 181, 103, .48);\n  border-radius: 10px;\n  background:\n    radial-gradient(ellipse at 50% 0%, rgba(217, 171, 83, .17), transparent 54%),\n    linear-gradient(160deg, rgba(28, 26, 20, .98), rgba(11, 13, 12, .99));\n  box-shadow: 0 12px 32px #0008, inset 0 1px #fff1;\n  animation: wcFinalsStandingsArrival .72s .32s cubic-bezier(.16, 1, .3, 1) both;\n}\n\n.wc-tourney-finals-standings-header {\n  display: flex;\n  flex-direction: column;\n  gap: 5px;\n  margin-bottom: 10px;\n  padding: 2px 4px 10px;\n  border-bottom: 1px solid rgba(222, 187, 112, .26);\n  text-align: center;\n}\n\n.wc-tourney-finals-standings-header > span {\n  color: #d8b875;\n  font-size: .5rem;\n  font-weight: 1000;\n  letter-spacing: .2em;\n}\n\n.wc-tourney-finals-standings-header h3 {\n  margin: 0;\n  color: #ffedc0;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: clamp(.9rem, 1.25vw, 1.15rem);\n  font-weight: 1000;\n  letter-spacing: .12em;\n  text-shadow: 0 0 13px rgba(238, 193, 106, .24);\n}\n\n.wc-tourney-finals-standings-header small {\n  color: #9d9279;\n  font-size: .48rem;\n  font-weight: 900;\n  letter-spacing: .13em;\n}\n\n.wc-tourney-finals-standings-list {\n  display: flex;\n  flex-direction: column;\n  gap: 6px;\n  margin: 0;\n  padding: 0;\n  list-style: none;\n}\n\n.wc-tourney-finals-standing {\n  display: grid;\n  grid-template-columns: 36px 42px minmax(0, 1fr);\n  align-items: center;\n  gap: 8px;\n  min-height: 48px;\n  padding: 4px 6px;\n  border: 1px solid rgba(183, 157, 106, .2);\n  border-radius: 5px;\n  background: linear-gradient(100deg, rgba(43, 38, 28, .8), rgba(13, 15, 14, .92));\n}\n\n.wc-tourney-finals-standing.is-finalist {\n  border-color: rgba(242, 202, 116, .68);\n  background: linear-gradient(100deg, rgba(84, 60, 24, .52), rgba(25, 22, 15, .95));\n  box-shadow: inset 3px 0 #e8c36f, 0 0 12px rgba(234, 188, 92, .1);\n}\n\n.wc-tourney-finals-standing-place {\n  color: #ebcf92;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: .72rem;\n  font-weight: 1000;\n  text-align: center;\n  font-variant-numeric: tabular-nums;\n}\n\n.wc-tourney-finals-standing img {\n  width: 40px;\n  height: 43px;\n  object-fit: contain;\n  object-position: center bottom;\n  filter: drop-shadow(0 3px 5px #000b);\n}\n\n.wc-tourney-finals-standing-copy {\n  display: flex;\n  flex-direction: column;\n  gap: 3px;\n  min-width: 0;\n}\n\n.wc-tourney-finals-standing-copy strong {\n  overflow: hidden;\n  color: #f5ebd5;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: .69rem;\n  font-weight: 950;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n\n.wc-tourney-finals-standing-copy small {\n  color: #bca679;\n  font-size: .44rem;\n  font-weight: 950;\n  letter-spacing: .12em;\n}\n\n.wc-tourney-finals-standing.is-finalist .wc-tourney-finals-standing-copy small {\n  color: #f1d18c;\n}\n\n/* Finals reveal: a crown-lit arrival, glowing arena, and a readable table. */\n@keyframes wcFinalsAura {\n  from { opacity: .55; transform: scale(.94); }\n  to { opacity: 1; transform: scale(1.04); }\n}\n\n@keyframes wcFinalsTitleArrival {\n  0% { opacity: 0; transform: translateY(20px) scale(.9); filter: blur(6px); }\n  65% { opacity: 1; transform: translateY(-2px) scale(1.025); filter: blur(0); }\n  100% { opacity: 1; transform: translateY(0) scale(1); }\n}\n\n@keyframes wcFinalsTitleGlow {\n  from { text-shadow: 0 2px 0 #6c481c, 0 0 12px rgba(255, 206, 111, .32); }\n  to { text-shadow: 0 2px 0 #6c481c, 0 0 22px rgba(255, 206, 111, .8), 0 0 46px rgba(238, 156, 52, .4); }\n}\n\n@keyframes wcFinalsMatchArrival {\n  from { opacity: 0; transform: translateY(30px) scale(.94); filter: brightness(.65); }\n  to { opacity: 1; transform: translateY(0) scale(1); filter: brightness(1); }\n}\n\n@keyframes wcFinalsMatchPulse {\n  0%, 100% { box-shadow: 0 18px 48px #000b, 0 0 0 1px rgba(255, 224, 157, .11), 0 0 28px rgba(235, 178, 75, .16), inset 0 1px rgba(255, 244, 208, .2); }\n  50% { box-shadow: 0 18px 48px #000b, 0 0 0 1px rgba(255, 224, 157, .22), 0 0 44px rgba(235, 178, 75, .34), inset 0 1px rgba(255, 244, 208, .24); }\n}\n\n@keyframes wcFinalsStandingsArrival {\n  from { opacity: 0; transform: translateX(24px); }\n  to { opacity: 1; transform: translateX(0); }\n}\n\n@keyframes wcFinalsButtonPulse {\n  from { box-shadow: 0 0 16px rgba(238, 188, 91, .18); }\n  to { box-shadow: 0 0 28px rgba(238, 188, 91, .46); }\n}\n\n@media (max-width: 1050px) {\n  .wc-tournament-bracket .wc-tourney-finals-layout {\n    grid-template-columns: minmax(0, 1fr) 270px;\n    gap: 12px;\n  }\n\n  .wc-tournament-bracket .wc-tourney-finals-round .wc-tourney-match {\n    min-height: 320px;\n  }\n\n  .wc-tournament-bracket .wc-tourney-finals-round .wc-tourney-fighter {\n    grid-template-columns: minmax(82px, 36%) minmax(0, 1fr);\n  }\n\n  .wc-tourney-finals-standing {\n    grid-template-columns: 30px 36px minmax(0, 1fr);\n    gap: 5px;\n  }\n\n  .wc-tourney-finals-standing img {\n    width: 35px;\n    height: 39px;\n  }\n}\n\n@media (max-width: 760px) {\n  .wc-tournament-bracket .wc-tourney-finals-layout {\n    grid-template-columns: minmax(0, 1fr);\n    overflow-y: auto;\n    padding-inline: 6px;\n  }\n\n  .wc-tourney-finals-standings {\n    width: 100%;\n  }\n\n  .wc-tourney-finals-standings-list {\n    display: grid;\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .wc-tournament-bracket .wc-tourney-finals-round .wc-tourney-match {\n    min-height: 0;\n    padding: 12px 8px;\n  }\n\n  .wc-tournament-bracket .wc-tourney-finals-round .wc-tourney-matchup {\n    grid-template-columns: minmax(0, 1fr) 26px minmax(0, 1fr);\n    gap: 4px;\n  }\n\n  .wc-tournament-bracket .wc-tourney-finals-round .wc-tourney-fighter {\n    height: 112px;\n    min-height: 112px;\n    grid-template-columns: minmax(56px, 38%) minmax(0, 1fr);\n    gap: 4px;\n    padding: 4px;\n  }\n\n  .wc-tournament-bracket .wc-tourney-finals-round .wc-tourney-portrait {\n    min-height: 100px;\n  }\n\n  .wc-tourney-finals-intro strong {\n    font-size: clamp(1.55rem, 7vw, 2.35rem);\n  }\n\n  .wc-tourney-finals-intro::before,\n  .wc-tourney-finals-intro::after {\n    width: 24px;\n  }\n\n  .wc-tourney-finals-standing {\n    grid-template-columns: 28px 34px minmax(0, 1fr);\n    min-height: 45px;\n    gap: 4px;\n    padding: 3px;\n  }\n\n  .wc-tourney-finals-standing img {\n    width: 32px;\n    height: 36px;\n  }\n\n  .wc-tourney-finals-standing-copy strong {\n    font-size: .61rem;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .wc-tourney-finals-round::before,\n  .wc-tourney-finals-intro,\n  .wc-tourney-finals-intro strong,\n  .wc-tournament-bracket .wc-tourney-finals-round .wc-tourney-match,\n  .wc-tournament-bracket .wc-tourney-finals-round .wc-tourney-fight-button,\n  .wc-tourney-finals-standings {\n    animation-duration: .01ms !important;\n    animation-iteration-count: 1 !important;\n    transition-duration: .01ms !important;\n  }\n}\n\n/* Bracket size is chosen in a focused popup after Generate Bracket is pressed. */\n.wc-tourney-format-backdrop {\n  position: fixed;\n  z-index: 10000;\n  inset: 0;\n  display: grid;\n  place-items: center;\n  overflow-y: auto;\n  padding: 18px;\n  background:\n    radial-gradient(ellipse at 50% 12%, rgba(226, 180, 86, .18), transparent 48%),\n    rgba(2, 4, 5, .84);\n  backdrop-filter: blur(8px);\n  animation: wcRoundTransitionFade .26s ease both;\n}\n\n.wc-tourney-format-dialog {\n  width: min(850px, 100%);\n  max-height: min(92vh, 780px);\n  overflow-y: auto;\n  padding: clamp(20px, 3vw, 34px);\n  border: 1px solid rgba(240, 207, 133, .82);\n  border-radius: 12px 4px;\n  color: #f8f0df;\n  background:\n    radial-gradient(ellipse at 50% 0%, rgba(218, 173, 83, .27), transparent 53%),\n    linear-gradient(145deg, #292317, #0a0e0c 70%);\n  box-shadow:\n    0 28px 100px #000f,\n    0 0 0 5px rgba(209, 168, 75, .14),\n    0 0 54px rgba(223, 186, 104, .28);\n  text-align: center;\n  animation: wcRoundPanelEnter .48s cubic-bezier(.16, 1, .3, 1) both;\n}\n\n.wc-tourney-format-kicker {\n  margin: 0 0 7px;\n  color: #f0d48c;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: .63rem;\n  font-weight: 1000;\n  letter-spacing: .22em;\n}\n\n.wc-tourney-format-dialog > h2 {\n  margin: 0;\n  color: #fff0c2;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: clamp(1.7rem, 4.5vw, 3rem);\n  font-weight: 1000;\n  letter-spacing: .09em;\n  text-shadow: 0 0 24px rgba(223, 184, 93, .4);\n}\n\n.wc-tourney-format-copy {\n  max-width: 540px;\n  margin: 9px auto 22px;\n  color: #d0c4a8;\n  font-size: .82rem;\n  line-height: 1.45;\n}\n\n.wc-tourney-format-options {\n  display: grid;\n  grid-template-columns: repeat(2, minmax(0, 1fr));\n  gap: clamp(12px, 2vw, 20px);\n}\n\n.wc-tourney-format-option {\n  position: relative;\n  min-width: 0;\n  min-height: 228px;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 7px;\n  padding: 22px 15px 17px;\n  overflow: hidden;\n  border: 1px solid rgba(196, 158, 88, .48);\n  border-radius: 9px 3px;\n  color: #eadbb9;\n  background:\n    radial-gradient(ellipse at 50% 0%, rgba(213, 172, 91, .17), transparent 58%),\n    linear-gradient(150deg, rgba(54, 43, 25, .94), rgba(12, 15, 13, .98) 72%);\n  box-shadow: 0 10px 24px #0007, inset 0 1px #fff1;\n  cursor: pointer;\n  transition:\n    border-color .2s ease,\n    background .2s ease,\n    box-shadow .2s ease,\n    transform .2s ease;\n}\n\n.wc-tourney-format-option::before {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  opacity: 0;\n  pointer-events: none;\n  background: linear-gradient(115deg, transparent 20%, rgba(255, 238, 187, .13), transparent 78%);\n  transform: translateX(-70%);\n  transition: opacity .2s ease, transform .55s ease;\n}\n\n.wc-tourney-format-option:hover:not(:disabled) {\n  border-color: rgba(255, 226, 157, .9);\n  box-shadow: 0 14px 30px #0009, 0 0 24px rgba(229, 183, 94, .2), inset 0 1px #fff2;\n  transform: translateY(-4px);\n}\n\n.wc-tourney-format-option:hover:not(:disabled)::before {\n  opacity: 1;\n  transform: translateX(70%);\n}\n\n.wc-tourney-format-option.selected {\n  border-color: #ffe5a1;\n  color: #fff2cf;\n  background:\n    radial-gradient(ellipse at 50% 0%, rgba(250, 211, 131, .28), transparent 58%),\n    linear-gradient(150deg, #594322, #19160f 76%);\n  box-shadow:\n    inset 0 0 0 2px rgba(255, 229, 161, .2),\n    0 0 0 2px rgba(242, 208, 131, .12),\n    0 0 32px rgba(231, 185, 92, .24);\n}\n\n.wc-tourney-format-option:disabled {\n  opacity: .38;\n  filter: grayscale(.8);\n  cursor: not-allowed;\n}\n\n.wc-tourney-format-number {\n  color: #ffe29b;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: clamp(3.7rem, 7vw, 5.5rem);\n  font-weight: 1000;\n  line-height: .9;\n  text-shadow: 0 0 24px rgba(244, 201, 112, .36);\n}\n\n.wc-tourney-format-option > strong {\n  color: #fff0c4;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: 1rem;\n  font-weight: 1000;\n  letter-spacing: .22em;\n}\n\n.wc-tourney-format-option > small {\n  color: #d3ba85;\n  font-size: .62rem;\n  font-weight: 950;\n  letter-spacing: .15em;\n}\n\n.wc-tourney-format-option > i {\n  min-height: 28px;\n  color: #aaa087;\n  font-size: .53rem;\n  font-style: normal;\n  font-weight: 900;\n  letter-spacing: .1em;\n}\n\n.wc-tourney-format-option > b {\n  margin-top: 4px;\n  padding: 7px 13px;\n  border: 1px solid rgba(224, 191, 121, .42);\n  border-radius: 4px;\n  color: #e5c987;\n  background: rgba(6, 9, 8, .5);\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: .57rem;\n  font-weight: 1000;\n  letter-spacing: .1em;\n}\n\n.wc-tourney-format-option.selected > b {\n  border-color: #f4d995;\n  color: #171207;\n  background: linear-gradient(100deg, #fff0bd, #d5a54e);\n}\n\n.wc-tourney-format-footer {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 12px;\n  margin-top: 20px;\n  padding-top: 14px;\n  border-top: 1px solid rgba(219, 179, 96, .24);\n}\n\n.wc-tourney-format-back,\n.wc-tourney-format-confirm {\n  min-height: 47px;\n  padding: 10px 19px;\n  border-radius: 4px;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: .68rem;\n  font-weight: 1000;\n  letter-spacing: .13em;\n  cursor: pointer;\n  transition: filter .18s ease, transform .18s ease, box-shadow .18s ease;\n}\n\n.wc-tourney-format-back {\n  border: 1px solid rgba(208, 174, 107, .45);\n  color: #ddc99f;\n  background: rgba(26, 23, 17, .8);\n}\n\n.wc-tourney-format-confirm {\n  min-width: 275px;\n  border: 1px solid #ffedb4;\n  color: #201707;\n  background: linear-gradient(110deg, #fff0bd 0%, #e7bf6d 45%, #a97932 100%);\n  box-shadow: 0 5px 20px rgba(203, 155, 66, .24), inset 0 1px rgba(255, 255, 255, .4);\n}\n\n.wc-tourney-format-confirm span {\n  margin-left: 10px;\n}\n\n.wc-tourney-format-back:hover,\n.wc-tourney-format-confirm:hover:not(:disabled) {\n  filter: brightness(1.12);\n  transform: translateY(-2px);\n}\n\n.wc-tourney-format-confirm:disabled {\n  opacity: .42;\n  cursor: not-allowed;\n}\n\n.wc-tourney-format-back:focus-visible,\n.wc-tourney-format-option:focus-visible,\n.wc-tourney-format-confirm:focus-visible {\n  outline: 2px solid #fff0b9;\n  outline-offset: 4px;\n}\n\n@media (max-width: 600px) {\n  .wc-tourney-format-backdrop {\n    padding: 10px;\n  }\n\n  .wc-tourney-format-dialog {\n    padding: 19px 12px;\n  }\n\n  .wc-tourney-format-options {\n    grid-template-columns: minmax(0, 1fr);\n  }\n\n  .wc-tourney-format-option {\n    min-height: 174px;\n    padding: 15px 10px;\n  }\n\n  .wc-tourney-format-number {\n    font-size: 3.5rem;\n  }\n\n  .wc-tourney-format-footer {\n    flex-direction: column-reverse;\n    align-items: stretch;\n  }\n\n  .wc-tourney-format-confirm {\n    min-width: 0;\n    width: 100%;\n  }\n}\n\n/* Delayed player-elimination modal: centered K.O. message with clear next steps. */\n.wc-tourney-ko-popup-backdrop {\n  position: fixed;\n  z-index: 11000;\n  inset: 0;\n  display: grid;\n  place-items: center;\n  overflow-y: auto;\n  padding: 18px;\n  background:\n    radial-gradient(ellipse at 50% 45%, rgba(121, 34, 28, .28), transparent 50%),\n    rgba(2, 3, 4, .82);\n  backdrop-filter: blur(8px);\n  animation: wcRoundTransitionFade .3s ease both;\n}\n\n.wc-tourney-ko-popup {\n  position: relative;\n  isolation: isolate;\n  width: min(610px, 100%);\n  max-height: min(92vh, 790px);\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  gap: 12px;\n  overflow-y: auto;\n  padding: clamp(24px, 4vw, 38px) clamp(18px, 4vw, 42px) 28px;\n  border: 1px solid rgba(220, 111, 99, .76);\n  border-radius: 12px 4px;\n  color: #f8eae0;\n  background:\n    radial-gradient(ellipse at 50% 0%, rgba(156, 51, 42, .28), transparent 58%),\n    linear-gradient(150deg, #321b19 0%, #171110 52%, #0c0d0c 100%);\n  box-shadow:\n    0 30px 100px #000f,\n    0 0 0 5px rgba(192, 69, 58, .1),\n    0 0 48px rgba(203, 76, 65, .24),\n    inset 0 1px rgba(255, 220, 203, .12);\n  text-align: center;\n  animation: wcTourneyKoPopupEnter .62s cubic-bezier(.16, 1, .3, 1) both;\n}\n\n.wc-tourney-ko-popup::before {\n  content: \"\";\n  position: absolute;\n  z-index: -1;\n  inset: 8px;\n  border: 1px solid rgba(220, 133, 118, .15);\n  border-radius: 8px 2px;\n  pointer-events: none;\n}\n\n.wc-tourney-ko-impact {\n  width: 76px;\n  height: 76px;\n  display: grid;\n  place-items: center;\n  border: 2px solid #e78b7d;\n  border-radius: 50%;\n  color: #ffe1d5;\n  background:\n    radial-gradient(circle, rgba(193, 73, 60, .35), rgba(50, 17, 15, .96) 72%);\n  box-shadow:\n    0 0 0 6px rgba(218, 93, 79, .08),\n    0 0 26px rgba(231, 116, 100, .32),\n    inset 0 0 18px rgba(231, 116, 100, .18);\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: 1.25rem;\n  font-weight: 1000;\n  letter-spacing: .04em;\n  transform: rotate(-9deg);\n  animation: wcTourneyKoStamp .55s .18s cubic-bezier(.16, 1, .3, 1) both;\n}\n\n.wc-tourney-ko-kicker {\n  margin: 4px 0 0;\n  color: #df9d8d;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: .61rem;\n  font-weight: 1000;\n  letter-spacing: .24em;\n}\n\n.wc-tourney-ko-popup h2 {\n  max-width: 500px;\n  margin: 0;\n  color: #ffe1d4;\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: clamp(1.35rem, 3.6vw, 2.25rem);\n  font-weight: 1000;\n  line-height: 1.08;\n  letter-spacing: .06em;\n  text-shadow: 0 0 20px rgba(223, 108, 93, .34);\n}\n\n.wc-tourney-ko-description {\n  max-width: 460px;\n  margin: 0 0 5px;\n  color: #d7bdb2;\n  font-size: clamp(.78rem, 1.2vw, .94rem);\n  line-height: 1.5;\n}\n\n.wc-tourney-ko-actions {\n  width: 100%;\n  display: flex;\n  flex-direction: column;\n  align-items: stretch;\n  gap: 9px;\n  margin-top: 4px;\n}\n\n.wc-tourney-ko-actions button {\n  min-height: 44px;\n  border: 1px solid rgba(219, 177, 122, .52);\n  border-radius: 4px;\n  padding: 10px 16px;\n  color: #f0dec7;\n  background: linear-gradient(110deg, rgba(49, 35, 25, .98), rgba(22, 19, 16, .98));\n  font-family: Oxanium, Arial, sans-serif;\n  font-size: .65rem;\n  font-weight: 1000;\n  letter-spacing: .13em;\n  cursor: pointer;\n  transition: filter .18s ease, transform .18s ease, border-color .18s ease, box-shadow .18s ease;\n}\n\n.wc-tourney-ko-actions button:hover:not(:disabled) {\n  filter: brightness(1.13);\n  transform: translateY(-2px);\n  border-color: #ffe2a0;\n  box-shadow: 0 6px 18px rgba(0, 0, 0, .35);\n}\n\n.wc-tourney-ko-actions .wc-tourney-ko-primary {\n  border-color: #f7dda0;\n  color: #241707;\n  background: linear-gradient(110deg, #fff0bc, #e7bf6d 58%, #a97932);\n  box-shadow: 0 5px 18px rgba(203, 155, 66, .2), inset 0 1px rgba(255, 255, 255, .38);\n}\n\n.wc-tourney-ko-actions .wc-tourney-ko-forfeit {\n  border-color: rgba(221, 131, 116, .55);\n  color: #f1b9ac;\n  background: linear-gradient(110deg, rgba(68, 30, 27, .94), rgba(28, 17, 16, .98));\n}\n\n.wc-tourney-ko-actions .wc-tourney-ko-restart {\n  min-height: 37px;\n  border-color: rgba(176, 151, 121, .27);\n  color: #b9aa98;\n  background: rgba(14, 15, 14, .75);\n  font-size: .57rem;\n}\n\n.wc-tourney-ko-actions button:disabled {\n  opacity: .48;\n  cursor: not-allowed;\n}\n\n.wc-tourney-ko-actions button:focus-visible {\n  outline: 2px solid #ffe6a0;\n  outline-offset: 3px;\n}\n\n@keyframes wcTourneyKoPopupEnter {\n  0% { opacity: 0; transform: translateY(24px) scale(.93); filter: blur(5px); }\n  68% { opacity: 1; transform: translateY(-3px) scale(1.015); filter: blur(0); }\n  100% { opacity: 1; transform: translateY(0) scale(1); }\n}\n\n@keyframes wcTourneyKoStamp {\n  0% { opacity: 0; transform: rotate(-20deg) scale(1.65); }\n  72% { opacity: 1; transform: rotate(-7deg) scale(.94); }\n  100% { opacity: 1; transform: rotate(-9deg) scale(1); }\n}\n\n@media (max-width: 600px) {\n  .wc-tourney-ko-popup-backdrop {\n    padding: 10px;\n  }\n\n  .wc-tourney-ko-popup {\n    max-height: 94vh;\n    gap: 9px;\n    padding: 22px 15px 18px;\n  }\n\n  .wc-tourney-ko-impact {\n    width: 62px;\n    height: 62px;\n    font-size: 1.05rem;\n  }\n\n  .wc-tourney-ko-actions button {\n    min-height: 42px;\n    font-size: .58rem;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .wc-tourney-ko-popup,\n  .wc-tourney-ko-impact {\n    animation-duration: .01ms !important;\n    animation-iteration-count: 1 !important;\n  }\n}\n\n\n/* Contender draw: a clean roster list rather than a miniature bracket. */\n.wc-tourney-draw-dialog {\n  width: min(620px, 100%);\n  max-height: min(88vh, 790px);\n  overflow-y: auto;\n}\n.wc-tourney-contender-list {\n  display: grid;\n  gap: 6px;\n  max-height: min(34vh, 290px);\n  margin: 12px 0;\n  padding: 0 5px 0 0;\n  overflow-y: auto;\n  list-style: none;\n}\n.wc-tourney-contender-row {\n  display: grid;\n  grid-template-columns: 27px 42px minmax(0, 1fr) auto;\n  align-items: center;\n  gap: 10px;\n  min-height: 54px;\n  padding: 5px 10px;\n  border: 1px solid rgba(226, 190, 111, .22);\n  border-radius: 5px;\n  background: linear-gradient(100deg, rgba(45, 38, 25, .72), rgba(13, 13, 12, .9));\n  animation: wcTourneyContenderReveal .35s ease both;\n  animation-delay: calc(var(--reveal-order, 0) * 75ms);\n}\n.wc-tourney-contender-row.is-player {\n  border-color: rgba(19, 213, 255, .55);\n  box-shadow: inset 3px 0 #13d5ff;\n}\n.wc-tourney-contender-row.is-first-opponent {\n  border-color: #f1ce79;\n  background: linear-gradient(100deg, rgba(110, 78, 28, .42), rgba(28, 22, 12, .96));\n  box-shadow: inset 3px 0 #f1ce79, 0 0 14px rgba(241, 206, 121, .12);\n}\n.wc-tourney-contender-number {\n  color: #a58d5c;\n  font-size: .65rem;\n  font-weight: 900;\n  font-variant-numeric: tabular-nums;\n}\n.wc-tourney-contender-row img,\n.wc-tourney-contender-question {\n  display: grid;\n  place-items: center;\n  width: 42px;\n  height: 42px;\n  border-radius: 3px;\n  object-fit: cover;\n  background: #171716;\n}\n.wc-tourney-contender-question {\n  color: #d4b66f;\n  font-size: 1.2rem;\n}\n.wc-tourney-contender-row strong {\n  min-width: 0;\n  overflow: hidden;\n  color: #f3ead8;\n  font-size: .82rem;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.wc-tourney-contender-row small {\n  color: #bda36d;\n  font-size: .52rem;\n  font-weight: 950;\n  letter-spacing: .1em;\n  text-align: right;\n}\n.wc-tourney-contender-row.is-player small { color: #68dff2; }\n.wc-tourney-contender-row.is-first-opponent small { color: #ffe5a0; }\n.wc-tourney-first-opponent {\n  display: grid;\n  gap: 7px;\n  margin: 12px 0;\n  padding: 11px;\n  border: 1px solid rgba(241, 206, 121, .62);\n  border-radius: 5px;\n  background: radial-gradient(ellipse at 50% 0, rgba(196, 147, 55, .2), transparent 72%), #15120c;\n  text-align: center;\n}\n.wc-tourney-first-opponent > span {\n  color: #f1ce79;\n  font-size: .58rem;\n  font-weight: 950;\n  letter-spacing: .18em;\n}\n.wc-tourney-first-opponent > div {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 12px;\n}\n.wc-tourney-first-opponent img {\n  width: 55px;\n  height: 58px;\n  border-radius: 3px;\n  object-fit: cover;\n}\n.wc-tourney-first-opponent strong {\n  color: #fff0c7;\n  font-size: 1.05rem;\n}\n.wc-tourney-first-opponent > small {\n  color: #b8a77e;\n  font-size: .52rem;\n  letter-spacing: .1em;\n}\n@keyframes wcTourneyContenderReveal {\n  from { opacity: 0; transform: translateY(7px); }\n  to { opacity: 1; transform: translateY(0); }\n}\n@media (max-width: 560px) {\n  .wc-tourney-contender-row {\n    grid-template-columns: 22px 36px minmax(0, 1fr);\n    gap: 7px;\n    min-height: 48px;\n  }\n  .wc-tourney-contender-row img,\n  .wc-tourney-contender-question { width: 36px; height: 36px; }\n  .wc-tourney-contender-row small { grid-column: 3; text-align: left; }\n  .wc-tourney-draw-dialog { padding: 14px; }\n}\n"],["STYLE",{},"@import url(\"https://fonts.googleapis.com/css2?family=Oxanium:wght@400;500;600;700;800&family=Rajdhani:wght@400;500;600;700&display=swap\");\n\n.story-screen {\n  --story-cyan: #13d5ff;\n  --story-red: #ff3159;\n\n  min-height: 100vh;\n  box-sizing: border-box;\n  display: flex;\n  flex-direction: column;\n  color: #fff;\n  background:\n    radial-gradient(ellipse at 50% 40%, #183b64 0%, transparent 65%),\n    linear-gradient(135deg, #101b35, #071020 75%);\n  font-family: inherit;\n  overflow-x: hidden;\n}\n\n.story-header {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  padding: 20px 5%;\n  border-bottom: 1px solid #ffffff20;\n  background: #071020aa;\n}\n\n.story-logo {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  font-weight: 900;\n  letter-spacing: 1px;\n}\n\n.story-logo-mark {\n  display: grid;\n  place-items: center;\n  width: 38px;\n  height: 32px;\n  color: var(--story-cyan);\n  border: 2px solid var(--story-cyan);\n  transform: skew(-8deg);\n}\n\n.story-header-label,\n.story-eyebrow {\n  color: var(--story-cyan);\n  font-size: 0.75rem;\n  font-weight: 800;\n  letter-spacing: 2px;\n}\n\n.story-content {\n  width: min(760px, 90%);\n  margin: auto;\n  padding: 36px 0;\n  text-align: center;\n  animation: story-appear 250ms ease-out;\n}\n\n.story-title {\n  margin: 8px 0;\n  font-size: clamp(2rem, 6vw, 3.2rem);\n  font-weight: 1000;\n  font-style: italic;\n  text-shadow: 0 0 22px #13d5ff45;\n}\n\n.story-description {\n  color: #c0cee0;\n  margin: 12px 0 30px;\n}\n\n.story-chapter-list {\n  display: grid;\n  gap: 14px;\n  text-align: left;\n}\n\n.story-chapter {\n  display: flex;\n  align-items: center;\n  gap: 18px;\n  width: 100%;\n  padding: 20px;\n  color: #fff;\n  text-align: left;\n  background: #13243bcc;\n  border: 1px solid #7890ad55;\n  border-left: 4px solid #64748b;\n  transition: transform 160ms ease, border-color 160ms ease;\n}\n\n.story-chapter.available {\n  cursor: pointer;\n  border-left-color: var(--story-cyan);\n}\n\n.story-chapter.available:hover {\n  transform: translateX(4px);\n  border-color: var(--story-cyan);\n  background: #163653;\n}\n\n.story-chapter.locked {\n  opacity: 0.45;\n  cursor: not-allowed;\n}\n\n.story-chapter-number {\n  color: var(--story-cyan);\n  font-size: 2rem;\n  font-weight: 900;\n}\n\n.story-chapter-info {\n  display: grid;\n  gap: 5px;\n  flex: 1;\n}\n\n.story-chapter-info strong {\n  letter-spacing: 1px;\n}\n\n.story-chapter-info small {\n  color: #a9bad0;\n  font-size: 0.7rem;\n  letter-spacing: 1px;\n}\n\n.story-chapter-status {\n  font-size: 0.75rem;\n  font-weight: 900;\n  letter-spacing: 1px;\n}\n\n.story-back-button {\n  margin-top: 28px;\n  padding: 12px 18px;\n  color: #dce8f7;\n  font: inherit;\n  font-weight: 800;\n  background: transparent;\n  border: 1px solid #8297b5;\n  cursor: pointer;\n}\n\n.story-back-button:hover {\n  color: var(--story-cyan);\n  border-color: var(--story-cyan);\n}\n\n.story-level-map {\n  position: relative;\n  width: min(100%, 560px);\n  height: 300px;\n  margin: 0 auto;\n  background: linear-gradient(135deg, #10264488, #07102066);\n  border: 1px solid #ffffff17;\n  border-radius: 14px;\n}\n\n.story-level-path {\n  position: absolute;\n  inset: 0;\n  width: 100%;\n  height: 100%;\n}\n\n.story-level-node {\n  position: absolute;\n  z-index: 1;\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  width: 58px;\n  height: 58px;\n  padding: 0;\n  color: #fff;\n  background: #102a45;\n  border: 3px solid var(--story-cyan);\n  border-radius: 50%;\n  box-shadow: 0 0 15px #13d5ff44;\n}\n\n.story-level-node strong {\n  font-size: 1.1rem;\n}\n\n.story-level-node small {\n  font-size: 0.5rem;\n  font-weight: 900;\n}\n\n.story-level-node.level-one {\n  top: 66%;\n  left: 5%;\n  color: #071020;\n  background: #45f59a;\n  border-color: #45f59a;\n  cursor: pointer;\n  box-shadow: 0 0 18px #45f59a66;\n}\n\n.story-level-node.level-one:hover {\n  transform: scale(1.08);\n}\n\n.story-level-node.level-two {\n  top: 47%;\n  left: 28%;\n}\n\n.story-level-node.level-three {\n  top: 24%;\n  left: 52%;\n}\n\n.story-level-node.level-four {\n  top: 40%;\n  right: 5%;\n}\n\n.story-level-node.locked {\n  color: #a0b0c5;\n  background: #1b2b40;\n  border-color: #71839a;\n  box-shadow: none;\n  opacity: 0.75;\n}\n\n.story-footer {\n  padding: 18px;\n  color: #7d90a9;\n  text-align: center;\n  font-size: 0.7rem;\n  letter-spacing: 1px;\n}\n\n@keyframes story-appear {\n  from {\n    opacity: 0;\n    transform: translateY(6px);\n  }\n\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n@media (max-width: 480px) {\n  .story-header {\n    padding: 16px 5%;\n  }\n\n  .story-header-label {\n    font-size: 0.6rem;\n  }\n\n  .story-chapter {\n    padding: 14px;\n    gap: 12px;\n  }\n\n  .story-chapter-number {\n    font-size: 1.6rem;\n  }\n\n  .story-chapter-status {\n    font-size: 0.65rem;\n  }\n\n  .story-level-map {\n    height: 240px;\n  }\n}\n\n/* ==========================================\n   WILD CARDS — STORY CAMPAIGN REDESIGN\n   MATCH THE SINGLE PLAYER CARD SYSTEM\n========================================== */\n\n.story-screen {\n  --story-blue: #168cff;\n  --story-cyan: #27dfff;\n  --story-dark: #050d1b;\n  --story-panel: rgba(9, 25, 47, 0.94);\n\n  position: relative;\n  isolation: isolate;\n  overflow: hidden;\n  color: #edf7ff;\n  font-family: \"Rajdhani\", sans-serif;\n\n  background:\n    radial-gradient(\n      ellipse at 50% 0%,\n      rgba(0, 119, 255, 0.24),\n      transparent 55%\n    ),\n    radial-gradient(\n      ellipse at 0% 60%,\n      rgba(0, 190, 255, 0.07),\n      transparent 40%\n    ),\n    linear-gradient(145deg, #07172d, #030914 75%);\n}\n\n.story-screen::before {\n  content: \"\";\n  position: absolute;\n  z-index: -1;\n  inset: 0;\n  pointer-events: none;\n  opacity: 0.12;\n  background-image:\n    linear-gradient(rgba(39, 160, 255, 0.13) 1px, transparent 1px),\n    linear-gradient(90deg, rgba(39, 160, 255, 0.13) 1px, transparent 1px);\n  background-size: 42px 42px;\n}\n\n/* HEADER */\n\n.story-header {\n  border-bottom: 1px solid rgba(39, 160, 255, 0.2);\n  background: rgba(4, 15, 29, 0.82);\n  backdrop-filter: blur(12px);\n}\n\n.story-logo {\n  color: #f1f9ff;\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 1.05rem;\n  font-weight: 800;\n  letter-spacing: 1.5px;\n  text-transform: uppercase;\n}\n\n.story-logo-mark {\n  width: 40px;\n  height: 36px;\n  border: 1px solid var(--story-cyan);\n  color: var(--story-cyan);\n  background: rgba(39, 223, 255, 0.08);\n  box-shadow: 0 0 14px rgba(39, 223, 255, 0.14);\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 0.85rem;\n  font-weight: 800;\n}\n\n.story-header-label,\n.story-eyebrow {\n  color: var(--story-cyan);\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 0.72rem;\n  font-weight: 700;\n  letter-spacing: 0.2em;\n}\n\n/* MAIN CONTENT */\n\n.story-content {\n  width: min(1080px, 92%);\n  padding: clamp(35px, 6vw, 70px) 0;\n}\n\n.story-title {\n  margin: 10px 0;\n  color: #f4fbff;\n  font-family: \"Oxanium\", sans-serif;\n  font-size: clamp(2.3rem, 6vw, 4rem);\n  font-weight: 800;\n  font-style: normal;\n  letter-spacing: 0.035em;\n  text-shadow:\n    0 0 16px rgba(22, 140, 255, 0.3),\n    0 0 35px rgba(39, 223, 255, 0.12);\n}\n\n.story-description {\n  max-width: 600px;\n  margin: 12px auto 34px;\n  color: #a9c3dc;\n  font-size: 1.1rem;\n  line-height: 1.5;\n}\n\n/* CHAPTER CARD GRID */\n\n.story-chapter-list {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  align-items: stretch;\n  gap: 18px;\n  margin: 30px auto 0;\n  text-align: left;\n}\n\n.story-chapter-card {\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n  padding: 0;\n  overflow: hidden;\n  border: 1px solid rgba(39, 160, 255, 0.28);\n  border-bottom: 3px solid rgba(39, 223, 255, 0.45);\n  border-radius: 3px;\n  color: #edf7ff;\n  background:\n    linear-gradient(\n      145deg,\n      rgba(13, 37, 66, 0.97),\n      rgba(5, 16, 31, 0.98)\n    );\n  text-align: left;\n  font: inherit;\n  transition:\n    transform 180ms ease,\n    border-color 180ms ease,\n    box-shadow 180ms ease;\n}\n\n.story-chapter-card--available {\n  cursor: pointer;\n}\n\n.story-chapter-card--available:hover {\n  transform: translateY(-6px);\n  border-color: var(--story-cyan);\n  border-bottom-color: var(--story-cyan);\n  box-shadow:\n    0 12px 30px rgba(0, 0, 0, 0.35),\n    0 0 22px rgba(39, 223, 255, 0.12);\n}\n\n.story-chapter-card:focus-visible {\n  outline: 2px solid var(--story-cyan);\n  outline-offset: 4px;\n}\n\n.story-chapter-card--locked {\n  cursor: not-allowed;\n  opacity: 0.58;\n  filter: saturate(0.55);\n}\n\n/* CARD ARTWORK AREA */\n\n.story-card-art {\n  position: relative;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  min-height: 190px;\n  overflow: hidden;\n  isolation: isolate;\n  border-bottom: 1px solid rgba(39, 160, 255, 0.25);\n}\n\n.story-card-art::before {\n  content: \"\";\n  position: absolute;\n  z-index: -1;\n  inset: 0;\n  opacity: 0.75;\n  background:\n    linear-gradient(135deg, transparent 35%, rgba(255,255,255,0.06)),\n    repeating-linear-gradient(\n      135deg,\n      transparent 0 22px,\n      rgba(255,255,255,0.035) 23px 24px\n    );\n}\n\n.story-card-art::after {\n  content: \"\";\n  position: absolute;\n  z-index: -1;\n  inset: 0;\n  background: linear-gradient(\n    180deg,\n    transparent 35%,\n    rgba(3, 10, 20, 0.82)\n  );\n}\n\n.story-card-art--chapter-one {\n  background:\n    radial-gradient(ellipse at 50% 45%, rgba(39, 223, 255, 0.3), transparent 50%),\n    linear-gradient(140deg, #123e65, #07182d 75%);\n}\n\n.story-card-art--chapter-2 {\n  background:\n    radial-gradient(ellipse at 50% 45%, rgba(22, 140, 255, 0.22), transparent 50%),\n    linear-gradient(140deg, #182e52, #091326 75%);\n}\n\n.story-card-art--chapter-3 {\n  background:\n    radial-gradient(ellipse at 50% 45%, rgba(255, 49, 89, 0.16), transparent 50%),\n    linear-gradient(140deg, #39213d, #130f25 75%);\n}\n\n.story-card-art-symbol {\n  color: rgba(220, 247, 255, 0.88);\n  font-family: \"Oxanium\", sans-serif;\n  font-size: clamp(5rem, 9vw, 7rem);\n  font-weight: 800;\n  line-height: 1;\n  text-shadow:\n    0 0 20px rgba(39, 223, 255, 0.45),\n    0 5px 25px rgba(0, 0, 0, 0.5);\n  transition: transform 250ms ease;\n}\n\n.story-chapter-card--available:hover .story-card-art-symbol {\n  transform: scale(1.1);\n}\n\n.story-card-art-index {\n  position: absolute;\n  top: 12px;\n  left: 14px;\n  color: rgba(225, 245, 255, 0.72);\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 0.85rem;\n  font-weight: 800;\n  letter-spacing: 0.12em;\n}\n\n.story-card-art-tag {\n  position: absolute;\n  right: 12px;\n  bottom: 12px;\n  padding: 5px 8px;\n  border: 1px solid rgba(39, 223, 255, 0.45);\n  color: var(--story-cyan);\n  background: rgba(3, 15, 29, 0.8);\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 0.58rem;\n  font-weight: 800;\n  letter-spacing: 0.1em;\n}\n\n.story-card-lock {\n  position: absolute;\n  top: 50%;\n  left: 50%;\n  display: grid;\n  place-items: center;\n  width: 44px;\n  height: 44px;\n  border: 1px solid rgba(180, 205, 225, 0.4);\n  border-radius: 50%;\n  background: rgba(3, 10, 20, 0.78);\n  font-size: 1.1rem;\n  transform: translate(-50%, -50%);\n}\n\n/* CARD TEXT */\n\n.story-card-info {\n  display: flex;\n  flex: 1;\n  flex-direction: column;\n  align-items: flex-start;\n  gap: 10px;\n  padding: 18px;\n}\n\n.story-card-number {\n  color: var(--story-cyan);\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 0.63rem;\n  font-weight: 700;\n  letter-spacing: 0.1em;\n}\n\n.story-card-info > strong {\n  color: #f3faff;\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 1.1rem;\n  font-weight: 800;\n  line-height: 1.25;\n  letter-spacing: 0.025em;\n}\n\n.story-card-description {\n  min-height: 66px;\n  color: #a9bfd4;\n  font-size: 0.98rem;\n  font-weight: 600;\n  line-height: 1.45;\n}\n\n.story-card-action {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  width: 100%;\n  margin-top: auto;\n  padding-top: 13px;\n  border-top: 1px solid rgba(39, 160, 255, 0.2);\n  color: var(--story-cyan);\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 0.72rem;\n  font-weight: 800;\n  letter-spacing: 0.08em;\n}\n\n.story-card-action > span {\n  font-size: 1.1rem;\n}\n\n.story-card-action--locked {\n  color: #8295a9;\n}\n\n/* BACK BUTTON */\n\n.story-back-button {\n  margin-top: 32px;\n  padding: 12px 18px;\n  border: 1px solid rgba(39, 160, 255, 0.35);\n  border-radius: 3px;\n  color: #c8e7ff;\n  background: rgba(8, 28, 52, 0.8);\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 0.75rem;\n  font-weight: 700;\n  letter-spacing: 0.07em;\n  cursor: pointer;\n  transition: 0.2s ease;\n}\n\n.story-back-button:hover {\n  border-color: var(--story-cyan);\n  color: white;\n  background: rgba(22, 140, 255, 0.15);\n  box-shadow: 0 0 15px rgba(39, 223, 255, 0.1);\n}\n\n/* LEVEL SELECT — SAME VISUAL LANGUAGE */\n\n.story-level-map {\n  border: 1px solid rgba(39, 160, 255, 0.3);\n  border-radius: 8px;\n  background:\n    radial-gradient(ellipse at 50% 50%, rgba(22, 140, 255, 0.13), transparent 65%),\n    rgba(7, 23, 43, 0.85);\n  box-shadow: inset 0 0 30px rgba(22, 140, 255, 0.06);\n}\n\n.story-level-path path {\n  stroke: rgba(39, 160, 255, 0.55);\n}\n\n.story-level-node {\n  border: 2px solid var(--story-cyan);\n  color: #eafaff;\n  background: #0a2a49;\n  box-shadow: 0 0 16px rgba(39, 223, 255, 0.2);\n  font-family: \"Oxanium\", sans-serif;\n  transition: transform 180ms ease, box-shadow 180ms ease;\n}\n\n.story-level-node.level-one {\n  border-color: #54e6a4;\n  color: #041a18;\n  background: #54e6a4;\n  box-shadow: 0 0 20px rgba(84, 230, 164, 0.3);\n}\n\n.story-level-node.level-one:hover {\n  transform: scale(1.1);\n  box-shadow: 0 0 25px rgba(84, 230, 164, 0.45);\n}\n\n.story-level-node.level-one.completed {\n  border-color: var(--story-cyan);\n  color: #041a25;\n  background: var(--story-cyan);\n}\n\n.story-level-node.locked {\n  border-color: #526b83;\n  color: #8ba0b5;\n  background: #13243a;\n  opacity: 0.7;\n  box-shadow: none;\n}\n\n/* FOOTER */\n\n.story-footer {\n  color: #66839f;\n  font-family: \"Oxanium\", sans-serif;\n  font-size: 0.65rem;\n  letter-spacing: 0.12em;\n}\n\n/* RESPONSIVE */\n\n@media (max-width: 850px) {\n  .story-chapter-list {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .story-chapter-card:first-child {\n    grid-column: span 2;\n  }\n\n  .story-chapter-card:first-child .story-card-art {\n    min-height: 220px;\n  }\n}\n\n@media (max-width: 560px) {\n  .story-header {\n    padding: 15px 5%;\n  }\n\n  .story-content {\n    width: 90%;\n    padding: 35px 0;\n  }\n\n  .story-header-label {\n    font-size: 0.58rem;\n    letter-spacing: 0.12em;\n  }\n\n  .story-logo {\n    font-size: 0.9rem;\n  }\n\n  .story-chapter-list {\n    grid-template-columns: 1fr;\n    gap: 14px;\n  }\n\n  .story-chapter-card:first-child {\n    grid-column: auto;\n  }\n\n  .story-card-art,\n  .story-chapter-card:first-child .story-card-art {\n    min-height: 170px;\n  }\n\n  .story-card-description {\n    min-height: auto;\n  }\n\n  .story-level-map {\n    height: 240px;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .story-screen *,\n  .story-screen *::before,\n  .story-screen *::after {\n    animation: none !important;\n    transition: none !important;\n  }\n}\n"],["STYLE",{},"@import url(\"https://fonts.googleapis.com/css2?family=Oxanium:wght@400;500;600;700;800&family=Rajdhani:wght@400;500;600;700&display=swap\");\n/* =========================================\n   FESTIVAL PAGE\n========================================= */\n.festival-screen {\n  min-height: 100vh;\n  position: relative;\n  overflow-x: hidden;\n  padding: 25px 4%;\n  background: #090b12;\n  color: #fff;\n  font-family: inherit;\n}\n.festival-background {\n  position: fixed;\n  inset: 0;\n  z-index: 0;\n  pointer-events: none;\n  background:\n    radial-gradient(\n      ellipse at 50% 10%,\n      rgba(19, 213, 255, 0.12),\n      transparent 55%\n    ),\n    linear-gradient(135deg, #090b12, #15101a);\n}\n.festival-header,\n.festival-intro,\n.festival-progress-section,\n.festival-rewards-section,\n.festival-challenges-section,\n.festival-daily-section {\n  position: relative;\n  z-index: 1;\n}\n/* =========================================\n   HEADER\n========================================= */\n.festival-header {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 20px;\n  padding-bottom: 20px;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.12);\n}\n.festival-logo {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n}\n.festival-logo span {\n  color: #13d5ff;\n  font-size: 27px;\n  font-weight: 1000;\n}\n.festival-logo h1 {\n  margin: 0;\n  font-size: 18px;\n  font-weight: 900;\n  letter-spacing: 2px;\n}\n.festival-back-button {\n  padding: 10px 17px;\n  border: 1px solid rgba(255, 255, 255, 0.3);\n  background: transparent;\n  color: #fff;\n  font-weight: 800;\n  cursor: pointer;\n  transition: 0.2s ease;\n}\n.festival-back-button:hover {\n  border-color: #13d5ff;\n  color: #13d5ff;\n}\n/* =========================================\n   INTRO\n========================================= */\n.festival-intro {\n  text-align: center;\n  margin: 45px auto 30px;\n}\n.festival-eyebrow {\n  color: #13d5ff;\n  font-size: 11px;\n  font-weight: 900;\n  letter-spacing: 3px;\n  margin-bottom: 8px;\n}\n.festival-intro h2 {\n  margin: 5px 0 10px;\n  font-size: clamp(35px, 5vw, 58px);\n  font-weight: 1000;\n  letter-spacing: 3px;\n  text-shadow: 0 0 22px rgba(19, 213, 255, 0.25);\n}\n.festival-description {\n  color: #aeb7c5;\n  font-size: 14px;\n}\n.festival-status {\n  display: flex;\n  justify-content: center;\n  flex-wrap: wrap;\n  gap: 12px;\n  margin-top: 22px;\n}\n.festival-status span {\n  padding: 7px 12px;\n  border: 1px solid rgba(19, 213, 255, 0.25);\n  background: rgba(19, 213, 255, 0.06);\n  color: #bdefff;\n  font-size: 10px;\n  font-weight: 900;\n  letter-spacing: 1px;\n}\n/* =========================================\n   OVERALL PROGRESS\n========================================= */\n.festival-progress-section {\n  max-width: 850px;\n  margin: 0 auto 55px;\n}\n.festival-progress-info {\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-end;\n  gap: 15px;\n  margin-bottom: 12px;\n}\n.festival-progress-info > div {\n  display: flex;\n  flex-direction: column;\n  gap: 5px;\n}\n.festival-section-label {\n  color: #aeb7c5;\n  font-size: 11px;\n  font-weight: 800;\n  letter-spacing: 1px;\n}\n.festival-progress-info strong {\n  color: #13d5ff;\n  font-size: 22px;\n}\n.festival-progress-percent {\n  color: #fff;\n  font-size: 18px;\n  font-weight: 900;\n}\n.festival-progress-track {\n  width: 100%;\n  height: 12px;\n  background: #252b38;\n  border-radius: 20px;\n  overflow: hidden;\n}\n.festival-progress-fill {\n  height: 100%;\n  background: linear-gradient(90deg, #087fa6, #13d5ff);\n  border-radius: inherit;\n  box-shadow: 0 0 12px rgba(19, 213, 255, 0.45);\n  transition: width 0.3s ease;\n}\n/* =========================================\n   SECTION HEADINGS\n========================================= */\n.festival-section-heading {\n  display: flex;\n  justify-content: space-between;\n  align-items: flex-end;\n  flex-wrap: wrap;\n  gap: 15px;\n  margin-bottom: 20px;\n}\n.festival-section-heading h3 {\n  margin: 0;\n  font-size: clamp(19px, 2.5vw, 25px);\n  font-weight: 1000;\n  letter-spacing: 1px;\n}\n.festival-tier-count,\n.festival-refresh-label,\n.festival-daily-label {\n  color: #13d5ff;\n  font-size: 11px;\n  font-weight: 900;\n  letter-spacing: 1px;\n}\n/* =========================================\n   REWARD TRACK\n========================================= */\n.festival-rewards-section {\n  margin-bottom: 60px;\n}\n.festival-track-container {\n  width: 100%;\n  overflow-x: auto;\n  overflow-y: hidden;\n  padding-bottom: 12px;\n  border: 1px solid rgba(255, 255, 255, 0.12);\n  background: rgba(10, 14, 24, 0.88);\n  border-radius: 10px;\n  scrollbar-color: #13d5ff #202633;\n  scrollbar-width: thin;\n}\n.festival-track {\n  width: max-content;\n  min-width: 100%;\n  padding: 14px;\n}\n.festival-tier-row {\n  display: grid;\n  grid-template-columns: 115px repeat(var(--festival-tier-count, 15), minmax(200px, 1fr));\n  gap: 6px;\n  margin-bottom: 10px;\n}\n.festival-tier-row::before {\n  content: \"\";\n}\n.festival-reward-row {\n  display: grid;\n  grid-template-columns: 115px repeat(var(--festival-tier-count, 15), minmax(200px, 1fr));\n  gap: 6px;\n}\n.festival-reward-label {\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  align-items: center;\n  gap: 6px;\n  border-radius: 5px;\n  font-size: 12px;\n  font-weight: 1000;\n  letter-spacing: 1px;\n}\n.free-reward-row .festival-reward-label {\n  background: rgba(19, 213, 255, 0.1);\n  color: #13d5ff;\n}\n.elite-reward-row .festival-reward-label {\n  background: rgba(255, 177, 48, 0.1);\n  color: #ffbd55;\n}\n.festival-reward-label span {\n  font-size: 23px;\n}\n.free-reward-row .festival-reward-slot:hover {\n  border-color: #13d5ff;\n}\n.elite-reward-row .festival-reward-slot:hover {\n  border-color: #ffbd55;\n}\n.elite-reward-row .reward-status {\n  color: #ffbd55;\n}\n.reward-unlocked {\n  border-color: rgba(19, 213, 255, 0.55);\n  background: rgba(19, 213, 255, 0.08);\n}\n/* The horizontal divider separating the two reward tracks */\n.festival-track-divider {\n  width: 100%;\n  box-sizing: border-box;\n  height: 45px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  margin: 12px 0;\n  border-top: 2px solid rgba(255, 189, 85, 0.6);\n  border-bottom: 2px solid rgba(255, 189, 85, 0.6);\n  color: #ffbd55;\n  font-size: 12px;\n  font-weight: 1000;\n  letter-spacing: 3px;\n}\n.festival-track-hint {\n  margin: 12px 0 20px;\n  text-align: center;\n  color: #929baa;\n  font-size: 10px;\n  letter-spacing: 2px;\n}\n/* =========================================\n   ELITE PASS BANNER\n========================================= */\n.festival-elite-banner {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 20px;\n  padding: 20px;\n  border: 1px solid rgba(255, 189, 85, 0.35);\n  background: linear-gradient(\n    100deg,\n    rgba(255, 189, 85, 0.1),\n    rgba(20, 20, 28, 0.8)\n  );\n  border-radius: 8px;\n}\n.festival-elite-banner > div {\n  display: flex;\n  align-items: center;\n  gap: 15px;\n}\n.elite-crown {\n  font-size: 35px;\n}\n.festival-elite-banner h4 {\n  margin: 0 0 5px;\n  color: #ffbd55;\n  font-size: 16px;\n  font-weight: 1000;\n}\n.festival-elite-banner p {\n  margin: 0;\n  color: #aeb7c5;\n  font-size: 12px;\n}\n.festival-elite-button {\n  padding: 11px 18px;\n  border: 1px solid #ffbd55;\n  background: rgba(255, 189, 85, 0.08);\n  color: #ffbd55;\n  font-size: 11px;\n  font-weight: 1000;\n  letter-spacing: 1px;\n  cursor: not-allowed;\n  opacity: 0.7;\n}\n/* =========================================\n   ROTATING CHALLENGES\n========================================= */\n.festival-challenges-section {\n  margin-bottom: 60px;\n}\n.festival-challenge-grid {\n  display: grid;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  gap: 15px;\n}\n.festival-challenge-card {\n  display: flex;\n  flex-direction: column;\n  min-height: 205px;\n  padding: 18px;\n  border: 1px solid rgba(255, 255, 255, 0.13);\n  border-left: 3px solid #13d5ff;\n  background: rgba(17, 23, 35, 0.94);\n  border-radius: 7px;\n  transition: 0.2s ease;\n}\n.festival-challenge-card:hover {\n  transform: translateY(-3px);\n  border-color: rgba(19, 213, 255, 0.6);\n  box-shadow: 0 5px 18px rgba(19, 213, 255, 0.08);\n}\n.challenge-card-top {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 15px;\n}\n.challenge-icon {\n  font-size: 25px;\n}\n.challenge-category {\n  color: #13d5ff;\n  font-size: 9px;\n  font-weight: 900;\n  letter-spacing: 1px;\n}\n.festival-challenge-card h4 {\n  margin: 0 0 7px;\n  font-size: 16px;\n  font-weight: 1000;\n}\n.festival-challenge-card p {\n  flex: 1;\n  margin: 0 0 18px;\n  color: #aeb7c5;\n  font-size: 12px;\n  line-height: 1.5;\n}\n.challenge-card-footer {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  margin-bottom: 8px;\n}\n.challenge-points {\n  color: #13d5ff;\n  font-size: 13px;\n  font-weight: 1000;\n}\n.challenge-progress {\n  color: #929baa;\n  font-size: 10px;\n  font-weight: 800;\n}\n.challenge-progress-track {\n  height: 5px;\n  overflow: hidden;\n  background: #2a3241;\n  border-radius: 10px;\n}\n.challenge-progress-fill {\n  width: 0%;\n  height: 100%;\n  background: #13d5ff;\n  border-radius: inherit;\n}\n/* =========================================\n   DAILY OBJECTIVES\n========================================= */\n.festival-daily-section {\n  margin-bottom: 40px;\n}\n.festival-daily-grid {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 15px;\n}\n.festival-daily-card {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 15px;\n  padding: 18px;\n  border: 1px solid rgba(255, 255, 255, 0.12);\n  background: rgba(17, 23, 35, 0.94);\n  border-radius: 7px;\n}\n.festival-daily-card h4 {\n  margin: 0 0 6px;\n  font-size: 14px;\n  font-weight: 900;\n}\n.festival-daily-card p {\n  margin: 0;\n  color: #aeb7c5;\n  font-size: 11px;\n}\n.festival-daily-card strong {\n  flex-shrink: 0;\n  color: #13d5ff;\n  font-size: 13px;\n}\n/* =========================================\n   RESPONSIVE\n========================================= */\n@media (max-width: 1000px) {\n  .festival-challenge-grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .festival-daily-grid {\n    grid-template-columns: 1fr;\n  }\n}\n@media (max-width: 600px) {\n  .festival-screen {\n    padding: 18px 4%;\n  }\n\n  .festival-header {\n    align-items: flex-start;\n    flex-direction: column;\n  }\n\n  .festival-logo h1 {\n    font-size: 15px;\n  }\n\n  .festival-intro {\n    margin-top: 35px;\n  }\n\n  .festival-intro h2 {\n    font-size: 35px;\n  }\n\n  .festival-progress-section {\n    margin-bottom: 40px;\n  }\n\n  .festival-progress-info strong {\n    font-size: 18px;\n  }\n\n  .festival-challenge-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .festival-elite-banner {\n    align-items: flex-start;\n    flex-direction: column;\n  }\n\n  .festival-elite-button {\n    width: 100%;\n  }\n\n  .festival-section-heading {\n    align-items: flex-start;\n    flex-direction: column;\n  }\n\n  .festival-daily-card {\n    align-items: flex-start;\n  }\n}\n.festival-test-button {\n  margin-top: 12px;\n  padding: 8px 14px;\n  border: 1px dashed #13d5ff;\n  background: rgba(19, 213, 255, 0.08);\n  color: #13d5ff;\n  font-size: 11px;\n  font-weight: 900;\n  cursor: pointer;\n}\n.festival-coin-balance {\n  display: block;\n  margin-top: 10px;\n  color: #ffbd55;\n  font-size: 12px;\n}\n.festival-purchase-message {\n  width: 100%;\n  margin: 10px 0 0;\n  color: #13d5ff;\n  font-size: 12px;\n  font-weight: 900;\n}\n.festival-elite-button:not(:disabled):hover {\n  background: #ffbd55;\n  color: #17120a;\n  box-shadow: 0 0 15px rgba(255, 189, 85, 0.3);\n}\n.festival-elite-button:disabled {\n  border-color: #13d5ff;\n  color: #13d5ff;\n  opacity: 0.8;\n  cursor: default;\n}\n/* Completed rotating challenges */\n.challenge-completed {\n  border-color: #13d5ff;\n  box-shadow: 0 0 12px rgba(19, 213, 255, 0.15);\n}\n.challenge-completed .challenge-progress-fill {\n  background: #13d5ff;\n  box-shadow: 0 0 10px rgba(19, 213, 255, 0.5);\n}\n.challenge-complete-label {\n  display: block;\n  margin-top: 10px;\n  color: #13d5ff;\n  font-size: 11px;\n  font-weight: 900;\n  letter-spacing: 1px;\n}\n/* Daily objectives use the same card design as rotating challenges */\n.festival-daily-grid .festival-challenge-card {\n  min-height: 205px;\n}\n/* FESTIVAL REWARD CLAIM BUTTONS */\n.festival-claim-button:not(:disabled):hover {\n  background: #13d5ff;\n  color: #080b12;\n  box-shadow: 0 0 12px rgba(19, 213, 255, 0.45);\n}\n.festival-claim-button:disabled {\n  opacity: 0.45;\n  cursor: not-allowed;\n}\n.festival-claim-button:disabled:not(:hover) {\n  border-color: rgba(255, 255, 255, 0.2);\n}\n/* ==========================================\n   FESTIVAL REWARD POPUP\n========================================== */\n.festival-reward-popup {\n  width: min(90%, 420px);\n  padding: 35px 25px;\n  text-align: center;\n  background: linear-gradient(145deg, #151d2b, #080d16);\n  border: 2px solid #13d5ff;\n  box-shadow: 0 0 25px rgba(19, 213, 255, 0.3);\n  animation: reward-popup-in 0.4s ease;\n}\n.reward-popup-icon {\n  font-size: 48px;\n  margin-bottom: 12px;\n}\n.reward-popup-eyebrow {\n  color: #13d5ff;\n  font-size: 11px;\n  font-weight: 800;\n  letter-spacing: 3px;\n  margin-bottom: 12px;\n}\n.festival-reward-popup h2 {\n  color: white;\n  font-size: clamp(22px, 5vw, 32px);\n  font-weight: 900;\n  margin: 0 0 12px;\n  text-shadow: 0 0 12px rgba(19, 213, 255, 0.45);\n}\n.reward-popup-description {\n  color: #b9c5d5;\n  font-size: 13px;\n  font-weight: 700;\n  letter-spacing: 1.5px;\n}\n.reward-popup-line {\n  width: 65%;\n  height: 3px;\n  margin: 22px auto 0;\n  background: #13d5ff;\n  box-shadow: 0 0 12px rgba(19, 213, 255, 0.7);\n}\n.character-reward-popup {\n  border-color: #f5c542;\n  box-shadow: 0 0 30px rgba(245, 197, 66, 0.25);\n}\n.character-reward-popup .reward-popup-eyebrow {\n  color: #f5c542;\n}\n.character-reward-popup h2 {\n  text-shadow: 0 0 12px rgba(245, 197, 66, 0.45);\n}\n.character-reward-popup .reward-popup-line {\n  background: #f5c542;\n  box-shadow: 0 0 12px rgba(245, 197, 66, 0.7);\n}\n@keyframes reward-overlay-in {\n  from {\n    opacity: 0;\n  }\n\n  to {\n    opacity: 1;\n  }\n}\n@keyframes reward-popup-in {\n  from {\n    opacity: 0;\n    transform: scale(0.8) translateY(15px);\n  }\n\n  to {\n    opacity: 1;\n    transform: scale(1) translateY(0);\n  }\n}\n/* REWARD POPUP FADE OUT */\n.festival-reward-popup-overlay {\n  position: fixed;\n  inset: 0;\n  z-index: 100000;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background: rgba(0, 0, 0, 0.72);\n  backdrop-filter: blur(5px);\n  animation: reward-overlay-in 0.25s ease;\n  transition: opacity 0.6s ease;\n}\n.festival-reward-popup-overlay.reward-popup-closing {\n  opacity: 0;\n  pointer-events: none;\n}\n.reward-popup-closing .festival-reward-popup {\n  transform: scale(0.9) translateY(10px);\n  transition: transform 0.6s ease;\n}\n/* ========================================\n   FESTIVAL EXCLUSIVE CHARACTER REWARDS\n======================================== */\n/* Character portrait inside reward track */\n/* Free character reward: cyan styling */\n/* Elite character reward: premium gold styling */\n.elite-reward-row .reward-character-image {\n  filter: drop-shadow(0 0 6px rgba(255, 189, 85, 0.4));\n}\n/* Character artwork in claim popup */\n.reward-popup-character-image {\n  display: block;\n  width: 145px;\n  height: 155px;\n  object-fit: contain;\n  object-position: center;\n  margin: 0 auto 12px;\n  filter: drop-shadow(0 0 12px rgba(255, 189, 85, 0.45));\n}\n/* ========================================\n   PREMIUM FESTIVAL REWARD TRACK\n======================================== */\n/* Tier header cards */\n.festival-tier-header {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 9px;\n  min-height: 75px;\n  padding: 14px 8px;\n\n  border: 1px solid rgba(255, 255, 255, 0.12);\n\n  background: linear-gradient(\n    180deg,\n    #202b3b,\n    #111824\n  );\n  border-radius: 7px;\n  text-align: center;\n  transition: all 0.25s ease;\n}\n.festival-tier-number {\n  color: #ffffff;\n  font-size: 13px;\n  font-weight: 1000;\n  letter-spacing: 1px;\n}\n.festival-tier-header strong {\n  color: #9ba9ba;\n  font-size: 11px;\n}\n.festival-tier-header.tier-unlocked {\n  border-color: rgba(19, 213, 255, 0.7);\n  background: linear-gradient(\n    180deg,\n    rgba(19, 213, 255, 0.22),\n    #111824\n  );\n\n  box-shadow: inset 0 0 12px rgba(19, 213, 255, 0.08);\n}\n.festival-tier-header.tier-unlocked .festival-tier-number,\n.festival-tier-header.tier-unlocked strong {\n  color: #13d5ff;\n}\n/* Larger reward cards */\n.festival-reward-slot {\n  min-height: 185px;\n  display: flex;\n  flex-direction: column;\n  justify-content: center;\n  align-items: center;\n  gap: 9px;\n  padding: 14px 7px;\n  border: 1px solid rgba(255, 255, 255, 0.12);\n  background: linear-gradient(\n    160deg,\n    #1b2635,\n    #101722\n  );\n\n  border-radius: 8px;\n  text-align: center;\n\n  transition:\n    transform 0.25s ease,\n    border-color 0.25s ease,\n    box-shadow 0.25s ease;\n}\n.festival-reward-slot:hover {\n  transform: translateY(-4px);\n  border-color: rgba(19, 213, 255, 0.75);\n  box-shadow: 0 5px 16px rgba(19, 213, 255, 0.13);\n}\n/* Larger character portraits */\n.festival-reward-slot.character-reward-slot {\n  min-height: 185px;\n  justify-content: space-between;\n  padding: 12px 6px;\n}\n.reward-character-image {\n  width: 85px;\n  height: 100px;\n  object-fit: contain;\n  object-position: center;\n  display: block;\n  filter: drop-shadow(0 0 5px rgba(19, 213, 255, 0.3));\n}\n/* More visible reward names */\n.reward-name {\n  color: #aeb7c5;\n  font-size: 11px;\n  font-weight: 900;\n  line-height: 1.3;\n  text-align: center;\n}\n/* Larger coin icons */\n.reward-icon {\n  font-size: 34px;\n}\n/* Reward status */\n.reward-status {\n  color: #13d5ff;\n  font-size: 10px;\n  font-weight: 900;\n  letter-spacing: 0.5px;\n}\n/* More substantial claim buttons */\n.festival-claim-button {\n  width: 90%;\n  padding: 6px 5px;\n  margin-top: 8px;\n  border: 1px solid #13d5ff;\n  background: rgba(19, 213, 255, 0.12);\n  color: #13d5ff;\n  font-size: 9px;\n  font-weight: 900;\n  letter-spacing: 0.4px;\n  cursor: pointer;\n  transition: 0.2s ease;\n  min-height: 28px;\n  border-radius: 4px;\n}\n/* More prominent character reward cards */\n.free-reward-row .character-reward-slot {\n  border-color: rgba(19, 213, 255, 0.65);\n  background: linear-gradient(\n    180deg,\n    rgba(19, 213, 255, 0.13),\n    #121824\n  );\n  border-width: 1.5px;\n  box-shadow: inset 0 0 15px rgba(19, 213, 255, 0.06);\n}\n.elite-reward-row .character-reward-slot {\n  border-color: rgba(255, 189, 85, 0.7);\n  background: linear-gradient(\n    180deg,\n    rgba(255, 189, 85, 0.15),\n    #121824\n  );\n  border-width: 1.5px;\n  box-shadow: inset 0 0 15px rgba(255, 189, 85, 0.07);\n}\n.elite-reward-row .character-reward-slot:hover {\n  border-color: #ffbd55;\n  box-shadow: 0 5px 18px rgba(255, 189, 85, 0.18);\n}\n.reward-rarity {\n  display: inline-block;\n  margin-top: 5px;\n  padding: 3px 9px;\n  border-radius: 4px;\n\n  font-size: 0.65rem;\n  font-weight: 900;\n  letter-spacing: 1px;\n}\n/* RARITY COLORS */\n.rarity-common {\n  color: #bfc5ce;\n  background: rgba(191, 197, 206, 0.12);\n  border: 1px solid #bfc5ce;\n}\n.rarity-uncommon {\n  color: #55dc86;\n  background: rgba(85, 220, 134, 0.12);\n  border: 1px solid #55dc86;\n}\n.rarity-rare {\n  color: #42a5ff;\n  background: rgba(66, 165, 255, 0.12);\n  border: 1px solid #42a5ff;\n}\n.rarity-epic {\n  color: #bd70ff;\n  background: rgba(189, 112, 255, 0.12);\n  border: 1px solid #bd70ff;\n}\n.rarity-legendary {\n  color: #ffb52e;\n  background: rgba(255, 181, 46, 0.12);\n  border: 1px solid #ffb52e;\n}\n.rarity-mythic {\n  color: #ff526c;\n  background: rgba(255, 82, 108, 0.12);\n  border: 1px solid #ff526c;\n}\n/* =====================================================\n   WILD CARDS — COMBAT FESTIVAL\n   PREMIUM TOURNAMENT THEME\n===================================================== */\n.festival-screen {\n  --fest-lime: #a5f51b;\n  --fest-gold: #f6d84a;\n  --fest-dark: #10141c;\n  --fest-panel: #171e29;\n  --fest-muted: #aab3c0;\n\n  padding: 26px clamp(18px, 4vw, 65px) 55px;\n  background: #10141c;\n  color: #f5f3e9;\n  isolation: isolate;\n}\n/* Atmospheric tournament background */\n.festival-background {\n  background:\n    radial-gradient(\n      ellipse at 50% 0%,\n      rgba(246, 216, 74, 0.15),\n      transparent 43%\n    ),\n    radial-gradient(\n      ellipse at 90% 35%,\n      rgba(165, 245, 27, 0.07),\n      transparent 35%\n    ),\n    linear-gradient(\n      180deg,\n      #20252a 0%,\n      #131a22 42%,\n      #10141c 100%\n    );\n}\n.festival-background::before {\n  content: \"\";\n  position: absolute;\n  inset: 0;\n  opacity: 0.12;\n  pointer-events: none;\n  background-image:\n    linear-gradient(\n      rgba(246, 216, 74, 0.12) 1px,\n      transparent 1px\n    ),\n    linear-gradient(\n      90deg,\n      rgba(246, 216, 74, 0.12) 1px,\n      transparent 1px\n    );\n  background-size: 55px 55px;\n  mask-image: linear-gradient(\n    to bottom,\n    black,\n    transparent 85%\n  );\n}\n/* HEADER */\n.festival-header {\n  max-width: 1500px;\n  margin: 0 auto;\n  padding-bottom: 18px;\n  border-bottom: 1px solid rgba(246, 216, 74, 0.22);\n}\n.festival-logo span {\n  color: var(--fest-lime);\n  font-style: italic;\n  text-shadow: 0 0 15px rgba(165, 245, 27, 0.25);\n}\n.festival-logo h1 {\n  color: #f5f3e9;\n  font-size: 16px;\n  font-weight: 1000;\n  letter-spacing: 3px;\n  text-transform: uppercase;\n}\n.festival-back-button {\n  padding: 11px 19px;\n  border: 1px solid rgba(246, 216, 74, 0.35);\n  background: rgba(15, 21, 29, 0.85);\n  color: #e9e4d1;\n  font-size: 10px;\n  font-weight: 900;\n  letter-spacing: 1.5px;\n  clip-path: polygon(\n    0 0,\n    calc(100% - 11px) 0,\n    100% 11px,\n    100% 100%,\n    11px 100%,\n    0 calc(100% - 11px)\n  );\n}\n.festival-back-button:hover {\n  border-color: var(--fest-lime);\n  background: rgba(165, 245, 27, 0.08);\n  color: var(--fest-lime);\n}\n/* FESTIVAL HERO */\n.festival-intro {\n  max-width: 1000px;\n  margin: 65px auto 50px;\n  padding: 38px 20px;\n  text-align: center;\n  border-top: 1px solid rgba(246, 216, 74, 0.25);\n  border-bottom: 1px solid rgba(246, 216, 74, 0.25);\n  background:\n    linear-gradient(\n      90deg,\n      transparent,\n      rgba(246, 216, 74, 0.045),\n      transparent\n    );\n}\n.festival-eyebrow {\n  color: var(--fest-lime);\n  font-size: 10px;\n  font-weight: 1000;\n  letter-spacing: 4px;\n  text-transform: uppercase;\n}\n.festival-intro h2 {\n  margin: 12px 0;\n  color: #fff8df;\n  font-size: clamp(38px, 6vw, 72px);\n  font-style: italic;\n  font-weight: 1000;\n  letter-spacing: 2px;\n  text-shadow:\n    3px 4px 0 rgba(0, 0, 0, 0.6),\n    0 0 25px rgba(246, 216, 74, 0.14);\n}\n.festival-description {\n  max-width: 560px;\n  margin: 12px auto 0;\n  color: #c0c5c8;\n  font-size: 13px;\n  line-height: 1.7;\n}\n.festival-status {\n  gap: 10px;\n  margin-top: 25px;\n}\n.festival-status span {\n  padding: 9px 14px;\n  border: 1px solid rgba(246, 216, 74, 0.25);\n  background: rgba(14, 20, 27, 0.8);\n  color: var(--fest-gold);\n  font-size: 9px;\n  font-weight: 900;\n  letter-spacing: 1.5px;\n}\n/* OVERALL PROGRESS */\n.festival-progress-section {\n  max-width: 1050px;\n  margin: 0 auto 65px;\n  padding: 23px 26px;\n  border: 1px solid rgba(246, 216, 74, 0.22);\n  border-left: 4px solid var(--fest-lime);\n  background: linear-gradient(\n    110deg,\n    rgba(34, 43, 42, 0.96),\n    rgba(13, 19, 28, 0.97)\n  );\n  clip-path: polygon(\n    0 0,\n    calc(100% - 15px) 0,\n    100% 15px,\n    100% 100%,\n    0 100%\n  );\n}\n.festival-section-label {\n  color: #b7c0bd;\n  font-size: 10px;\n  letter-spacing: 2px;\n}\n.festival-progress-info strong {\n  color: var(--fest-lime);\n  font-size: 24px;\n  font-weight: 1000;\n}\n.festival-progress-percent {\n  color: var(--fest-gold);\n  font-size: 22px;\n  font-weight: 1000;\n}\n.festival-progress-track {\n  height: 10px;\n  margin-top: 5px;\n  border-radius: 0;\n  background: #30363b;\n}\n.festival-progress-fill {\n  border-radius: 0;\n  background: linear-gradient(\n    90deg,\n    #718f28,\n    var(--fest-lime),\n    #e5ff9c\n  );\n  box-shadow: 0 0 15px rgba(165, 245, 27, 0.3);\n}\n/* SECTION HEADINGS */\n.festival-section-heading {\n  margin-bottom: 22px;\n}\n.festival-section-heading h3 {\n  color: #f5f3e9;\n  font-size: clamp(20px, 2.5vw, 28px);\n  font-style: italic;\n  letter-spacing: 1px;\n}\n.festival-tier-count,\n.festival-refresh-label,\n.festival-daily-label {\n  color: var(--fest-lime);\n  font-size: 10px;\n  letter-spacing: 1.5px;\n}\n/* REWARD TRACK */\n.festival-track-container {\n  padding: 0 0 12px;\n  border: 1px solid rgba(246, 216, 74, 0.2);\n  border-radius: 0;\n  background: rgba(8, 13, 20, 0.94);\n  scrollbar-color: var(--fest-lime) #202833;\n}\n.festival-track {\n  padding: 18px;\n}\n.festival-tier-header {\n  min-height: 76px;\n  border: 1px solid #38413e;\n  border-radius: 0;\n  background: linear-gradient(\n    180deg,\n    #29312f,\n    #151d22\n  );\n}\n.festival-tier-number {\n  color: #e8e6d9;\n  font-size: 12px;\n  letter-spacing: 1.5px;\n}\n.festival-tier-header strong {\n  color: #aeb8ae;\n  font-size: 10px;\n}\n.festival-tier-header.tier-unlocked {\n  border-color: var(--fest-lime);\n  background: linear-gradient(\n    180deg,\n    rgba(165, 245, 27, 0.2),\n    #17221d\n  );\n  box-shadow: inset 0 0 15px rgba(165, 245, 27, 0.08);\n}\n.festival-tier-header.tier-unlocked .festival-tier-number,\n.festival-tier-header.tier-unlocked strong {\n  color: var(--fest-lime);\n}\n/* FREE AND ELITE REWARD CARDS */\n.festival-reward-slot {\n  min-height: 195px;\n  gap: 10px;\n  padding: 13px 8px;\n  border: 1px solid rgba(255, 255, 255, 0.12);\n  border-radius: 0;\n  background: linear-gradient(\n    145deg,\n    #222b30,\n    #111920\n  );\n}\n.festival-reward-slot:hover {\n  border-color: var(--fest-lime);\n  box-shadow: 0 7px 18px rgba(165, 245, 27, 0.1);\n}\n.reward-name {\n  color: #e4e3d9;\n  font-size: 10px;\n  line-height: 1.5;\n}\n.reward-status {\n  color: var(--fest-lime);\n  font-size: 9px;\n  letter-spacing: 1px;\n}\n.reward-icon {\n  color: var(--fest-gold);\n}\n.free-reward-row .character-reward-slot {\n  border-color: rgba(165, 245, 27, 0.55);\n  border-radius: 0;\n  background: linear-gradient(\n    180deg,\n    rgba(165, 245, 27, 0.12),\n    #131c1c\n  );\n}\n.elite-reward-row .character-reward-slot {\n  border-color: rgba(246, 216, 74, 0.7);\n  border-radius: 0;\n  background: linear-gradient(\n    180deg,\n    rgba(246, 216, 74, 0.13),\n    #1c1b19\n  );\n  box-shadow: inset 0 0 16px rgba(246, 216, 74, 0.05);\n}\n.elite-reward-row .character-reward-slot:hover {\n  border-color: var(--fest-gold);\n  box-shadow: 0 7px 20px rgba(246, 216, 74, 0.15);\n}\n.elite-reward-row .reward-character-image {\n  filter: drop-shadow(0 0 8px rgba(246, 216, 74, 0.4));\n}\n/* TRACK LABELS */\n.festival-reward-label {\n  display: flex;\n  flex-direction: column;\n  align-items: center;\n  justify-content: center;\n  gap: 9px;\n  border: 1px solid rgba(246, 216, 74, 0.2);\n  background: #1a2228;\n}\n.festival-reward-label strong {\n  color: #e8e5d8;\n  font-size: 11px;\n  letter-spacing: 2px;\n}\n.free-reward-row .festival-reward-label {\n  border-left: 3px solid var(--fest-lime);\n}\n.elite-reward-row .festival-reward-label {\n  border-left: 3px solid var(--fest-gold);\n}\n.festival-track-divider {\n  padding: 14px;\n  border-top: 1px solid rgba(246, 216, 74, 0.2);\n  border-bottom: 1px solid rgba(246, 216, 74, 0.2);\n  background: rgba(246, 216, 74, 0.045);\n  color: var(--fest-gold);\n  font-size: 10px;\n  font-weight: 1000;\n  letter-spacing: 3px;\n  text-align: center;\n}\n.festival-track-hint {\n  color: #aab3c0;\n  font-size: 9px;\n  letter-spacing: 2px;\n}\n/* CLAIM BUTTONS */\n.festival-claim-button {\n  border: 1px solid rgba(165, 245, 27, 0.55);\n  border-radius: 0;\n  background: rgba(165, 245, 27, 0.08);\n  color: var(--fest-lime);\n  font-size: 8px;\n  font-weight: 1000;\n  letter-spacing: 0.7px;\n  clip-path: polygon(\n    0 0,\n    calc(100% - 7px) 0,\n    100% 7px,\n    100% 100%,\n    7px 100%,\n    0 calc(100% - 7px)\n  );\n}\n.festival-claim-button:not(:disabled):hover {\n  border-color: var(--fest-lime);\n  background: var(--fest-lime);\n  color: #11180d;\n  box-shadow: 0 0 16px rgba(165, 245, 27, 0.25);\n}\n.elite-reward-row .festival-claim-button {\n  border-color: rgba(246, 216, 74, 0.65);\n  background: rgba(246, 216, 74, 0.08);\n  color: var(--fest-gold);\n}\n.elite-reward-row .festival-claim-button:not(:disabled):hover {\n  background: var(--fest-gold);\n  color: #17140a;\n  box-shadow: 0 0 16px rgba(246, 216, 74, 0.25);\n}\n/* ELITE PASS */\n.festival-elite-banner {\n  position: relative;\n  margin-top: 30px;\n  padding: 25px;\n  border: 1px solid rgba(246, 216, 74, 0.55);\n  border-left: 5px solid var(--fest-gold);\n  border-radius: 0;\n  background:\n    radial-gradient(\n      ellipse at 15% 50%,\n      rgba(246, 216, 74, 0.12),\n      transparent 55%\n    ),\n    linear-gradient(\n      110deg,\n      #292820,\n      #171b20\n    );\n  clip-path: polygon(\n    0 0,\n    calc(100% - 17px) 0,\n    100% 17px,\n    100% 100%,\n    17px 100%,\n    0 calc(100% - 17px)\n  );\n}\n.elite-crown {\n  color: var(--fest-gold);\n  font-size: 42px;\n  filter: drop-shadow(0 0 10px rgba(246, 216, 74, 0.3));\n}\n.festival-elite-banner h4 {\n  color: var(--fest-gold);\n  font-size: 17px;\n  font-style: italic;\n  letter-spacing: 1px;\n}\n.festival-elite-banner p {\n  color: #c5c2b5;\n  line-height: 1.6;\n}\n.festival-coin-balance {\n  color: var(--fest-lime);\n  font-size: 11px;\n  letter-spacing: 1px;\n}\n.festival-elite-button {\n  padding: 13px 22px;\n  border: 1px solid var(--fest-gold);\n  border-radius: 0;\n  background: linear-gradient(\n    110deg,\n    #76602a,\n    #3c3420\n  );\n  color: #fff1b4;\n  font-size: 10px;\n  font-weight: 1000;\n  letter-spacing: 1.3px;\n  cursor: pointer;\n  clip-path: polygon(\n    0 0,\n    calc(100% - 11px) 0,\n    100% 11px,\n    100% 100%,\n    11px 100%,\n    0 calc(100% - 11px)\n  );\n}\n.festival-elite-button:not(:disabled):hover {\n  background: var(--fest-gold);\n  color: #17140a;\n  box-shadow: 0 0 22px rgba(246, 216, 74, 0.25);\n}\n.festival-elite-button:disabled {\n  border-color: var(--fest-lime);\n  background: rgba(165, 245, 27, 0.1);\n  color: var(--fest-lime);\n  opacity: 1;\n  cursor: default;\n}\n/* CHALLENGES AND DAILY OBJECTIVES */\n.festival-challenges-section,\n.festival-daily-section {\n  margin-bottom: 65px;\n}\n.festival-challenge-card {\n  position: relative;\n  min-height: 215px;\n  padding: 20px;\n  border: 1px solid rgba(246, 216, 74, 0.18);\n  border-left: 3px solid rgba(165, 245, 27, 0.6);\n  border-radius: 0;\n  background: linear-gradient(\n    145deg,\n    rgba(32, 42, 43, 0.96),\n    rgba(13, 19, 28, 0.98)\n  );\n  transition:\n    transform 180ms ease,\n    border-color 180ms ease,\n    box-shadow 180ms ease;\n}\n.festival-challenge-card:hover {\n  transform: translateY(-4px);\n  border-color: var(--fest-lime);\n  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);\n}\n.challenge-icon {\n  font-size: 26px;\n}\n.challenge-category {\n  color: var(--fest-gold);\n  font-size: 9px;\n  letter-spacing: 1.5px;\n}\n.festival-challenge-card h4 {\n  color: #f6f2df;\n  font-size: 15px;\n  letter-spacing: 0.5px;\n}\n.festival-challenge-card p {\n  color: #aeb8bb;\n  font-size: 11px;\n  line-height: 1.65;\n}\n.challenge-points {\n  color: var(--fest-lime);\n  font-size: 13px;\n  font-weight: 1000;\n}\n.challenge-progress {\n  color: #b7b9ad;\n  font-size: 10px;\n}\n.challenge-progress-track {\n  height: 5px;\n  border-radius: 0;\n  background: #343b3c;\n}\n.challenge-progress-fill {\n  border-radius: 0;\n  background: linear-gradient(\n    90deg,\n    #708f29,\n    var(--fest-lime)\n  );\n  box-shadow: 0 0 9px rgba(165, 245, 27, 0.25);\n}\n.challenge-completed {\n  border-color: var(--fest-lime);\n  box-shadow: inset 0 0 18px rgba(165, 245, 27, 0.06);\n}\n.challenge-complete-label {\n  color: var(--fest-lime);\n  font-size: 9px;\n  letter-spacing: 1.5px;\n}\n/* DAILY OBJECTIVES */\n.festival-daily-grid .festival-challenge-card {\n  min-height: 205px;\n}\n/* REWARD POPUP */\n.festival-reward-popup {\n  border: 2px solid var(--fest-lime);\n  border-radius: 0;\n  background:\n    radial-gradient(\n      ellipse at 50% 0%,\n      rgba(165, 245, 27, 0.14),\n      transparent 60%\n    ),\n    linear-gradient(145deg, #252d2c, #10161e);\n  box-shadow: 0 0 35px rgba(165, 245, 27, 0.18);\n  clip-path: polygon(\n    0 0,\n    calc(100% - 18px) 0,\n    100% 18px,\n    100% 100%,\n    18px 100%,\n    0 calc(100% - 18px)\n  );\n}\n.reward-popup-eyebrow {\n  color: var(--fest-lime);\n}\n.festival-reward-popup h2 {\n  color: #fff8df;\n  text-shadow: 0 0 15px rgba(165, 245, 27, 0.25);\n}\n.reward-popup-description {\n  color: #c5c9bd;\n}\n.reward-popup-line {\n  background: var(--fest-lime);\n  box-shadow: 0 0 15px rgba(165, 245, 27, 0.5);\n}\n.character-reward-popup {\n  border-color: var(--fest-gold);\n  box-shadow: 0 0 35px rgba(246, 216, 74, 0.2);\n}\n.character-reward-popup .reward-popup-eyebrow,\n.character-reward-popup h2 {\n  color: var(--fest-gold);\n}\n.character-reward-popup .reward-popup-line {\n  background: var(--fest-gold);\n}\n/* RESPONSIVE */\n@media (max-width: 900px) {\n  .festival-intro {\n    margin-top: 45px;\n  }\n\n  .festival-progress-section {\n    padding: 19px;\n  }\n}\n@media (max-width: 600px) {\n  .festival-screen {\n    padding: 18px 14px 40px;\n  }\n\n  .festival-intro {\n    margin: 35px auto;\n    padding: 28px 12px;\n  }\n\n  .festival-intro h2 {\n    font-size: clamp(32px, 10vw, 45px);\n    line-height: 1.05;\n  }\n\n  .festival-status {\n    gap: 7px;\n  }\n\n  .festival-status span {\n    font-size: 8px;\n  }\n\n  .festival-progress-info strong {\n    font-size: 18px;\n  }\n\n  .festival-elite-banner {\n    padding: 19px;\n  }\n\n  .festival-elite-button {\n    width: 100%;\n  }\n}\n@media (prefers-reduced-motion: reduce) {\n  .festival-screen *,\n  .festival-screen *::before,\n  .festival-screen *::after {\n    scroll-behavior: auto !important;\n    animation-duration: 0.01ms !important;\n    transition-duration: 0.01ms !important;\n  }\n}\n/* ==========================================\n   WILD CARDS FESTIVAL — GAMER TYPOGRAPHY\n========================================== */\n/* Main Festival typography */\n.festival-screen {\n  font-family: \"Rajdhani\", sans-serif;\n  font-weight: 600;\n}\n/* Strong display typography */\n.festival-logo h1,\n.festival-intro h2,\n.festival-section-heading h3,\n.festival-elite-banner h4,\n.festival-reward-popup h2 {\n  font-family: \"Oxanium\", sans-serif;\n  font-weight: 800;\n  letter-spacing: 2px;\n}\n/* Logo */\n.festival-logo h1 {\n  font-size: 21px;\n  letter-spacing: 2.5px;\n}\n/* Main title */\n.festival-intro h2 {\n  font-size: clamp(38px, 5vw, 64px);\n  letter-spacing: 4px;\n  text-transform: uppercase;\n}\n/* Small category labels */\n.festival-eyebrow,\n.festival-section-label,\n.festival-tier-count,\n.festival-refresh-label,\n.festival-daily-label,\n.challenge-category,\n.reward-popup-eyebrow {\n  font-family: \"Oxanium\", sans-serif;\n  font-weight: 700;\n  letter-spacing: 1.5px;\n}\n/* Descriptions and supporting information */\n.festival-description,\n.festival-elite-banner p,\n.festival-challenge-card p,\n.festival-daily-card p,\n.reward-popup-description {\n  font-family: \"Rajdhani\", sans-serif;\n  font-weight: 600;\n  letter-spacing: 0.3px;\n  line-height: 1.5;\n}\n/* Challenge titles */\n.festival-challenge-card h4,\n.festival-daily-card h4 {\n  font-family: \"Oxanium\", sans-serif;\n  font-weight: 700;\n  letter-spacing: 0.5px;\n}\n/* Reward track */\n.festival-reward-label,\n.festival-tier-number,\n.festival-tier-header strong,\n.reward-name,\n.reward-status {\n  font-family: \"Oxanium\", sans-serif;\n  font-weight: 700;\n}\n/* Progress and reward values */\n.festival-progress-info strong,\n.festival-progress-percent,\n.challenge-points,\n.festival-daily-card strong,\n.festival-coin-balance {\n  font-family: \"Oxanium\", sans-serif;\n  font-weight: 800;\n}\n/* Buttons */\n.festival-back-button,\n.festival-elite-button,\n.festival-claim-button,\n.festival-test-button {\n  font-family: \"Oxanium\", sans-serif;\n  font-weight: 700;\n  letter-spacing: 1px;\n}\n/* Reward popup */\n.festival-reward-popup,\n.festival-reward-popup button {\n  font-family: \"Rajdhani\", sans-serif;\n}\n.festival-reward-popup h2 {\n  letter-spacing: 1.5px;\n}\n/* Responsive title sizing */\n@media (max-width: 600px) {\n  .festival-intro h2 {\n    font-size: 36px;\n    letter-spacing: 2px;\n  }\n\n  .festival-logo h1 {\n    font-size: 18px;\n  }\n}\n/* Festival-exclusive attack artwork in reward cards and claim popups */\n.reward-attack-image {\n  width: 100%;\n  max-width: 118px;\n  height: 100px;\n  object-fit: cover;\n  object-position: center;\n  border: 1px solid rgba(19, 213, 255, 0.38);\n  border-radius: 5px;\n  background: rgba(3, 12, 24, 0.7);\n  filter: drop-shadow(0 0 7px rgba(19, 213, 255, 0.24));\n}\n.elite-reward-row .reward-attack-image {\n  border-color: rgba(246, 216, 74, 0.48);\n  filter: drop-shadow(0 0 8px rgba(246, 216, 74, 0.3));\n}\n.reward-popup-attack-image {\n  width: 190px;\n  height: 155px;\n  object-fit: contain;\n  border: 1px solid rgba(19, 213, 255, 0.4);\n  border-radius: 7px;\n  background: rgba(3, 12, 24, 0.65);\n  padding: 5px;\n}\n"],["STYLE",{},"\n.story-reward-screen {\n  min-height: 100vh;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  padding: 30px 16px;\n  background:\n    radial-gradient(circle at center, #263b59 0%, #101827 55%, #080d16 100%);\n  color: white;\n  text-align: center;\n  overflow: hidden;\n}\n\n.story-reward-content {\n  width: 100%;\n  max-width: 550px;\n  animation: story-reward-enter 0.7s ease-out both;\n}\n\n.story-reward-eyebrow {\n  color: #13d5ff;\n  font-size: 13px;\n  font-weight: 800;\n  letter-spacing: 4px;\n  margin-bottom: 12px;\n}\n\n.story-reward-title {\n  color: #ffd76a;\n  font-size: clamp(30px, 6vw, 48px);\n  font-weight: 900;\n  letter-spacing: 2px;\n  text-shadow: 0 0 18px rgba(255, 190, 60, 0.45);\n  margin-bottom: 22px;\n}\n\n.story-reward-character {\n  position: relative;\n  width: 160px;\n  height: 210px;\n  margin: 0 auto 18px;\n  display: flex;\n  justify-content: center;\n  align-items: center;\n}\n\n.story-reward-character img {\n  position: relative;\n  z-index: 1;\n  width: 125px;\n  height: 190px;\n  object-fit: contain;\n  filter: drop-shadow(0 0 12px rgba(19, 213, 255, 0.5));\n  animation: story-reward-reveal 1s ease-out both;\n}\n\n.story-reward-glow {\n  position: absolute;\n  width: 150px;\n  height: 150px;\n  border-radius: 50%;\n  background: rgba(19, 213, 255, 0.2);\n  filter: blur(35px);\n  animation: story-reward-pulse 2.5s ease-in-out infinite;\n}\n\n.story-reward-name {\n  font-size: 27px;\n  font-weight: 900;\n  margin: 10px 0;\n}\n\n.story-reward-unlocked {\n  color: #69f5a5;\n  font-size: 15px;\n  font-weight: 900;\n  letter-spacing: 3px;\n  margin-bottom: 15px;\n}\n\n.story-reward-description {\n  max-width: 420px;\n  margin: 0 auto 15px;\n  color: #d5e0ed;\n  line-height: 1.6;\n}\n\n.story-reward-requirement {\n  color: #9db3ca;\n  font-size: 12px;\n  letter-spacing: 1px;\n  margin-bottom: 25px;\n}\n\n.story-reward-continue {\n  min-width: 190px;\n  padding: 13px 28px;\n  border: 2px solid #13d5ff;\n  border-radius: 5px;\n  background: #13d5ff;\n  color: #07121e;\n  font-weight: 900;\n  letter-spacing: 2px;\n  cursor: pointer;\n  transition: 0.2s ease;\n}\n\n.story-reward-continue:hover {\n  background: transparent;\n  color: #13d5ff;\n  box-shadow: 0 0 18px rgba(19, 213, 255, 0.35);\n  transform: translateY(-2px);\n}\n\n@keyframes story-reward-enter {\n  from {\n    opacity: 0;\n    transform: translateY(25px);\n  }\n\n  to {\n    opacity: 1;\n    transform: translateY(0);\n  }\n}\n\n@keyframes story-reward-reveal {\n  from {\n    opacity: 0;\n    transform: scale(0.65);\n  }\n\n  to {\n    opacity: 1;\n    transform: scale(1);\n  }\n}\n\n@keyframes story-reward-pulse {\n  0%, 100% {\n    opacity: 0.45;\n    transform: scale(0.9);\n  }\n\n  50% {\n    opacity: 0.9;\n    transform: scale(1.12);\n  }\n}\n"],["STYLE",{},"\n.story-cutscene {\n  --vn-accent: #13d5ff;\n  --vn-panel: rgba(9, 17, 34, 0.88);\n\n  position: relative;\n  display: flex;\n  flex-direction: column;\n  width: 100%;\n  height: 100vh;\n  height: 100dvh;\n  min-height: 500px;\n  box-sizing: border-box;\n  overflow: hidden;\n  color: #f6f8ff;\n  background: #080f20;\n  font-family: inherit;\n}\n\n/* =========================\n   HEADER\n========================= */\n\n.vn-header {\n  position: relative;\n  z-index: 10;\n  flex: 0 0 auto;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 16px;\n  padding: 12px 4%;\n  background: #080f20ed;\n  border-bottom: 1px solid #ffffff18;\n}\n\n.vn-logo {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  font-size: 0.85rem;\n  font-weight: 900;\n  letter-spacing: 1px;\n}\n\n.vn-logo-mark {\n  display: grid;\n  place-items: center;\n  width: 34px;\n  height: 30px;\n  color: var(--vn-accent);\n  border: 2px solid var(--vn-accent);\n  transform: skew(-8deg);\n}\n\n.vn-chapter {\n  color: #9eafc8;\n  font-size: 0.7rem;\n  font-weight: 800;\n  letter-spacing: 1px;\n}\n\n.vn-skip {\n  padding: 8px 12px;\n  color: #d9e8fa;\n  background: transparent;\n  border: 1px solid #8296b555;\n  font: inherit;\n  font-size: 0.7rem;\n  font-weight: 800;\n  cursor: pointer;\n}\n\n.vn-skip:hover {\n  color: var(--vn-accent);\n  border-color: var(--vn-accent);\n}\n\n/* =========================\n   SCENE AND BACKGROUNDS\n========================= */\n\n.vn-scene {\n  position: relative;\n  isolation: isolate;\n  flex: 1 1 auto;\n  min-height: 0;\n  overflow: hidden;\n  cursor: pointer;\n  background-color: #142844;\n  background-image:\n    radial-gradient(ellipse at 50% 85%, #28517b 0%, transparent 60%),\n    linear-gradient(145deg, #182b49, #0a1225 80%);\n  background-position: center;\n  background-size: cover;\n  background-repeat: no-repeat;\n}\n\n.vn-scene.vn-bg-opening {\n  background-image:\n    linear-gradient(0deg, #080f2066, transparent 70%),\n    radial-gradient(ellipse at 50% 50%, #1c4770, transparent 65%),\n    linear-gradient(135deg, #182f50, #080f20);\n}\n\n.vn-scene.vn-bg-arena {\n  background-image:\n    linear-gradient(rgba(8, 15, 32, 0.2), rgba(8, 15, 32, 0.45)),\n    url(\"../../../assets/img/Arena.jpg\");\n\n  background-position: center;\n  background-size: cover;\n  background-repeat: no-repeat;\n}\n\n/*\n  Optional image backgrounds:\n  Put these files in public/StoryBackgrounds/.\n  Then uncomment the corresponding background-image rule.\n*/\n\n/*\n.vn-scene.vn-bg-arena {\n  background-image:\n    linear-gradient(0deg, #080f2070, transparent 70%),\n    url(\"/StoryBackgrounds/arena.jpg\");\n}\n\n.vn-scene.vn-bg-opening {\n  background-image:\n    linear-gradient(0deg, #080f2070, transparent 70%),\n    url(\"/StoryBackgrounds/opening.jpg\");\n}\n*/\n\n.vn-atmosphere {\n  position: absolute;\n  z-index: 0;\n  inset: 0;\n  background:\n    linear-gradient(0deg, #080f2070, transparent 40%),\n    linear-gradient(90deg, #07102030, transparent 50%, #07102030);\n  pointer-events: none;\n}\n\n.vn-scene-caption {\n  position: absolute;\n  z-index: 1;\n  top: 20px;\n  left: 4%;\n  padding: 7px 11px;\n  color: #c6d9f0;\n  background: #080f2077;\n  border-left: 2px solid var(--vn-accent);\n  font-size: 0.65rem;\n  font-weight: 900;\n  letter-spacing: 2px;\n  pointer-events: none;\n}\n\n.vn-click-hint {\n  position: absolute;\n  z-index: 1;\n  right: 4%;\n  bottom: 20px;\n  color: #ffffff75;\n  font-size: 0.6rem;\n  letter-spacing: 1px;\n  pointer-events: none;\n}\n\n/* =========================\n   CHARACTER POSITIONING\n========================= */\n\n.vn-character {\n  position: absolute;\n  z-index: 2;\n  bottom: 0;\n\n  height: min(76%, 650px);\n  width: min(40%, 420px);\n\n  display: flex;\n  align-items: flex-end;\n  justify-content: center;\n\n  pointer-events: none;\n  transform-origin: center bottom;\n\n  /* Smooth movement and zoom */\n  transition:\n    left 750ms cubic-bezier(.22, .8, .25, 1),\n    right 750ms cubic-bezier(.22, .8, .25, 1),\n    scale 750ms cubic-bezier(.22, .8, .25, 1);\n    \n\n  scale: var(--vn-zoom, 1);\n}\n\n/* LEFT: character stays on the left side. */\n.vn-position-left {\n  left: 0%;\n  right: auto;\n  transform: none;\n  transform-origin: left bottom;\n}\n\n/* CENTER: character is centered using its own width. */\n.vn-position-center {\n  left: 50%;\n  right: auto;\n  transform: translateX(-50%);\n  transform-origin: center bottom;\n}\n\n/* RIGHT: character stays on the right side. */\n.vn-position-right {\n  left: auto;\n  right: 0%;\n  transform: none;\n  transform-origin: right bottom;\n}\n\n/* Character animations.\n   The translate property preserves the positioning transform. */\n\n.vn-motion-enter {\n  animation: vn-enter 500ms cubic-bezier(.2, .8, .2, 1) both;\n}\n\n.vn-motion-fade {\n  animation: vn-fade 400ms ease both;\n}\n\n.vn-motion-bounce {\n  animation: vn-bounce 450ms ease both;\n}\n\n@keyframes vn-enter {\n  from {\n    opacity: 0;\n    translate: 70px 0;\n  }\n\n  to {\n    opacity: 1;\n    translate: 0 0;\n  }\n}\n\n@keyframes vn-fade {\n  from {\n    opacity: 0;\n  }\n\n  to {\n    opacity: 1;\n  }\n}\n\n@keyframes vn-bounce {\n  0% {\n    opacity: 0;\n    translate: 0 20px;\n  }\n\n  60% {\n    opacity: 1;\n    translate: 0 -10px;\n  }\n\n  100% {\n    translate: 0 0;\n  }\n}\n\n\n\n/* =========================\n   OVERLAID DIALOGUE\n========================= */\n\n.vn-dialogue-panel {\n  position: relative;\n  width: 100%;\n  min-height: 145px;\n  box-sizing: border-box;\n  padding: 28px 24px 18px;\n\n  background: var(--vn-panel);\n  border: 1px solid #8ba5c64a;\n  border-top: 2px solid var(--vn-accent);\n  border-radius: 5px;\n\n  box-shadow: 0 12px 40px #0006;\n  backdrop-filter: blur(10px);\n\n  transition:\n    opacity 180ms ease,\n    transform 180ms ease;\n}\n\n.vn-transitioning .vn-dialogue-panel {\n  opacity: 0.45;\n  transform: translateY(5px);\n}\n\n.vn-nameplate {\n  position: absolute;\n  top: -18px;\n  left: 22px;\n  min-width: 110px;\n  padding: 9px 18px;\n\n  color: #071020;\n  background: var(--vn-accent);\n  clip-path: polygon(0 0, 100% 0, 92% 100%, 0 100%);\n\n  font-size: 0.78rem;\n  font-weight: 1000;\n  letter-spacing: 1px;\n}\n\n.vn-dialogue-text {\n  min-height: 52px;\n  margin: 0 0 12px;\n  color: #f3f6ff;\n  font-size: clamp(0.95rem, 1.6vw, 1.15rem);\n  line-height: 1.7;\n  white-space: pre-wrap;\n}\n\n.vn-text-cursor {\n  display: inline-block;\n  margin-left: 3px;\n  color: var(--vn-accent);\n  animation: vn-cursor-blink 650ms steps(2, start) infinite;\n}\n\n@keyframes vn-cursor-blink {\n  to {\n    visibility: hidden;\n  }\n}\n\n.vn-next-button {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 10px;\n  margin-left: auto;\n  padding: 10px 16px;\n\n  color: #f4f8ff;\n  background: #132b43;\n  border: 1px solid #13d5ff77;\n  font: inherit;\n  font-size: 0.72rem;\n  font-weight: 900;\n  letter-spacing: 1px;\n  cursor: pointer;\n\n  transition:\n    background 160ms ease,\n    transform 160ms ease,\n    border-color 160ms ease;\n}\n\n.vn-next-button span {\n  color: var(--vn-accent);\n}\n\n.vn-next-button:hover {\n  transform: translateY(-2px);\n  background: #1a405e;\n  border-color: var(--vn-accent);\n}\n\n/* Story progress */\n\n.vn-progress {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n  margin-top: 12px;\n\n  color: #aabbd2;\n  font-size: 0.65rem;\n  font-weight: 800;\n  letter-spacing: 1px;\n}\n\n.vn-progress-track {\n  flex: 1;\n  height: 3px;\n  overflow: hidden;\n  background: #ffffff1b;\n}\n\n.vn-progress-fill {\n  height: 100%;\n  background: var(--vn-accent);\n  box-shadow: 0 0 10px #13d5ff66;\n  transition: width 250ms ease;\n}\n\n/* =========================\n   RESPONSIVE LAYOUT\n========================= */\n\n@media (max-width: 600px) {\n  .story-cutscene {\n    min-height: 480px;\n  }\n\n  .vn-header {\n    gap: 8px;\n    padding: 10px 3%;\n  }\n\n  .vn-logo {\n    gap: 6px;\n    font-size: 0.65rem;\n  }\n\n  .vn-logo-mark {\n    width: 27px;\n    height: 25px;\n  }\n\n  .vn-chapter {\n    font-size: 0.52rem;\n    text-align: center;\n  }\n\n  .vn-skip {\n    padding: 7px;\n    font-size: 0.6rem;\n  }\n\n  .vn-scene {\n    min-height: 0;\n  }\n\n\n  .vn-dialogue-area {\n    padding: 0 3% 10px;\n  }\n\n  .vn-dialogue-panel {\n    min-height: 135px;\n    padding: 27px 15px 14px;\n  }\n\n  .vn-dialogue-text {\n    min-height: 60px;\n    font-size: 0.9rem;\n  }\n\n  .vn-click-hint {\n    font-size: 0.5rem;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .vn-character,\n  .vn-character img,\n  .vn-dialogue-text,\n  .vn-text-cursor {\n    animation: none !important;\n  }\n\n  .vn-progress-fill,\n  .vn-dialogue-panel,\n  .vn-next-button {\n    transition: none !important;\n  }\n}\n\n\n/* Two independent layers allow real image crossfading. */\n.vn-background-layers {\n  position: absolute;\n  inset: 0;\n  z-index: 0;\n  overflow: hidden;\n  pointer-events: none;\n}\n\n.vn-background-layer {\n  position: absolute;\n  inset: 0;\n  background-size: cover;\n  background-position: center;\n  background-repeat: no-repeat;\n  transition: opacity 700ms ease-in-out;\n}\n\n\n.vn-background-old {\n  opacity: 1;\n  z-index: 0;\n}\n\n.vn-background-current {\n  opacity: 1;\n  z-index: 1;\n  animation: vnBackgroundEntrance 700ms ease-in-out both;\n}\n\n@keyframes vnBackgroundEntrance {\n  from {\n    opacity: 0;\n  }\n\n  to {\n    opacity: 1;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  .vn-background-current {\n    animation: none;\n  }\n}\n/* =========================\n   ROCK LEE PUSH-UP POSES\n========================= */\n\n.vn-character-rocklee-pushups {\n\n  /* Raise Lee above the dialogue box */\n\n  /* Put Lee above the dialogue layer */\n  z-index: 6;\n  height: min(58%, 500px);\n  bottom: 190px;\n\n  pointer-events: none;\n}\n\n/* Dialogue stays below the special character sprite */\n.vn-dialogue-area {\n  position: absolute;\n  z-index: 5;\n  left: 0;\n  right: 0;\n  bottom: 0;\n\n  padding: 0 4% 16px;\n  box-sizing: border-box;\n\n  background: linear-gradient(\n    180deg,\n    transparent,\n    #080f2040 10%,\n    #080f20b8 100%\n  );\n\n  cursor: pointer;\n}\n\n/* Mobile adjustments */\n@media (max-width: 600px) {\n  .vn-character-rocklee-pushups {\n    height: 48%;\n    bottom: 205px;\n  }\n}\n\n/* =========================\n   CHARACTER EXPRESSION ANIMATIONS\n========================= */\n\n/* Default idle: subtle breathing for every character. */\n.vn-character img {\n  display: block;\n  width: auto;\n  height: 100%;\n  max-width: 100%;\n  object-fit: contain;\n  object-position: center bottom;\n  filter: drop-shadow(0 12px 18px #0005);\n  user-select: none;\n  transform-origin: center bottom;\n  animation: vn-idle 4s ease-in-out infinite;\n}\n\n/* Neutral: calm breathing. */\n.vn-expression-neutral img {\n  animation: vn-idle 4s ease-in-out infinite;\n}\n\n/* Happy: gentle, friendly bounce. */\n.vn-expression-happy img {\n  filter: drop-shadow(0 0 16px #ffd16666);\n  animation: vn-happy 2.2s ease-in-out infinite;\n}\n\n/* Excited: more energetic movement. */\n.vn-expression-excited img {\n  filter: drop-shadow(0 0 20px #13d5ff88);\n  animation: vn-excited 1.3s ease-in-out infinite;\n}\n\n/* Angry: brief bursts of shaking, with pauses. */\n.vn-expression-angry img {\n  animation: vn-angry 2.6s ease-in-out infinite;\n}\n\n/* Determined: subtle forward movement. */\n.vn-expression-determined img {\n  filter: drop-shadow(0 10px 14px #ff315966);\n  animation: vn-determined 3s ease-in-out infinite;\n}\n\n/* Serious: almost still, with restrained breathing. */\n.vn-expression-serious img {\n  animation: vn-serious 5s ease-in-out infinite;\n}\n\n/* Tenten: understanding / relating with a small nod. */\n.vn-expression-relate img {\n  animation: vn-relate 3s ease-in-out infinite;\n}\n\n/* Tenten: facepalm with a slight head-and-body dip. */\n.vn-expression-facepalm img {\n  animation: vn-facepalm 3.5s ease-in-out infinite;\n}\n\n/* Tenten: exasperated head tilt. */\n.vn-expression-exasperated img {\n  animation: vn-exasperated 3s ease-in-out infinite;\n}\n\n/* Rock Lee: alternating push-up poses. */\n.vn-expression-pushups1 img {\n  animation: vn-pushup-up 1.2s ease-in-out infinite;\n}\n\n.vn-expression-pushups2 img {\n  animation: vn-pushup-down 1.2s ease-in-out infinite;\n}\n\n\n/* =========================\n   ANIMATION KEYFRAMES\n========================= */\n\n@keyframes vn-idle {\n  0%, 100% {\n    transform: translateY(0);\n  }\n\n  50% {\n    transform: translateY(-4px);\n  }\n}\n\n@keyframes vn-happy {\n  0%, 100% {\n    transform: translateY(0);\n  }\n\n  50% {\n    transform: translateY(-9px);\n  }\n}\n\n@keyframes vn-excited {\n  0%, 100% {\n    transform: translateY(0) scale(1);\n  }\n\n  25% {\n    transform: translateY(-8px) scale(1.015);\n  }\n\n  50% {\n    transform: translateY(0) scale(1);\n  }\n\n  75% {\n    transform: translateY(-5px) scale(1.01);\n  }\n}\n\n@keyframes vn-angry {\n  0%, 75%, 100% {\n    transform: translateX(0);\n  }\n\n  78% {\n    transform: translateX(-4px);\n  }\n\n  81% {\n    transform: translateX(4px);\n  }\n\n  84% {\n    transform: translateX(-3px);\n  }\n\n  87% {\n    transform: translateX(3px);\n  }\n\n  90% {\n    transform: translateX(0);\n  }\n}\n\n@keyframes vn-determined {\n  0%, 100% {\n    transform: translateY(0) scale(1);\n  }\n\n  50% {\n    transform: translateY(-3px) scale(1.01);\n  }\n}\n\n@keyframes vn-serious {\n  0%, 100% {\n    transform: translateY(0);\n  }\n\n  50% {\n    transform: translateY(-2px);\n  }\n}\n\n@keyframes vn-relate {\n  0%, 100% {\n    transform: rotate(0);\n  }\n\n  35% {\n    transform: rotate(-0.8deg) translateY(-2px);\n  }\n\n  65% {\n    transform: rotate(0.5deg) translateY(0);\n  }\n}\n\n@keyframes vn-facepalm {\n  0%, 100% {\n    transform: translateY(0) rotate(0);\n  }\n\n  50% {\n    transform: translateY(3px) rotate(1deg);\n  }\n}\n\n@keyframes vn-exasperated {\n  0%, 100% {\n    transform: rotate(0);\n  }\n\n  40% {\n    transform: rotate(-2deg);\n  }\n\n  70% {\n    transform: rotate(2deg);\n  }\n}\n\n@keyframes vn-pushup-up {\n  0%, 100% {\n    transform: translateY(0);\n  }\n\n  50% {\n    transform: translateY(-3px);\n  }\n}\n\n@keyframes vn-pushup-down {\n  0%, 100% {\n    transform: translateY(0);\n  }\n\n  50% {\n    transform: translateY(3px);\n  }\n}\n\n\n\n\n/* Beat-synced Story Mode logo animations.\n   Swap wc-beat-animation--bounce for --shake, --pulse, --tilt or --pop. */\n.wc-rhythm-active .vn-logo.wc-beat-animation--bounce {\n  animation: wc-logo-bounce var(--wc-beat-duration, 0.5s) ease-in-out infinite;\n}\n.wc-rhythm-active .vn-logo.wc-beat-animation--shake {\n  animation: wc-logo-shake var(--wc-beat-duration, 0.5s) steps(1, end) infinite;\n}\n.wc-rhythm-active .vn-logo.wc-beat-animation--pulse {\n  animation: wc-logo-pulse var(--wc-beat-duration, 0.5s) ease-in-out infinite;\n}\n.wc-rhythm-active .vn-logo.wc-beat-animation--tilt {\n  animation: wc-logo-tilt var(--wc-beat-duration, 0.5s) ease-in-out infinite;\n}\n.wc-rhythm-active .vn-logo.wc-beat-animation--pop {\n  animation: wc-logo-pop var(--wc-beat-duration, 0.5s) cubic-bezier(.2,.8,.2,1) infinite;\n}\n@keyframes wc-logo-bounce {\n  0%, 100% { transform: translateY(0) scale(1); }\n  16% { transform: translateY(-6px) scale(1.03); }\n  32% { transform: translateY(0) scale(1); }\n}\n@keyframes wc-logo-shake {\n  0%, 100% { transform: translateX(0) rotate(0); }\n  12% { transform: translateX(-3px) rotate(-1deg); }\n  24% { transform: translateX(3px) rotate(1deg); }\n  36% { transform: translateX(-2px) rotate(-.5deg); }\n  48% { transform: translateX(0) rotate(0); }\n}\n@keyframes wc-logo-pulse {\n  0%, 100% { transform: scale(1); filter: brightness(1); }\n  18% { transform: scale(1.05); filter: brightness(1.18); }\n  36% { transform: scale(1); filter: brightness(1); }\n}\n@keyframes wc-logo-tilt {\n  0%, 100% { transform: rotate(0) translateY(0); }\n  18% { transform: rotate(-3deg) translateY(-2px); }\n  36% { transform: rotate(3deg) translateY(0); }\n  54% { transform: rotate(0); }\n}\n@keyframes wc-logo-pop {\n  0%, 100% { transform: scale(1); }\n  14% { transform: scale(1.1); }\n  28% { transform: scale(.98); }\n  42% { transform: scale(1); }\n}\n@media (prefers-reduced-motion: reduce) {\n  .wc-rhythm-active .vn-logo[class*=\"wc-beat-animation--\"] { animation: none !important; }\n}\n"]],"\n\n  ",["BODY",{},"\n    ",["DIV",{"id":"app"},["MAIN",{"class":"game-intro ","aria-live":"polite"},["DIV",{"class":"game-intro-grid"}],["DIV",{"class":"game-intro-scanlines"}],["SECTION",{"class":"game-intro-card game-intro-credit"},["SPAN",{"class":"game-intro-index"},"INTRODUCTION"],["DIV",{"class":"game-intro-copy"},["SPAN",{},"A PRODUCTION"]],["SPAN",{"class":"game-intro-progress"},"01"," / 04"]],["BUTTON",{"type":"button","class":"game-intro-skip"},"PRESS ANY KEY TO SKIP ",["SPAN",{},"▶"]]]],"\n\n    ","\n  \n"]],"viewport":{"width":1280,"height":720},"timestamp":22538.786,"wallTime":1795834617890,"collectionTime":2.300000000046566,"resourceOverrides":[],"isMainFrame":true}}
