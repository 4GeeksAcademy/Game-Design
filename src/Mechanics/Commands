// Unlock one specific character:


const unlocked = JSON.parse(
  localStorage.getItem("fightersArenaUnlockedCharacters") || "[]"
);

if (!unlocked.includes("goku")) {
  unlocked.push("goku");
}

localStorage.setItem(
  "fightersArenaUnlockedCharacters",
  JSON.stringify(unlocked)
);

window.dispatchEvent(new Event("unlocksUpdated"));

console.log("Goku unlocked!");




// Reset character unlocks to the starter roster:
localStorage.removeItem("fightersArenaUnlockedCharacters");

window.dispatchEvent(new Event("unlocksUpdated"));

console.log("Character unlocks reset!");


// Check unlocked characters:
console.log(
  JSON.parse(
    localStorage.getItem("fightersArenaUnlockedCharacters") || "[]"
  )
);

// Add 1,000 Festival points:
const key = "fighters-arena-combat-festival-2026";

const progress = JSON.parse(
  localStorage.getItem(key) || "{}"
);

progress.points = Math.min(
  20000,
  (Number(progress.points) || 0) + 1000
);

localStorage.setItem(key, JSON.stringify({
  festivalId: "combat-festival-2026",
  points: progress.points,
  elitePassOwned: progress.elitePassOwned ?? false,
  claimedFreeRewards: progress.claimedFreeRewards ?? [],
  claimedEliteRewards: progress.claimedEliteRewards ?? []
}));

window.dispatchEvent(
  new CustomEvent("festivalProgressUpdated", {
    detail: progress
  })
);

console.log("Festival points:", progress.points);

// Set Festival points to a specific amount:

// For example, 25,000 points:

const progress = JSON.parse(
  localStorage.getItem(key) || "{}"
);

progress.points = 25000;

localStorage.setItem(key, JSON.stringify({
  festivalId: "combat-festival-2026",
  points: 25000,
  elitePassOwned: progress.elitePassOwned ?? false,
  claimedFreeRewards: progress.claimedFreeRewards ?? [],
  claimedEliteRewards: progress.claimedEliteRewards ?? []
}));

window.dispatchEvent(
  new CustomEvent("festivalProgressUpdated", {
    detail: progress
  })
);


// Reset Festival points and rewards:
localStorage.removeItem("fighters-arena-combat-festival-2026");

window.dispatchEvent(
  new CustomEvent("festivalProgressUpdated", {
    detail: {
      festivalId: "combat-festival-2026",
      points: 0,
      elitePassOwned: false,
      claimedFreeRewards: [],
      claimedEliteRewards: []
    }
  })
);

console.log("Festival progress reset!");


// Reset all owned skins:
localStorage.removeItem("fightersArenaOwnedSkins");
localStorage.removeItem("fightersArenaEquippedSkins");

window.dispatchEvent(new Event("skinsUpdated"));

console.log("Skin progress reset!");

// Check owned skins:
console.log(
  JSON.parse(
    localStorage.getItem("fightersArenaOwnedSkins") || "[]"
  )
);



// FACTORY RESET

(() => {
  const keysToReset = [
    "fightersArenaCoins",
    "fightersArenaUnlockedCharacters",

    "fightersArenaOwnedSkins",
    "fightersArenaEquippedSkins",

    "fighters-arena-combat-festival-2026",
    "fighters-arena-rotating-challenges",

    "fighters-arena-daily-objectives",

    "fightersArenaAchievements",
    "storyLevel1Complete"
  ];

  keysToReset.forEach(key => {
    localStorage.removeItem(key);
  });

  window.dispatchEvent(new Event("coinsUpdated"));
  window.dispatchEvent(new Event("unlocksUpdated"));
  window.dispatchEvent(new Event("skinsUpdated"));

  console.log("WILD CARDS FACTORY RESET COMPLETE!");

  location.reload();
})();