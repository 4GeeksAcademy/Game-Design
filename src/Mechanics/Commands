// Reset unlocked characters to the starter roster
localStorage.removeItem("fightersArenaUnlockedCharacters");

// Give yourself 10,000 coins
localStorage.setItem("fightersArenaCoins", "10000");

// Notify the game that the saved values changed
window.dispatchEvent(new Event("unlocksUpdated"));
window.dispatchEvent(new Event("coinsUpdated"));

console.log("Progress reset! Coins:", localStorage.getItem("fightersArenaCoins"));
console.log("Unlocked characters reset to the starter roster.");

localStorage.removeItem("fightersArenaOwnedSkins");


(() => {
  const keysToReset = [
    // Currency and character unlocks
    "fightersArenaCoins",
    "fightersArenaUnlockedCharacters",

    // Skins
    "fightersArenaOwnedSkins",
    "fightersArenaEquippedSkins",

    // Festival
    "fighters-arena-combat-festival-2026",
    "fighters-arena-rotating-challenges",

    // Daily objectives
    "fighters-arena-daily-objectives",

    // Achievements and story progression
    "fightersArenaAchievements",
    "storyLevel1Complete",
  ];

  keysToReset.forEach((key) => {
    localStorage.removeItem(key);
  });

  // Refresh game data and UI
  window.dispatchEvent(new Event("coinsUpdated"));
  window.dispatchEvent(new Event("unlocksUpdated"));
  window.dispatchEvent(new Event("skinsUpdated"));

  console.clear();

  console.log("🔥 FIGHTER'S ARENA FACTORY RESET COMPLETE!");
  console.log("Coins, characters, skins, Festival, and progression reset.");
  console.log("Restarting game...");

  location.reload();
})();

// unlock all characters
localStorage.setItem(
  "fightersArenaUnlockedCharacters",
  JSON.stringify([
    "mina", "rockLee", "usopp", "chad",
    "picolo", "tenten", "kirishima", "ochaco",
    "luffy", "ichigo", "naruto", "yoruichi",
    "goku", "toga", "kenpachi", "hinata"
  ])
);

window.dispatchEvent(new Event("unlocksUpdated"));
