



// Give yourself 10,000 coins (replaces your current balance):
localStorage.setItem("fightersArenaCoins", "10000");
window.dispatchEvent(new Event("coinsUpdated"));




// Add 10,000 coins to your existing balance:
const current = Number(localStorage.getItem("fightersArenaCoins")) || 0;

localStorage.setItem("fightersArenaCoins", String(current + 10000));

window.dispatchEvent(new Event("coinsUpdated"));

console.log("New balance:", current + 10000);


// Reset coins to zero:
localStorage.setItem("fightersArenaCoins", "0");
window.dispatchEvent(new Event("coinsUpdated"));


// Unlock ALL characters:
localStorage.setItem(
  "fightersArenaUnlockedCharacters",
  JSON.stringify([
    "mina",
    "rockLee",
    "usopp",
    "chad",
    "picolo",
    "tenten",
